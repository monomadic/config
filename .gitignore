.DS_Store
.env
.env.*
.claude
!.env.example
.Brewfile.lock.json
.dotter/local.toml
.dotter/cache
.dotter/cache.toml
dotter/local.toml
bin/Logs/
__pycache__/
*.py[cod]
*.lock.json
vendor/bin/beatportdl-config.yml
vendor/bin/beatportdl-credentials.json

# browser profiles must never be tracked
.ug-browser-profile/

# compiled Go binaries built in-tree
src/ytform/ytform

# job-folder data: workflows in config/jobs are tracked, what runs through
# them is not (the Deployfile never links these either)
config/jobs/*/input/
config/jobs/*/output/
config/jobs/*/done/
config/jobs/*/failed/
config/jobs/**/*.log
