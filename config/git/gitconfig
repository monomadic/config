[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only
[add.interactive]
    useBuiltin = false # required for git 2.37.0

[delta]
    navigate = true    # use n and N to move between diff sections
    light = false      # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

[gpg]
  format = ssh

[gpg "ssh"]
  # Wrapper around ssh-keygen that drops SSH_AUTH_SOCK first, so signing
  # always reads the key file and never waits on a 1Password approval.
  program = ~/.bin/ssh-sign-local

[commit]
  gpgsign = true
