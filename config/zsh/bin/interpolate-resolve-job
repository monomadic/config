#!/usr/bin/env zsh
# interpolate-resolve-job
# Queue DaVinci Resolve interpolation instead of running it here: writes one
# NAME.job script per input into the jobs folder, where job-folder (or
# job-daemon) picks it up and runs it.
#
#   interpolate-resolve-job [options] [fps] <input-file>...
#
# All this writes is the job: a short script calling the deployed
# interpolate-resolve on $TARGET_FILE. Getting it into a jobs folder — which
# folder, whether there is room, the atomic drop — is send-job's work, and it
# is handed over with --reference, so nothing is copied: Resolve reads the
# source where it lies and writes its output beside it, exactly as the
# interactive command does. That is the point, with multi-gigabyte files on a
# local disk and the queue running on this machine — and also the one thing to
# keep in mind when send-job asks where to send it, since a referenced job only
# makes sense to a runner that can see that path.
#
# The job is named for the work rather than for the file: `clip.mp4.60.job`
# makes the queue's row read "clip.mp4.60" and keeps two renders of one clip
# apart.
#
# Resolve renders one timeline at a time through the scripting API, so set
# job-folder's Workers to 1 if you queue these alongside other Resolve work.

emulate -L zsh
setopt extended_glob
set -euo pipefail

script_name="${0:t}"

# The *deployed* path, not the repo one: the job runs from job-folder, which
# knows nothing about where this checkout lives.
interpolate="${INTERPOLATE_RESOLVE:-$HOME/.zsh/bin/interpolate-resolve}"
# send-job does the copy-or-reference dance, the folder search and the atomic
# drop — no reason to have a second copy of that here.
send_job="${SEND_JOB:-${0:A:h}/send-job}"
jobs_dir=""   # only when asked for; otherwise send-job chooses or asks

target_fps=60
quality=enhanced-better
use_prores=0
dry_run=false
typeset -a positional=()

usage() {
  cat <<EOF
$script_name

Queue DaVinci Resolve interpolation as jobs.

Usage:
  $script_name [options] [fps] <input-file>...

Arguments:
  [fps]              Target FPS as the first positional (60, 120, 23.976).
                     Defaults to 60.
  <input-file>       One or more input media files; one job each.

Options:
  --fps FPS          Target FPS. Overrides the positional FPS.
  --quality MODE     Optical Flow quality: enhanced-better, speed-warp
  --speed-warp       Shortcut for --quality speed-warp
  --prores           Render ProRes 422 Proxy MOV instead of HEVC MP4
  --dir DIR          Jobs folder, passed straight to send-job. Without it
                     send-job picks the folder, or asks. Also --dir=DIR.
  --dry-run          Print each job, write and send nothing
  -h, --help         Show help

Environment:
  JOBS_DIR             Jobs folder (send-job honours it)
  SEND_JOB             send-job to hand the job to
  INTERPOLATE_RESOLVE  Renderer the job calls (default: ~/.zsh/bin/interpolate-resolve)

Examples:
  $script_name clip.mp4
  $script_name 120 a.mp4 b.mov
  $script_name --prores --speed-warp clip.mp4
EOF
}

die() {
  print -u2 -- "$script_name: $1"
  exit "${2:-1}"
}

normalize_fps() {
  local fps="${1:l}"
  fps="${fps%fps}"
  [[ "$fps" =~ '^[0-9]+([.][0-9]+)?$' ]] || die "invalid fps: $1" 2
  [[ "$fps" == "0" || "$fps" == "0."* ]] && die "fps must be greater than zero: $1" 2
  print -r -- "$fps"
}

while (( $# )); do
  case "$1" in
    --fps)
      (( $# >= 2 )) || die "missing argument for --fps" 2
      target_fps="$(normalize_fps "$2")"
      shift 2
      ;;
    --fps=*)
      target_fps="$(normalize_fps "${1#--fps=}")"
      shift
      ;;
    --quality)
      (( $# >= 2 )) || die "missing argument for --quality" 2
      case "$2" in
        enhanced-better|speed-warp) quality="$2" ;;
        *) die "unknown quality: $2 (enhanced-better, speed-warp)" 2 ;;
      esac
      shift 2
      ;;
    --speed-warp)
      quality=speed-warp
      shift
      ;;
    --prores)
      use_prores=1
      shift
      ;;
    --dir)
      (( $# >= 2 )) || die "missing argument for --dir" 2
      jobs_dir="$2"
      shift 2
      ;;
    --dir=*)
      jobs_dir="${1#--dir=}"
      shift
      ;;
    --dry-run)
      dry_run=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      positional+=( "$@" )
      break
      ;;
    -*)
      die "unknown option: $1" 2
      ;;
    *)
      positional+=( "$1" )
      shift
      ;;
  esac
done

# A leading bare number is the fps, as in interpolate-resolve itself.
if (( ${#positional[@]} > 1 )) && [[ "${positional[1]:l}" =~ '^[0-9]+([.][0-9]+)?(fps)?$' ]]; then
  target_fps="$(normalize_fps "${positional[1]}")"
  positional=( "${positional[@]:1}" )
fi

(( ${#positional[@]} )) || { usage >&2; die "no input file given" 2 }

if ! $dry_run && [[ ! -x "$send_job" ]]; then
  send_job="$(command -v send-job)" || die "send-job not found (set \$SEND_JOB)"
fi

# Reference the renderer through $HOME so the job survives another account.
renderer_ref="${(qq)interpolate}"
if [[ "$interpolate" == "$HOME"/* ]]; then
  rest="${interpolate#$HOME/}"
  if [[ "$rest" == [A-Za-z0-9._/-]## ]]; then
    renderer_ref="\"\$HOME\"/$rest"
  else
    renderer_ref="\"\$HOME\"/${(qq)rest}"
  fi
fi

fps_label="${target_fps//./p}"
label_suffix="$fps_label"
(( use_prores )) && label_suffix="prores$fps_label"

typeset -a job_options=( --fps "$target_fps" --quality "$quality" )
description="${target_fps}fps, $quality"
if (( use_prores )); then
  job_options+=( --prores )
  description+=", ProRes 422 Proxy"
fi

option_line=""
for option in "${job_options[@]}"; do
  if [[ "$option" == --* ]]; then
    option_line+=" $option"
  else
    option_line+=" ${(qq)option}"
  fi
done

staging=""
cleanup() {
  [[ -n "$staging" ]] && rm -rf -- "$staging" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

if ! $dry_run; then
  staging="$(mktemp -d "${TMPDIR:-/tmp}/interpolate-resolve-job.XXXXXX")" \
    || die "could not make a staging directory"
fi

for input in "${positional[@]}"; do
  [[ -f "$input" ]] || die "input file not found: $input"
  input="${input:A}"

  # The source is named through $TARGET_FILE, never inlined: send-job's
  # reference preamble points it at the original, and the same job file would
  # work just as well beside a staged copy.
  job_text="#!/bin/zsh
# DaVinci Resolve interpolation job — generated by $script_name
# $description
: \"\${TARGET_FILE:?run me through the jobs queue, or set TARGET_FILE}\"
exec $renderer_ref$option_line -- \"\$TARGET_FILE\""

  # The job is named for the work, not for the file: `clip.mp4.120.job` keeps
  # two renders of one clip apart in the queue's rows.
  job_name="${input:t}.$label_suffix.job"

  if $dry_run; then
    print -- "job: $job_name${jobs_dir:+ -> $jobs_dir}"
    print -r -- "$job_text"
    print
    continue
  fi

  job_path="$staging/$job_name"
  print -r -- "$job_text" > "$job_path" || die "could not write job file: $job_path"
  chmod +x "$job_path" || die "could not make the job executable: $job_path"

  # Everything from here — which jobs folder, free space, the atomic drop — is
  # send-job's job, and only has to be right in one place.
  "$send_job" --reference ${jobs_dir:+--dir="$jobs_dir"} -- "$input" "$job_path" \
    || die "send-job could not queue $job_name"
done

exit 0
