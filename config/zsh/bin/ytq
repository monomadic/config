#!/usr/bin/env zsh
# -----------------------------------------------------------------------------
# ytq - yt-dlp queue manager
#
# Environment:
#   export YT_DLP_BATCH_FILE=~/.local/share/yt-dlp/queue.txt
#   export YT_DLP_ARCHIVE_FILE=~/.local/share/yt-dlp/archive.txt
#   export YT_DLP_JSON_DIR=~/.local/share/yt-dlp/json
#   export YT_DLP_THUMBCACHE_DIR=~/.local/share/yt-dlp/thumbs
#
# Examples:
#   ytq add https://youtu.be/foo
#   ytq next https://youtu.be/bar
#   ytq paste
#   ytq print
#   ytq list --visuals
#   ytq clean
#   ytq pop --visuals
#   ytq run --visuals
# -----------------------------------------------------------------------------

setopt pipefail

typeset -r YTQ_SELF="${0:A}"

# YTQ_C_TAG/YTQ_C_BORDER use an explicit 256-color gray, NOT \e[90m ("bright
# black") — themes are free to map color8 to whatever they want, including
# literal black (the "1984" theme here maps both color0 AND color8 to
# #000000), which makes \e[90m text invisible on a black background.
# \e[38;5;244m is a fixed mid-gray independent of the terminal's ANSI palette.
typeset -gr \
  YTQ_C_RESET=$'\e[0m'      YTQ_C_DIM=$'\e[2m'        YTQ_C_BOLD=$'\e[1m' \
  YTQ_C_TITLE=$'\e[1;36m'   YTQ_C_USER=$'\e[37m'      YTQ_C_ACTOR=$'\e[35m' \
  YTQ_C_DUR=$'\e[33m'       YTQ_C_OK=$'\e[32m'        YTQ_C_WARN=$'\e[33m' \
  YTQ_C_ERR=$'\e[31m'       YTQ_C_ACCENT=$'\e[38;5;39m' YTQ_C_TAG=$'\e[38;5;244m' \
  YTQ_C_BORDER=$'\e[38;5;244m'

# Font Awesome codepoints via Nerd Font (same PUA range used by starship.toml).
typeset -gr \
  YTQ_I_PLAY=$''   YTQ_I_CHECK=$''  YTQ_I_USER=$'' \
  YTQ_I_USERS=$''  YTQ_I_CLOCK=$''  YTQ_I_CAL=$'' \
  YTQ_I_EYE=$''    YTQ_I_LINK=$''   YTQ_I_DESC=$'' \
  YTQ_I_TAG=$''    YTQ_I_DOWN=$''

require_batch_file() {
  if [[ -z "${YT_DLP_BATCH_FILE:-}" ]]; then
    print -u2 "❌ YT_DLP_BATCH_FILE is not set"
    exit 1
  fi

  mkdir -p "${YT_DLP_BATCH_FILE:h}"
  touch "$YT_DLP_BATCH_FILE"
}

require_command() {
  local cmd="$1"

  command -v "$cmd" >/dev/null 2>&1 || {
    print -u2 "❌ Missing dependency: $cmd"
    exit 1
  }
}

is_url() {
  [[ "$1" =~ '^https?://[^[:space:]]+$' ]]
}

youtube_id_from_url() {
  local url="$1"

  if [[ "$url" =~ 'youtu\.be/([A-Za-z0-9_-]{11})' ]]; then
    print -r -- "$match[1]"
    return 0
  fi

  if [[ "$url" =~ 'youtube(-nocookie)?\.com/(shorts|embed|live|v)/([A-Za-z0-9_-]{11})' ]]; then
    print -r -- "$match[3]"
    return 0
  fi

  if [[ "$url" =~ '[?&]v=([A-Za-z0-9_-]{11})' ]]; then
    print -r -- "$match[1]"
    return 0
  fi

  return 1
}

archive_key_for_url() {
  local url="$1"
  local video_id json key

  # Cached metadata (any extractor yt-dlp supports) is authoritative and
  # matches the archive file's "<extractor> <id>" format directly — try it
  # first so sites other than youtube/faphouse are recognized too.
  if json="$(find_cached_metadata_json "$url" 2>/dev/null)" && [[ -s "$json" ]]; then
    if key="$(archive_key_from_json "$json" 2>/dev/null)" && [[ -n "$key" ]]; then
      print -r -- "$key"
      return 0
    fi
  fi

  if video_id="$(youtube_id_from_url "$url" 2>/dev/null)"; then
    print -r -- "youtube $video_id"
    return 0
  fi

  if video_id="$(faphouse_id_from_url "$url" 2>/dev/null)"; then
    print -r -- "faphouse $video_id"
    return 0
  fi

  if video_id="$(pornhub_id_from_url "$url" 2>/dev/null)"; then
    print -r -- "pornhub $video_id"
    return 0
  fi

  if video_id="$(xhamster_id_from_url "$url" 2>/dev/null)"; then
    print -r -- "xhamster $video_id"
    return 0
  fi

  if video_id="$(xvideos_id_from_url "$url" 2>/dev/null)"; then
    print -r -- "xvideos $video_id"
    return 0
  fi

  if video_id="$(xvideosred_id_from_url "$url" 2>/dev/null)"; then
    print -r -- "xvideosred $video_id"
    return 0
  fi

  return 1
}

# Reads the canonical "<extractor> <id>" key straight out of a cached
# info.json — .extractor is already lowercase and matches yt-dlp's own
# --download-archive line format, so this works for any site, not just the
# ones youtube_id_from_url/faphouse_id_from_url know how to regex.
archive_key_from_json() {
  local json="$1" key

  [[ -s "$json" ]] || return 1
  command -v jq >/dev/null 2>&1 || return 1

  # yt-dlp's own --download-archive lines use ie_key().lower() (the
  # "extractor_key" field, e.g. "InstagramStory" -> "instagramstory"), NOT
  # the "extractor" field (IE_NAME, e.g. "instagram:story") — using the
  # wrong one silently never matches archive entries for compound IEs.
  key="$(jq -r '
    ((.extractor_key // .extractor // "") | tostring | ascii_downcase | gsub("[^a-z0-9]"; "")) as $extractor
    | (.id // "" | tostring) as $id
    | select($extractor != "" and $id != "")
    | "\($extractor) \($id)"
  ' "$json" 2>/dev/null)"

  [[ -n "$key" ]] || return 1
  print -r -- "$key"
}

faphouse_id_from_url() {
  local url="$1"

  if [[ "$url" =~ 'faphouse\.com/([a-z]{2}(-[a-z]{2})?/)?(videos?|watch)/([^/?#&]+)' ]]; then
    print -r -- "$match[4]"
    return 0
  fi

  return 1
}

pornhub_id_from_url() {
  local url="$1"

  if [[ "$url" =~ 'pornhub\.com/.*[?&]viewkey=([a-zA-Z0-9]+)' ]]; then
    print -r -- "$match[1]"
    return 0
  fi

  return 1
}

# yt-dlp's id for XHamster is the trailing "xh...." token on the slug — old
# archive entries predate that (plain numeric ids), those just won't match here.
xhamster_id_from_url() {
  local url="$1"

  if [[ "$url" =~ 'xhamster\.com/videos/.*-(xh[A-Za-z0-9]+)([/?#]|$)' ]]; then
    print -r -- "$match[1]"
    return 0
  fi

  return 1
}

# xvideos.com and xvideos.red are separate yt-dlp extractors ("xvideos" vs
# "xvideosred") despite the identical /video.<id>/... URL shape, so the archive
# key's extractor name has to come from the domain, not just the id.
xvideos_id_from_url() {
  local url="$1"

  if [[ "$url" =~ 'xvideos\.com/video\.([a-z0-9]+)' ]]; then
    print -r -- "$match[1]"
    return 0
  fi

  return 1
}

xvideosred_id_from_url() {
  local url="$1"

  if [[ "$url" =~ 'xvideos\.red/video\.([a-z0-9]+)' ]]; then
    print -r -- "$match[1]"
    return 0
  fi

  return 1
}

load_archive() {
  typeset -gA ARCHIVED
  ARCHIVED=()

  [[ -n "${YT_DLP_ARCHIVE_FILE:-}" && -r "$YT_DLP_ARCHIVE_FILE" ]] || return 0

  local line
  while IFS= read -r line; do
    [[ -n "$line" ]] && ARCHIVED[$line]=1
  done < "$YT_DLP_ARCHIVE_FILE"
}

is_archived_url() {
  local url="$1"
  local archive_key

  [[ -n "${YT_DLP_ARCHIVE_FILE:-}" && -r "$YT_DLP_ARCHIVE_FILE" ]] || return 1

  archive_key="$(archive_key_for_url "$url" 2>/dev/null)" || archive_key=""

  if [[ -n "$archive_key" && -n "${ARCHIVED[$archive_key]:-}" ]]; then
    return 0
  fi

  [[ -n "${ARCHIVED[$url]:-}" ]]
}

load_queue() {
  typeset -gA QUEUED

  local line
  while IFS= read -r line; do
    [[ -n "$line" ]] && QUEUED[$line]=1
  done < "$YT_DLP_BATCH_FILE"
}

cmd_add() {
  require_batch_file
  load_queue

  (( $# > 0 )) || {
    print -u2 "Usage: ytq add <url> [url ...]"
    exit 1
  }

  local added=0
  local skipped=0
  local url

  for url in "$@"; do
    if ! is_url "$url"; then
      print -u2 "❌ Invalid URL: $url"
      ((skipped++))
      continue
    fi

    if [[ -n ${QUEUED[$url]} ]]; then
      print "⚠️  Already queued: $url"
      ((skipped++))
      continue
    fi

    print -r -- "$url" >> "$YT_DLP_BATCH_FILE"
    QUEUED[$url]=1

    print "➕ Added: $url"
    ((added++))
  done

  print ""
  print "Added:   $added"
  print "Skipped: $skipped"
}

cmd_next() {
  require_batch_file

  (( $# > 0 )) || {
    print -u2 "Usage: ytq next <url> [url ...]"
    exit 1
  }

  local tmp_file
  tmp_file="$(mktemp)" || exit 1

  local url
  local added=0
  local skipped=0

  {
    for url in "$@"; do
      if ! is_url "$url"; then
        print -u2 "❌ Invalid URL: $url"
        ((skipped++))
        continue
      fi

      print -r -- "$url"
      [[ -w /dev/tty ]] && print "⬆️  Prioritized: $url" > /dev/tty
      ((added++))
    done

    while IFS= read -r line; do
      local keep=1

      for url in "$@"; do
        [[ "$line" == "$url" ]] && keep=0 && break
      done

      (( keep )) && print -r -- "$line"
    done < "$YT_DLP_BATCH_FILE"

  } > "$tmp_file"

  mv "$tmp_file" "$YT_DLP_BATCH_FILE"

  print ""
  print "Prioritized: $added"
  print "Skipped:     $skipped"
}

cmd_addclip() {
  local clip
  clip="$(pbpaste)"

  [[ -n "$clip" ]] || {
    print -u2 "❌ Clipboard is empty"
    exit 1
  }

  cmd_add ${(f)clip}
}

cmd_queue() {
  require_batch_file

  if [[ ! -s "$YT_DLP_BATCH_FILE" ]]; then
    print "📭 Queue is empty"
    return
  fi

  nl -ba "$YT_DLP_BATCH_FILE"
}

cmd_clean_completed() {
  require_batch_file

  local quiet=false

  if [[ "${1:-}" == "--quiet" ]]; then
    quiet=true
    shift
  fi

  if [[ -z "${YT_DLP_ARCHIVE_FILE:-}" ]]; then
    print -u2 "❌ YT_DLP_ARCHIVE_FILE is not set; cannot identify completed downloads"
    return 1
  fi

  if [[ ! -r "$YT_DLP_ARCHIVE_FILE" ]]; then
    print -u2 "❌ Archive file is not readable: $YT_DLP_ARCHIVE_FILE"
    return 1
  fi

  load_archive
  load_json_url_index

  local tmp_file
  tmp_file="$(mktemp)" || return 1

  local line kept=0 removed=0
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue

    if is_archived_url "$line"; then
      ((removed++))
      continue
    fi

    print -r -- "$line" >> "$tmp_file"
    ((kept++))
  done < "$YT_DLP_BATCH_FILE"

  mv "$tmp_file" "$YT_DLP_BATCH_FILE"

  $quiet || {
    print "🧹 Removed completed: $removed"
    print "Remaining fresh:   $kept"
  }
}

# Compact "1h 2m" / "3m 4s" duration from raw seconds — mirrors ytui's own
# human_duration but for the list row, where space is tight.
ytq_fmt_duration() {
  local -i secs="${1:-0}"
  (( secs > 0 )) || return 1

  local -i h=$(( secs / 3600 )) m=$(( (secs % 3600) / 60 )) s=$(( secs % 60 ))
  if (( h > 0 )); then
    print -r -- "${h}h ${m}m"
  elif (( m > 0 )); then
    print -r -- "${m}m ${s}s"
  else
    print -r -- "${s}s"
  fi
}

# One colorful line per queue entry. Falls back to the plain archived-glyph +
# URL row (the original format) whenever there's no cached metadata for it yet.
queue_list_item() {
  local url="$1"
  local index="$2"

  local meta="${JSON_URL_META[$url]:-${JSON_URL_META[${url%%\#*}]:-}}"
  # Exact webpage_url/original_url match missed — try the same <extractor>_<id>
  # stem identity find_cached_metadata_json falls back to (redirects, stale
  # entries, trailing slashes all break the exact-string match above).
  if [[ -z "$meta" ]]; then
    local cand stem
    for cand in "${(@f)$(metadata_json_candidates "$url" "")}"; do
      stem="${cand#/}"; stem="${stem%.info.json}"
      [[ -n "${JSON_URL_META[$stem]:-}" ]] && { meta="${JSON_URL_META[$stem]}"; break }
    done
  fi
  local glyph color idxfmt line suffix
  idxfmt="$(printf '%4s' "$index")"

  # Running beats archived: a re-download in flight is the more useful thing to
  # see, and mid-download the archive may already claim the entry.
  if is_running_url "$url"; then
    glyph="${YTQ_C_WARN}${YTQ_I_DOWN}${YTQ_C_RESET}"
    suffix="  ${YTQ_C_WARN}${YTQ_I_DOWN} downloading${YTQ_C_RESET}"
  elif is_archived_url "$url"; then
    glyph="${YTQ_C_OK}${YTQ_I_CHECK}${YTQ_C_RESET}"
  else
    glyph="${YTQ_C_ACCENT}${YTQ_I_PLAY}${YTQ_C_RESET}"
  fi

  if [[ -z "$meta" ]]; then
    printf '%s\t%s\t%s %s%s %s%s%s\n' "$url" "$index" "$glyph" "$YTQ_C_DIM" "$idxfmt" "$url" "$YTQ_C_RESET" "$suffix"
    return
  fi

  local title uploader cast duration extractor
  IFS=$'\x1f' read -r title uploader cast duration extractor <<< "$meta"

  line="${glyph} ${YTQ_C_DIM}${idxfmt}${YTQ_C_RESET}"
  [[ -n "$title" ]] && line+="  ${YTQ_C_TITLE}${title}${YTQ_C_RESET}" || line+="  ${url}"
  [[ -n "$uploader" ]] && line+="  ${YTQ_C_DIM}${YTQ_I_USER}${YTQ_C_RESET} ${YTQ_C_USER}${uploader}${YTQ_C_RESET}"
  [[ -n "$cast" && "$cast" != "$uploader" ]] && line+="  ${YTQ_C_DIM}${YTQ_I_USERS}${YTQ_C_RESET} ${YTQ_C_ACTOR}${cast}${YTQ_C_RESET}"
  local durtxt; durtxt="$(ytq_fmt_duration "$duration" 2>/dev/null)" && line+="  ${YTQ_C_DIM}${YTQ_I_CLOCK} ${durtxt}${YTQ_C_RESET}"
  [[ -n "$extractor" ]] && line+="  ${YTQ_C_TAG}${YTQ_I_TAG} ${extractor}${YTQ_C_RESET}"
  line+="$suffix"

  printf '%s\t%s\t%s\n' "$url" "$index" "$line"
}

cmd_list_rows() {
  require_batch_file
  load_archive
  load_json_url_index

  local line index=0
  while IFS= read -r line; do
    ((index++))
    [[ -n "$line" ]] && queue_list_item "$line" "$index"
  done < "$YT_DLP_BATCH_FILE"
}

cmd_rm_index() {
  require_batch_file

  local index="$1"

  [[ -n "$index" ]] || {
    print -u2 "Usage: ytq __rm_index <number>"
    return 1
  }

  [[ "$index" == <-> && "$index" -gt 0 ]] || {
    print -u2 "❌ Invalid queue number: $index"
    return 1
  }

  local tmp_file
  tmp_file="$(mktemp)" || return 1

  awk -v target="$index" 'NR != target { print }' "$YT_DLP_BATCH_FILE" > "$tmp_file"
  mv "$tmp_file" "$YT_DLP_BATCH_FILE"
}

next_unarchived_queue_item() {
  require_batch_file
  load_archive
  load_json_url_index

  local line index=0
  while IFS= read -r line; do
    ((index++))
    [[ -n "$line" ]] || continue
    is_archived_url "$line" && continue

    printf '%s\t%s\n' "$index" "$line"
    return 0
  done < "$YT_DLP_BATCH_FILE"

  return 1
}

queue_push_top() {
  require_batch_file

  local url="$1"
  local tmp_file

  tmp_file="$(mktemp)" || return 1

  {
    print -r -- "$url"
    cat "$YT_DLP_BATCH_FILE"
  } > "$tmp_file"

  mv "$tmp_file" "$YT_DLP_BATCH_FILE"
}

ytq_cache_dir() {
  print -r -- "${XDG_CACHE_HOME:-$HOME/.cache}/ytq"
}

url_cache_key() {
  printf 'ytq-preview-v4\n%s' "$1" | shasum -a 256 | awk '{print $1}'
}

# ── in-flight download state ─────────────────────────────────────────────────
# `ytq list` Enter now launches ytui in its own Kitty window and stays open, so
# the list has to show which rows are being downloaded by a window it doesn't
# own. A marker file per URL is the whole mechanism: the launcher creates it,
# the ytui wrapper (__run_ytui) overwrites it with its own pid and deletes it on
# exit, and the row renderer reads it. Nothing here is authoritative about the
# download itself — the archive file still is, once yt-dlp finishes.
ytq_running_dir() {
  print -r -- "$(ytq_cache_dir)/running"
}

ytq_launch_log() {
  print -r -- "$(ytq_cache_dir)/launch.log"
}

running_marker_for_url() {
  print -r -- "$(ytq_running_dir)/$(url_cache_key "$1")"
}

mark_running() {
  local marker
  marker="$(running_marker_for_url "$1")" || return 1
  mkdir -p "${marker:h}" 2>/dev/null
  print -r -- "${2:-}" > "$marker"
}

clear_running() {
  rm -f -- "$(running_marker_for_url "$1")" 2>/dev/null
}

# Self-healing: a marker whose pid is gone (window closed, machine rebooted,
# ytui killed) is deleted on sight rather than leaving a row stuck at
# "downloading" forever. The pid-less window is the gap between the launcher
# writing the marker and __run_ytui claiming it — trusted briefly, then stale.
is_running_url() {
  local marker pid now mtime
  marker="$(running_marker_for_url "$1")" || return 1

  [[ -e "$marker" ]] || return 1

  pid="$(<"$marker")" 2>/dev/null || pid=""
  pid="${pid//[^0-9]/}"

  if [[ -n "$pid" ]]; then
    kill -0 "$pid" 2>/dev/null && return 0
    rm -f -- "$marker" 2>/dev/null
    return 1
  fi

  now="$(date +%s)" || return 0
  mtime="$(stat -f %m "$marker" 2>/dev/null || stat -c %Y "$marker" 2>/dev/null)" || return 0
  (( now - mtime < 120 )) && return 0

  rm -f -- "$marker" 2>/dev/null
  return 1
}

# Nudge a RUNNING `ytq list` (started with --listen) to re-render its rows.
# Used both from the preview pane and from the ytui wrapper in another Kitty
# window, which only knows the port because it was passed one on the command line.
fzf_reload_rows() {
  local port="$1"

  [[ "$port" == <-> ]] || return 0
  command -v curl >/dev/null 2>&1 || return 0

  curl -s -XPOST "localhost:${port}" -d "reload(${(q)YTQ_SELF} __list_rows)" >/dev/null 2>&1
}

ytq_json_dir() {
  [[ -n "${YT_DLP_JSON_DIR:-}" ]] || return 1
  print -r -- "${~YT_DLP_JSON_DIR}"
}

ytq_thumbcache_dir() {
  if [[ -n "${YT_DLP_THUMBCACHE_DIR:-}" ]]; then
    print -r -- "${~YT_DLP_THUMBCACHE_DIR}"
  else
    ytq_cache_dir
  fi
}

metadata_json_candidates() {
  local url="$1"
  local dir="$2"
  local video_id

  if video_id="$(youtube_id_from_url "$url" 2>/dev/null)"; then
    print -r -- "$dir/youtube_${video_id}.info.json"
  fi

  if video_id="$(faphouse_id_from_url "$url" 2>/dev/null)"; then
    print -r -- "$dir/faphouse_${video_id}.info.json"
  fi

  if video_id="$(pornhub_id_from_url "$url" 2>/dev/null)"; then
    print -r -- "$dir/pornhub_${video_id}.info.json"
  fi

  if video_id="$(xhamster_id_from_url "$url" 2>/dev/null)"; then
    print -r -- "$dir/xhamster_${video_id}.info.json"
  fi

  if video_id="$(xvideos_id_from_url "$url" 2>/dev/null)"; then
    print -r -- "$dir/xvideos_${video_id}.info.json"
  fi

  if video_id="$(xvideosred_id_from_url "$url" 2>/dev/null)"; then
    print -r -- "$dir/xvideosred_${video_id}.info.json"
  fi
}

metadata_json_matches_url() {
  local json="$1"
  local url="$2"
  local url_no_fragment="${url%%#*}"
  local youtube_id faphouse_id

  command -v jq >/dev/null 2>&1 || return 1

  youtube_id="$(youtube_id_from_url "$url" 2>/dev/null)" || youtube_id=""
  faphouse_id="$(faphouse_id_from_url "$url" 2>/dev/null)" || faphouse_id=""

  jq -e \
    --arg url "$url" \
    --arg url_no_fragment "$url_no_fragment" \
    --arg youtube_id "$youtube_id" \
    --arg faphouse_id "$faphouse_id" '
      def extractor:
        ((.extractor_key // .extractor // "") | tostring | ascii_downcase);

      (.webpage_url? == $url)
      or (.original_url? == $url)
      or (.webpage_url? == $url_no_fragment)
      or (.original_url? == $url_no_fragment)
      or ($youtube_id != "" and (.id? == $youtube_id) and extractor == "youtube")
      or ($faphouse_id != "" and (.id? == $faphouse_id) and extractor == "faphouse")
    ' "$json" >/dev/null 2>&1
}

# Full-directory fallback scan (metadata_json_matches_url per file) costs one jq
# spawn per cached json. Called once per URL that's fine, but is_archived_url runs
# it per QUEUE ROW — for a queue of N items against M cached json files that's
# O(N*M) jq spawns, which is what made `ytq list` crawl. load_json_url_index()
# below does the same scan ONCE and indexes it, so batch callers (cmd_list_rows,
# next_unarchived_queue_item, cmd_clean_completed) get O(1) lookups per row instead.
#
# The same pass also fills JSON_URL_META (title/uploader/cast/duration/extractor,
# joined by \x1f) so the colorful list rows don't need a second per-row jq spawn.
typeset -gA JSON_URL_INDEX JSON_URL_META
typeset -gi JSON_INDEX_READY=0

load_json_url_index() {
  JSON_URL_INDEX=()
  JSON_URL_META=()
  JSON_INDEX_READY=0

  local dir; dir="$(ytq_json_dir 2>/dev/null)" || return 0
  [[ -d "$dir" ]] || return 0
  command -v jq >/dev/null 2>&1 || return 0

  local -a files
  files=( "$dir"/*.info.json(N.) )
  (( ${#files} )) || { JSON_INDEX_READY=1; return 0 }

  local -r meta_filter='
    def clean:
      if . == null then ""
      else
        (tostring
         | gsub("[\u0001-\u001f\u007f\u00a0\u200b\u200c\u200d\ufeff]"; " ")
         | gsub(" +"; " ")
         | sub("^ +"; "")
         | sub(" +$"; ""))
      end;
    [
      input_filename,
      (.webpage_url // "" | clean),
      (.original_url // "" | clean),
      (.title // "" | clean),
      ((.uploader // .channel // .creator // "") | clean),
      (((.cast // .creators // []) | if type == "array" then join(", ") else tostring end) | clean),
      ((.duration // 0) | tostring),
      ((.extractor_key // .extractor // "") | tostring | ascii_downcase)
    ] | join("")
    '

  # jq streams multiple file args as one job (input_filename tags each result),
  # so this is ONE spawn per chunk instead of one per file — the chunking is
  # just a resilience cap: a single malformed json aborts jq mid-stream, and
  # capping the blast radius to 200 files keeps that from losing the whole index.
  #
  # Fields are \x1f-joined, NOT tab (@tsv) — zsh's `read` treats tab (and space)
  # as an "IFS whitespace" class and silently COLLAPSES runs of them even when
  # IFS is scoped to just that one character, so a null .original_url (an empty
  # field between two tabs) merges with its neighbor and shifts every field
  # after it. \x1f isn't in that whitespace class, so empty fields survive —
  # and `clean` above already strips any stray \x1f out of the values
  # themselves, so it's a safe delimiter to introduce.
  local -a slice
  local -i chunk=200 i=1 n=${#files}
  local out file webpage original title uploader cast duration extractor meta stem
  while (( i <= n )); do
    slice=( "${(@)files[i,i+chunk-1]}" )
    out="$(jq -r "$meta_filter" "${slice[@]}" 2>/dev/null)"
    while IFS=$'\x1f' read -r file webpage original title uploader cast duration extractor; do
      [[ -n "$file" ]] || continue
      meta="${title}"$'\x1f'"${uploader}"$'\x1f'"${cast}"$'\x1f'"${duration}"$'\x1f'"${extractor}"
      if [[ -n "$webpage" ]]; then
        JSON_URL_INDEX[$webpage]="$file"
        JSON_URL_META[$webpage]="$meta"
      fi
      if [[ -n "$original" ]]; then
        JSON_URL_INDEX[$original]="$file"
        JSON_URL_META[$original]="$meta"
      fi
      # Also key by the <extractor>_<id> filename stem — the same identity
      # find_cached_metadata_json falls back to via metadata_json_candidates()
      # when a queued URL's exact string doesn't match the json's own
      # webpage_url/original_url (redirects, trailing slashes, stale entries).
      stem="${file:t}"; stem="${stem%.info.json}"
      [[ -n "$stem" ]] && JSON_URL_META[$stem]="$meta"
    done <<< "$out"
    (( i += chunk ))
  done

  JSON_INDEX_READY=1
}

find_cached_metadata_json() {
  local url="$1"
  local dir candidate file
  local -a candidates

  dir="$(ytq_json_dir 2>/dev/null)" || return 1
  [[ -d "$dir" ]] || return 1

  candidates=("${(@f)$(metadata_json_candidates "$url" "$dir")}")
  for candidate in "${candidates[@]}"; do
    [[ -s "$candidate" ]] && {
      print -r -- "$candidate"
      return 0
    }
  done

  # A batch caller already built the index (one pass over every cached json) —
  # trust it and skip straight to a hash lookup instead of re-scanning the
  # directory for this one URL.
  if (( JSON_INDEX_READY )); then
    local url_no_fragment="${url%%#*}"
    local hit="${JSON_URL_INDEX[$url]:-${JSON_URL_INDEX[$url_no_fragment]:-}}"
    [[ -n "$hit" && -s "$hit" ]] && { print -r -- "$hit"; return 0; }
    return 1
  fi

  command -v jq >/dev/null 2>&1 || return 1

  for file in "$dir"/*.info.json(N.); do
    if metadata_json_matches_url "$file" "$url"; then
      print -r -- "$file"
      return 0
    fi
  done

  return 1
}

metadata_json_has_thumbnail() {
  local json="$1"

  [[ -s "$json" ]] || return 1
  command -v jq >/dev/null 2>&1 || return 1

  jq -e '
    ((.thumbnail // "") | tostring | length > 0)
    or ((.thumbnails // []) | length > 0)
  ' "$json" >/dev/null 2>&1
}

thumbnail_is_valid() {
  local file="$1"
  local mime=""
  local mime_checked=false

  [[ -s "$file" ]] || return 1

  if command -v file >/dev/null 2>&1; then
    mime="$(file -b --mime-type "$file" 2>/dev/null || file -b -I "$file" 2>/dev/null)" || mime=""
    mime="${mime%%;*}"
    mime_checked=true
    [[ "$mime" == image/* ]] || return 1
  fi

  if command -v sips >/dev/null 2>&1 && sips -g pixelWidth -g pixelHeight "$file" >/dev/null 2>&1; then
    return 0
  fi

  if command -v magick >/dev/null 2>&1 && magick identify "$file" >/dev/null 2>&1; then
    return 0
  fi

  if command -v identify >/dev/null 2>&1 && identify "$file" >/dev/null 2>&1; then
    return 0
  fi

  $mime_checked
}

find_preview_thumbnail() {
  local base ext candidate

  for base in "$@"; do
    [[ -n "$base" ]] || continue

    for ext in jpg jpeg png webp avif; do
      candidate="${base}.${ext}"
      [[ -e "$candidate" ]] || continue

      if thumbnail_is_valid "$candidate"; then
        print -r -- "$candidate"
        return 0
      fi

      rm -f -- "$candidate"
    done
  done

  return 1
}

thumbnail_stem_from_json() {
  local json="$1"

  [[ -s "$json" ]] || return 1
  command -v jq >/dev/null 2>&1 || return 1

  jq -r '
    (.extractor // (.extractor_key // "" | tostring | ascii_downcase) | tostring) as $extractor
    | (.id // "" | tostring) as $id
    | select($extractor != "" and $id != "")
    | "\($extractor)_\($id)"
  ' "$json" 2>/dev/null
}

thumbnail_base_candidates() {
  local url="$1"
  local key="$2"
  local json="${3:-}"
  local fallback_base="${4:-}"
  local thumb_dir stem video_id base
  typeset -A seen

  thumb_dir="$(ytq_thumbcache_dir 2>/dev/null)" || return 1
  seen=()

  if stem="$(thumbnail_stem_from_json "$json" 2>/dev/null)" && [[ -n "$stem" ]]; then
    base="$thumb_dir/$stem"
    [[ -z "${seen[$base]:-}" ]] && print -r -- "$base" && seen[$base]=1
  fi

  if video_id="$(youtube_id_from_url "$url" 2>/dev/null)"; then
    base="$thumb_dir/youtube_$video_id"
    [[ -z "${seen[$base]:-}" ]] && print -r -- "$base" && seen[$base]=1
  fi

  if video_id="$(faphouse_id_from_url "$url" 2>/dev/null)"; then
    base="$thumb_dir/faphouse_$video_id"
    [[ -z "${seen[$base]:-}" ]] && print -r -- "$base" && seen[$base]=1
  fi

  base="$thumb_dir/$key"
  [[ -z "${seen[$base]:-}" ]] && print -r -- "$base" && seen[$base]=1

  if [[ -n "$fallback_base" ]]; then
    [[ -z "${seen[$fallback_base]:-}" ]] && print -r -- "$fallback_base"
  fi
}

find_cached_thumbnail() {
  local url="$1"
  local key="$2"
  local json="${3:-}"
  local fallback_base="${4:-}"
  local -a bases

  bases=("${(@f)$(thumbnail_base_candidates "$url" "$key" "$json" "$fallback_base")}")
  find_preview_thumbnail "${bases[@]}"
}

thumbnail_output_template() {
  local fallback_template="$1"

  if [[ -n "${YT_DLP_THUMBCACHE_DIR:-}" ]]; then
    print -r -- '%(extractor)s_%(id)s.%(ext)s'
  else
    print -r -- "$fallback_template"
  fi
}

preview_error_cache_fresh() {
  local error_file="$1"
  local max_age="${YTQ_PREVIEW_ERROR_CACHE_SECONDS:-300}"
  local now mtime

  [[ -s "$error_file" ]] || return 1
  if grep -qiE 'already been recorded in the archive|has already been recorded in the archive' "$error_file" 2>/dev/null; then
    return 1
  fi

  [[ "$max_age" == <-> ]] || max_age=300
  (( max_age > 0 )) || return 1

  now="$(date +%s)" || return 1
  mtime="$(stat -f %m "$error_file" 2>/dev/null || stat -c %Y "$error_file" 2>/dev/null)" || return 1

  (( now - mtime < max_age ))
}

# A row change in fzf kills the in-flight preview command (and its yt-dlp
# child) mid-write. yt-dlp writes thumbnails straight to their final name, so
# an interrupted fetch used to leave a truncated/corrupt file sitting at the
# shared cache path — later reads could pick it up as "the" thumbnail even
# though it never fully downloaded. Fetch into a private tmp dir instead and
# only promote files that pass thumbnail_is_valid into the shared cache.
stage_thumbnails() {
  local tmp_dir="$1" dest_dir="$2"
  local f

  [[ -d "$tmp_dir" ]] || return 0
  mkdir -p "$dest_dir" 2>/dev/null

  for f in "$tmp_dir"/*(N.); do
    if thumbnail_is_valid "$f"; then
      mv -f -- "$f" "$dest_dir/${f:t}"
    else
      rm -f -- "$f"
    fi
  done
}

fetch_preview_cache() {
  local url="$1"
  local base="$2"
  local key="${base:t}"
  local json="${base}.info.json"
  local error_file="${base}.error"
  local cache_dir="${base:h}"
  local cache_template="${base:t}.%(ext)s"
  local thumb_dir thumb_template metadata_json json_dir fetch_status tmp_log tmp_thumb_dir
  local -a metadata_args

  thumb_dir="$(ytq_thumbcache_dir)"
  thumb_template="$(thumbnail_output_template "$cache_template")"
  mkdir -p "$thumb_dir" 2>/dev/null

  metadata_json="$(find_cached_metadata_json "$url" 2>/dev/null)" || metadata_json=""
  if [[ -s "$metadata_json" ]]; then
    find_cached_thumbnail "$url" "$key" "$metadata_json" "$base" >/dev/null 2>&1 && return 0
    fetch_preview_thumbnail_from_json "$metadata_json" "$thumb_dir" "$thumb_template"
    find_cached_thumbnail "$url" "$key" "$metadata_json" "$base" >/dev/null 2>&1 && return 0
    metadata_json_has_thumbnail "$metadata_json" && return 0
  fi

  [[ -s "$json" ]] && return 0
  preview_error_cache_fresh "$error_file" && return 0
  rm -f "$error_file"

  if ! command -v yt-dlp >/dev/null 2>&1; then
    print -r -- "yt-dlp not found" > "$error_file"
    return 0
  fi

  tmp_log="${error_file}.tmp.$$"
  rm -f "$tmp_log"

  if json_dir="$(ytq_json_dir 2>/dev/null)"; then
    mkdir -p "$json_dir" 2>/dev/null
    metadata_args=(
      --paths "infojson:$json_dir"
      --output 'infojson:%(extractor)s_%(id)s'
    )
  else
    metadata_args=(
      --paths "infojson:$cache_dir"
      --output "infojson:$cache_template"
    )
  fi

  tmp_thumb_dir="$(mktemp -d -t ytq-thumb)" || tmp_thumb_dir=""

  {
    yt-dlp \
      --skip-download \
      --write-thumbnail \
      --write-info-json \
      --no-download-archive \
      --no-playlist \
      --no-warnings \
      --no-progress \
      "${metadata_args[@]}" \
      --paths "home:$cache_dir" \
      --paths "temp:$cache_dir" \
      --paths "thumbnail:${tmp_thumb_dir:-$thumb_dir}" \
      --output "$cache_template" \
      --output "thumbnail:$thumb_template" \
      "$url" > "$tmp_log" 2>&1
    fetch_status=$?
  } always {
    [[ -n "$tmp_thumb_dir" ]] && stage_thumbnails "$tmp_thumb_dir" "$thumb_dir"
    [[ -n "$tmp_thumb_dir" ]] && rm -rf -- "$tmp_thumb_dir"
  }

  metadata_json="$(find_cached_metadata_json "$url" 2>/dev/null)" || metadata_json=""

  if (( fetch_status != 0 )) || [[ ! -s "$metadata_json" && ! -s "$json" ]]; then
    if [[ -s "$tmp_log" ]]; then
      cat "$tmp_log" > "$error_file"
    else
      print -r -- "yt-dlp preview fetch failed with status $fetch_status" > "$error_file"
    fi
    rm -f "$tmp_log"
  else
    rm -f "$tmp_log"
    rm -f "$error_file"
  fi
}

fetch_preview_thumbnail_from_json() {
  local json="$1"
  local thumb_dir="$2"
  local thumb_template="$3"
  local tmp_thumb_dir

  [[ -s "$json" ]] || return 1
  command -v yt-dlp >/dev/null 2>&1 || return 1
  mkdir -p "$thumb_dir" 2>/dev/null

  tmp_thumb_dir="$(mktemp -d -t ytq-thumb)" || tmp_thumb_dir=""

  {
    yt-dlp \
      --load-info-json "$json" \
      --skip-download \
      --write-thumbnail \
      --no-write-info-json \
      --no-download-archive \
      --no-warnings \
      --no-progress \
      --paths "home:${tmp_thumb_dir:-$thumb_dir}" \
      --paths "temp:${tmp_thumb_dir:-$thumb_dir}" \
      --paths "thumbnail:${tmp_thumb_dir:-$thumb_dir}" \
      --output "$thumb_template" \
      --output "thumbnail:$thumb_template" \
      >/dev/null 2>&1
  } always {
    [[ -n "$tmp_thumb_dir" ]] && stage_thumbnails "$tmp_thumb_dir" "$thumb_dir"
    [[ -n "$tmp_thumb_dir" ]] && rm -rf -- "$tmp_thumb_dir"
  }
}

preview_image_handler() {
  local handler="${YTQ_PREVIEW_IMAGE_HANDLER:-auto}"

  if [[ "$handler" != "auto" ]]; then
    print -r -- "$handler"
    return 0
  fi

  if [[ -n "${KITTY_WINDOW_ID:-}" || "${TERM_PROGRAM:-}" == "kitty" || "${TERM:-}" == xterm-kitty* ]]; then
    print -r -- "kitty"
  elif command -v chafa >/dev/null 2>&1; then
    print -r -- "symbols"
  else
    print -r -- "none"
  fi
}

render_kitty_image() {
  local image="$1"
  local columns="$2"
  local image_lines="$3"
  local -a icat_cmd
  local i

  if command -v kitty >/dev/null 2>&1; then
    icat_cmd=(kitty +kitten icat)
  elif command -v kitten >/dev/null 2>&1; then
    icat_cmd=(kitten icat)
  else
    return 1
  fi

  "${icat_cmd[@]}" \
    --clear \
    --transfer-mode=file \
    --stdin=no \
    --align=left \
    --place="${columns}x${image_lines}@0x0" \
    "$image" 2>/dev/null || return 1

  for (( i = 0; i < image_lines; i++ )); do
    print ""
  done
}

render_preview_image() {
  local image="$1"
  local columns="${FZF_PREVIEW_COLUMNS:-80}"
  local lines="${FZF_PREVIEW_LINES:-40}"
  local image_lines=$(( lines - 13 ))
  local handler

  (( image_lines > 22 )) && image_lines=22
  (( image_lines < 8 )) && image_lines=8

  handler="$(preview_image_handler)"

  case "$handler" in
    kitty)
      if render_kitty_image "$image" "$columns" "$image_lines"; then
        return 0
      fi
      ;;
    none)
      print "\033[36mThumbnail:\033[0m $image"
      return 0
      ;;
    symbols)
      if command -v chafa >/dev/null 2>&1; then
        chafa -f symbols -s "${columns}x${image_lines}" "$image" --animate false
        return 0
      fi
      ;;
  esac

  if command -v chafa >/dev/null 2>&1; then
    chafa -f symbols -s "${columns}x${image_lines}" "$image" --animate false
  else
    print "\033[36mThumbnail:\033[0m $image"
  fi
}

print_preview_archive_status() {
  local url="$1"

  load_archive

  if [[ -z "${YT_DLP_ARCHIVE_FILE:-}" ]]; then
    print "${YTQ_C_WARN}${YTQ_I_TAG} archive file not set${YTQ_C_RESET}"
  elif [[ ! -r "$YT_DLP_ARCHIVE_FILE" ]]; then
    print "${YTQ_C_WARN}${YTQ_I_TAG} archive file not readable${YTQ_C_RESET}"
  elif is_archived_url "$url"; then
    print "${YTQ_C_OK}${YTQ_I_CHECK} already downloaded${YTQ_C_RESET}"
  else
    print "${YTQ_C_ACCENT}${YTQ_I_PLAY} not downloaded yet${YTQ_C_RESET}"
  fi
}

# No text labels for the obvious stuff -- an icon says "this is the uploader"
# or "this is the duration" as well as a word would, in a fraction of the
# width. "Description" keeps its header since there's no icon that reads
# unambiguously as "description" at a glance the way a clock does for duration.
print_preview_metadata() {
  local json="$1"

  if ! command -v jq >/dev/null 2>&1; then
    print "${YTQ_C_WARN}jq not found; showing raw metadata path:${YTQ_C_RESET} $json"
    return
  fi

  jq -r '
    def clean:
      if . == null or . == "" then null
      else
        (tostring
         | gsub("[\u0001-\u001f\u007f\u00a0\u200b\u200c\u200d\ufeff]"; " ")
         | gsub(" +"; " ")
         | sub("^ +"; "")
         | sub(" +$"; ""))
      end;
    def human_duration:
      if .duration == null then null
      else
        (.duration | floor) as $total
        | (($total / 3600) | floor) as $hours
        | ((($total % 3600) / 60) | floor) as $minutes
        | ($total % 60) as $seconds
        | if $hours > 0
          then "\($hours)h \($minutes)m"
          else "\($minutes)m \($seconds)s"
          end
      end;
    def upload_day:
      (.upload_date // .release_date) as $day
      | if $day == null then null
        else ($day | tostring) as $text
        | if ($text | test("^[0-9]{8}$"))
          then $text[0:4] + "-" + $text[4:6] + "-" + $text[6:8]
          else $text
          end
        end;
    def human_views:
      .view_count as $v
      | if $v == null then null
        elif $v >= 1000000 then (($v / 1000000 * 10 | round) / 10 | tostring) + "M"
        elif $v >= 1000 then (($v / 1000 * 10 | round) / 10 | tostring) + "K"
        else ($v | tostring)
        end;

    (.title | clean) as $title
    | ((.uploader // .channel // .creator) | clean) as $uploader
    | (((.cast // .creators // []) | if type == "array" then join(", ") else clean end) | clean) as $cast
    | ((.extractor_key // .extractor // "yt-dlp") | tostring | ascii_downcase) as $extractor
    | ((.id // "") | tostring) as $id
    | (.description | clean) as $description
    | (.webpage_url // .original_url) as $url

    | (if $title then "[1;36m" + $title + "[0m" else empty end),
      (
        [
          (if $uploader then "[2m[0m [37m" + $uploader + "[0m" else empty end),
          (if human_duration then "[2m " + human_duration + "[0m" else empty end),
          (if upload_day then "[2m " + upload_day + "[0m" else empty end)
        ] | map(select(. != null)) | join("  ")
      ),
      (if $cast and $cast != $uploader
       then "[2m[0m [35m" + $cast + "[0m"
       else empty end),
      (
        [
          (if human_views then "[2m " + human_views + "[0m" else empty end),
          "[38;5;244m " + $extractor + " " + $id + "[0m"
        ] | map(select(. != null)) | join("  ")
      ),
      (if $url then "[2m " + $url + "[0m" else empty end),
      (if $description and $description != ""
       then "\n[38;5;244m Description[0m\n" + ($description[0:800])
       else empty end)
  ' "$json" 2>/dev/null
}
cmd_preview() {
  local url="$1"

  [[ -n "$url" ]] || return 0

  local cache_dir
  cache_dir="$(ytq_cache_dir)"
  mkdir -p "$cache_dir"

  local key base json error_file thumbnail
  key="$(url_cache_key "$url")"
  base="${cache_dir}/${key}"
  json="$(find_cached_metadata_json "$url" 2>/dev/null)" || json=""
  [[ -n "$json" ]] || json="${base}.info.json"
  error_file="${base}.error"

  local -i had_meta=0
  [[ -s "$json" ]] && had_meta=1

  print_preview_archive_status "$url"
  print ""

  fetch_preview_cache "$url" "$base"
  json="$(find_cached_metadata_json "$url" 2>/dev/null)" || json=""
  [[ -n "$json" ]] || json="${base}.info.json"

  if [[ -s "$error_file" && ! -s "$json" ]]; then
    print "${YTQ_C_ERR}Preview load failed:${YTQ_C_RESET}"
    sed -n '1,24p' "$error_file"
    return 0
  fi

  # This row had no cached metadata a moment ago and now does — the list row
  # is still the plain-URL fallback (it was rendered before this fetch ran).
  # `ytq list` starts fzf with --listen, so we can nudge the RUNNING fzf
  # instance to reload its rows in the background via its HTTP control port,
  # picking up the freshly cached title/actors — without touching the
  # cursor, the multi-selection, or this preview panel itself.
  if (( ! had_meta )) && [[ -s "$json" && -n "${FZF_PORT:-}" ]] && command -v curl >/dev/null 2>&1; then
    curl -s -XPOST "localhost:${FZF_PORT}" -d "reload(${(q)YTQ_SELF} __list_rows)" >/dev/null 2>&1 &
    disown
  fi

  thumbnail="$(find_cached_thumbnail "$url" "$key" "$json" "$base" 2>/dev/null)" || thumbnail=""
  if [[ -n "$thumbnail" ]]; then
    render_preview_image "$thumbnail"
    print ""
  fi

  if [[ -s "$json" ]]; then
    print_preview_metadata "$json"
  else
    print "${YTQ_C_WARN}No metadata cached yet.${YTQ_C_RESET}"
    print "${YTQ_C_DIM}${YTQ_I_LINK} ${url}${YTQ_C_RESET}"
  fi
}

cmd_list() {
  require_batch_file
  require_command fzf

  if [[ ! -s "$YT_DLP_BATCH_FILE" ]]; then
    print "📭 Queue is empty"
    return
  fi

  load_archive

  local archive_note="archive: ${YT_DLP_ARCHIVE_FILE:-unset}"
  local rows_cmd="${(q)YTQ_SELF} __list_rows"
  local clean_cmd="${(q)YTQ_SELF} __clean_completed --quiet"
  local rm_cmd="${(q)YTQ_SELF} __rm_index"
  local play_cmd="${(q)YTQ_SELF} __preview_play"
  local record_cmd="${(q)YTQ_SELF} __preview_record"
  local launch_cmd="${(q)YTQ_SELF} __launch"
  local copy_cmd="${(q)YTQ_SELF} __copy_urls"
  local key url fzf_status
  local -a out

  # Any `ytq list <yt-dlp args>` have to be baked into the Enter binding — the
  # launcher runs as an fzf child, so it can't see this function's argv.
  local extra_args=""
  (( $# )) && extra_args=" ${(j: :)${(q)@}}"

  [[ -n "${YT_DLP_ARCHIVE_FILE:-}" && -r "$YT_DLP_ARCHIVE_FILE" ]] || archive_note="archive: unavailable"

  # fzf never wraps a header/footer, and the footer only spans the list pane
  # (the preview eats 40% of the width), so the key list has to be hand-broken
  # into short lines or it just gets truncated mid-binding.
  local k="$YTQ_C_ACCENT" d="$YTQ_C_DIM" r="$YTQ_C_RESET"
  local footer
  footer="${k}enter${r}${d} download in kitty (stays open)   ${r}${k}alt-enter${r}${d} ytui here${r}"$'\n'
  footer+="${k}ctrl-o${r}${d} play in mpv   ${r}${k}ctrl-r${r}${d} play + record   ${r}${k}ctrl-y${r}${d} copy url${r}"$'\n'
  footer+="${k}ctrl-d${r}${d} delete row   ${r}${k}ctrl-x${r}${d} clean completed   ${r}${k}alt-e${r}${d} archive line${r}"$'\n'
  footer+="${d}j/k move   tab select   esc quit   ${YTQ_C_OK}${YTQ_I_CHECK}${r}${d} done   ${YTQ_C_WARN}${YTQ_I_DOWN}${r}${d} downloading${r}"

  out=( "${(f)$(
    cmd_list_rows |
      fzf \
        --ansi \
        --multi \
        --no-sort \
        --tiebreak=index \
        --delimiter=$'\t' \
        --with-nth=3 \
        --accept-nth=1 \
        --expect=alt-enter,alt-e \
        --marker='»' \
        --pointer='❯' \
        --listen \
        --no-input \
        --info=hidden \
        --footer="$footer" \
        --footer-border=line \
        --footer-label=" keys " \
        --header="${YTQ_C_DIM}${archive_note}${YTQ_C_RESET}" \
        --bind="j:down,k:up" \
        --bind="enter:execute-silent($launch_cmd \$FZF_PORT$extra_args -- {+1})+reload($rows_cmd)" \
        --bind="ctrl-d:execute-silent($rm_cmd {2})+reload($rows_cmd)" \
        --bind="ctrl-x:execute-silent($clean_cmd)+reload($rows_cmd)" \
        --bind="ctrl-o:execute-silent($play_cmd {1})" \
        --bind="ctrl-r:execute-silent($record_cmd {1})" \
        --bind="ctrl-y:execute-silent($copy_cmd {+1})+bell" \
        --preview="${(q)YTQ_SELF} __preview {1}" \
        --preview-window='right,40%,wrap,border-left'
  )}" )
  fzf_status=$?

  case "$fzf_status" in
    0) ;;
    1) return 0 ;;
    130) return 130 ;;
    *) return "$fzf_status" ;;
  esac

  key="${out[1]:-}"
  local -a urls
  urls=( "${(@)out[2,-1]}" )
  (( ${#urls} )) || return 0

  case "$key" in
    alt-e)
      cmd_edit_archive_line "${urls[1]}"
      ;;
    alt-enter)
      require_command ytui
      local u
      for u in "${urls[@]}"; do
        ytui "$@" "$u"
      done
      ;;
    *)
      local u
      for u in "${urls[@]}"; do
        cmd_kitty_ytui "$u" "$@"
      done
      ;;
  esac
}

cmd_run() {
  require_batch_file

  if [[ ! -s "$YT_DLP_BATCH_FILE" ]]; then
    print "📭 Queue is empty"
    return
  fi

  yt-dlp "$@" --batch-file "$YT_DLP_BATCH_FILE"
}

queue_url_at_index() {
  require_batch_file

  local index="$1"

  [[ -n "$index" ]] || {
    print -u2 "Usage: ytq get <number> [yt-dlp args ...]"
    return 1
  }

  [[ "$index" == <-> && "$index" -gt 0 ]] || {
    print -u2 "❌ Invalid queue number: $index"
    return 1
  }

  local url
  url="$(sed -n "${index}p" "$YT_DLP_BATCH_FILE")"

  [[ -n "$url" ]] || {
    print -u2 "❌ No queue item at position $index"
    return 1
  }

  if ! is_url "$url"; then
    print -u2 "❌ Queue item $index is not a URL: $url"
    return 1
  fi

  print -r -- "$url"
}

cmd_get() {
  local index="$1"
  local url

  [[ -n "$index" ]] || {
    print -u2 "Usage: ytq get <number> [yt-dlp args ...]"
    exit 1
  }

  shift
  url="$(queue_url_at_index "$index")" || exit 1

  yt-dlp "$@" "$url"
}

cmd_pop() {
  require_batch_file
  require_command yt-dlp

  if [[ ! -s "$YT_DLP_BATCH_FILE" ]]; then
    print "📭 Queue is empty"
    return 0
  fi

  local item index url tab download_status
  tab=$'\t'

  item="$(next_unarchived_queue_item)" || {
    print "📭 No unarchived queue items"
    return 0
  }

  index="${item%%${tab}*}"
  url="${item#*${tab}}"

  if ! is_url "$url"; then
    print -u2 "❌ Queue item $index is not a URL: $url"
    return 1
  fi

  cmd_rm_index "$index" || return 1

  print "⬇️  Popped #$index: $url"
  yt-dlp "$@" "$url"
  download_status=$?

  if (( download_status != 0 )); then
    if queue_push_top "$url"; then
      print -u2 "↩️  Download failed; re-added at top of queue"
    else
      print -u2 "❌ Download failed and could not re-add queue item: $url"
    fi
    return "$download_status"
  fi

  print "✅ Downloaded and removed: $url"
}

kitty_launch_bin() {
  if command -v kitty-launch >/dev/null 2>&1; then
    command -v kitty-launch
  elif [[ -x "$HOME/.zsh/bin/kitty-launch" ]]; then
    print -r -- "$HOME/.zsh/bin/kitty-launch"
  else
    return 1
  fi
}

ytui_bin() {
  if command -v ytui >/dev/null 2>&1; then
    command -v ytui
  elif [[ -x "$HOME/.zsh/bin/ytui" ]]; then
    print -r -- "$HOME/.zsh/bin/ytui"
  else
    return 1
  fi
}

# `ytq list` Enter: run ytui for one URL inside a new kitty pane. ytui does
# its own thumbnail fetch, progress UI and mpv streaming ('o'), so this
# replaces the old get+mpv-send flow entirely — no separate get/play step.
cmd_kitty_ytui() {
  local url="$1"
  local ytui kitty_launch

  [[ -n "$url" ]] || {
    print -u2 "Usage: ytq __kitty_ytui <url> [yt-dlp args ...]"
    return 1
  }

  shift
  ytui="$(ytui_bin)" || {
    print -u2 "❌ Missing dependency: ytui"
    return 1
  }
  kitty_launch="$(kitty_launch_bin)" || {
    print -u2 "❌ Missing dependency: kitty-launch"
    return 1
  }

  "$kitty_launch" \
    --window \
    --cwd "$PWD" \
    --title " ytui " \
    -- "$ytui" "$@" "$url"
}

# `ytq list` Enter: launch ytui for every selected URL in its own Kitty window
# WITHOUT closing the picker, so you can keep queueing more. Called as
#   ytq __launch <fzf-port> [ytui args ...] -- <url> [url ...]
# The port is passed explicitly rather than inherited: `kitten @ launch` starts
# the new window from the kitty daemon's environment, so FZF_PORT would not
# survive the trip into the ytui wrapper.
cmd_launch_ytui() {
  local port="$1"
  local -a extra urls
  local arg url ytui kitty_launch

  shift

  # fzf's execute-silent throws away stdout AND stderr, so anything that fails
  # in here (missing ytui, kitty IPC unreachable, a bad URL) is completely
  # invisible — Enter simply appears to do nothing. Everything this subcommand
  # says goes to a log instead of the void: `ytq launchlog` reads it back.
  local log
  log="$(ytq_launch_log)"
  mkdir -p "${log:h}" 2>/dev/null
  exec 2>>"$log"
  print -u2 -r -- "[$(date '+%Y-%m-%d %H:%M:%S')] __launch port=$port argv=${(q)@}"

  for arg in "$@"; do
    shift
    [[ "$arg" == "--" ]] && break
    extra+=( "$arg" )
  done
  urls=( "$@" )

  (( ${#urls} )) || {
    print -u2 "Usage: ytq __launch <port> [ytui args ...] -- <url> [url ...]"
    return 1
  }

  ytui="$(ytui_bin)" || {
    print -u2 "❌ Missing dependency: ytui"
    return 1
  }
  kitty_launch="$(kitty_launch_bin)" || {
    print -u2 "❌ Missing dependency: kitty-launch"
    return 1
  }

  # `kitten @ launch` starts the new window from the kitty daemon's environment,
  # which is the GUI/launchd one — it has PATH but NOT the YT_DLP_* exports from
  # zshrc. Without these, ytui silently falls back to a private cache: metadata
  # never lands in the shared JSON dir, so rows downloaded from here never gain
  # a title in `ytq list`. Re-inject them explicitly via env(1); kitty-launch
  # has no --env passthrough of its own.
  local -a env_prefix
  local var
  for var in YT_DLP_BATCH_FILE YT_DLP_ARCHIVE_FILE YT_DLP_JSON_DIR YT_DLP_THUMBCACHE_DIR; do
    [[ -n "${(P)var}" ]] && env_prefix+=( "$var=${(P)var}" )
  done
  (( ${#env_prefix} )) && env_prefix=( /usr/bin/env "${env_prefix[@]}" )

  for url in "${urls[@]}"; do
    # Marked here, not in the wrapper: the reload bound after this action fires
    # immediately, well before the new Kitty window has started anything.
    mark_running "$url"

    "$kitty_launch" \
      --window \
      --cwd "$PWD" \
      --title " ytui " \
      -- "${env_prefix[@]}" "$YTQ_SELF" __run_ytui "$port" "$url" "${extra[@]}" >/dev/null

    if (( $? != 0 )); then
      print -u2 -r -- "  ✗ kitty-launch failed for $url"
      clear_running "$url"
    else
      print -u2 -r -- "  ✓ launched $url"
    fi
  done
}

# Read back what `ytq list` Enter actually did — the only view into a binding
# fzf runs with its output discarded.
cmd_launch_log() {
  local log
  log="$(ytq_launch_log)"

  if [[ ! -s "$log" ]]; then
    print "📭 No launches logged yet: $log"
    return 0
  fi

  print "${YTQ_C_DIM}${log}${YTQ_C_RESET}"
  tail -n "${1:-40}" "$log"
}

# The ytui wrapper that runs inside the launched Kitty window: claims the
# marker with its own pid, runs ytui, then clears the marker and pokes the
# still-open `ytq list` so the finished row re-renders (archived ✓, and the
# title/actors now that the metadata json exists).
cmd_run_ytui() {
  local port="$1"
  local url="$2"
  local ytui run_status

  [[ -n "$url" ]] || {
    print -u2 "Usage: ytq __run_ytui <port> <url> [ytui args ...]"
    return 1
  }

  shift 2
  ytui="$(ytui_bin)" || {
    print -u2 "❌ Missing dependency: ytui"
    clear_running "$url"
    fzf_reload_rows "$port"
    return 1
  }

  mark_running "$url" "$$"

  {
    "$ytui" "$@" "$url"
    run_status=$?
  } always {
    clear_running "$url"
    fzf_reload_rows "$port"
  }

  # `kitten @ launch` closes the window the moment its command exits, so a ytui
  # that dies in its preflight just flashes and disappears — indistinguishable
  # from "Enter did nothing". Hold the window open on failure so the error is
  # actually readable.
  if (( run_status != 0 )) && [[ -t 0 ]]; then
    print ""
    print -r -- "${YTQ_C_ERR}ytui exited with status ${run_status}${YTQ_C_RESET}"
    print -r -- "${YTQ_C_DIM}${url}${YTQ_C_RESET}"
    print -r -- "${YTQ_C_DIM}press any key to close${YTQ_C_RESET}"
    read -k 1 -s
  fi

  return $run_status
}

# `ytq list` Ctrl-Y: copy the selected URL(s) to the clipboard, one per line so
# a multi-selection pastes straight back into `ytq add`.
cmd_copy_urls() {
  (( $# )) || return 0
  require_command pbcopy

  print -rl -- "$@" | pbcopy
}

# `ytq list` Alt-E: jump straight to the matching download-archive line, so
# you can inspect or hand-edit the record instead of hunting for it.
cmd_edit_archive_line() {
  local url="$1"
  local line

  [[ -n "$url" ]] || {
    print -u2 "Usage: ytq __archive_line <url>"
    return 1
  }

  if [[ -z "${YT_DLP_ARCHIVE_FILE:-}" ]]; then
    print -u2 "❌ YT_DLP_ARCHIVE_FILE is not set"
    return 1
  fi
  if [[ ! -r "$YT_DLP_ARCHIVE_FILE" ]]; then
    print -u2 "❌ Archive file is not readable: $YT_DLP_ARCHIVE_FILE"
    return 1
  fi

  line="$(archive_line_for_url "$url" 2>/dev/null)"
  if [[ -n "$line" ]]; then
    "${EDITOR:-nvim}" "+$line" "$YT_DLP_ARCHIVE_FILE"
  else
    print -u2 "⚠️  Not found in archive, opening at top: $url"
    "${EDITOR:-nvim}" "$YT_DLP_ARCHIVE_FILE"
  fi
}

archive_line_for_url() {
  local url="$1"
  local key

  key="$(archive_key_for_url "$url" 2>/dev/null)" || return 1
  [[ -n "$key" && -r "${YT_DLP_ARCHIVE_FILE:-}" ]] || return 1

  grep -Fnx -- "$key" "$YT_DLP_ARCHIVE_FILE" | head -n1 | cut -d: -f1
}

# `ytq list` Ctrl-O: play the URL straight in mpv (its built-in yt-dlp hook
# resolves the stream), no download and no queue mutation — a quick look
# without waiting on a full fetch.
cmd_preview_play() {
  local url="$1"

  [[ -n "$url" ]] || return 0
  require_command mpv

  mpv --force-window=immediate -- "$url" >/dev/null 2>&1 &
  disown
}

# A short filesystem-safe tag for the recording filename — last path segment of
# the URL, not a full title (that would need a yt-dlp preflight, which is the
# exact latency ctrl-r is meant to skip).
record_slug_for_url() {
  local url="$1" slug
  slug="${url%%\#*}"; slug="${slug%%\?*}"; slug="${slug##*/}"
  slug="${slug//[^A-Za-z0-9_-]/-}"
  slug="${slug:0:60}"
  [[ -n "$slug" ]] && print -r -- "$slug" || print -r -- "video"
}

# `ytq list` Ctrl-R: same instant mpv preview as ctrl-o, but also dumps the raw
# stream mpv's ytdl hook resolved to disk via --stream-record — no separate
# yt-dlp download, no archive entry, no proper title/metadata. This is a raw
# byte capture (mpv doesn't remux it), so for HLS sources especially, run it
# through `ffmpeg -i in -c copy out.mp4` afterward if it doesn't play cleanly.
# For a real download (correct filename, metadata, archive tracking, resumable),
# use enter/alt-enter for ytui instead.
cmd_preview_record() {
  local url="$1"

  [[ -n "$url" ]] || return 0
  require_command mpv

  local dir="${YT_DLP_MPV_RECORD_DIR:-$HOME/Movies/mpv-recordings}"
  mkdir -p -- "$dir" 2>/dev/null

  local dest="$dir/$(date +%Y%m%d-%H%M%S)-$(record_slug_for_url "$url").mp4"

  mpv --force-window=immediate --stream-record="$dest" -- "$url" >/dev/null 2>&1 &
  disown
}

cmd_runclear() {
  require_batch_file

  yt-dlp "$@" --batch-file "$YT_DLP_BATCH_FILE" || exit $?

  : > "$YT_DLP_BATCH_FILE"

  print "🗑️  Queue cleared"
}

cmd_clear() {
  require_batch_file

  : > "$YT_DLP_BATCH_FILE"

  print "🗑️  Queue cleared"
}

cmd_rm() {
  require_batch_file

  local url="$1"

  [[ -n "$url" ]] || {
    print -u2 "Usage: ytq rm <url>"
    exit 1
  }

  local tmp_file
  tmp_file="$(mktemp)" || exit 1

  grep -Fvx -- "$url" "$YT_DLP_BATCH_FILE" > "$tmp_file"
  mv "$tmp_file" "$YT_DLP_BATCH_FILE"

  print "➖ Removed: $url"
}

cmd_dedupe() {
  require_batch_file

  local tmp_file
  tmp_file="$(mktemp)" || exit 1

  awk 'NF && !seen[$0]++' "$YT_DLP_BATCH_FILE" > "$tmp_file"
  mv "$tmp_file" "$YT_DLP_BATCH_FILE"

  print "🧹 Queue deduped"
}

cmd_edit() {
  require_batch_file
  "${EDITOR:-nvim}" "$YT_DLP_BATCH_FILE"
}

cmd_path() {
  require_batch_file
  print "$YT_DLP_BATCH_FILE"
}

usage() {
  cat <<EOF
ytq - small yt-dlp queue manager

Queue file:   ${YT_DLP_BATCH_FILE:-<YT_DLP_BATCH_FILE is not set>}
Archive file: ${YT_DLP_ARCHIVE_FILE:-<YT_DLP_ARCHIVE_FILE is not set>}
JSON cache:   ${YT_DLP_JSON_DIR:-<YT_DLP_JSON_DIR is not set>}
Thumb cache:  ${YT_DLP_THUMBCACHE_DIR:-<YT_DLP_THUMBCACHE_DIR is not set; using ytq preview cache>}

Usage:
  ytq <command> [arguments]

Queue editing:
  ytq add <url> [url ...]       Add URL(s) to the bottom of the queue.
  ytq next <url> [url ...]      Move URL(s) to the top of the queue.
  ytq paste                     Add URL(s) from the clipboard.
  ytq rm <url>                  Remove one exact URL from the queue.
  ytq dedupe                    Remove duplicate and blank queue entries.
  ytq clean                     Remove archived/completed URLs from the queue.
  ytq clear                     Empty the whole queue.
  ytq edit                      Open the queue file in \$EDITOR.

Viewing and picking:
  ytq print                     Print the numbered queue.
  ytq list [yt-dlp args ...]    Browse and act on the queue in fzf.
                                In fzf: Enter runs ytui for every selected item
                                in its own Kitty window and LEAVES the picker
                                open — running rows show a ⭳ downloading mark
                                and refresh themselves when they finish;
                                Alt-Enter runs ytui here instead (closes the
                                picker); Alt-E opens the download archive at
                                that item's line in \$EDITOR; Ctrl-O plays the
                                URL in mpv without downloading; Ctrl-R plays
                                and records it; Ctrl-Y copies the selected
                                URL(s) to the clipboard; Ctrl-D deletes a row;
                                Ctrl-X removes archived rows; Esc quits.
  ytq path                      Print the queue file path.
  ytq launchlog [n]             Show the last n (default 40) lines of what
                                \`ytq list\` Enter did — fzf discards that
                                binding's output, so this is the only view.

Downloading:
  ytq run [yt-dlp args ...]     Run yt-dlp with --batch-file.
  ytq get <n> [yt-dlp args ...] Download only queue item n, without --batch-file.
  ytq pop [yt-dlp args ...]     Download the next unarchived queue item, removing
                                it unless the transfer fails.
  ytq runclear [args ...]       Run the queue with yt-dlp, then clear it.

Compatibility aliases:
  ytq addclip                   Same as paste.
  ytq queue, ytq ls             Same as print.
  ytq prune                     Same as clean.
EOF
}

case "$1" in
  ""|-h|--help|help)
    usage
    ;;
  add)
    shift
    cmd_add "$@"
    ;;
  next)
    shift
    cmd_next "$@"
    ;;
  paste|addclip)
    shift
    cmd_addclip "$@"
    ;;
  print|queue|ls)
    cmd_queue
    ;;
  list)
    shift
    cmd_list "$@"
    ;;
  run)
    shift
    cmd_run "$@"
    ;;
  get)
    shift
    cmd_get "$@"
    ;;
  pop)
    shift
    cmd_pop "$@"
    ;;
  runclear)
    shift
    cmd_runclear "$@"
    ;;
  clear)
    cmd_clear
    ;;
  clean|prune)
    shift
    cmd_clean_completed "$@"
    ;;
  rm)
    shift
    cmd_rm "$@"
    ;;
  dedupe)
    cmd_dedupe
    ;;
  edit)
    cmd_edit
    ;;
  path)
    cmd_path
    ;;
  __preview)
    shift
    cmd_preview "$@"
    ;;
  __list_rows)
    shift
    cmd_list_rows "$@"
    ;;
  __clean_completed)
    shift
    cmd_clean_completed "$@"
    ;;
  __rm_index)
    shift
    cmd_rm_index "$@"
    ;;
  __preview_play)
    shift
    cmd_preview_play "$@"
    ;;
  __preview_record)
    shift
    cmd_preview_record "$@"
    ;;
  __archive_line)
    shift
    cmd_edit_archive_line "$@"
    ;;
  __copy_urls)
    shift
    cmd_copy_urls "$@"
    ;;
  launchlog)
    shift
    cmd_launch_log "$@"
    ;;
  __kitty_ytui)
    shift
    cmd_kitty_ytui "$@"
    ;;
  __launch)
    shift
    cmd_launch_ytui "$@"
    ;;
  __run_ytui)
    shift
    cmd_run_ytui "$@"
    ;;
  *)
    usage
    exit 1
    ;;
esac
