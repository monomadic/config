#!/usr/bin/env zsh
# ============================================================================
# ytui — an interactive TUI wrapper around yt-dlp
# ============================================================================
#
# Download a URL with yt-dlp behind a live TUI: a progress bar, the video's
# thumbnail fetched in parallel, and single-key controls while it runs. Any
# arguments before the URL are passed straight through to yt-dlp, so the
# yt-dlp config aliases work as usual:
#
#   ytui --porn   https://…      # --porn is a yt-dlp --alias (see ~/.config/yt-dlp/config)
#   ytui --visuals https://…
#   ytui -f best  https://…
#
# The URL is always the LAST argument (same convention as dl-porn).
#
# Gallery / index pages (a model page, a channel, a playlist) are detected in the
# preflight and switch the UI into gallery mode: an overall bar across the items
# plus the current item's own bar, filename and thumbnail. Rating and filename
# editing are per-file, so they're disabled there — everything else still works.
#
# Keys while downloading:
#   o   open in mpv — stream the growing .part file (keep downloading)
#   p   pause / resume the download (SIGSTOP/SIGCONT on yt-dlp)
#   r   rename — edit the whole proposed filename in $EDITOR (used as-is)
#   R   rating 0–5 stars (same star-in-filename convention as media-set-rating)
#   q   quit (Ctrl-C also works)
#
# The rating and the edited title/actors/tags feed a proposed filename built
# with the SAME grammar that media-parse-filename-to-json reads back:
#
#   Actor A, Actor B - [Channel] Title #tag1 #tag2 (Origin) ★★★☆☆.ext
#
# If you touch either (R or r), the finished file is renamed to that proposed
# name in place. If you touch neither, yt-dlp's own filename is left untouched.
#
# How it works: yt-dlp runs in the background writing a machine-readable
# progress line (via --progress-template) into a fifo; the main loop waits on
# that fifo AND the terminal at once with zsh/zselect, so keystrokes stay
# responsive without busy-waiting. A short preflight (--simulate --print)
# resolves the output path and seeds the title/actors up front, so the
# thumbnail job and mpv streaming both know where the file will land.
#
# Dependencies: yt-dlp, mpv (for `o`); the star grammar mirrors media-set-rating.
# See also: dl-porn, yt-dlp-stream, media-parse-filename-to-json
# ============================================================================
emulate -L zsh
setopt pipefail extended_glob
zmodload zsh/zselect

SELF="${0:t}"

# ── colors ──────────────────────────────────────────────────────────────────
# C_BORDER/C_DESC use an explicit 256-color gray, NOT \e[90m ("bright black") —
# themes are free to map color8 to whatever they want, including literal black
# (e.g. the "1984" theme here maps both color0 AND color8 to #000000), which
# makes \e[90m text invisible on a black background. \e[38;5;244m is a fixed
# mid-gray independent of the terminal's ANSI palette.
typeset -gr \
  C_STAR=$'\e[33m'   C_EMPTY=$'\e[2m'   C_BORDER=$'\e[38;5;244m' \
  C_KEY=$'\e[97m'    C_DESC=$'\e[38;5;244m'   C_FILE=$'\e[1;36m' \
  C_OK=$'\e[32m'     C_ERR=$'\e[31m'    C_WARN=$'\e[33m'   \
  C_DIM=$'\e[2m'     C_BOLD=$'\e[1m'    C_ACCENT=$'\e[38;5;39m' \
  C_BAR=$'\e[38;5;46m' \
  C_RESET=$'\e[0m'

die()  { print -ru2 -- "${SELF}: $*"; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

usage() {
  cat <<EOF
Usage: $SELF [yt-dlp args...] <url>

Download <url> with yt-dlp behind an interactive TUI. Everything before the URL
is forwarded to yt-dlp, so config aliases work: e.g. \`$SELF --porn <url>\`.

Keys:  o open in mpv · p pause/resume · r rename (\$EDITOR) · R rating · q quit
EOF
}

# ── filename star grammar (matches media-set-rating / media-parse-…) ─────────
stars_plain() {   # form stored in the filename: exactly five ★/☆, no spaces
  local n=$1 i out=""
  for (( i = 1; i <= 5; i++ )); do (( i <= n )) && out+="★" || out+="☆"; done
  print -rn -- "$out"
}
stars_colored() { # spaced + colored form for the UI
  local n=$1 i out=""
  for (( i = 1; i <= 5; i++ )); do
    (( i <= n )) && out+="${C_STAR}★${C_RESET}" || out+="${C_EMPTY}☆${C_RESET}"
    (( i < 5 )) && out+=" "
  done
  print -rn -- "$out"
}

trim() { local s="$1"; s="${s#"${s%%[![:space:]]*}"}"; s="${s%"${s##*[![:space:]]}"}"; print -rn -- "$s"; }

# Strip a common form of ANSI SGR sequences (yt-dlp colors its log lines).
strip_ansi() { local s="$1"; s="${s//$'\e'\[[0-9;]#[a-zA-Z]/}"; print -rn -- "$s"; }

# Filesystem-safe: no slashes or control chars in a filename component.
sanitize() { local s="$1"; s="${s//\//-}"; s="${s//$'\n'/ }"; s="${s//$'\t'/ }"; print -rn -- "$(trim "$s")"; }

# Bytes → yt-dlp-style human units (MiB/GiB), so an estimate reads like the rest.
human_bytes() {
  local -i b=${1:-0}
  if   (( b >= 1073741824 )); then printf '%.2fGiB' "$(( b / 1073741824.0 ))"
  elif (( b >= 1048576 ));    then printf '%.1fMiB' "$(( b / 1048576.0 ))"
  elif (( b >= 1024 ));       then printf '%.1fKiB' "$(( b / 1024.0 ))"
  else                             printf '%dB' "$b"
  fi
}

# ── argument parsing (URL is the last arg, rest passes through to yt-dlp) ─────
case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac
(( $# )) || { usage >&2; exit 2; }

typeset -a argv passthru
argv=( "$@" )
url="${argv[-1]}"
passthru=( "${(@)argv[1,-2]}" )   # (@) keeps them separate words, not one joined arg
[[ -n "$url" && "$url" != -* ]] || die "last argument must be a URL (got: ${url:-<none>})"

have yt-dlp || die "yt-dlp not found"

# ── proposed-metadata + download state (globals; edited by the modals) ───────
typeset -g title="" channel="" origin="" ext=""
typeset -g override_stem=""               # set by `t` ($EDITOR): used verbatim as the filename
typeset -ga actors=() tags=()
typeset -g rating=0 touched=0            # touched: user changed rating or metadata
typeset -g final_path="" final_real="" proposed_dir="" dl_dest=""
typeset -g video_id="" extractor_key="" archive_key=""
typeset -gi in_archive=0
typeset -gA archive_set                   # loaded once: archive_set[<extractor> <id>]=1
typeset -g pct=0 dl_str="—" tot_str="—" spd_str="—" eta_str="—" dstatus="starting"
typeset -g phase_msg="" msg=""
typeset -g ytdlp_pid="" mpv_pid="" thumb_pid=""
# thumbnail: shared with ytq via YT_DLP_THUMBCACHE_DIR, named <extractor>_<id>.<ext>
typeset -g thumb_stem="" thumb_file=""
typeset -g thumb_cache="${~YT_DLP_THUMBCACHE_DIR:-$HOME/.cache/ytq}"
typeset -gi thumb_drawn=0 thumb_active=0 thumb_rows=10 thumb_cols=32
# metadata: shared with ytq via YT_DLP_JSON_DIR, same <extractor>_<id>.info.json naming as
# thumb_stem. Unset entirely (json_dir="") when YT_DLP_JSON_DIR isn't set — same opt-in as ytq.
typeset -g json_dir="" json_file=""
typeset -gi paused=0
typeset -g fifo="" pfd="" tfd="" saved_stty="" alt_active=0
typeset -ga logring=()                    # recent yt-dlp lines, for error reporting

# gallery (playlist/index) mode: one URL, many items
typeset -gi gallery=0 gal_total=0 gal_index=0 gal_done=0
typeset -g gal_name="" gal_archive_key=""
typeset -gi gal_in_archive=0

# terminal geometry; need_full_redraw is set by SIGWINCH and on entering the TUI
typeset -gi TERM_ROWS=24 TERM_COLS=80 need_full_redraw=1

# ── preflight: resolve the output path and seed title/actors ─────────────────
# One --simulate extraction. --print honors the yt-dlp config (aliases, paths,
# --output-na-placeholder ""), so the filename here matches what the real run
# will write, and empty fields come back as empty strings.
#
# --no-download-archive matters: the global config sets --download-archive, and
# an already-archived id is skipped BEFORE extraction — yt-dlp then exits 0 and
# prints nothing, which reads here as "could not resolve". ytui is an explicit,
# single-URL tool, so it overrides the archive on all its yt-dlp calls (preflight,
# thumbnail, real download) — you asked for this URL, you get it.
#
# -I 1:1 keeps this to ONE extraction even when the URL is a gallery/index page
# (a model page, a channel, a playlist). The extra %(playlist…)s prints are how we
# find out we're in one: --no-playlist already collapses a video-inside-a-playlist
# URL to the single video, so a non-empty playlist title / count > 1 here means the
# URL itself IS the playlist, and we switch to gallery mode.
preflight() {
  local errf; errf="$(mktemp -t ytui-preflight)"
  local -a lines
  lines=( "${(@f)$(yt-dlp --no-warnings --no-playlist --simulate --no-download-archive \
    -I 1:1 \
    --print "filename" \
    --print "%(title)s" \
    --print "%(channel,uploader)s" \
    --print "%(cast)l" \
    --print "%(extractor)s_%(id)s" \
    --print "%(playlist_count)s" \
    --print "%(playlist,playlist_id)s" \
    --print "%(extractor_key)s" \
    --print "%(id)s" \
    "${passthru[@]}" "$url" 2>"$errf")}" )
  local rc=$?
  if (( rc != 0 )) || [[ -z "${lines[1]:-}" ]]; then
    print -ru2 -- "${SELF}: could not resolve the video (yt-dlp exited $rc):"
    sed 's/^/  /' "$errf" >&2
    rm -f "$errf"; exit 1
  fi
  rm -f "$errf"

  final_path="${lines[1]}"
  proposed_dir="${final_path:h}"
  ext="${final_path:e}"
  title="$(trim "${lines[2]:-}")"
  channel="$(trim "${lines[3]:-}")"

  local cast="${lines[4]:-}"
  actors=()
  if [[ -n "$cast" ]]; then
    local a
    for a in "${(@s:,:)cast}"; do a="$(trim "$a")"; [[ -n "$a" ]] && actors+=("$a"); done
  fi

  # <extractor>_<id> is exactly ytq's thumb-cache stem, so a thumbnail either of
  # us has already fetched is reused instead of re-downloaded.
  thumb_stem="$(sanitize "${lines[5]:-}")"

  # A missing field prints as the literal "NA" unless the config/alias in play
  # sets --output-na-placeholder "" — so both spellings of "absent" count here,
  # otherwise every plain video would look like a playlist.
  local count="${${lines[6]:-}//[^0-9]/}" plname="$(trim "${lines[7]:-}")"
  [[ "$plname" == (NA|none) ]] && plname=""
  if [[ -n "$plname" ]] || (( ${count:-0} > 1 )); then
    gallery=1
    gal_total=${count:-0}                 # 0 == count unknown (lazy playlist)
    gal_name="${final_path:t}"
  fi

  # The archive key yt-dlp actually writes/checks is "<extractor_key, lowercased> <id>"
  # — NOT the extractor_id form used for thumb_stem. Build and show it so it's obvious
  # which line in the archive this URL corresponds to, and whether it's already there.
  extractor_key="$(trim "${lines[8]:-}")"
  video_id="$(trim "${lines[9]:-}")"
  [[ -n "$extractor_key" && -n "$video_id" ]] && archive_key="${(L)extractor_key} ${video_id}"

  in_archive=0
  [[ -n "$archive_key" && -n "${archive_set[$archive_key]:-}" ]] && in_archive=1
}

# Read the whole download-archive file into a hash once, so both the single-file
# check above and the per-item gallery check below are O(1) lookups instead of a
# grep per item (a gallery can be hundreds of entries).
load_archive_set() {
  local apath; apath="$(archive_file_path)"
  [[ -n "$apath" && -f "$apath" ]] || return
  local l
  while IFS= read -r l; do
    [[ -n "$l" ]] && archive_set[$l]=1
  done < "$apath"
}

# Same archive file ytq reads/writes: $YT_DLP_ARCHIVE_FILE, synced across machines,
# falling back to the path baked into the yt-dlp config's own --download-archive.
archive_file_path() {
  print -r -- "${YT_DLP_ARCHIVE_FILE:-$HOME/Library/Mobile Documents/com~apple~CloudDocs/Sync/archive.txt}"
}

# A thumbnail already in the shared cache, any common extension — or "" if none.
cached_thumb() {
  [[ -n "$thumb_stem" ]] || return
  local e
  for e in jpg jpeg png webp; do
    [[ -e "$thumb_cache/$thumb_stem.$e" ]] && { print -r -- "$thumb_cache/$thumb_stem.$e"; return; }
  done
}

# Letterbox a thumbnail onto a fixed 16:9 canvas so the image band always has
# the same shape, whatever the source aspect (portrait covers, square avatars…).
# Cached next to the original as <stem>.box.jpg; falls back to the raw file if
# ffmpeg is missing or fails. The ".box" suffix keeps it invisible to
# cached_thumb, so the raw cache stays shareable with ytq.
boxed_thumb() {
  local src="$1"
  [[ -n "$src" && -e "$src" ]] || return
  have ffmpeg || { print -r -- "$src"; return; }
  local dst="$thumb_cache/${src:t:r}.box.jpg"
  if [[ ! -e "$dst" || "$src" -nt "$dst" ]]; then
    ffmpeg -y -loglevel error -i "$src" \
      -vf "scale=640:360:force_original_aspect_ratio=decrease,pad=640:360:(ow-iw)/2:(oh-ih)/2:black" \
      "$dst" >/dev/null 2>&1 || { rm -f -- "$dst"; print -r -- "$src"; return; }
  fi
  print -r -- "$dst"
}

# ── proposed filename (reverse of media-parse-filename-to-json) ──────────────
compose_stem() {
  # `r` lets you edit the whole filename in $EDITOR; that saved string wins as-is.
  [[ -n "$override_stem" ]] && { print -rn -- "$override_stem"; return; }
  local s="" ch="$channel"
  # A channel that just restates the first actor's name adds nothing — drop it.
  (( ${#actors} )) && [[ "${(L)ch}" == "${(L)actors[1]}" ]] && ch=""
  (( ${#actors} )) && s+="${(j:, :)actors} - "
  [[ -n "$ch" ]] && s+="[$ch] "
  s+="$title"
  local t; for t in "${tags[@]}"; do s+=" #$t"; done
  [[ -n "$origin" ]] && s+=" ($origin)"
  (( rating > 0 )) && s+=" $(stars_plain $rating)"
  print -rn -- "$(sanitize "$s")"
}

# ── terminal setup / teardown (single controlling-tty fd, alt screen) ────────
# Geometry is re-read from the tty rather than trusted from $LINES/$COLUMNS: this
# script never runs zle, so those are only accurate at startup.
measure_term() {
  local sz; sz="$(stty size <&$tfd 2>/dev/null)"
  TERM_ROWS=0; TERM_COLS=0
  [[ "$sz" == <->" "<-> ]] && { TERM_ROWS=${sz%% *}; TERM_COLS=${sz##* } }
  # a pty that reports 0x0 (some capture/CI harnesses) is not a usable answer
  (( TERM_ROWS < 8 ))  && TERM_ROWS=${LINES:-24}
  (( TERM_COLS < 24 )) && TERM_COLS=${COLUMNS:-80}
  (( TERM_ROWS < 8 ))  && TERM_ROWS=24
  (( TERM_COLS < 24 )) && TERM_COLS=80
}

# A resize invalidates everything on screen: the old frame's line wrapping is
# already scrambled and the kitty image is placed in cells that moved. Just flag
# it — render() does the full clear + image repaint on the next frame.
TRAPWINCH() { need_full_redraw=1 }

enter_tui() {
  exec {tfd}<>/dev/tty || die "no controlling terminal"
  saved_stty="$(stty -g <&$tfd 2>/dev/null)" || saved_stty=""
  stty -icanon -echo min 1 time 0 <&$tfd 2>/dev/null   # raw keys, but keep ISIG (Ctrl-C)
  printf '\e[?1049h\e[?25l' >&$tfd                      # alt screen, hide cursor
  alt_active=1
  measure_term
  need_full_redraw=1
}
leave_tui() {
  (( alt_active )) || return 0
  alt_active=0
  clear_thumb
  [[ -n "$saved_stty" ]] && stty "$saved_stty" <&$tfd 2>/dev/null
  printf '\e[?25h\e[?1049l' >&$tfd 2>/dev/null          # show cursor, leave alt screen
}

is_kitty() {
  [[ -n "${KITTY_WINDOW_ID:-}" || "${TERM_PROGRAM:-}" == "kitty" || "${TERM:-}" == xterm-kitty* ]]
}

# Paint the thumbnail once into the reserved top band via kitty's icat. The band
# is drawn once and never touched by render() (which starts below it), so the
# image survives the per-frame text redraw. Only on kitty; elsewhere skipped.
draw_thumb() {
  (( thumb_active )) || return
  (( thumb_drawn )) && return
  [[ -n "$thumb_file" && -e "$thumb_file" ]] || return
  local -a icat
  if   have kitty;  then icat=(kitty +kitten icat)
  elif have kitten; then icat=(kitten icat)
  else return; fi
  local img; img="$(boxed_thumb "$thumb_file")"; [[ -n "$img" ]] || img="$thumb_file"
  printf '\e[H' >&$tfd                                  # anchor at top-left
  "${icat[@]}" --clear --transfer-mode=file --stdin=no --align=left \
    --place="${thumb_cols}x${thumb_rows}@0x0" "$img" >&$tfd 2>/dev/null
  thumb_drawn=1
}

clear_thumb() {
  (( thumb_drawn )) || return
  printf '\e_Ga=d\e\\' >&$tfd 2>/dev/null               # delete every kitty image
  thumb_drawn=0
}

cleanup() {
  local ec=$?
  # Resume first (a stopped process can't be signalled to die), then stop it.
  [[ -n "$ytdlp_pid" ]] && kill -CONT "$ytdlp_pid" 2>/dev/null
  [[ -n "$ytdlp_pid" ]] && kill "$ytdlp_pid" 2>/dev/null
  [[ -n "$thumb_pid" ]] && kill "$thumb_pid" 2>/dev/null
  leave_tui
  [[ -n "$fifo" && -e "$fifo" ]] && rm -f "$fifo"
  return $ec
}
trap cleanup EXIT
trap 'exit 130' INT TERM

# ── rendering ────────────────────────────────────────────────────────────────
hrule() { local -i n=$1 i; local out=""; for (( i = 0; i < n; i++ )); do out+="─"; done; print -rn -- "$out"; }

draw_bar() {
  local w=$1 p=$2 i filled g="" e=""
  (( p > 100 )) && p=100; (( p < 0 )) && p=0
  (( filled = (w * p) / 100 ))
  for (( i = 0; i < w; i++ )); do (( i < filled )) && g+="█" || e+="░"; done
  print -rn -- "${C_BAR}${g}${C_DIM}${e}${C_RESET}"
}

# Truncate to a visible width (input is plain text, no SGR) so a narrow window
# never wraps a line and pushes the whole frame down.
clip() {
  local -i n=$2; local s="$1"
  (( ${#s} > n )) && s="${s[1,n-1]}…"
  print -rn -- "$s"
}

render() {
  # A just-finished thumbnail fetch shows up in the cache; pick it up and paint
  # it into the top band once. Text then starts *below* that reserved band so
  # the redraw never clears the image.
  if (( need_full_redraw )); then
    measure_term
    thumb_drawn=0                      # cells moved — the image must be replaced
    printf '\e[H\e[2J' >&$tfd
    need_full_redraw=0
  fi
  [[ -z "$thumb_file" ]] && thumb_file="$(cached_thumb)"

  # The image band only exists if there is room for it AND for the text block.
  local -i band=0
  (( thumb_active && TERM_ROWS >= thumb_rows + 14 && TERM_COLS >= thumb_cols + 8 )) && band=1
  if (( band )); then draw_thumb; else clear_thumb; fi

  local -i W                          # bar cells; the border is W+2 wide
  (( W = TERM_COLS - 8 )); (( W > 44 )) && W=44; (( W < 8 )) && W=8
  local rule; rule="$(hrule $(( W + 2 )))"
  local -i textw; (( textw = TERM_COLS - 4 )); (( textw < 8 )) && textw=8

  local -i top=1
  (( band )) && (( top = thumb_rows + 2 ))
  local buf=$'\e['${top}';1H'
  local nl=$'\e[K\n'                 # clear-to-EOL then newline (avoids full-clear flicker)

  local statecol="$C_ACCENT" statetxt="$dstatus"
  (( paused )) && { statecol="$C_WARN"; statetxt="paused"; }
  [[ "$dstatus" == finished ]] && statecol="$C_OK"

  local previewname
  if (( gallery )); then
    previewname="${gal_name:-…}"
  else
    previewname="$(compose_stem).${ext}"
  fi
  previewname="$(clip "$previewname" $(( textw - 8 )))"

  buf+="  ${C_BOLD}${SELF}${C_RESET} ${C_DIM}$(clip "$url" $(( textw - ${#SELF} - 1 )))${C_RESET}${nl}"

  if (( gallery )); then
    # Two bars: overall position through the gallery, then the current item.
    local total_txt="${gal_total:-0}"; (( gal_total > 0 )) || total_txt="?"
    local -i overall=0
    if (( gal_total > 0 )); then
      (( overall = ((gal_index > 0 ? gal_index - 1 : 0) * 100 + pct) / gal_total ))
      (( overall > 100 )) && overall=100
    fi
    buf+="  ${C_DIM}gallery${C_RESET}  ${C_BOLD}item ${gal_index}/${total_txt}${C_RESET}  ${C_DIM}${gal_done} done${C_RESET}${nl}"
    buf+="${nl}"
    if (( gal_total > 0 )); then
      buf+="    $(draw_bar $W $overall) ${C_DIM}${overall}%${C_RESET}${nl}"
    fi
  fi

  buf+="  ${C_BORDER}╭${rule}╮${C_RESET}${nl}"
  buf+="  ${C_BORDER}│${C_RESET} $(draw_bar $W $pct) ${C_BORDER}│${C_RESET}${nl}"
  buf+="  ${C_BORDER}╰${rule}╯${C_RESET}${nl}"
  buf+="   ${C_BOLD}${pct}%${C_RESET}  ${C_DIM}${dl_str} / ${tot_str}${C_RESET}  ${C_ACCENT}${spd_str}${C_RESET}  ${C_DIM}ETA ${eta_str}${C_RESET}  ${statecol}${statetxt}${C_RESET}${nl}"
  [[ -n "$phase_msg" ]] && buf+="   ${C_DIM}$(clip "$phase_msg" $(( textw - 1 )))${C_RESET}${nl}"
  buf+="${nl}"
  (( gallery )) || buf+="   ${C_DESC}rating${C_RESET}  $(stars_colored $rating)  ${C_DIM}${rating}/5${C_RESET}${nl}"
  local curr_akey curr_inarch
  if (( gallery )); then curr_akey="$gal_archive_key"; curr_inarch=$gal_in_archive
  else                   curr_akey="$archive_key";     curr_inarch=$in_archive
  fi
  if [[ -n "$curr_akey" ]]; then
    if (( curr_inarch )); then
      buf+="   ${C_DESC}id${C_RESET}      ${C_WARN}${curr_akey}  ⚠ already in archive${C_RESET}${nl}"
    else
      buf+="   ${C_DESC}id${C_RESET}      ${C_DIM}${curr_akey}${C_RESET}${nl}"
    fi
  fi
  buf+="   ${C_DESC}file${C_RESET}    ${C_FILE}${previewname}${C_RESET}${nl}"
  (( band )) || [[ -z "$thumb_file" ]] || buf+="   ${C_DESC}thumb${C_RESET}   ${C_OK}✓ cached${C_RESET}${nl}"
  [[ -n "$msg" ]] && buf+="${nl}   ${C_ACCENT}$(clip "$msg" $(( textw - 1 )))${C_RESET}${nl}"
  buf+="${nl}"
  if (( gallery )); then
    buf+="  ${C_KEY}o${C_DESC} mpv   ${C_KEY}p${C_DESC} pause   ${C_KEY}q${C_DESC} quit${C_RESET}${nl}"
  else
    buf+="  ${C_KEY}o${C_DESC} mpv   ${C_KEY}p${C_DESC} pause   ${C_KEY}r${C_DESC} rename   ${C_KEY}R${C_DESC} rating   ${C_KEY}q${C_DESC} quit${C_RESET}${nl}"
  fi
  buf+=$'\e[J'                        # clear anything below the block
  printf '%s' "$buf" >&$tfd
}

# Failure view: drawn INSIDE the alt screen so the yt-dlp error is readable in
# place, instead of flashing past on stderr after the TUI is torn down. Shows
# the tail of the captured log (logring) and waits for a keypress.
render_error() {
  clear_thumb                         # the failure panel owns the whole screen
  local nl=$'\e[K\n' l
  local buf=$'\e[H\e[J'
  buf+="  ${C_BOLD}${C_ERR}${SELF}: yt-dlp failed (exit ${1})${C_RESET}${nl}"
  buf+="${nl}"
  buf+="  ${C_DIM}${url}${C_RESET}${nl}"
  buf+="${nl}"
  if (( ${#logring} )); then
    for l in "${logring[@]:(-14)}"; do buf+="  ${l[1,112]}${nl}"; done
  else
    buf+="  ${C_DIM}(no output captured)${C_RESET}${nl}"
  fi
  buf+="${nl}"
  buf+="  ${C_KEY}q${C_DESC}/any key — close${C_RESET}${nl}"
  buf+=$'\e[J'
  printf '%s' "$buf" >&$tfd
  read -k 1 -u $tfd 2>/dev/null        # hold the panel until the user looks
}

# In gallery mode each item has its own thumbnail, and there is no per-item
# yt-dlp preflight to fetch it — the URL comes in on the ITEM line instead, so
# grab it straight with curl into the same shared cache ytq uses. Written to a
# temp name and moved into place, so a half-fetched file is never displayed.
fetch_thumb() {
  local turl="$1"
  [[ -n "$turl" && "$turl" == http* && -n "$thumb_stem" ]] || return
  [[ -n "$(cached_thumb)" ]] && return
  have curl || return
  local e="${${turl%%\?*}##*.}"
  [[ "$e" == (jpg|jpeg|png|webp) ]] || e=jpg
  local dest="$thumb_cache/$thumb_stem.$e"
  { local tmp="${dest}.part.$$"
    curl -sL --max-time 20 -o "$tmp" -- "$turl" 2>/dev/null && [[ -s "$tmp" ]] \
      && mv -f -- "$tmp" "$dest" || rm -f -- "$tmp"
  } >/dev/null 2>&1 &
  thumb_pid=$!
}

# ── progress / log line handling ─────────────────────────────────────────────
handle_line() {
  local line="$1"
  if [[ "$line" == PROGRESS\|* ]]; then
    local rest="${line#PROGRESS|}" pc db tb sp et st dbr
    IFS='|' read -r pc db tb sp et st dbr <<<"$rest"
    local nf="${pc//[^0-9.]/}"; pct="${nf%%.*}"; [[ -z "$pct" ]] && pct=0
    dl_str="$(trim "$db")"; tot_str="$(trim "$tb")"
    spd_str="$(trim "$sp")"; eta_str="$(trim "$et")"
    dstatus="$(trim "$st")"
    [[ "$dstatus" == finished ]] && pct=100
    # HLS/live streams report no total up front (tot_str "N/A"), but we do get
    # bytes-so-far and a percentage — so back out an estimate and mark it "~".
    if [[ "$tot_str" == (N/A|NA|Unknown|unknown|-|) && "$nf" == [0-9]* ]]; then
      local dbc="${dbr//[^0-9]/}"
      local -F frac; (( frac = nf / 100.0 ))
      if [[ -n "$dbc" ]] && (( dbc > 0 && frac > 0 )); then
        local -i tot_est; (( tot_est = dbc / frac ))
        (( tot_est > 0 )) && tot_str="~$(human_bytes tot_est)"
      fi
    fi
    return
  fi
  if [[ "$line" == FINALPATH\|* ]]; then
    final_real="${line#FINALPATH|}"
    (( gallery )) && (( gal_done++ ))
    return
  fi
  # gallery: one ITEM line per entry, printed before that entry's download starts.
  if [[ "$line" == ITEM\|* ]]; then
    local rest="${line#ITEM|}" idx stem turl fname akey
    IFS='|' read -r idx stem turl fname akey <<<"$rest"
    gal_index="${idx//[^0-9]/}"; (( gal_index > 0 )) || (( gal_index = gal_done + 1 ))
    [[ -n "$fname" ]] && gal_name="${fname:t}"
    pct=0; dl_str="—"; tot_str="—"; spd_str="—"; eta_str="—"; dstatus="starting"
    local newstem; newstem="$(sanitize "$stem")"
    if [[ -n "$newstem" && "$newstem" != "$thumb_stem" ]]; then
      thumb_stem="$newstem"; thumb_file=""; clear_thumb   # next frame paints the new one
      fetch_thumb "$turl"
    fi
    gal_archive_key="$(trim "$akey")"
    gal_in_archive=0
    [[ -n "$gal_archive_key" && -n "${archive_set[$gal_archive_key]:-}" ]] && gal_in_archive=1
    return
  fi
  # Any other yt-dlp chatter: keep a small ring for error reports, and show the
  # latest meaningful line as the phase message ([Merger], [Metadata], …).
  local clean; clean="$(strip_ansi "$line")"; clean="$(trim "$clean")"
  [[ -z "$clean" ]] && return
  # "[download] Destination: <path>" tells us where the growing .part actually
  # lives — which is the yt-dlp temp: path, not the final dir. `o` needs this to
  # find the file to stream while it downloads.
  [[ "$clean" == *"Destination: "* ]] && dl_dest="${clean##*Destination: }"
  logring+=("$clean"); (( ${#logring} > 40 )) && shift logring
  phase_msg="${clean[1,72]}"
}

# ── actions ──────────────────────────────────────────────────────────────────
toggle_pause() {
  [[ -n "$ytdlp_pid" ]] && kill -0 "$ytdlp_pid" 2>/dev/null || { msg="download already finished"; return; }
  if (( paused )); then kill -CONT "$ytdlp_pid" 2>/dev/null; paused=0; msg="resumed"
  else                  kill -STOP "$ytdlp_pid" 2>/dev/null; paused=1; msg="paused"; fi
}

# Where is the growing partial? With yt-dlp's --paths temp:… the .part lives in
# a temp tree, not the final dir, and for HLS it's "<file>.mp4.part" alongside
# per-fragment "*.part-FragNN.part" files. The one authoritative source is the
# running yt-dlp itself: whatever .part fd IT holds open is the real file, no
# matter how the paths are configured. lsof on our own child gives us exactly
# that; the Destination line and dir globs are only fallbacks if lsof is absent.
find_partfile() {
  local p
  # 1) the .part our yt-dlp child currently has open (exclude fragment parts)
  if [[ -n "$ytdlp_pid" ]] && kill -0 "$ytdlp_pid" 2>/dev/null && have lsof; then
    p=$(lsof -p "$ytdlp_pid" -Fn 2>/dev/null | sed -n 's/^n//p' \
          | grep -E '\.part$' | grep -v -- '.part-Frag' | head -1)
    [[ -n "$p" && -e "$p" ]] && { print -r -- "$p"; return; }
  fi
  # 2) names we can name directly (already-merged or non-temp downloads)
  local cand
  for cand in "${dl_dest}.part" "$dl_dest" "${final_path}.part" "$final_path" "$final_real"; do
    [[ -n "$cand" && -e "$cand" ]] && { print -r -- "$cand"; return; }
  done
  # 3) largest .part in the captured dest dir, else the final dir (largest, so
  #    the assembled file wins over the little *-FragNN.part siblings)
  local -a parts=()
  [[ -n "$dl_dest" ]]      && parts+=( ${dl_dest:h}/*.part~*.part-Frag*(N.OL) )
  [[ -n "$proposed_dir" ]] && parts+=( ${proposed_dir}/*.part~*.part-Frag*(N.OL) )
  (( ${#parts} )) && { print -r -- "${parts[1]}"; return; }
}

open_mpv() {
  have mpv || { msg="mpv not found"; return; }
  if [[ -n "$mpv_pid" ]] && kill -0 "$mpv_pid" 2>/dev/null; then msg="mpv already open"; return; fi
  local pf; pf="$(find_partfile)"
  [[ -z "$pf" ]] && { msg="nothing downloaded to play yet"; return; }
  mpv --force-window=immediate --force-seekable=yes --cache=yes \
      --demuxer-readahead-secs=20 --profile=low-latency -- "$pf" >/dev/null 2>&1 &
  mpv_pid=$!
  msg="streaming ${pf:t} in mpv"
}

# rating modal — a small centered box, same keys as media-set-rating
rate_modal() {
  local start=$rating key a b bar nl=$'\n'
  bar="$(printf '─%.0s' {1..19})"
  clear_thumb                          # modal owns the screen; drop the image
  while true; do
    local content="  $(stars_colored $rating)   ${C_DESC}${rating}/5${C_RESET}  "
    local buf=$'\e[H\e[J'
    buf+="${C_BOLD}  set rating${C_RESET}${nl}${nl}"
    buf+="  ${C_BORDER}╭${bar}╮${C_RESET}${nl}"
    buf+="  ${C_BORDER}│${C_RESET}${content}${C_BORDER}│${C_RESET}${nl}"
    buf+="  ${C_BORDER}╰${bar}╯${C_RESET}${nl}${nl}"
    buf+="  ${C_KEY}1-5${C_DESC} set  ${C_KEY}0${C_DESC} clear  ${C_KEY}h/l${C_DESC} ±1  ${C_KEY}j/k${C_DESC} clear/full  ${C_KEY}⏎${C_DESC} ok  ${C_KEY}esc${C_DESC} cancel${C_RESET}${nl}"
    printf '%s' "$buf" >&$tfd
    read -k 1 -u $tfd key || { rating=$start; return; }
    case "$key" in
      0)           rating=0 ;;
      [1-5])       rating=$key ;;
      h|H)         (( rating = rating > 0 ? rating - 1 : 0 )) ;;
      l|L)         (( rating = rating < 5 ? rating + 1 : 5 )) ;;
      k|K)         rating=5 ;;
      j|J)         rating=0 ;;
      $'\r'|$'\n') touched=1; msg="rated ${rating}/5"; return ;;
      q|Q)         rating=$start; return ;;
      $'\e')
        a=""; b=""
        read -t 0.05 -k 1 -u $tfd a 2>/dev/null
        if [[ "$a" == "[" || "$a" == "O" ]]; then
          read -t 0.05 -k 1 -u $tfd b 2>/dev/null
          case "$b" in
            C) (( rating = rating < 5 ? rating + 1 : 5 )) ;;   # →
            D) (( rating = rating > 0 ? rating - 1 : 0 )) ;;   # ←
            A) rating=5 ;;                                     # ↑
            B) rating=0 ;;                                     # ↓
          esac
        else
          rating=$start; return                               # bare ESC cancels
        fi
        ;;
    esac
  done
}

# `r` — rename: edit the whole proposed filename in $EDITOR. Whatever you save becomes
# the filename verbatim (compose_stem then returns it as-is). Seeded with the
# current proposal; a trailing ".<ext>" left in is trimmed back off. Saving an
# empty file discards the edit and keeps the field-derived name.
edit_modal() {
  local editor="${EDITOR:-${VISUAL:-vi}}"
  local tmpf="${TMPDIR:-/tmp}/ytui-name.$$.txt"
  print -r -- "$(compose_stem)" > "$tmpf" || { msg="cannot write temp file"; return; }

  leave_tui                                      # hand the real terminal to the editor
  ${(z)editor} "$tmpf" </dev/tty >/dev/tty 2>/dev/tty
  local ec=$?
  enter_tui                                      # back to raw mode + alt screen

  if (( ec != 0 )); then
    rm -f "$tmpf"; msg="edit cancelled (editor exit $ec)"; render; return
  fi

  local edited; edited="$(<"$tmpf")"; rm -f "$tmpf"
  edited="${edited%%$'\n'*}"                      # first line only
  [[ -n "$ext" ]] && edited="${edited%.$ext}"     # tolerate a trailing .ext
  edited="$(sanitize "$edited")"

  if [[ -n "$edited" ]]; then
    override_stem="$edited"; touched=1; msg=""
  else
    msg="edit discarded (empty)"
  fi
  render
}

# ── kick off the background jobs ─────────────────────────────────────────────
load_archive_set
preflight

# metadata: reuse ytq's shared info.json cache (same <extractor>_<id> naming as
# thumb_stem). If YT_DLP_JSON_DIR isn't set, json_dir stays empty and this is a no-op.
if [[ -n "${YT_DLP_JSON_DIR:-}" ]]; then
  json_dir="${~YT_DLP_JSON_DIR}"
  mkdir -p -- "$json_dir" 2>/dev/null
  [[ -n "$thumb_stem" ]] && json_file="$json_dir/${thumb_stem}.info.json"
fi
typeset -a json_write_args=()
[[ -n "$json_dir" ]] && json_write_args=( --write-info-json --paths "infojson:$json_dir" --output "infojson:%(extractor)s_%(id)s" )

# thumbnail: reuse ytq's shared cache. If it's already there, we display it at
# once; otherwise fetch it into that same cache (named <extractor>_<id>.jpg) so
# ytq and future ytui runs get it for free. Never re-download a cached thumb.
mkdir -p -- "$proposed_dir" "$thumb_cache" 2>/dev/null
thumb_file="$(cached_thumb)"
# In gallery mode the per-item thumbnails arrive with the ITEM lines instead —
# a second full extraction of the whole index here would cost minutes.
if (( ! gallery )) && [[ -z "$thumb_file" && -n "$thumb_stem" ]]; then
  if [[ -n "$json_file" && -s "$json_file" ]]; then
    # Metadata already cached (by ytq or a prior ytui run) — pull the thumbnail
    # straight out of it, no network round-trip needed.
    yt-dlp --quiet --no-warnings --skip-download --no-download-archive \
      --write-thumbnail --convert-thumbnails jpg \
      -o "thumbnail:${thumb_cache}/%(extractor)s_%(id)s.%(ext)s" \
      "${passthru[@]}" --load-info-json "$json_file" >/dev/null 2>&1 &
  else
    yt-dlp --quiet --no-warnings --no-playlist --skip-download --no-download-archive \
      --write-thumbnail --convert-thumbnails jpg \
      -o "thumbnail:${thumb_cache}/%(extractor)s_%(id)s.%(ext)s" \
      "${json_write_args[@]}" "${passthru[@]}" "$url" >/dev/null 2>&1 &
  fi
  thumb_pid=$!
fi
# reserve the top band for the image only when we can actually draw one
is_kitty && [[ -n "$thumb_stem" ]] && thumb_active=1

# progress fifo: opened read/write so the parent never blocks and never sees
# EOF when yt-dlp exits — we detect completion with kill -0 instead.
fifo="$(mktemp -u -t ytui-fifo).fifo"
mkfifo "$fifo" || die "could not create fifo"
exec {pfd}<>"$fifo"

enter_tui

typeset -a item_print=()
# gallery: one line per entry as it starts, so the UI can follow the index, the
# current filename and that entry's thumbnail without a second extraction pass.
(( gallery )) && item_print=(
  --print "before_dl:ITEM|%(playlist_index)s|%(extractor)s_%(id)s|%(thumbnail)s|%(filename)s|%(extractor)s %(id)s"
  --ignore-errors                     # one dead entry must not kill the whole gallery
)

yt-dlp --no-playlist --newline --no-download-archive --continue \
  --progress-template "download:PROGRESS|%(progress._percent_str)s|%(progress._downloaded_bytes_str)s|%(progress._total_bytes_str)s|%(progress._speed_str)s|%(progress._eta_str)s|%(progress.status)s|%(progress.downloaded_bytes)d" \
  --print "after_move:FINALPATH|%(filepath)s" \
  "${item_print[@]}" "${json_write_args[@]}" "${passthru[@]}" "$url" >&$pfd 2>&1 &
ytdlp_pid=$!

# ── main loop ────────────────────────────────────────────────────────────────
# NOTE: this runs at script top level, not in a function — so a bare `local x`
# here does NOT scope a variable, it runs `typeset x` which PRINTS x's current
# value into the alt screen (the stray "line=PROGRESS…" leak). Declare the
# loop's scratch vars once, up front, and only ever assign to them below.
typeset line="" key=""
render
while true; do
  zselect -t 20 -r $pfd -r $tfd 2>/dev/null    # wait ≤0.2s on progress OR keys

  while read -r -u $pfd -t 0 line 2>/dev/null; do handle_line "$line"; done

  while read -k 1 -u $tfd -t 0 key 2>/dev/null; do
    case "$key" in
      o|O) open_mpv ;;
      p|P) toggle_pause ;;
      R)   (( gallery )) && msg="rating is per-file — not available in gallery mode" \
             || { rate_modal; need_full_redraw=1 } ;;   # the modal owned the screen
      r)   (( gallery )) && msg="renaming is per-file — not available in gallery mode" || edit_modal ;;
      q|Q) leave_tui; print -r -- "${SELF}: cancelled"; exit 130 ;;
    esac
  done

  render
  kill -0 "$ytdlp_pid" 2>/dev/null || break
done

# ── drain any trailing output, then reap ─────────────────────────────────────
while read -r -u $pfd -t 0.1 line 2>/dev/null; do handle_line "$line"; done
wait "$ytdlp_pid"; typeset -gi rc=$?
[[ -n "$thumb_pid" ]] && wait "$thumb_pid" 2>/dev/null

# ── report / rename ──────────────────────────────────────────────────────────
if (( rc != 0 )); then
  render_error "$rc"                 # show the failure IN the window, wait for a key
  leave_tui
  print -ru2 -- "${SELF}: yt-dlp failed (exit $rc)"   # one line for scrollback/logs
  exit $rc
fi

leave_tui

# gallery: many files, none of them named by the (disabled) rating/edit modals —
# so there is nothing to rename and no single output path to report.
if (( gallery )); then
  if (( gal_done )); then
    print -r -- "${C_OK}✓${C_RESET} gallery finished — ${C_BOLD}${gal_done}${C_RESET} item(s) downloaded"
    [[ -n "$proposed_dir" ]] && print -r -- "  ${C_DESC}into:${C_RESET} ${proposed_dir}"
  else
    print -r -- "${C_WARN}${SELF}: gallery finished, but no items were downloaded${C_RESET}"
  fi
  exit 0
fi

src="${final_real:-$final_path}"
if [[ ! -e "$src" ]]; then
  print -r -- "${C_WARN}${SELF}: finished, but couldn't locate the output file${C_RESET}"
  print -r -- "  expected: ${src}"
  exit 0
fi

print -r -- "${C_OK}✓${C_RESET} downloaded  ${C_FILE}${src:t}${C_RESET}"
[[ -z "$thumb_file" ]] && thumb_file="$(cached_thumb)"
[[ -n "$thumb_file" ]] && print -r -- "  ${C_DESC}thumbnail:${C_RESET} ${thumb_file:t} ${C_DIM}(cached)${C_RESET}"
[[ -n "$json_file" && -s "$json_file" ]] && print -r -- "  ${C_DESC}metadata:${C_RESET} ${json_file:t} ${C_DIM}(cached)${C_RESET}"

if (( touched )); then
  stem="$(compose_stem)"
  dst="${src:h}/${stem}.${src:e}"
  if [[ "$dst" == "$src" ]]; then
    print -r -- "  ${C_DIM}name unchanged${C_RESET}"
  elif [[ -e "$dst" ]]; then
    print -r -- "  ${C_ERR}rename skipped — exists:${C_RESET} ${dst:t}"
  elif mv -n -- "$src" "$dst"; then
    print -r -- "  ${C_OK}renamed →${C_RESET} ${C_FILE}${dst:t}${C_RESET}"
  else
    print -ru2 -- "  ${C_ERR}rename failed${C_RESET}"
  fi
fi
