#!/usr/bin/env zsh

emulate -L zsh
set -u
setopt pipefail extended_glob

TTY=/dev/tty
if { exec 3< "$TTY" } 2>/dev/null && { exec 4> "$TTY" } 2>/dev/null; then
  :
else
  exec 3<&0
  exec 4>&2
fi

CHECK_UTF8=true
CHECK_FASTSTART=true
CHECK_BLACKFRAMES=true
CHECK_URL=true
CHECK_METADATA=true
CHECK_RENAME=true
CHECK_LENGTH=true

SHOW_THUMBNAIL=true
THUMB_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/media-audit/thumbs"
# Pixel box the thumbnail is cropped to fill; recomputed from the real terminal
# cell size in detect_thumb_backend.
THUMB_BOX_W=720
THUMB_BOX_H=405
THUMB_CELL_W=10
THUMB_CELL_H=20

MAX_FILENAME_BYTES=240
MEDIA_RENAME_TIMEOUT="${MEDIA_RENAME_TIMEOUT:-20}"

typeset -a INPUT_FILES=()
typeset -i processed_count=0
typeset -i total_count=0
typeset -i clean_count=0
typeset -i issue_file_count=0
typeset -i fix_count=0
typeset -i repaired_file_count=0
typeset -i skip_count=0
typeset -i fail_count=0

C_RESET=$'\033[0m'
C_DIM=$'\033[2m'
C_BOLD=$'\033[1m'
C_REVERSE=$'\033[7m'
C_CYAN=$'\033[36m'
C_GREEN=$'\033[32m'
C_RED=$'\033[31m'
C_YELLOW=$'\033[33m'
ICON_PASS="✓"
ICON_FAIL="✕"
ICON_PENDING="·"
CURRENT_FILE=""
CURRENT_STATS=""
CURRENT_CHECK=""
# Number of rows draw_fileinfo prints (filename, directory, stats). Keep in
# sync with draw_fileinfo and checks_header_row.
INFO_ROWS=3
CURRENT_TOTAL=0
CURRENT_PASS=0
CURRENT_FAIL=0
typeset -a ENABLED_CHECKS=()
typeset -A CHECK_STATUS=()
MENU_CHECK=""
typeset -a MENU_OPTIONS=()
MENU_INDEX=0
MENU_NOTE=""
FETCH_ERROR=""
CHECKS_HEADER_ROW=0
typeset -a PENDING_METADATA_ARGS=()
typeset -a PENDING_FIXES=()
PENDING_FASTSTART=false
PENDING_TRIM_START=""
# Chapters/subtitles ride along with the metadata fetch (see
# queue_fetched_metadata); they are extra ffmpeg inputs rather than -metadata
# args, so they are held separately from PENDING_METADATA_ARGS.
PENDING_CHAPTERS_JSON=""
PENDING_SUBTITLE_FILE=""
PENDING_SUBTITLE_LANG=""
typeset -a PENDING_TMPFILES=()
THUMB_ENABLE=false
THUMB_BACKEND=""
typeset -a THUMB_ICAT=()
THUMB_ROWS=0
THUMB_COLS=0
THUMB_CURRENT_IMG=""

usage() {
  cat >&2 <<'EOF'
Usage:
  media-audit [options] [file ...]

Audits a media library. With no file arguments it streams files from fd-media.
When files are provided, only those files are checked. A directory argument is
recursed for media files via fd-media.

Checks:
  MP4/MOV/M4V FastStart
  black screens/scenes at the start of video
  embedded source URL
  embedded title metadata
  filename health: invalid UTF-8, media-rename canonical syntax, length

Options:
  --bypass-check-utf8
  --bypass-check-faststart
  --bypass-check-blackframes, --bypass-check-black-frames
  --bypass-check-url
  --bypass-check-metadata
  --bypass-check-rename
  --bypass-check-length
  --bypass-check-filename       Bypass UTF-8, rename, and length checks
  --max-filename-bytes N        Default: 240
  --no-thumbnail                Do not render a video thumbnail at the top
  -h, --help
EOF
}

say() {
  print -P -u4 -- "$*"
}

say_raw() {
  print -r -u4 -- "$*"
}

warn() {
  say "%F{yellow}!%f $*"
}

fail() {
  say "%F{red}x%f $*"
}

pass() {
  say "%F{green}ok%f $*"
}

clear_status() {
  [[ -t 4 ]] || return 0
  print -n -u4 -- $'\r\033[K'
}

# "3/7 files OK" — files finished so far, and how many needed no attention.
session_summary_line() {
  local done=$(( clean_count + issue_file_count ))

  say "${C_GREEN}${clean_count}${C_RESET}/${done} files OK"
}

build_enabled_checks() {
  ENABLED_CHECKS=()

  $CHECK_BLACKFRAMES && ENABLED_CHECKS+=("black-frames")
  $CHECK_URL && ENABLED_CHECKS+=("source-url")
  $CHECK_METADATA && ENABLED_CHECKS+=("metadata")
  $CHECK_FASTSTART && ENABLED_CHECKS+=("faststart")

  if $CHECK_UTF8 || $CHECK_RENAME || $CHECK_LENGTH; then
    ENABLED_CHECKS+=("filename")
  fi
}

check_enabled() {
  local check="$1"
  local item

  for item in "${ENABLED_CHECKS[@]}"; do
    [[ "$item" == "$check" ]] && return 0
  done

  return 1
}

reset_file_checks() {
  local item

  CHECK_STATUS=()
  CURRENT_TOTAL=0
  CURRENT_PASS=0
  CURRENT_FAIL=0

  for item in "${ENABLED_CHECKS[@]}"; do
    CHECK_STATUS[$item]=""
  done
}

refresh_current_counts() {
  local item check_state

  CURRENT_TOTAL=0
  CURRENT_PASS=0
  CURRENT_FAIL=0

  for item in "${ENABLED_CHECKS[@]}"; do
    check_state="${CHECK_STATUS[$item]-}"
    [[ -n "$check_state" ]] || continue
    (( CURRENT_TOTAL++ ))
    case "$check_state" in
      pass) (( CURRENT_PASS++ )) ;;
      fail) (( CURRENT_FAIL++ )) ;;
    esac
  done
}

set_check_status() {
  local check="$1"
  local check_state="$2"

  check_enabled "$check" || return 0
  CHECK_STATUS[$check]="$check_state"
  refresh_current_counts
}

# One checklist row — glyph and text share a single state colour, so a green
# tick always means "passed" and nothing else wears a tick. A pending check is
# a dim dot with a bare name; an evaluated one reads "name: <word>". The
# displayed name is deliberately plainer than the internal check id.
check_row() {
  local item="$1" state="$2"
  local name good bad color icon text

  case "$item" in
    black-frames) name="intro";      good="none";    bad="found" ;;
    source-url)   name="source url"; good="found";   bad="missing" ;;
    metadata)     name="metadata";   good="found";   bad="missing" ;;
    faststart)    name="container";  good="enabled"; bad="disabled" ;;
    filename)     name="filename";   good="ok";      bad="issues" ;;
    *)            name="$item";      good="ok";      bad="issue" ;;
  esac

  case "$state" in
    pass) color="${C_GREEN}${C_BOLD}"; icon="$ICON_PASS";    text="${name}: ${good}" ;;
    fail) color="${C_RED}${C_BOLD}";   icon="$ICON_FAIL";    text="${name}: ${bad}" ;;
    *)    color="$C_DIM";              icon="$ICON_PENDING"; text="$name" ;;
  esac

  print -r -- "${color}${icon} ${text}${C_RESET}"
}

# Truncate a menu option to fit within the checklist indent.
menu_option_text() {
  local text="$1" fw="$2"
  (( ${#text} > fw )) && text="${text[1,fw-1]}…"
  print -r -- "$text"
}

draw_checks_block() {
  local item check_state row i text width fw

  width="${COLUMNS:-100}"
  fw=$(( width - 9 ))
  (( fw < 20 )) && fw=20

  for item in "${ENABLED_CHECKS[@]}"; do
    check_state="${CHECK_STATUS[$item]-}"
    row="$(check_row "$item" "$check_state")"
    print -rn -u4 -- $'\r\033[K'" ${row}"
    print -u4 -- ""

    # Draw the active menu directly beneath its check, indented.
    if [[ -n "$MENU_CHECK" && "$item" == "$MENU_CHECK" ]]; then
      if [[ -n "$MENU_NOTE" ]]; then
        print -rn -u4 -- $'\r\033[K'"    ${C_RED}$(menu_option_text "$MENU_NOTE" "$fw")${C_RESET}"
        print -u4 -- ""
      fi
      for (( i = 1; i <= ${#MENU_OPTIONS[@]}; i++ )); do
        text="$(menu_option_text "${MENU_OPTIONS[i]}" "$fw")"
        if (( i == MENU_INDEX )); then
          print -rn -u4 -- $'\r\033[K'"    ${C_REVERSE}${C_BOLD} ❯ ${text} ${C_RESET}"
        else
          print -rn -u4 -- $'\r\033[K'"       ${C_DIM}${text}${C_RESET}"
        fi
        print -u4 -- ""
      done
      print -u4 -- ""
    fi
  done
}

human_size() {
  awk -v b="$1" 'BEGIN {
    split("B KB MB GB TB PB", u, " ")
    i = 1; s = b
    while (s >= 1024 && i < 6) { s /= 1024; i++ }
    if (i == 1)          printf "%d %s", s, u[i]
    else if (s >= 100)   printf "%.0f %s", s, u[i]
    else if (s >= 10)    printf "%.1f %s", s, u[i]
    else                 printf "%.2f %s", s, u[i]
  }'
}

# Round an ffprobe r_frame_rate ("60000/1001", "30/1", "25") to a tidy fps
# string: an integer when it lands within 0.05 of one, else two decimals.
fps_from_rate() {
  local rate="$1"
  [[ -n "$rate" && "$rate" != "0/0" ]] || return 0
  awk -v r="$rate" 'BEGIN {
    n = split(r, a, "/")
    v = (n == 2 && a[2] + 0 > 0) ? a[1] / a[2] : r + 0
    if (v <= 0) exit
    rv = int(v + 0.5)
    # Snap NTSC rates (59.94, 29.97, 23.976, ...) to their nominal integer.
    if (v >= rv - 0.1 && v <= rv + 0.1) printf "%d", rv
    else printf "%.2f", v
  }'
}

human_age() {
  local secs="$1"
  (( secs < 0 )) && secs=0
  awk -v s="$secs" 'BEGIN {
    day = 86400; mon = day * 30.4375; yr = day * 365.25
    if (s < 60)     { printf "just now"; exit }
    if (s < 3600)   { m = int(s / 60);   printf "%d minute%s old", m, (m == 1 ? "" : "s"); exit }
    if (s < day)    { h = int(s / 3600); printf "%d hour%s old",   h, (h == 1 ? "" : "s"); exit }
    if (s < mon)    { d = int(s / day);  printf "%d day%s old",    d, (d == 1 ? "" : "s"); exit }
    if (s < yr)     { o = int(s / mon); if (o < 1) o = 1; printf "%d month%s old", o, (o == 1 ? "" : "s"); exit }
    y = int(s / yr); printf "%d year%s old", y, (y == 1 ? "" : "s")
  }'
}

# Build the one-line "560 MB · 2160p 60fps · 4 months old" stats string for the
# current file into CURRENT_STATS. Each part is best-effort; missing pieces are
# simply dropped.
build_file_stats() {
  local file="$1"
  local bytes mtime now probe height rfr res fps
  local -a parts=()

  CURRENT_STATS=""
  [[ -f "$file" ]] || return 0

  bytes="$(stat -f '%z' -- "$file" 2>/dev/null)"
  [[ "$bytes" == <-> ]] && parts+=("$(human_size "$bytes")")

  if is_video_path "$file" && command -v ffprobe >/dev/null 2>&1; then
    probe="$(ffprobe -v error -select_streams v:0 \
      -show_entries stream=height,r_frame_rate \
      -of default=noprint_wrappers=1:nokey=1 -- "$file" 2>/dev/null)"
    local -a pv=("${(@f)probe}")
    height="${pv[1]-}"
    rfr="${pv[2]-}"
    if [[ "$height" == <-> ]] && (( height > 0 )); then
      res="${height}p"
      fps="$(fps_from_rate "$rfr")"
      [[ -n "$fps" ]] && res="${res} ${fps}fps"
      parts+=("$res")
    fi
  fi

  mtime="$(stat -f '%m' -- "$file" 2>/dev/null)"
  if [[ "$mtime" == <-> ]]; then
    now="$(date +%s)"
    parts+=("$(human_age $(( now - mtime )))")
  fi

  (( ${#parts[@]} > 0 )) && CURRENT_STATS="${(j: · :)parts}"
}

# Filename, then the directory holding it, then size/format stats. When a
# thumbnail is on screen this becomes a column to the right of it; otherwise it
# stacks at the left margin. Either way it occupies the height the checklist
# below assumes (see checks_header_row).
draw_fileinfo() {
  local dir name max col i
  local -a lines

  [[ -n "$CURRENT_FILE" ]] || return 0
  dir="${CURRENT_FILE:h}"
  name="${CURRENT_FILE:t}"

  col=1
  $THUMB_ENABLE && [[ -n "$THUMB_CURRENT_IMG" ]] && col=$(( THUMB_COLS + 3 ))

  max=$(( ${COLUMNS:-100} - col ))
  (( max < 20 )) && max=20
  (( ${#name} > max )) && name="${name[1,max-1]}…"
  (( ${#dir} > max )) && dir="…${dir[-(max-1),-1]}"

  lines=(
    "${C_BOLD}${C_YELLOW}${name}${C_RESET}"
    "${C_CYAN}${dir}${C_RESET}"
    "${C_DIM}${CURRENT_STATS}${C_RESET}"
  )

  if (( col == 1 )); then
    for (( i = 1; i <= ${#lines[@]}; i++ )); do
      say_raw "${lines[i]}"
    done
    return 0
  fi

  # render_thumb_band parked the cursor just below the band; paint the info
  # column with absolute positioning and put the cursor back where it was.
  for (( i = 1; i <= ${#lines[@]}; i++ )); do
    print -n -u4 -- $'\033['"$(( THUMB_ABOVE + i ))"$';'"${col}"$'H'
    print -rn -u4 -- "${lines[i]}"
  done
  print -n -u4 -- $'\033['"$(( THUMB_ABOVE + THUMB_ROWS + 1 ))"$';1H'
}

# Row (1-based) of the first checklist line, so the checklist region can be
# repainted without disturbing the thumbnail band above it.
checks_header_row() {
  local band=$INFO_ROWS
  $THUMB_ENABLE && [[ -n "$THUMB_CURRENT_IMG" ]] && band=$THUMB_ROWS
  # 3 header rows (title, summary, blank) + the band + 1 trailing blank.
  print -r -- $(( band + 5 ))
}

draw_header() {
  say_raw "${C_REVERSE}${C_BOLD} MEDIA LIBRARY FILE CHECK v1 ${C_RESET}"
  session_summary_line
  say ""
  CHECKS_HEADER_ROW="$(checks_header_row)"
  render_thumb_band
  draw_fileinfo
  say ""
  draw_checks_block
  say ""
}

# Repaint only the checklist (and any inline menu) in place, leaving the
# title, summary and thumbnail untouched — used for menu navigation and for
# per-check updates, so the screen never fully clears and flickers.
render_checks_region() {
  [[ -t 4 ]] || return 0
  print -n -u4 -- $'\033['"${CHECKS_HEADER_ROW}"$';1H\033[J'
  draw_checks_block
}

# Repaint just the summary line (row 2); the fix tally changes as fixes land.
render_summary_line() {
  [[ -t 4 ]] || return 0
  print -n -u4 -- $'\033[2;1H\033[K'
  session_summary_line
}

# Pick an image backend the same way ffmpeg-lossless-cut's fzf preview does:
# kitty icat when in kitty, else wezterm/imgcat/chafa. Sized to the tty so the
# thumbnail band never crowds out the checks panel below it.
detect_thumb_backend() {
  local size rows cols

  THUMB_BACKEND=""
  THUMB_ICAT=()
  THUMB_ROWS=0
  THUMB_COLS=0
  THUMB_ENABLE=false

  $SHOW_THUMBNAIL || return 0
  [[ -t 4 ]] || return 0
  command -v ffmpeg >/dev/null 2>&1 || return 0

  # Detect kitty by TERM, not KITTY_WINDOW_ID: plain ssh forwards TERM but not
  # kitty's env vars, and icat's stream transfer mode works fine over ssh.
  # Prefer the standalone `kitten` binary (present wherever kitty is, and easy
  # to install alone on remotes); imgcat is iTerm2's protocol, so only trust it
  # inside iTerm — a stray imgcat on a remote host renders nothing in kitty.
  if [[ "$TERM" == *kitty* || -n "${KITTY_WINDOW_ID:-}" ]] && command -v kitten >/dev/null 2>&1; then
    THUMB_BACKEND=kitty
    THUMB_ICAT=(kitten icat)
  elif [[ -n "${KITTY_WINDOW_ID:-}" ]] && command -v kitty >/dev/null 2>&1; then
    THUMB_BACKEND=kitty
    THUMB_ICAT=(kitty +kitten icat)
  elif [[ -n "${WEZTERM_PANE:-}" ]] && command -v wezterm >/dev/null 2>&1; then
    THUMB_BACKEND=wezterm
  elif [[ "${TERM_PROGRAM:-}" == "iTerm.app" ]] && command -v imgcat >/dev/null 2>&1; then
    THUMB_BACKEND=imgcat
  elif command -v chafa >/dev/null 2>&1; then
    THUMB_BACKEND=chafa
  else
    return 0
  fi

  # Inside a multiplexer (zellij/tmux) the pty reports a 0x0 pixel size and
  # swallows kitty graphics, even though TERM still says kitty. icat's
  # --print-window-size fails in exactly that case, so use it as a probe and
  # demote to chafa's character-cell renderer, which works everywhere.
  if [[ "$THUMB_BACKEND" == kitty ]] && ! "${THUMB_ICAT[@]}" --print-window-size >/dev/null 2>&1; then
    THUMB_BACKEND=""
    THUMB_ICAT=()
    command -v chafa >/dev/null 2>&1 && THUMB_BACKEND=chafa
    [[ -n "$THUMB_BACKEND" ]] || return 0
  fi

  size="$(stty size <&3 2>/dev/null)"
  rows="${size%% *}"
  cols="${size##* }"
  { [[ "$rows" == <-> ]] && (( rows > 0 )) } || rows="${LINES:-40}"
  { [[ "$cols" == <-> ]] && (( cols > 0 )) } || cols="${COLUMNS:-100}"

  measure_cell_size "$rows" "$cols"

  # Height first: the band only has to leave room for the checklist and its
  # inline menu below it, since the file info now sits beside the thumbnail.
  THUMB_ROWS=16
  (( THUMB_ROWS > rows - 14 )) && THUMB_ROWS=$(( rows - 14 ))
  if (( THUMB_ROWS < 6 )); then
    THUMB_ROWS=0
    return 0
  fi

  # Width a 16:9 frame of that height actually occupies, clamped to half the
  # screen so the info column has room. Whatever aspect the clamp leaves is
  # what the thumbnail gets cropped to, so the box is always exactly filled —
  # no dead columns beside the image or dead rows under it.
  THUMB_COLS=$(( THUMB_ROWS * THUMB_CELL_H * 16 / (THUMB_CELL_W * 9) ))
  (( THUMB_COLS > cols / 2 )) && THUMB_COLS=$(( cols / 2 ))
  (( THUMB_COLS < 16 )) && THUMB_COLS=16

  THUMB_BOX_W=$(( THUMB_COLS * THUMB_CELL_W ))
  THUMB_BOX_H=$(( THUMB_ROWS * THUMB_CELL_H ))

  THUMB_ENABLE=true
}

# Terminal cell size in pixels, so the thumbnail box has a real aspect ratio to
# crop against. kitty reports the window's pixel size; everything else gets the
# usual 1:2 cell.
measure_cell_size() {
  local rows="$1" cols="$2"
  local size w h

  THUMB_CELL_W=10
  THUMB_CELL_H=20

  [[ "$THUMB_BACKEND" == kitty ]] || return 0
  size="$("${THUMB_ICAT[@]}" --print-window-size 2>/dev/null)" || return 0
  w="${size%%x*}"
  h="${size##*x}"
  { [[ "$w" == <-> ]] && [[ "$h" == <-> ]] } || return 0
  (( w / cols > 0 )) && THUMB_CELL_W=$(( w / cols ))
  (( h / rows > 0 )) && THUMB_CELL_H=$(( h / rows ))
}

thumb_cache_path() {
  local file="$1"
  local mtime size key

  mtime="$(stat -f '%m' -- "$file" 2>/dev/null)"
  size="$(stat -f '%z' -- "$file" 2>/dev/null)"
  # The box dimensions are part of the key: a resized terminal wants a
  # differently cropped thumbnail, not the cached one.
  key="$(printf '%s:%s:%s:%sx%s' "$file" "$mtime" "$size" \
    "$THUMB_BOX_W" "$THUMB_BOX_H" | md5 -q 2>/dev/null)"
  [[ -n "$key" ]] || key="$(printf '%s' "${file:t}" | md5 -q 2>/dev/null)"
  [[ -n "$key" ]] || return 1

  print -r -- "$THUMB_CACHE_DIR/${key}.jpg"
}

# Cover-fit: scale until the frame covers the box, then crop the overflow, so
# the rendered thumbnail fills its cells exactly whatever the source aspect is.
thumb_filter() {
  print -r -- "scale=${THUMB_BOX_W}:${THUMB_BOX_H}:force_original_aspect_ratio=increase:flags=lanczos,crop=${THUMB_BOX_W}:${THUMB_BOX_H}"
}

generate_thumb() {
  local file="$1"
  local img="$2"
  local tmp

  [[ -s "$img" ]] && return 0
  mkdir -p -- "${img:h}" 2>/dev/null || return 1
  tmp="${img}.$$.jpg"

  # A few seconds in usually clears any black leader; fall back to frame 0.
  if ffmpeg -v error -y -ss 2 -i "$file" -frames:v 1 \
      -vf "$(thumb_filter)" -q:v 3 -- "$tmp" 2>/dev/null \
      && [[ -s "$tmp" ]]; then
    mv -f -- "$tmp" "$img"
    return 0
  fi

  rm -f -- "$tmp" 2>/dev/null || true
  if ffmpeg -v error -y -i "$file" -frames:v 1 \
      -vf "$(thumb_filter)" -q:v 3 -- "$tmp" 2>/dev/null \
      && [[ -s "$tmp" ]]; then
    mv -f -- "$tmp" "$img"
    return 0
  fi

  rm -f -- "$tmp" 2>/dev/null || true
  return 1
}

set_current_thumb() {
  local file="$1"
  local img

  THUMB_CURRENT_IMG=""
  $THUMB_ENABLE || return 0
  is_video_path "$file" || return 0

  img="$(thumb_cache_path "$file")" || return 0
  generate_thumb "$file" "$img" || return 0
  THUMB_CURRENT_IMG="$img"
}

# Re-point the current thumbnail at a specific timestamp (e.g. the frame the
# user picked as the new start when trimming leading black) and repaint the
# band. Cached per (file, timestamp) so re-visits are instant; best-effort, so
# a failure leaves the existing thumbnail in place.
set_thumb_at_time() {
  local file="$1"
  local ss="$2"
  local img tmp key

  $THUMB_ENABLE || return 0
  is_video_path "$file" || return 0
  [[ -n "$ss" ]] || return 0

  img="$(thumb_cache_path "$file")" || return 0
  key="${ss//[^0-9]/_}"
  img="${img%.jpg}.t${key}.jpg"

  if [[ ! -s "$img" ]]; then
    mkdir -p -- "${img:h}" 2>/dev/null || return 0
    tmp="${img}.$$.jpg"
    if ffmpeg -v error -y -ss "$ss" -i "$file" -frames:v 1 \
        -vf "$(thumb_filter)" -q:v 3 -- "$tmp" 2>/dev/null \
        && [[ -s "$tmp" ]]; then
      mv -f -- "$tmp" "$img"
    else
      rm -f -- "$tmp" 2>/dev/null || true
      return 0
    fi
  fi

  THUMB_CURRENT_IMG="$img"
  render_thumb_band
  # The info column shares the band, so repaint it in case the backend drew
  # over it.
  draw_fileinfo
}

# Three header rows sit above the thumbnail: title, summary, blank.
THUMB_ABOVE=3
render_thumb_band() {
  $THUMB_ENABLE || return 0

  if [[ -z "$THUMB_CURRENT_IMG" ]]; then
    [[ "$THUMB_BACKEND" == kitty ]] && "${THUMB_ICAT[@]}" --clear --stdin=no >&4 2>/dev/null
    return 0
  fi

  # Home the cursor to the top of the band: kitty places by coordinates, but the
  # inline backends draw wherever the cursor happens to be, which is not the
  # band when this is called to re-point an existing thumbnail.
  [[ -t 4 ]] && print -n -u4 -- $'\033['"$(( THUMB_ABOVE + 1 ))"$';1H'

  case "$THUMB_BACKEND" in
    kitty)
      "${THUMB_ICAT[@]}" --clear --transfer-mode=stream --stdin=no --align=left \
        --place="${THUMB_COLS}x${THUMB_ROWS}@0x${THUMB_ABOVE}" -- "$THUMB_CURRENT_IMG" >&4 2>/dev/null
      ;;
    wezterm)
      wezterm imgcat --width "${THUMB_COLS}" -- "$THUMB_CURRENT_IMG" >&4 2>/dev/null
      ;;
    imgcat)
      imgcat "$THUMB_CURRENT_IMG" >&4 2>/dev/null
      ;;
    chafa)
      # -f symbols: chafa otherwise auto-picks the kitty protocol from TERM,
      # which draws nothing inside a multiplexer.
      # --font-ratio keeps chafa's idea of a cell in step with the box the
      # image was cropped for, so it fills the band rather than letterboxing.
      chafa -f symbols --animate=off --align=left --size="${THUMB_COLS}x${THUMB_ROWS}" \
        --font-ratio "${THUMB_CELL_W}/${THUMB_CELL_H}" \
        -- "$THUMB_CURRENT_IMG" >&4 2>/dev/null
      ;;
  esac

  # Land the cursor just below a fixed-height band so the layout below the
  # thumbnail is deterministic regardless of the image's aspect ratio.
  print -n -u4 -- $'\033['"$(( THUMB_ABOVE + THUMB_ROWS + 1 ))"$';1H'
}

clear_thumb() {
  $THUMB_ENABLE || return 0
  [[ "$THUMB_BACKEND" == kitty ]] || return 0
  "${THUMB_ICAT[@]}" --clear --stdin=no >&4 2>/dev/null || true
}

# Ctrl-C anywhere aborts the whole run (not just the current file). Restore the
# cursor, wipe any thumbnail, and exit. Prompt handlers call this after undoing
# their own raw-mode stty tweaks.
finish_interrupt() {
  print -n -u4 -- $'\033[?25h' 2>/dev/null || true
  clear_thumb 2>/dev/null || true
  print -u4 '' 2>/dev/null || true
  say "%F{yellow}Interrupted.%f"
  exit 130
}

redraw_screen() {
  [[ -t 4 ]] || return 0
  print -n -u4 -- $'\033[2J\033[H'
  draw_header
}

colored_path() {
  local file="$1"
  local dir="${file:h}"
  local base="${file:t}"

  if [[ "$dir" == "." ]]; then
    print -r -- "${C_CYAN}${base}${C_RESET}"
  else
    print -r -- "${C_DIM}${dir}/${C_RESET}${C_CYAN}${base}${C_RESET}"
  fi
}

issue_screen() {
  local check="$1"
  local file="$2"

  CURRENT_CHECK="$check"
  set_check_status "$check" "fail"

  [[ -t 4 ]] && render_checks_region
  clear_status
}

# Count this file toward the repaired total once, on its first applied fix.
# FILE_REPAIRED is an audit_file local, visible here via zsh dynamic scope.
note_repaired_file() {
  ${FILE_REPAIRED:-true} && return 0
  FILE_REPAIRED=true
  (( repaired_file_count++ ))
}

mark_fixed() {
  local message="${1:-Fixed.}"

  (( fix_count++ ))
  note_repaired_file
  [[ -n "$CURRENT_CHECK" ]] && set_check_status "$CURRENT_CHECK" "pass"

  if [[ -t 4 ]]; then
    render_summary_line
    render_checks_region
  else
    pass "$message"
  fi
}

mark_unresolved() {
  (( FILE_UNRESOLVED++ ))
  [[ -n "$CURRENT_CHECK" ]] && set_check_status "$CURRENT_CHECK" "fail"
}

run_check() {
  local check="$1"
  shift

  check_enabled "$check" || return 0
  CURRENT_CHECK="$check"

  "$@"
  local rc=$?

  if (( rc == 0 )); then
    set_check_status "$check" "pass"
    [[ -t 4 ]] && render_checks_region
  else
    set_check_status "$check" "fail"
  fi

  return "$rc"
}

prompt_yes_no() {
  local prompt="$1"
  local default="${2:-Y}"
  local ans suffix

  if [[ "$default" == Y ]]; then
    suffix="(Y/n)"
  else
    suffix="(y/N)"
  fi

  while true; do
    print -n -P -u4 -- "${prompt} ${suffix} "
    read_prompt_line || return 1
    ans="$READ_PROMPT_REPLY"
    ans="${ans:-$default}"

    case "$ans" in
      [Yy]|[Yy][Ee][Ss]) return 0 ;;
      [Nn]|[Nn][Oo]) return 1 ;;
      *) warn "Please answer y or n." ;;
    esac
  done
}

READ_PROMPT_REPLY=""
read_prompt_line() {
  local saved_stty rc ch buffer

  READ_PROMPT_REPLY=""
  saved_stty=""
  buffer=""

  if [[ ! -t 3 ]]; then
    IFS= read -r -u 3 READ_PROMPT_REPLY
    return $?
  fi

  if command -v stty >/dev/null 2>&1; then
    saved_stty="$(stty -g <&3 2>/dev/null || true)"
    stty -echo -icanon min 1 time 0 <&3 2>/dev/null || true
  fi

  trap '[[ -n "$saved_stty" ]] && stty "$saved_stty" <&3 2>/dev/null; finish_interrupt' INT

  while true; do
    IFS= read -r -k 1 -u 3 ch
    rc=$?
    (( rc == 0 )) || break

    case "$ch" in
      $'\003')
        [[ -n "$saved_stty" ]] && stty "$saved_stty" <&3 2>/dev/null || true
        finish_interrupt
        ;;
      $'\004')
        [[ -n "$buffer" ]] || {
          rc=1
          break
        }
        ;;
      $'\n'|$'\r')
        print -u4
        READ_PROMPT_REPLY="$buffer"
        rc=0
        break
        ;;
      $'\177'|$'\010')
        if [[ -n "$buffer" ]]; then
          buffer="${buffer[1,-2]}"
          print -n -u4 -- $'\b \b'
        fi
        ;;
      $'\025')
        while [[ -n "$buffer" ]]; do
          buffer="${buffer[1,-2]}"
          print -n -u4 -- $'\b \b'
        done
        ;;
      *)
        buffer+="$ch"
        print -n -u4 -- "$ch"
        ;;
    esac
  done

  trap finish_interrupt INT

  [[ -n "$saved_stty" ]] && stty "$saved_stty" <&3 2>/dev/null || true
  return "$rc"
}

# Arrow/vim-key select control on fds 3 (input) and 4 (output).
# Sets SELECT_INDEX (1-based). Returns 130 on Ctrl-C.
# Non-TTY fallback reads a 1-based index as a line from fd 3.
SELECT_INDEX=0
prompt_select() {
  local -a options=("$@")
  local count=${#options[@]}
  local i key seq saved_stty line

  SELECT_INDEX=0
  (( count > 0 )) || return 1

  if [[ ! -t 3 ]]; then
    for (( i = 1; i <= count; i++ )); do
      say_raw "  ${i}) ${options[i]}"
    done
    IFS= read -r -u 3 line || return 130
    [[ "$line" == <-> ]] && (( line >= 1 && line <= count )) || return 130
    SELECT_INDEX=$line
    return 0
  fi

  saved_stty=""
  if command -v stty >/dev/null 2>&1; then
    saved_stty="$(stty -g <&3 2>/dev/null || true)"
    stty -echo -icanon min 1 time 0 <&3 2>/dev/null || true
  fi
  print -n -u4 -- $'\033[?25l'

  # Host the menu inside the checklist, under the check being resolved.
  MENU_CHECK="$CURRENT_CHECK"
  MENU_OPTIONS=("${options[@]}")
  MENU_INDEX=1

  select_restore() {
    [[ -n "$saved_stty" ]] && stty "$saved_stty" <&3 2>/dev/null || true
    print -n -u4 -- $'\033[?25h'
    MENU_CHECK=""
    MENU_OPTIONS=()
    MENU_INDEX=0
    render_checks_region
    trap finish_interrupt INT
  }

  trap 'select_restore; finish_interrupt' INT

  while true; do
    render_checks_region

    IFS= read -r -k 1 -u 3 key || {
      select_restore
      return 130
    }

    case "$key" in
      $'\033')
        seq=""
        IFS= read -r -k 1 -t 0.05 -u 3 seq 2>/dev/null || seq=""
        if [[ "$seq" == "[" ]]; then
          seq=""
          IFS= read -r -k 1 -t 0.05 -u 3 seq 2>/dev/null || seq=""
          case "$seq" in
            A) (( MENU_INDEX > 1 )) && (( MENU_INDEX-- )) ;;
            B) (( MENU_INDEX < count )) && (( MENU_INDEX++ )) ;;
          esac
        fi
        ;;
      j) (( MENU_INDEX < count )) && (( MENU_INDEX++ )) ;;
      k) (( MENU_INDEX > 1 )) && (( MENU_INDEX-- )) ;;
      $'\n'|$'\r')
        SELECT_INDEX=$MENU_INDEX
        select_restore
        return 0
        ;;
      $'\003')
        select_restore
        finish_interrupt
        ;;
      [1-9])
        if (( key <= count )); then
          SELECT_INDEX=$key
          select_restore
          return 0
        fi
        ;;
    esac
  done
}

PROMPT_REPLY=""
prompt_input_or_skip() {
  local prompt="$1"

  PROMPT_REPLY=""
  print -n -P -u4 -- "${prompt} "
  read_prompt_line || return 130
  PROMPT_REPLY="$READ_PROMPT_REPLY"
  return 0
}

# Prompts until a valid http(s) URL is entered. Sets PROMPT_URL and returns 0,
# or returns 1 when the user submits a blank line to skip. (Ctrl-C aborts the
# whole run.)
PROMPT_URL=""
prompt_valid_url() {
  PROMPT_URL=""

  while true; do
    if ! prompt_input_or_skip "Source URL (blank to skip):"; then
      return 1
    fi
    if [[ -z "$PROMPT_REPLY" ]]; then
      return 1
    fi
    if ! is_url "$PROMPT_REPLY"; then
      warn "Expected http:// or https:// URL."
      continue
    fi
    PROMPT_URL="$PROMPT_REPLY"
    return 0
  done
}

# Animate a spinner on fd 4 until $1 (a background PID) exits; returns its
# exit status. Falls back to a plain wait when fd 4 is not a terminal.
spin_until_pid() {
  local pid="$1"
  local label="${2:-working…}"
  local start=$SECONDS
  integer i=0
  local -a spin=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')

  if [[ ! -t 4 ]]; then
    wait "$pid"
    return $?
  fi

  while kill -0 "$pid" 2>/dev/null; do
    print -n -u4 -- $'\r\033[K'"  ${C_CYAN}${spin[i % 10 + 1]}${C_RESET}  ${label} ${C_DIM}$(( SECONDS - start ))s${C_RESET}"
    (( i++ ))
    sleep 0.15
  done

  print -n -u4 -- $'\r\033[K'
  wait "$pid"
  return $?
}

is_video_path() {
  case "${1:l}" in
    *.mp4|*.mov|*.m4v|*.avi|*.mkv|*.wmv|*.flv|*.webm) return 0 ;;
    *) return 1 ;;
  esac
}

is_faststart_path() {
  case "${1:l}" in
    *.mp4|*.mov|*.m4v) return 0 ;;
    *) return 1 ;;
  esac
}

is_url() {
  [[ "$1" == http://* || "$1" == https://* ]]
}

normalize_audit_path() {
  local path="$1"

  if [[ "$path" == /* ]]; then
    print -r -- "$path"
    return 0
  fi

  if [[ -e "$path" ]]; then
    print -r -- "${path:A}"
    return 0
  fi

  if [[ -e "/$path" ]]; then
    print -r -- "/$path"
    return 0
  fi

  print -r -- "${path:A}"
}

creation_date_for_setfile() {
  local file="$1"
  local epoch

  epoch="$(stat -f '%B' -- "$file" 2>/dev/null)" || return 1
  [[ "$epoch" == <-> ]] || return 1
  (( epoch > 0 )) || return 1

  date -r "$epoch" '+%m/%d/%Y %H:%M:%S'
}

copy_creation_date() {
  local source="$1"
  local target="$2"
  local created

  command -v SetFile >/dev/null 2>&1 || return 1
  created="$(creation_date_for_setfile "$source")" || return 1
  SetFile -d "$created" "$target" >/dev/null 2>&1
}

touch_modified_now() {
  local file="$1"

  touch "$file" 2>/dev/null || true
}

filename_byte_length() {
  LC_ALL=C printf '%s' "$1" | wc -c | tr -d '[:space:]'
}

shorten_filename() {
  local filename="$1"
  local max_bytes="$2"

  python3 - "$filename" "$max_bytes" <<'PY'
import os
import sys

name = sys.argv[1]
max_bytes = int(sys.argv[2])
stem, ext = os.path.splitext(name)
marker = "..."
suffix_bytes = len(ext.encode("utf-8"))
marker_bytes = len(marker.encode("utf-8"))
available = max_bytes - suffix_bytes - marker_bytes

if available < 12:
    available = max(1, max_bytes - suffix_bytes)
    marker = ""

out = ""
for ch in stem:
    if len((out + ch).encode("utf-8")) > available:
        break
    out += ch

out = out.rstrip()
if marker and out:
    out += marker

print(out + ext)
PY
}

color_filename_diff() {
  local source_name="$1"
  local target_name="$2"

  python3 - "$source_name" "$target_name" <<'PY'
import difflib
import re
import sys

red = "\033[31m"
green = "\033[32m"
reset = "\033[0m"

source = sys.argv[1]
target = sys.argv[2]

def tokens(value):
    return re.findall(r"\s+|\S+", value)

source_tokens = tokens(source)
target_tokens = tokens(target)
matcher = difflib.SequenceMatcher(None, source_tokens, target_tokens)
source_out = []
target_out = []

for tag, i1, i2, j1, j2 in matcher.get_opcodes():
    source_part = "".join(source_tokens[i1:i2])
    target_part = "".join(target_tokens[j1:j2])

    if tag == "equal":
        source_out.append(source_part)
        target_out.append(target_part)
    elif tag == "delete":
        source_out.append(red + source_part + reset)
    elif tag == "insert":
        target_out.append(green + target_part + reset)
    else:
        source_out.append(red + source_part + reset)
        target_out.append(green + target_part + reset)

print("".join(source_out))
print("".join(target_out))
PY
}

prompt_rename_path() {
  local current="$1"
  local target="$2"
  local reason="${3:-filename}"
  local -a diff_lines=()

  [[ -n "$target" && "$current" != "$target" ]] || return 0

  (( FILE_ISSUES++ ))
  issue_screen "$reason" "$current"
  diff_lines=("${(@f)$(color_filename_diff "${current:t}" "${target:t}")}")
  print -r -u4 -- "filename:  ${diff_lines[1]-${current:t}}"
  print -r -u4 -- "proposed:  ${diff_lines[2]-${target:t}}"
  say ""

  if [[ -e "$target" ]]; then
    fail "filename: cannot rename because the target already exists"
    say_raw "$target"
    (( fail_count++ ))
    mark_unresolved
    return 1
  fi

  if mv -n -- "$current" "$target"; then
    AUDIT_PATH="$target"
    CURRENT_FILE="$target"
    touch_modified_now "$target"
    mark_fixed "Renamed: ${target:t}"
    return 0
  fi

  fail "filename: rename failed"
  (( fail_count++ ))
  mark_unresolved
  return 1
}

check_utf8_filename() {
  local file="$1"
  local filename="${file:t}"
  local fixed target

  $CHECK_UTF8 || return 0
  command -v iconv >/dev/null 2>&1 || return 0

  if printf '%s' "$filename" | iconv -f UTF-8 -t UTF-8 >/dev/null 2>&1; then
    return 0
  fi

  fixed="$(printf '%s' "$filename" | iconv -f UTF-8 -t UTF-8 -c 2>/dev/null)"
  fixed="${fixed##[[:space:]]##}"
  fixed="${fixed%%[[:space:]]##}"

  if [[ -z "$fixed" || "$fixed" == "$filename" ]]; then
    (( FILE_ISSUES++ ))
    issue_screen "filename" "$file"
    say "filename: invalid UTF-8"
    warn "The shell cannot safely recover the original byte sequence for this filename."
    warn "Use a byte-safe rename tool such as convmv, then re-run this audit."
    (( fail_count++ ))
    mark_unresolved
    return 1
  fi

  target="${file:h}/${fixed}"
  prompt_rename_path "$file" "$target" "filename"
}

# Container-structure classification is mp4doctor's job now (the structural
# half of this audit, split out the way media-rename owns filenames). Exit:
# 0 = faststart, 1 = repairable (moov-at-end OR fragmented — a moof-per-
# keyframe file whose empty front moov used to fool the old inline check),
# 3 = a NAME.frag.EXT topaz-encode partial (an unfinished encode: resume or
# delete, never remux), 2 = inconclusive.
faststart_state() {
  mp4doctor --state --quiet -- "$1" 2>/dev/null
}

check_faststart() {
  local file="$1"
  local state

  $CHECK_FASTSTART || return 0
  is_faststart_path "$file" || return 0
  command -v mp4doctor >/dev/null 2>&1 || return 0

  faststart_state "$file"
  state=$?

  case "$state" in
    0)
      return 0
      ;;
    1)
      (( FILE_ISSUES++ ))
      issue_screen "faststart" "$file"
      PENDING_FASTSTART=true
      PENDING_FIXES+=("faststart")
      return 0
      ;;
    3)
      (( FILE_ISSUES++ ))
      issue_screen "faststart" "$file"
      say "faststart: unfinished .frag encode"
      warn "This is topaz-encode's in-flight fragmented output — resume it (topaz-encode --resume) or delete it; remuxing would freeze a partial as if it were done."
      (( fail_count++ ))
      mark_unresolved
      return 1
      ;;
    *)
      (( FILE_ISSUES++ ))
      issue_screen "faststart" "$file"
      say "faststart: inconclusive"
      warn "Could not read the top-level MP4/MOV atoms; leaving the file unchanged."
      (( fail_count++ ))
      mark_unresolved
      return 1
      ;;
  esac
}

detect_black_leader_seconds() {
  local file="$1"
  local output line start end
  local black_re='black_start:([0-9]+([.][0-9]+)?)[[:space:]]+black_end:([0-9]+([.][0-9]+)?)'

  command -v ffmpeg-detect-black-scenes >/dev/null 2>&1 || return 2

  output="$(BLACK_SCAN_DURATION=10 ffmpeg-detect-black-scenes "$file" 2>/dev/null || true)"

  while IFS= read -r line; do
    if [[ "$line" =~ $black_re ]]; then
      start="${match[1]}"
      end="${match[3]}"

      if awk -v s="$start" -v e="$end" 'BEGIN { exit !(s <= 0.25 && e > 0.05) }'; then
        print -r -- "$end"
        return 0
      fi
    fi
  done <<< "$output"

  return 1
}

check_black_frames() {
  local file="$1"
  local seconds rc output trim_start

  $CHECK_BLACKFRAMES || return 0
  is_video_path "$file" || return 0

  seconds="$(detect_black_leader_seconds "$file")"
  rc=$?

  if (( rc == 1 )); then
    return 0
  fi

  if (( rc != 0 )); then
    (( FILE_ISSUES++ ))
    issue_screen "black-frames" "$file"
    say "black-frames: check could not run"
    warn "ffmpeg-detect-black-scenes is required for the black-screen audit."
    (( fail_count++ ))
    mark_unresolved
    return 1
  fi

  (( FILE_ISSUES++ ))
  issue_screen "black-frames" "$file"

  if prompt_yes_no "Trim leading black (${seconds}s)?" "Y"; then
    output="$(ffmpeg-lossless-cut --print-start --from "$seconds" -- "$file" < "$TTY" 2> "$TTY")"
    rc=$?

    local -a marker_lines
    marker_lines=("${(@M)${(@f)output}:#FLC_START=*}")
    trim_start=""
    (( ${#marker_lines[@]} > 0 )) && trim_start="${marker_lines[-1]#FLC_START=}"

    if (( rc == 0 )) && [[ -n "$trim_start" ]]; then
      PENDING_TRIM_START="$trim_start"
      PENDING_FIXES+=("black-frames")
      # Preview the chosen start frame as the thumbnail from here on.
      set_thumb_at_time "$file" "$trim_start"
      return 0
    fi

    if (( rc == 0 )); then
      warn "Keyframe selection cancelled; skipped trim."
      (( skip_count++ ))
      mark_unresolved
      return 1
    fi

    fail "Keyframe selection did not complete."
    (( fail_count++ ))
    mark_unresolved
    return 1
  fi

  warn "Skipped trim."
  (( skip_count++ ))
  mark_unresolved
  return 1
}

PROBE_TITLE=""
PROBE_URL=""
PROBE_HAS_CHAPTERS=false
PROBE_HAS_SUBS=false
probe_media_tags() {
  local file="$1"
  local tags_json streams_json

  PROBE_TITLE=""
  PROBE_URL=""
  PROBE_HAS_CHAPTERS=false
  PROBE_HAS_SUBS=false

  command -v ffprobe >/dev/null 2>&1 || return 1
  command -v jq >/dev/null 2>&1 || return 1

  tags_json="$(ffprobe -v error -show_entries format_tags -of json -- "$file" 2>/dev/null)" || return 1

  # What the file already carries, so an audit re-run does not stack a second
  # copy of the same chapters or captions on top of the first.
  streams_json="$(ffprobe -v error -show_chapters \
    -show_entries stream=codec_type -of json -- "$file" 2>/dev/null)"
  if [[ -n "$streams_json" ]]; then
    jq -e '(.chapters // []) | length > 0' <<< "$streams_json" >/dev/null 2>&1 \
      && PROBE_HAS_CHAPTERS=true
    jq -e '[(.streams // [])[] | select(.codec_type == "subtitle")] | length > 0' \
      <<< "$streams_json" >/dev/null 2>&1 && PROBE_HAS_SUBS=true
  fi

  PROBE_TITLE="$(
    jq -r '(.format.tags // {}) | with_entries(.key |= ascii_downcase) | .title // empty' <<< "$tags_json"
  )"

  PROBE_URL="$(
    jq -r '(.format.tags // {}) | with_entries(.key |= ascii_downcase) as $t |
      [$t.source_url, $t.webpage_url, $t.purl, $t.url, $t.comment, $t.description] |
      [.[]? | strings | (try capture("(?<url>https?://[^[:space:]\"<>]+)").url catch empty)] |
      .[0] // empty' <<< "$tags_json"
  )"

  return 0
}

# ffmpeg's text subtitle codec for a container, or empty when the container
# cannot carry one (so the caption is skipped rather than failing the rewrite).
subtitle_codec_for() {
  case "${1:l}" in
    *.mp4|*.mov|*.m4v) print -r -- "mov_text" ;;
    *.mkv) print -r -- "srt" ;;
    *.webm) print -r -- "webvtt" ;;
    *) return 1 ;;
  esac
}

# ISO 639-2/B code for the container's language tag; falls back to the raw
# code, which ffmpeg stores verbatim.
subtitle_iso3() {
  case "${1%%-*}" in
    en) print -r -- "eng" ;;
    es) print -r -- "spa" ;;
    de) print -r -- "deu" ;;
    fr) print -r -- "fra" ;;
    it) print -r -- "ita" ;;
    pt) print -r -- "por" ;;
    ru) print -r -- "rus" ;;
    ja) print -r -- "jpn" ;;
    ko) print -r -- "kor" ;;
    zh) print -r -- "zho" ;;
    nl) print -r -- "nld" ;;
    pl) print -r -- "pol" ;;
    *) print -r -- "${1%%-*}" ;;
  esac
}

# Turn yt-dlp's chapters array into an FFMETADATA file for ffmpeg -map_chapters.
# `shift_secs` is the leading-black trim, if any: chapter times are relative to
# the untrimmed source, so they slide back by the same amount and chapters that
# fall entirely inside the trimmed head are dropped. `max_secs` is the local
# file's own duration — a local copy can be shorter than the source the metadata
# describes (a clip, an excerpt), so chapters past its end are trimmed off.
write_chapters_metadata() {
  local json_file="$1"
  local out_file="$2"
  local shift_secs="${3:-0}"
  local max_secs="${4:-0}"

  python3 - "$json_file" "$out_file" "$shift_secs" "$max_secs" <<'PY'
import json
import sys

src, dst, shift = sys.argv[1], sys.argv[2], float(sys.argv[3] or 0)
limit = float(sys.argv[4] or 0)

with open(src, encoding="utf-8") as fh:
    chapters = json.load(fh) or []

lines = [";FFMETADATA1"]
count = 0

for chapter in chapters:
    try:
        start = float(chapter.get("start_time"))
        end = float(chapter.get("end_time"))
    except (TypeError, ValueError):
        continue

    start -= shift
    end -= shift
    if end <= 0 or end <= start:
        continue
    start = max(start, 0.0)

    if limit > 0:
        if start >= limit:
            continue
        end = min(end, limit)
        if end <= start:
            continue

    title = (chapter.get("title") or "").strip()
    # FFMETADATA treats these as syntax, so they are escaped rather than dropped.
    for ch in ("\\", "=", ";", "#", "\n"):
        title = title.replace(ch, "\\" + ch if ch != "\n" else "\\\n")

    lines += [
        "[CHAPTER]",
        "TIMEBASE=1/1000",
        f"START={int(round(start * 1000))}",
        f"END={int(round(end * 1000))}",
    ]
    if title:
        lines.append(f"title={title}")
    count += 1

if not count:
    sys.exit(1)

with open(dst, "w", encoding="utf-8") as fh:
    fh.write("\n".join(lines) + "\n")
PY
}

# Download the preferred caption track named in a yt-dlp info JSON. Mirrors the
# --sub-langs "en.*" preference in ~/.config/yt-dlp/config: exact "en" first,
# then any en-* variant. Sets PENDING_SUBTITLE_FILE / PENDING_SUBTITLE_LANG.
fetch_subtitle_track() {
  local json_file="$1"
  local container="$2"
  local lang sub_url sub_ext tmp

  subtitle_codec_for "$container" >/dev/null || return 1
  command -v curl >/dev/null 2>&1 || return 1

  lang="$(jq -r '
    (.subtitles // {}) | keys_unsorted as $k
    | (($k | map(select(. == "en"))) + ($k | map(select(startswith("en")))))[0] // empty
  ' "$json_file" 2>/dev/null)"
  [[ -n "$lang" ]] || return 1

  # Prefer the formats ffmpeg reads directly as text subtitles.
  sub_url="$(jq -r --arg l "$lang" '
    (.subtitles[$l] // []) as $t
    | (($t | map(select(.ext == "vtt"))) + ($t | map(select(.ext == "srt"))) + $t)[0].url // empty
  ' "$json_file" 2>/dev/null)"
  [[ -n "$sub_url" ]] || return 1

  sub_ext="$(jq -r --arg l "$lang" '
    (.subtitles[$l] // []) as $t
    | (($t | map(select(.ext == "vtt"))) + ($t | map(select(.ext == "srt"))) + $t)[0].ext // "vtt"
  ' "$json_file" 2>/dev/null)"
  [[ -n "$sub_ext" ]] || sub_ext="vtt"

  tmp="$(mktemp -t media-check-sub.XXXXXX)" || return 1
  mv -- "$tmp" "${tmp}.${sub_ext}" 2>/dev/null && tmp="${tmp}.${sub_ext}"
  PENDING_TMPFILES+=("$tmp")

  curl -fsSL --max-time 30 -o "$tmp" -- "$sub_url" >/dev/null 2>&1 || return 1
  [[ -s "$tmp" ]] || return 1

  # Some hosts gate captions and answer with an HTML error page; embedding that
  # would fail the whole rewrite, so require it to actually look like a caption.
  case "$sub_ext" in
    vtt) head -c 6 -- "$tmp" | grep -q "WEBVTT" || return 1 ;;
    srt) grep -q -- "-->" "$tmp" || return 1 ;;
  esac

  PENDING_SUBTITLE_FILE="$tmp"
  PENDING_SUBTITLE_LANG="$lang"
  return 0
}

cleanup_pending_media() {
  local item

  for item in "${PENDING_TMPFILES[@]}"; do
    [[ -n "$item" ]] && rm -f -- "$item" 2>/dev/null
  done

  PENDING_TMPFILES=()
  PENDING_CHAPTERS_JSON=""
  PENDING_SUBTITLE_FILE=""
  PENDING_SUBTITLE_LANG=""
}

media_duration_seconds() {
  ffprobe -v error -show_entries format=duration \
    -of default=noprint_wrappers=1:nokey=1 -- "$1" 2>/dev/null
}

# Draw a single in-place progress bar frame from ffmpeg -progress values.
draw_rewrite_progress_bar() {
  local total="$1" out_time="$2" speed="$3" state="${4:-}" cols="${5:-80}"

  awk -v total="$total" -v t="$out_time" -v speed="$speed" -v state="$state" -v cols="$cols" '
    function clk(s,   h, m, sec) {
      if (s < 0) s = 0
      h = int(s / 3600); s -= h * 3600
      m = int(s / 60);   sec = int(s - m * 60)
      return (h > 0) ? sprintf("%d:%02d:%02d", h, m, sec) : sprintf("%02d:%02d", m, sec)
    }
    BEGIN {
      esc = sprintf("%c", 27)
      cyan = esc "[1;36m"; dim = esc "[2m"; green = esc "[1;32m"
      yellow = esc "[1;33m"; reset = esc "[0m"; clr = esc "[K"

      n = split(t, p, ":")
      elapsed = (n == 3) ? p[1] * 3600 + p[2] * 60 + p[3] : t + 0
      sp = speed; gsub(/[^0-9.]/, "", sp); sp = sp + 0
      total = total + 0
      if (state == "end" && total > 0) elapsed = total

      if (total > 0) {
        pct = elapsed / total * 100
        if (pct < 0) pct = 0; if (pct > 100) pct = 100
        barw = cols - 40
        if (barw < 10) barw = 10; if (barw > 48) barw = 48
        filled = int(pct / 100 * barw + 0.5)
        if (filled > barw) filled = barw; if (filled < 0) filled = 0
        fill = ""; for (i = 0; i < filled; i++) fill = fill "█"
        emp = "";  for (i = 0; i < barw - filled; i++) emp = emp "░"
        printf "\r  %s%3d%%%s  %s%s%s%s%s  %s / %s  %s%.2fx%s%s",
          cyan, pct, reset,
          green, fill, dim, emp, reset,
          clk(elapsed), clk(total),
          yellow, sp, reset, clr
      } else {
        printf "\r  %scopying…%s  %s%s elapsed%s%s",
          cyan, reset, dim, clk(elapsed), reset, clr
      }
    }
  ' >&4
}

# Poll ffmpeg's -progress file while it runs. Once the muxed data hits ~100%,
# ffmpeg's faststart pass rewrites the whole file to move the moov atom to the
# front and emits no further progress, so animate a spinner for that phase
# instead of freezing the bar at 99%.
monitor_ffmpeg_progress() {
  local pid="$1" pfile="$2" total="$3" cols="$4"
  local tail_label="${5:-finalizing…}"
  local block out_time speed pct
  local start=$SECONDS
  integer spin_i=0
  local -a spin=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')

  while kill -0 "$pid" 2>/dev/null; do
    out_time=""
    speed=""
    pct=0

    if [[ -n "$pfile" && -s "$pfile" ]]; then
      local -a plines
      plines=("${(@f)$(tail -n 16 -- "$pfile" 2>/dev/null)}")
      out_time="${${(@M)plines:#out_time=*}[-1]#out_time=}"
      speed="${${(@M)plines:#speed=*}[-1]#speed=}"
    fi

    if [[ -n "$out_time" ]]; then
      pct="$(awk -v t="$out_time" -v tot="$total" 'BEGIN {
        n = split(t, p, ":")
        e = (n == 3) ? p[1] * 3600 + p[2] * 60 + p[3] : t + 0
        if (tot + 0 > 0) { x = e / tot * 100; if (x > 100) x = 100; printf "%d", x }
        else { print 0 }
      }')"
    fi

    if (( pct >= 99 )); then
      print -n -u4 -- $'\r\033[K'"  ${C_CYAN}${spin[spin_i % 10 + 1]}${C_RESET}  ${tail_label} ${C_DIM}$(( SECONDS - start ))s${C_RESET}"
      (( spin_i++ ))
    else
      draw_rewrite_progress_bar "$total" "$out_time" "$speed" "continue" "$cols"
    fi

    sleep 0.15
  done

  print -n -u4 -- $'\r\033[K'
}

rewrite_with_metadata() {
  local file="$1"
  shift

  local dir="${file:h}"
  local base="${file:t:r}"
  local ext="${file:e}"
  local tmp total errlog chapters_meta sub_codec
  local -a ffmpeg_args metadata_args
  integer rc=0
  integer next_input=1 chapters_input=-1 subs_input=-1

  metadata_args=("$@")

  command -v ffmpeg >/dev/null 2>&1 || return 1
  tmp="$(mktemp "${dir}/.${base}.metadata.XXXXXX.${ext}")" || return 1

  # Built here rather than at fetch time so the chapter times see the final
  # trim offset, whichever order the checks resolved in.
  if [[ -n "$PENDING_CHAPTERS_JSON" ]]; then
    if chapters_meta="$(mktemp -t media-check-ffmeta.XXXXXX)"; then
      PENDING_TMPFILES+=("$chapters_meta")
      write_chapters_metadata "$PENDING_CHAPTERS_JSON" "$chapters_meta" \
        "${PENDING_TRIM_START:-0}" "$(media_duration_seconds "$file")" \
        || chapters_meta=""
    else
      chapters_meta=""
    fi
  fi

  [[ -n "$PENDING_SUBTITLE_FILE" ]] && sub_codec="$(subtitle_codec_for "$file")"

  ffmpeg_args=(-hide_banner -loglevel error -nostdin -y)

  [[ -n "$PENDING_TRIM_START" ]] && ffmpeg_args+=(-ss "$PENDING_TRIM_START")

  ffmpeg_args+=(-i "$file")

  if [[ -n "$chapters_meta" ]]; then
    ffmpeg_args+=(-i "$chapters_meta")
    chapters_input=$next_input
    (( next_input++ ))
  fi

  if [[ -n "$PENDING_SUBTITLE_FILE" && -n "$sub_codec" ]]; then
    # Caption cues are timed against the untrimmed source, so the same -ss
    # applies to this input to keep them in sync with the video.
    [[ -n "$PENDING_TRIM_START" ]] && ffmpeg_args+=(-ss "$PENDING_TRIM_START")
    ffmpeg_args+=(-i "$PENDING_SUBTITLE_FILE")
    subs_input=$next_input
    (( next_input++ ))
  fi

  ffmpeg_args+=(
    -map '0:v?'
    -map '0:a?'
    -map '0:s?'
  )

  (( subs_input >= 0 )) && ffmpeg_args+=(-map "${subs_input}:s:0")

  ffmpeg_args+=(-c copy -map_metadata 0)

  (( chapters_input >= 0 )) && ffmpeg_args+=(-map_chapters "$chapters_input")

  if (( subs_input >= 0 )); then
    # Only reached when the file had no subtitle stream of its own, so the
    # incoming track is unambiguously s:0.
    ffmpeg_args+=(
      -c:s "$sub_codec"
      -metadata:s:s:0 "language=$(subtitle_iso3 "$PENDING_SUBTITLE_LANG")"
    )
  fi

  if is_faststart_path "$file"; then
    ffmpeg_args+=(-movflags +faststart+use_metadata_tags)
  fi

  ffmpeg_args+=("${metadata_args[@]}" "$tmp")

  if [[ -t 4 ]]; then
    local pfile pid tail_label
    total="$(media_duration_seconds "$file")"
    if [[ -n "$total" && -n "$PENDING_TRIM_START" ]]; then
      total="$(awk -v t="$total" -v s="$PENDING_TRIM_START" 'BEGIN { d = t - s; if (d < 0) d = 0; print d }')"
    fi

    tail_label="finalizing…"
    is_faststart_path "$file" && tail_label="finalizing (faststart)…"

    errlog="$(mktemp -t media-check-ffmpeg.XXXXXX)" || errlog=""
    pfile="$(mktemp -t media-check-progress.XXXXXX)" || pfile=""
    clear_status
    ffmpeg -progress "${pfile:-/dev/null}" "${ffmpeg_args[@]}" \
      >/dev/null 2>"${errlog:-/dev/null}" &
    pid=$!
    monitor_ffmpeg_progress "$pid" "$pfile" "$total" "${COLUMNS:-80}" "$tail_label"
    wait "$pid"
    rc=$?

    if (( rc != 0 )) && [[ -n "$errlog" ]]; then
      cat -- "$errlog" >&4
    fi
    [[ -n "$errlog" ]] && rm -f -- "$errlog"
    [[ -n "$pfile" ]] && rm -f -- "$pfile"
  else
    ffmpeg "${ffmpeg_args[@]}" || rc=$?
  fi

  if (( rc == 0 )); then
    copy_creation_date "$file" "$tmp" || {
      rm -f -- "$tmp" 2>/dev/null || true
      return 1
    }
    mv -f -- "$tmp" "$file"
    touch_modified_now "$file"
    return 0
  fi

  rm -f -- "$tmp" 2>/dev/null || true
  return 1
}

queue_source_url() {
  local url="$1"

  PENDING_METADATA_ARGS+=(
    -metadata "source_url=$url"
    -metadata "webpage_url=$url"
    -metadata "purl=$url"
    -metadata "comment=$url"
  )
}

# --- yt-dlp toolchain caches -------------------------------------------
# media-audit shares its yt-dlp metadata/thumbnail caches with ytq/ytui
# instead of keeping its own: a hit here saves a network round-trip, and a
# miss gets written back so the other tools benefit from it too.

yt_dlp_json_dir() {
  [[ -n "${YT_DLP_JSON_DIR:-}" ]] || return 1
  print -r -- "${~YT_DLP_JSON_DIR}"
}

yt_dlp_thumb_dir() {
  [[ -n "${YT_DLP_THUMBCACHE_DIR:-}" ]] || return 1
  print -r -- "${~YT_DLP_THUMBCACHE_DIR}"
}

yt_dlp_temp_dir() {
  [[ -n "${YT_DLP_TEMP_DIR:-}" ]] || return 1
  print -r -- "${~YT_DLP_TEMP_DIR}"
}

# Full-directory scan matching webpage_url/original_url, same fields ytq
# matches on. media-audit only ever looks up one URL per file (not a batch),
# so there's no need for ytq's index-building fast path.
find_cached_source_json() {
  local url="$1"
  local dir file
  local url_no_fragment="${url%%#*}"

  dir="$(yt_dlp_json_dir 2>/dev/null)" || return 1
  [[ -d "$dir" ]] || return 1
  command -v jq >/dev/null 2>&1 || return 1

  for file in "$dir"/*.info.json(N.); do
    jq -e --arg u "$url" --arg un "$url_no_fragment" '
      (.webpage_url? == $u) or (.original_url? == $u)
      or (.webpage_url? == $un) or (.original_url? == $un)
    ' "$file" >/dev/null 2>&1 && { print -r -- "$file"; return 0; }
  done

  return 1
}

find_cached_source_thumb() {
  local extractor="$1" id="$2"
  local dir candidate

  [[ -n "$extractor" && -n "$id" ]] || return 1
  dir="$(yt_dlp_thumb_dir 2>/dev/null)" || return 1
  [[ -d "$dir" ]] || return 1

  for candidate in "$dir/${extractor}_${id}".*(N.); do
    [[ -s "$candidate" ]] && { print -r -- "$candidate"; return 0; }
  done

  return 1
}

# Copies a freshly-fetched info.json into the shared cache, named the way
# ytq/yt-dlp itself would (extractor_id.info.json), so later runs of any tool
# in the toolchain get a cache hit for this URL.
cache_source_json() {
  local src="$1" extractor="$2" id="$3"
  local dir dest tmp

  [[ -s "$src" && -n "$extractor" && -n "$id" ]] || return 1
  dir="$(yt_dlp_json_dir 2>/dev/null)" || return 1
  mkdir -p -- "$dir" 2>/dev/null || return 1

  dest="$dir/${extractor}_${id}.info.json"
  tmp="${dest}.$$.tmp"
  cp -- "$src" "$tmp" 2>/dev/null || return 1
  mv -f -- "$tmp" "$dest" 2>/dev/null || { rm -f -- "$tmp"; return 1; }
  print -r -- "$dest"
}

# Best-effort thumbnail download for the shared cache, using an info.json
# already on disk so yt-dlp doesn't have to re-fetch the page.
cache_source_thumb() {
  local json="$1" extractor="$2" id="$3"
  local dir tmp_dir template

  [[ -s "$json" && -n "$extractor" && -n "$id" ]] || return 1
  command -v yt-dlp >/dev/null 2>&1 || return 1
  dir="$(yt_dlp_thumb_dir 2>/dev/null)" || return 1
  mkdir -p -- "$dir" 2>/dev/null || return 1

  tmp_dir="$(mktemp -d -t media-audit-thumb)" || return 1
  template="${extractor}_${id}.%(ext)s"

  yt-dlp --load-info-json "$json" --skip-download --write-thumbnail \
    --no-write-info-json --no-download-archive --no-warnings --no-progress \
    --paths "thumbnail:$tmp_dir" --output "thumbnail:$template" \
    >/dev/null 2>&1

  local f
  for f in "$tmp_dir"/*(N.); do
    [[ -s "$f" ]] && mv -f -- "$f" "$dir/${f:t}"
  done
  rm -rf -- "$tmp_dir"
}

# Reads the canonical "<extractor_key> <id>" key straight out of an info.json
# — matches yt-dlp's own --download-archive line format (ie_key().lower()),
# which is .extractor_key, NOT the .extractor field used for cache filenames.
archive_key_from_json() {
  local json="$1" key

  [[ -s "$json" ]] || return 1
  command -v jq >/dev/null 2>&1 || return 1

  key="$(jq -r '
    ((.extractor_key // .extractor // "") | tostring | ascii_downcase | gsub("[^a-z0-9]"; "")) as $extractor
    | (.id // "" | tostring) as $id
    | select($extractor != "" and $id != "")
    | "\($extractor) \($id)"
  ' "$json" 2>/dev/null)"

  [[ -n "$key" ]] || return 1
  print -r -- "$key"
}

# A file we've just finished auditing is, definitionally, already downloaded
# — record it in the shared archive so ytq stops offering it and other tools
# treat it as done, the same bookkeeping a real yt-dlp download would leave.
add_url_to_archive() {
  local json="$1"
  local archive_file key

  [[ -n "${YT_DLP_ARCHIVE_FILE:-}" ]] || return 0
  key="$(archive_key_from_json "$json" 2>/dev/null)" || return 0
  archive_file="${~YT_DLP_ARCHIVE_FILE}"

  mkdir -p -- "${archive_file:h}" 2>/dev/null
  [[ -f "$archive_file" ]] || : > "$archive_file" 2>/dev/null
  [[ -f "$archive_file" ]] || return 0

  grep -Fxq -- "$key" "$archive_file" 2>/dev/null && return 0
  print -r -- "$key" >> "$archive_file" 2>/dev/null
}

# The URL is now attached to a file on disk, so it no longer belongs in the
# ytq download queue — drop it if it's sitting there.
remove_url_from_batch() {
  local url="$1"
  local batch_file tmp

  [[ -n "$url" && -n "${YT_DLP_BATCH_FILE:-}" ]] || return 0
  batch_file="${~YT_DLP_BATCH_FILE}"
  [[ -s "$batch_file" ]] || return 0
  grep -Fxq -- "$url" "$batch_file" 2>/dev/null || return 0

  tmp="${batch_file}.$$.tmp"
  grep -Fxv -- "$url" "$batch_file" > "$tmp" 2>/dev/null || { rm -f -- "$tmp"; return 1; }
  mv -f -- "$tmp" "$batch_file"
}

# Best-effort archive/batch sync for a URL we already know about but aren't
# fetching metadata for right now (e.g. the file already carries a title
# tag). Uses whatever's already cached; never triggers a network fetch.
sync_yt_dlp_bookkeeping() {
  local url="$1"
  local json

  [[ -n "$url" ]] || return 0

  json="$(find_cached_source_json "$url" 2>/dev/null)" || json=""
  [[ -s "$json" ]] && add_url_to_archive "$json"

  remove_url_from_batch "$url"
}

queue_fetched_metadata() {
  local url="$1"
  local tmp_json errlog title uploader channel webpage_url original_url description upload_date timestamp duration id extractor
  local cached_json source_json cached_hit=false
  local -a temp_args
  integer rc=0

  command -v jq >/dev/null 2>&1 || return 1

  cached_json="$(find_cached_source_json "$url" 2>/dev/null)" || cached_json=""

  if [[ -s "$cached_json" ]]; then
    title="$(jq -r '.title // empty' "$cached_json" 2>/dev/null)"
  fi

  if [[ -n "${title:-}" ]]; then
    say "Using cached metadata for: ${title}"
    tmp_json="$cached_json"
    cached_hit=true
  else
    command -v yt-dlp >/dev/null 2>&1 || return 1

    tmp_json="$(mktemp -t media-check-ytmeta.XXXXXX.json)" || return 1
    errlog="$(mktemp -t media-check-ytmeta-err.XXXXXX)" || errlog=""

    temp_args=()
    local temp_dir
    if temp_dir="$(yt_dlp_temp_dir 2>/dev/null)"; then
      mkdir -p -- "$temp_dir" 2>/dev/null
      temp_args=(--paths "temp:$temp_dir")
    fi

    # --ignore-no-formats-error lets metadata come back even when the video's
    # formats are gated (e.g. faphouse fan/VOD the account can't access); we
    # only want the tags anyway (--skip-download).
    # --no-download-archive is essential: the user's yt-dlp config sets a
    # --download-archive, and every file we audit is already downloaded (hence
    # recorded there). Without this, yt-dlp skips the URL as "already recorded"
    # and emits no JSON, so the metadata fetch silently comes back empty.
    yt-dlp --skip-download --dump-single-json --no-warnings \
      --ignore-no-formats-error --no-download-archive "${temp_args[@]}" "$url" \
      > "$tmp_json" 2>"${errlog:-/dev/null}" &
    spin_until_pid $! "Fetching metadata…" || rc=$?

    title="$(jq -r '.title // empty' "$tmp_json" 2>/dev/null)"

    # Success is "we got a title", not exit status — yt-dlp may exit non-zero
    # over missing formats while still returning perfectly good metadata.
    if [[ -z "$title" ]]; then
      FETCH_ERROR=""
      if [[ -n "$errlog" && -s "$errlog" ]]; then
        # Keep the last real line of yt-dlp's stderr (usually the ERROR: line)
        # so the caller can surface why the fetch failed.
        FETCH_ERROR="$(grep -a . -- "$errlog" | tail -n 1)"
      fi
      [[ -n "$errlog" ]] && rm -f -- "$errlog"
      rm -f -- "$tmp_json"
      return 1
    fi
    [[ -n "$errlog" ]] && rm -f -- "$errlog"
  fi

  uploader="$(jq -r '.uploader // empty' "$tmp_json")"
  channel="$(jq -r '.channel // empty' "$tmp_json")"
  webpage_url="$(jq -r '.webpage_url // empty' "$tmp_json")"
  original_url="$(jq -r '.original_url // empty' "$tmp_json")"
  description="$(jq -r '.description // empty' "$tmp_json")"
  upload_date="$(jq -r '.upload_date // empty' "$tmp_json")"
  timestamp="$(jq -r '.timestamp // empty' "$tmp_json")"
  duration="$(jq -r '.duration // empty' "$tmp_json")"
  id="$(jq -r '.id // empty' "$tmp_json")"
  extractor="$(jq -r '.extractor // empty' "$tmp_json")"

  [[ -n "$webpage_url" ]] || webpage_url="$url"
  [[ -n "$original_url" ]] || original_url="$url"

  # Freshly-fetched metadata: write it into the shared cache so ytq/ytui (and
  # a re-run of this audit) get a hit next time instead of re-fetching.
  source_json="$tmp_json"
  if ! $cached_hit; then
    source_json="$(cache_source_json "$tmp_json" "$extractor" "$id" 2>/dev/null)"
    [[ -s "$source_json" ]] || source_json="$tmp_json"
  fi

  if [[ -z "$(find_cached_source_thumb "$extractor" "$id" 2>/dev/null)" ]]; then
    cache_source_thumb "$source_json" "$extractor" "$id" || true
  fi

  # The file this metadata is for is already downloaded (that's the whole
  # premise of an audit) — record it in the archive and drop it from the
  # queue so ytq doesn't keep offering it.
  add_url_to_archive "$source_json"
  remove_url_from_batch "$url"
  remove_url_from_batch "$webpage_url"
  remove_url_from_batch "$original_url"

  PENDING_METADATA_ARGS+=(
    -metadata "source_url=$webpage_url"
    -metadata "webpage_url=$webpage_url"
    -metadata "original_url=$original_url"
    -metadata "purl=$webpage_url"
    -metadata "comment=$webpage_url"
    -metadata "artist=${uploader:-$channel}"
    -metadata "album_artist=$channel"
    -metadata "description=$description"
    -metadata "yt_dlp_extractor=$extractor"
    -metadata "yt_dlp_id=$id"
    -metadata "yt_dlp_upload_date=$upload_date"
    -metadata "yt_dlp_timestamp=$timestamp"
    -metadata "yt_dlp_duration=$duration"
  )

  [[ -n "$title" ]] && PENDING_METADATA_ARGS+=(-metadata "title=$title")

  # Chapters and captions ride along with this fetch: both are extra ffmpeg
  # inputs, applied by the same rewrite that writes the tags above. Each is
  # best-effort and skipped when the file already has its own.
  if ! $PROBE_HAS_CHAPTERS && jq -e '(.chapters // []) | length > 0' "$tmp_json" >/dev/null 2>&1; then
    local chapters_json
    if chapters_json="$(mktemp -t media-check-chapters.XXXXXX.json)"; then
      PENDING_TMPFILES+=("$chapters_json")
      if jq -c '.chapters' "$tmp_json" > "$chapters_json" 2>/dev/null; then
        PENDING_CHAPTERS_JSON="$chapters_json"
      fi
    fi
  fi

  $PROBE_HAS_SUBS || fetch_subtitle_track "$tmp_json" "$AUDIT_PATH" || true

  PROBE_TITLE="$title"
  PROBE_URL="$webpage_url"

  $cached_hit || rm -f -- "$tmp_json"
  return 0
}

apply_pending_rewrite() {
  local file="$1"
  local item

  (( ${#PENDING_FIXES[@]} > 0 )) || return 0

  # Structure-only repair belongs to mp4doctor. When faststart is the lone
  # pending fix there is nothing to combine, so delegate — same lossless
  # remux, plus its timestamp preservation and verification. Any other mix
  # still takes the combined rewrite below (which emits faststart anyway).
  if [[ "${(j:,:)PENDING_FIXES}" == "faststart" ]]; then
    if mp4doctor --fix --quiet -- "$file" >/dev/null 2>&1 && faststart_state "$file"; then
      CURRENT_CHECK="faststart"
      (( fix_count++ ))
      note_repaired_file
      if [[ -t 4 ]]; then
        render_summary_line
        render_checks_region
      fi
      return 0
    fi
    CURRENT_CHECK="faststart"
    (( fail_count++ ))
    mark_unresolved
    clear_status
    fail "mp4doctor could not repair the container; file left unchanged."
    return 1
  fi

  if rewrite_with_metadata "$file" "${PENDING_METADATA_ARGS[@]}"; then
    if $PENDING_FASTSTART && ! faststart_state "$file"; then
      CURRENT_CHECK="faststart"
      (( fail_count++ ))
      mark_unresolved
      (( fix_count += ${#PENDING_FIXES[@]} - 1 ))
      (( ${#PENDING_FIXES[@]} > 1 )) && note_repaired_file
      clear_status
      fail "FastStart verification failed after rewrite."
      return 1
    fi

    (( fix_count += ${#PENDING_FIXES[@]} ))
    note_repaired_file
    if [[ -t 4 ]]; then
      render_summary_line
      render_checks_region
    fi
    return 0
  fi

  clear_status
  fail "Combined ffmpeg rewrite failed; queued fixes were not applied."
  for item in "${PENDING_FIXES[@]}"; do
    CURRENT_CHECK="$item"
    (( fail_count++ ))
    mark_unresolved
  done
  CURRENT_CHECK=""
  return 1
}

# Prints four lines: full-strip query, its search URL,
# braces-only-strip query, its search URL.
filename_search_query() {
  local name="$1"

  python3 - "$name" <<'PY'
import os
import re
import sys
import urllib.parse

stem = os.path.splitext(sys.argv[1])[0]

def clean(value):
    # Strip any stray bracket/brace/paren characters and hyphens so they can
    # never leak into the search query.
    value = re.sub(r"[][(){}-]", "", value)
    return re.sub(r"\s+", " ", value).strip()

braces_only = clean(re.sub(r"\{[^}]*\}", " ", stem))
full = clean(re.sub(r"\[[^\]]*\]", " ", braces_only))

for query in (full, braces_only):
    print(query)
    print("https://www.google.com/search?q=" + urllib.parse.quote_plus(query))
PY
}

open_in_browser() {
  local url="$1"

  # Over ssh, `open` would launch the browser on this machine's display where
  # nobody is looking. Bounce the URL back to the ssh client so it opens in
  # front of the user; fall through to a local open if that fails.
  if [[ -n "${SSH_CONNECTION:-}" ]]; then
    local ssh_client="${SSH_CONNECTION%% *}"
    if ssh -o BatchMode=yes -o ConnectTimeout=4 -o StrictHostKeyChecking=accept-new \
        "$ssh_client" "open ${(q)url} 2>/dev/null || xdg-open ${(q)url} 2>/dev/null" \
        >/dev/null 2>&1; then
      return 0
    fi
    warn "Could not open on ssh client ${ssh_client}; opening here instead."
  fi

  if command -v open >/dev/null 2>&1; then
    open "$url" >/dev/null 2>&1
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url" >/dev/null 2>&1
  else
    warn "No browser opener (open/xdg-open) found."
    return 1
  fi
}

check_source_url() {
  local file="$1"
  local url action
  local -a search_info options actions

  $CHECK_URL || return 0

  [[ -n "$PROBE_URL" ]] && return 0

  (( FILE_ISSUES++ ))
  issue_screen "source-url" "$file"

  options=()
  actions=()

  if command -v python3 >/dev/null 2>&1; then
    search_info=("${(@f)$(filename_search_query "${file:t}")}")
    if [[ -n "${search_info[1]-}" ]]; then
      options+=("search browser: ${search_info[1]}")
      actions+=("open:${search_info[2]}")
    fi
    if [[ -n "${search_info[3]-}" && "${search_info[3]-}" != "${search_info[1]-}" ]]; then
      options+=("search browser: ${search_info[3]}")
      actions+=("open:${search_info[4]}")
    fi
  fi

  options+=("enter URL manually" "skip this file")
  actions+=("manual" "skip")

  if ! prompt_select "${options[@]}"; then
    action="skip"
  else
    action="${actions[$SELECT_INDEX]}"
  fi

  case "$action" in
    open:*)
      open_in_browser "${action#open:}" || true
      ;;
    manual)
      ;;
    skip)
      warn "Skipped source URL."
      (( skip_count++ ))
      mark_unresolved
      return 1
      ;;
  esac

  say ""

  if ! prompt_valid_url; then
    warn "Skipped source URL."
    (( skip_count++ ))
    mark_unresolved
    return 1
  fi
  url="$PROMPT_URL"

  queue_source_url "$url"
  PENDING_FIXES+=("source-url")
  PROBE_URL="$url"
  return 0
}

check_title_metadata() {
  local file="$1"
  local url

  $CHECK_METADATA || return 0

  if [[ -n "$PROBE_TITLE" ]]; then
    sync_yt_dlp_bookkeeping "$PROBE_URL"
    return 0
  fi

  (( FILE_ISSUES++ ))
  issue_screen "metadata" "$file"

  if [[ -z "$PROBE_URL" ]]; then
    warn "No embedded source URL is available, so yt-dlp metadata cannot be fetched."
    (( fail_count++ ))
    mark_unresolved
    return 1
  fi

  # A source URL is present, so try to pull metadata automatically. Only fall
  # back to a prompt when the fetch fails.
  url="$PROBE_URL"

  while true; do
    if queue_fetched_metadata "$url"; then
      MENU_NOTE=""
      PENDING_FIXES+=("metadata")
      return 0
    fi

    # Surface yt-dlp's own error under the check so a config problem (e.g. a
    # locked cookies-from-browser database) is visible instead of a silent fail.
    MENU_NOTE="${FETCH_ERROR:-yt-dlp could not fetch metadata for that URL.}"

    if ! prompt_select "try a different URL" "skip metadata" || (( SELECT_INDEX == 2 )); then
      MENU_NOTE=""
      warn "Skipped metadata fetch."
      (( skip_count++ ))
      mark_unresolved
      return 1
    fi

    if ! prompt_valid_url; then
      MENU_NOTE=""
      warn "Skipped metadata fetch."
      (( skip_count++ ))
      mark_unresolved
      return 1
    fi
    url="$PROMPT_URL"
  done
}

check_canonical_name() {
  local file="$1"
  local media_rename_cmd target rc

  $CHECK_RENAME || return 0
  is_video_path "$file" || return 0
  command -v python3 >/dev/null 2>&1 || return 0
  media_rename_cmd="$(command -v media-rename 2>/dev/null)" || return 0

  target="$(
    python3 - "$MEDIA_RENAME_TIMEOUT" "$media_rename_cmd" "$file" <<'PY'
import os
import signal
import subprocess
import sys
import time

timeout = float(sys.argv[1])
cmd = [sys.argv[2], "--print-target", sys.argv[3]]

proc = subprocess.Popen(
    cmd,
    stdout=subprocess.PIPE,
    stderr=subprocess.DEVNULL,
    text=True,
    start_new_session=True,
)

try:
    stdout, _ = proc.communicate(timeout=timeout)
except subprocess.TimeoutExpired:
    try:
        os.killpg(proc.pid, signal.SIGTERM)
    except ProcessLookupError:
        pass

    deadline = time.monotonic() + 2
    while proc.poll() is None and time.monotonic() < deadline:
        time.sleep(0.05)

    if proc.poll() is None:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass

    proc.wait()
    sys.exit(124)

if proc.returncode != 0:
    sys.exit(proc.returncode)

lines = [line for line in stdout.splitlines() if line]
if lines:
    print(lines[-1])
PY
  )"
  rc=$?

  if (( rc == 124 )); then
    (( FILE_ISSUES++ ))
    issue_screen "filename" "$file"
    say "filename: media-rename timed out"
    warn "Skipped canonical rename check after ${MEDIA_RENAME_TIMEOUT}s."
    (( fail_count++ ))
    mark_unresolved
    return 1
  elif (( rc != 0 )); then
    return 0
  fi

  [[ -n "$target" ]] || return 0

  prompt_rename_path "$file" "$target" "filename"
}

check_filename_length() {
  local file="$1"
  local name="${file:t}"
  local bytes target_name target

  $CHECK_LENGTH || return 0
  command -v python3 >/dev/null 2>&1 || return 0

  bytes="$(filename_byte_length "$name")"
  [[ "$bytes" == <-> ]] || return 0
  (( bytes <= MAX_FILENAME_BYTES )) && return 0

  target_name="$(shorten_filename "$name" "$MAX_FILENAME_BYTES")"
  [[ -n "$target_name" && "$target_name" != "$name" ]] || {
    (( FILE_ISSUES++ ))
    issue_screen "filename" "$file"
    say "filename: too long (${bytes} bytes)"
    warn "Filename is ${bytes} bytes; could not build a safe shorter proposal."
    (( fail_count++ ))
    mark_unresolved
    return 1
  }

  target="${file:h}/${target_name}"
  prompt_rename_path "$file" "$target" "filename"
}

check_filename_checks() {
  local rc=0

  check_utf8_filename "$AUDIT_PATH" || rc=1
  check_canonical_name "$AUDIT_PATH" || rc=1
  check_filename_length "$AUDIT_PATH" || rc=1

  return "$rc"
}

audit_file() {
  local file="$1"
  integer FILE_ISSUES=0
  integer FILE_UNRESOLVED=0
  local FILE_REPAIRED=false

  [[ -n "$file" ]] || return 0
  file="$(normalize_audit_path "$file")"

  (( processed_count++ ))
  AUDIT_PATH="$file"
  CURRENT_FILE="$AUDIT_PATH"
  CURRENT_CHECK=""
  PENDING_METADATA_ARGS=()
  PENDING_FIXES=()
  PENDING_FASTSTART=false
  PENDING_TRIM_START=""
  MENU_NOTE=""
  cleanup_pending_media
  reset_file_checks
  set_current_thumb "$AUDIT_PATH"
  build_file_stats "$AUDIT_PATH"

  if [[ -t 4 ]]; then
    redraw_screen
  fi

  if [[ ! -f "$AUDIT_PATH" ]]; then
    (( FILE_ISSUES++ ))
    issue_screen "file" "$AUDIT_PATH"
    say "file: not found"
    (( fail_count++ ))
    mark_unresolved
    (( issue_file_count++ ))
    return 1
  fi

  if is_video_path "$AUDIT_PATH"; then
    run_check "black-frames" check_black_frames "$AUDIT_PATH"

    if $CHECK_URL || $CHECK_METADATA; then
      if probe_media_tags "$AUDIT_PATH"; then
        run_check "source-url" check_source_url "$AUDIT_PATH"
        run_check "metadata" check_title_metadata "$AUDIT_PATH"
      else
        (( FILE_ISSUES++ ))
        issue_screen "metadata" "$AUDIT_PATH"
        say "metadata: probe failed"
        warn "Could not read format tags with ffprobe/jq."
        (( fail_count++ ))
        mark_unresolved
      fi
    fi
  fi

  if is_video_path "$AUDIT_PATH"; then
    run_check "faststart" check_faststart "$AUDIT_PATH"
  fi

  apply_pending_rewrite "$AUDIT_PATH"
  cleanup_pending_media

  run_check "filename" check_filename_checks

  if (( FILE_UNRESOLVED == 0 )); then
    (( clean_count++ ))
  else
    (( issue_file_count++ ))
  fi
}

parse_args() {
  while (( $# > 0 )); do
    case "$1" in
      --bypass-check-utf8)
        CHECK_UTF8=false
        shift
        ;;
      --bypass-check-faststart)
        CHECK_FASTSTART=false
        shift
        ;;
      --bypass-check-blackframes|--bypass-check-black-frames)
        CHECK_BLACKFRAMES=false
        shift
        ;;
      --bypass-check-url)
        CHECK_URL=false
        shift
        ;;
      --bypass-check-metadata)
        CHECK_METADATA=false
        shift
        ;;
      --bypass-check-rename)
        CHECK_RENAME=false
        shift
        ;;
      --bypass-check-length)
        CHECK_LENGTH=false
        shift
        ;;
      --no-thumbnail|--no-thumb)
        SHOW_THUMBNAIL=false
        shift
        ;;
      --bypass-check-filename)
        CHECK_UTF8=false
        CHECK_RENAME=false
        CHECK_LENGTH=false
        shift
        ;;
      --max-filename-bytes)
        (( $# >= 2 )) || {
          fail "Missing value for --max-filename-bytes"
          exit 1
        }
        MAX_FILENAME_BYTES="$2"
        [[ "$MAX_FILENAME_BYTES" == <-> ]] || {
          fail "--max-filename-bytes must be an integer"
          exit 1
        }
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      --)
        shift
        INPUT_FILES+=("$@")
        break
        ;;
      -*)
        usage
        fail "Unknown option: $1"
        exit 1
        ;;
      *)
        INPUT_FILES+=("$1")
        shift
        ;;
    esac
  done
}

process_fd_media() {
  command -v fd-media >/dev/null 2>&1 || {
    fail "fd-media not found."
    exit 1
  }

  while IFS= read -r -d $'\0' file; do
    audit_file "$file"
  done < <(fd-media --print0)
}

audit_dir() {
  local dir="$1"

  command -v fd-media >/dev/null 2>&1 || {
    fail "fd-media not found; cannot recurse ${dir}"
    exit 1
  }

  while IFS= read -r -d $'\0' file; do
    audit_file "$file"
  done < <(fd-media --print0 . "$dir")
}

audit_arg() {
  local arg="$1"

  if [[ -d "$arg" ]]; then
    audit_dir "$arg"
  else
    audit_file "$arg"
  fi
}

process_stdin_or_fd_media() {
  local line
  local saw_stdin=false

  if [[ ! -t 0 ]]; then
    while IFS= read -r line; do
      [[ -n "$line" ]] || continue
      saw_stdin=true
      audit_arg "$line"
    done
  fi

  $saw_stdin && return 0
  process_fd_media
}

main() {
  local file

  parse_args "$@"
  build_enabled_checks
  detect_thumb_backend
  reset_file_checks

  # Ctrl-C aborts the whole run, even outside an interactive prompt.
  trap finish_interrupt INT

  if (( ${#INPUT_FILES[@]} > 0 )); then
    total_count="${#INPUT_FILES[@]}"
  fi

  draw_header

  if (( ${#INPUT_FILES[@]} > 0 )); then
    for file in "${INPUT_FILES[@]}"; do
      audit_arg "$file"
    done
  else
    process_stdin_or_fd_media
  fi

  clear_status
  clear_thumb
  say ""
  say "%B%F{green}DONE%f%b"
  say "CHECKED: ${processed_count}  CLEAN: ${clean_count}  ATTENTION: ${issue_file_count}  FIXES: ${fix_count}  SKIPPED: ${skip_count}  FAILED: ${fail_count}"
}

main "$@"
