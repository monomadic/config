#!/usr/bin/env zsh
# Purpose: low-level Topaz encode runner and shared execution engine.
# Use this directly for scripted/repeatable jobs, explicit filters, resume,
# previews, or copied commands. For an interactive preset picker, prefer
# topaz-pick (mpv-style choices) or topaz-workflow (visual A/B previews).
set -euo pipefail

script_name="${0:t}"

usage() {
  cat <<EOF
usage:
  $script_name [--preview [seconds]] [--trash-originals] [--resume] [--copy-cmd] [--nice[=N]] [--background] [--log] [--preset_name name --filter_complex filter] [--output_ext ext] [--video_args args] [--metadata key=value] -- file1 [file2 ...]
  $script_name file1 [file2 ...]

With --preset_name and --filter_complex, runs the supplied Topaz filter directly.
Without them, opens the interactive preset picker.

With --log (aka --headless), prints a plain timestamped transcript on stdout:
no ANSI colour, no in-place progress bar (a progress line every 5% instead),
no prompts, no mpv/kitty windows, and failures reported on stdout with the rest
of the run. Partial outputs resume automatically, and only a failed encode
makes the exit status non-zero. This turns on by itself when stdout is not a
terminal or NO_COLOR / CLICOLOR=0 / TERM=dumb are set — which is exactly what
job-runner does — so a NAME.job script needs nothing but the normal command.
--no-log forces the interactive presentation back on.

With --nice, runs the encoder through nice(1) at niceness N (default 19) so the
machine stays responsive during long jobs. --background additionally applies
taskpolicy -b (PRIO_DARWIN_BG): throttled disk I/O and, on Apple Silicon, the
encoder is confined to efficiency cores — much gentler, but a lot slower.
Both are inherited by the encoder's children and survive the pause/resume keys.

With --preview, encodes only the first seconds of each input with the selected
preset. The preview length defaults to 1 second.

During an interactive encode, press p to suspend the live encoder and p again
to continue it from the exact same process state. Press o to open the output so
far in mpv, and q to stop the encode. This live pause is separate from --resume,
which recovers a partial output.

If the output file already exists but is shorter than expected (an interrupted
encode), $script_name offers to resume it: the tail is re-encoded from the last
keyframe of the partial and losslessly concatenated onto it. --resume skips the
prompt and resumes automatically.

Every encode embeds its job (source path, preset, filter, video args) as
metadata tags in the output, and fragmented outputs keep those tags even when
an encode crashes. Passing such a file as the only argument, with no preset
flags, reconstructs the job from the file itself:
  $script_name --resume 'partial [Topaz - ...].mp4'

With --copy-cmd, prints the exact $script_name command for each input (and copies
it to the clipboard) instead of encoding — paste it later to rerun or resume.

After each successful encode, copies source metadata tags and filesystem creation
date to the Topaz output. With --trash-originals, moves successfully encoded
source files to Trash.

Uses the first installed Topaz bundle by default:
  /Applications/Topaz Video.app
  /Applications/Topaz Video AI.app
Set TOPAZ_APP to override.
EOF
}

(( $# == 0 )) && {
  usage >&2
  exit 1
}

case "${1:-}" in
  -h|--help|help)
    usage
    exit 0
    ;;
esac

TOPAZ_APP_LIB="${0:A:h}/lib/topaz-app.zsh"
[[ -r "$TOPAZ_APP_LIB" ]] || {
  print -u2 "Topaz app resolver not found: $TOPAZ_APP_LIB"
  exit 1
}
source "$TOPAZ_APP_LIB"

TOPAZ_APP="$(topaz_resolve_app)" || exit 1
TOPAZ_MACOS_DIR="$(topaz_resolve_macos_dir "$TOPAZ_APP")"
TOPAZ_FFMPEG="$(topaz_resolve_ffmpeg "$TOPAZ_APP")"
TOPAZ_FFPROBE="$TOPAZ_MACOS_DIR/ffprobe"
if [[ ! -x "$TOPAZ_FFPROBE" ]] && command -v ffprobe >/dev/null 2>&1; then
  TOPAZ_FFPROBE="$(command -v ffprobe)"
fi
TOPAZ_MODELS_DIR="$(topaz_resolve_models_dir "$TOPAZ_APP")"
LOG_DIR="${HOME}/Library/Logs/topaz-batch"
PRESET_CATALOG="${0:A:h}/lib/topaz-preset-catalog.zsh"
TOPAZ_PREVIEW_FRAME_KITTY="${0:A:h}/topaz-preview-frame-kitty"

[[ -r "$PRESET_CATALOG" ]] || {
  print -u2 "Topaz preset catalog not found: $PRESET_CATALOG"
  exit 1
}

source "$PRESET_CATALOG"

topaz_escape_prompt() {
  print -r -- "${1//\%/%%}"
}

topaz_file_preset_label() {
  emulate -L zsh
  local label="$1"

  label="${label//\// - }"
  label="${label//->/to}"
  [[ "$label" != *" "* ]] && label="${label//-/ }"
  label="${label//  / }"
  label="${label## }"
  label="${label%% }"

  print -r -- "$label"
}

topaz_safe_log_label() {
  emulate -L zsh
  local label="${1:l}"

  label="${label// /-}"
  label="${label//[^a-z0-9._-]/}"
  label="${label//---/-}"
  label="${label//--/-}"
  label="${label#-}"
  label="${label%-}"

  print -r -- "$label"
}

# The mpv workflow builds preset names as "Enhance + Res + Interp + Output";
# only the first (enhancement) part belongs in a filename tag.
topaz_short_preset_label() {
  emulate -L zsh
  print -r -- "${1%% + *}"
}

# Drop every trailing "[...]" group from a filename stem, so an existing tag
# ("[1080p 60fps h264 ...]", an old "[Topaz - ...]") is replaced by the new
# Topaz tag instead of stacking up.
topaz_strip_trailing_brackets() {
  emulate -L zsh
  setopt localoptions extendedglob
  local stem="$1" prev=""

  while [[ "$stem" != "$prev" ]]; do
    prev="$stem"
    stem="${stem%%[[:space:]]##}"
    [[ "$stem" == *\[*\] ]] && stem="${stem%\[*\]}"
  done
  stem="${stem%%[[:space:]]##}"

  if [[ -z "${stem//[[:space:]]/}" ]]; then
    print -r -- "$1"
  else
    print -r -- "$stem"
  fi
}

# "<dir>/<stem><suffix>", with stem cut down so the name stays comfortably
# under the 255-byte filename limit (headroom for " [resume tail]" sidecars).
topaz_fit_filename() {
  emulate -L zsh
  setopt localoptions extendedglob
  local dir="$1" stem="$2" suffix="$3"
  integer max_bytes=200 bytes

  bytes=$(print -rn -- "${stem}${suffix}" | wc -c)
  while (( bytes > max_bytes && ${#stem} > 1 )); do
    stem="${stem[1,-2]}"
    bytes=$(print -rn -- "${stem}${suffix}" | wc -c)
  done
  stem="${stem%%[[:space:]]##}"
  print -r -- "${dir}/${stem}${suffix}"
}

topaz_open_log_tail() {
  emulate -L zsh
  local log_file="$1"
  local title="topaz log: ${log_file:t}"
  local -a kitty_cmd

  [[ "$log_mode" == true ]] && return 0
  command -v kitty >/dev/null 2>&1 || return 0
  [[ -n "${KITTY_WINDOW_ID:-}" || -n "${KITTY_LISTEN_ON:-}" ]] || return 0

  kitty_cmd=(kitty @)
  [[ -z "${KITTY_LISTEN_ON:-}" ]] && kitty_cmd+=(--to "unix:/tmp/kitty-$USER")

  "${kitty_cmd[@]}" launch \
    --type=window \
    --location=hsplit \
    --bias=30 \
    --cwd=current \
    --keep-focus \
    --title "$title" \
    zsh -lc 'print -P "%F{white}tailing:%f %F{blue}${1//\%/%%}%f\n"; tail -n +1 -F "$1"' \
    topaz-tail "$log_file" >/dev/null 2>&1 || true
}

have() {
  command -v "$1" >/dev/null 2>&1
}

# --- output modes ----------------------------------------------------------
# Interactive runs get ANSI colour, an in-place progress bar and prompts.
# Log mode emits plain timestamped lines on stdout only — no escape codes, no
# carriage-return redraws, no prompts — so a headless run reads as one
# transcript. It turns on with --log, or automatically when the environment
# says nobody is watching: stdout is not a tty, or NO_COLOR / CLICOLOR=0 /
# TERM=dumb are set. job-runner sets all of those, so a .job script can just
# call topaz-encode normally.
log_mode=false
log_mode_explicit=false

# Strip zsh prompt escapes (%F{..}, %B, %f ...) so the same message strings can
# be printed with or without colour.
topaz_plain() {
  emulate -L zsh
  setopt localoptions extendedglob
  local s="$1" sentinel=$'\x01'
  # Patterns live in variables and are applied with ${~var}: a literal { } or [ ]
  # written inline in a ${//} pattern is not parsed as a glob.
  local color_pat='%[FK]{[^}]##}'
  local attr_pat='%[fkbBuU]'

  # Literal %% (escaped text, e.g. a filename with a % in it) is parked first
  # so its % can't be read as the start of an escape sequence.
  s="${s//\%\%/$sentinel}"
  s="${s//${~color_pat}/}"
  s="${s//${~attr_pat}/}"
  s="${s//$sentinel/%}"

  print -r -- "$s"
}

topaz_log_stamp() {
  [[ "$log_mode" == true ]] && print -rn -- "[$(date '+%F %T')] "
}

say() {
  if [[ "$log_mode" == true ]]; then
    print -r -- "$(topaz_log_stamp)$(topaz_plain "$1")"
  else
    print -P -- "$1"
  fi
}

# Failures. In log mode they go to stdout with the rest of the transcript
# (job-runner already reports failure from the exit status, and a split stream
# would interleave badly); headline lines are tagged ERROR: so they grep out,
# while indented continuation lines are left alone.
say_err() {
  local plain
  if [[ "$log_mode" == true ]]; then
    plain="$(topaz_plain "$1")"
    [[ "$plain" == [[:space:]]* ]] || plain="ERROR: $plain"
    print -r -- "$(topaz_log_stamp)$plain"
  else
    print -P -u2 -- "$1"
  fi
}

# Spacer between blocks; pure noise in a log.
say_blank() {
  [[ "$log_mode" == true ]] || print
}

warn() {
  if [[ "$log_mode" == true ]]; then
    print -r -- "$(topaz_log_stamp)WARN: $*"
  else
    print -r -u2 -- "warning: $*"
  fi
}

info() {
  if [[ "$log_mode" == true ]]; then
    print -r -- "$(topaz_log_stamp)$*"
  else
    print -r -- "$*"
  fi
}

is_number() {
  [[ "${1:-}" == <-> || "${1:-}" == <->.<-> ]]
}

number_gt_zero() {
  awk -v v="$1" 'BEGIN { exit !(v > 0) }'
}

format_frame_rate() {
  local rate="${1:-}"

  [[ -n "$rate" && "$rate" != "0/0" ]] || {
    print -r -- "unknown"
    return
  }

  awk -v rate="$rate" '
    BEGIN {
      split(rate, parts, "/")
      if (parts[2] == "" || parts[2] == 0) {
        value = parts[1]
      } else {
        value = parts[1] / parts[2]
      }

      if (value == int(value)) {
        printf "%dfps\n", value
      } else {
        printf "%.2ffps\n", value
      }
    }
  '
}

media_orientation() {
  local width="${1:-}"
  local height="${2:-}"

  [[ "$width" == <-> && "$height" == <-> ]] || {
    print -r -- "unknown"
    return
  }

  if (( width > height )); then
    print -r -- "landscape"
  elif (( height > width )); then
    print -r -- "portrait"
  else
    print -r -- "square"
  fi
}

media_summary_for_file() {
  local input_file="$1"
  local width="" height="" codec="" avg_frame_rate="" r_frame_rate=""
  local key value line resolution orientation framerate

  if [[ ! -x "$TOPAZ_FFPROBE" ]]; then
    print -r -- "${input_file:t}: media info unavailable"
    return
  fi

  while IFS= read -r line; do
    key="${line%%=*}"
    value="${line#*=}"
    case "$key" in
      width) width="$value" ;;
      height) height="$value" ;;
      codec_name) codec="$value" ;;
      avg_frame_rate) avg_frame_rate="$value" ;;
      r_frame_rate) r_frame_rate="$value" ;;
    esac
  done < <(
    "$TOPAZ_FFPROBE" \
      -v error \
      -select_streams v:0 \
      -show_entries stream=width,height,codec_name,avg_frame_rate,r_frame_rate \
      -of default=noprint_wrappers=1 \
      -- "$input_file" 2>/dev/null
  )

  if [[ -n "$width" && -n "$height" ]]; then
    resolution="${width}x${height}"
    orientation="$(media_orientation "$width" "$height")"
  else
    resolution="unknown"
    orientation="unknown"
  fi

  framerate="$(format_frame_rate "${avg_frame_rate:-$r_frame_rate}")"
  print -r -- "${resolution} (${orientation}), ${framerate}, ${codec:-unknown}"
}

media_duration_seconds() {
  emulate -L zsh
  local input_file="$1" dur=""

  [[ -x "$TOPAZ_FFPROBE" ]] || { print -r -- ""; return; }

  dur="$(
    "$TOPAZ_FFPROBE" -v error \
      -show_entries format=duration \
      -of default=noprint_wrappers=1:nokey=1 \
      -- "$input_file" 2>/dev/null
  )"

  if [[ "$dur" == <-> || "$dur" == <->.<-> ]]; then
    print -r -- "$dur"
  else
    print -r -- ""
  fi
}

topaz_format_clock() {
  emulate -L zsh
  awk -v s="${1:-0}" 'BEGIN {
    if (s < 0) s = 0
    h = int(s / 3600); s -= h * 3600
    m = int(s / 60);   sec = int(s - m * 60)
    if (h > 0) printf "%d:%02d:%02d", h, m, sec
    else printf "%d:%02d", m, sec
  }'
}

# Duration multiplier a slow-motion interpolation applies to the output
# (tvai_fi slowmo=N stretches the timeline by N).
topaz_slowmo_factor() {
  emulate -L zsh
  local filter="$1"

  if [[ "$filter" == *tvai_fi=* && "$filter" =~ 'slowmo=([0-9]+(\.[0-9]+)?)' ]]; then
    print -r -- "${match[1]}"
  else
    print -r -- "1"
  fi
}

# Timestamp (seconds) of the last video keyframe in `file` at or before `max_t`,
# searched within the final ~60s window. Empty output on failure.
topaz_last_keyframe_before() {
  emulate -L zsh
  local file="$1" max_t="$2" start

  [[ -x "$TOPAZ_FFPROBE" ]] || { print -r -- ""; return; }

  start="$(awk -v m="$max_t" 'BEGIN { s = m - 60; if (s < 0) s = 0; print s }')"
  "$TOPAZ_FFPROBE" -v error -select_streams v:0 \
    -read_intervals "${start}%" \
    -show_entries packet=pts_time,flags -of csv=p=0 -- "$file" 2>/dev/null |
    awk -F, -v max="$max_t" '
      $2 ~ /K/ && $1 != "N/A" && $1 + 0 <= max { k = $1 }
      END { if (k != "") print k }
    '
}

# The exact wrapper invocation that reproduces the current encode for one input.
# Printing this (rather than the raw ffmpeg command) is what makes resume easy:
# rerunning it detects the partial output and offers to continue.
topaz_wrapper_cmd() {
  emulate -L zsh
  local input_file="$1"
  local -a cmd

  cmd=("$script_name")
  [[ "$preview_mode" == true ]] && cmd+=(--preview "$preview_seconds")
  [[ "$trash_originals" == true ]] && cmd+=(--trash-originals)
  [[ -n "$nice_level" ]] && cmd+=("--nice=$nice_level")
  [[ "$background_mode" == true ]] && cmd+=(--background)
  cmd+=(--preset_name "$preset_name" --filter_complex "$preset_value")
  [[ -n "$preset_output_ext" ]] && cmd+=(--output_ext "$preset_output_ext")
  [[ -n "$preset_video_args" ]] && cmd+=(--video_args "$preset_video_args")
  [[ -n "$preset_metadata" ]] && cmd+=(--metadata "$preset_metadata")
  # Reference the file by bare name: the printed/saved command is meant to run
  # from the directory the video lives in, so it stays valid if the file moves.
  cmd+=(-- "${input_file:t}")

  print -r -- "${(j: :)${(@q-)cmd}}"
}

# Escape a path for an ffmpeg concat-demuxer list entry (single-quoted).
topaz_concat_escape() {
  emulate -L zsh
  local p="$1"
  print -r -- "${p//\'/\'\\\'\'}"
}

topaz_output_summary_line() {
  emulate -L zsh
  local file="$1"
  local width="" height="" codec="" avg="" rfr="" line key value
  local size_bytes res fps size_str

  if [[ -x "$TOPAZ_FFPROBE" ]]; then
    while IFS= read -r line; do
      key="${line%%=*}"
      value="${line#*=}"
      case "$key" in
        width) width="$value" ;;
        height) height="$value" ;;
        codec_name) codec="$value" ;;
        avg_frame_rate) avg="$value" ;;
        r_frame_rate) rfr="$value" ;;
      esac
    done < <(
      "$TOPAZ_FFPROBE" -v error -select_streams v:0 \
        -show_entries stream=width,height,codec_name,avg_frame_rate,r_frame_rate \
        -of default=noprint_wrappers=1 -- "$file" 2>/dev/null
    )
  fi

  if [[ "$width" == <-> && "$height" == <-> ]]; then
    res="${width}x${height}"
  else
    res="unknown"
  fi
  fps="$(format_frame_rate "${avg:-$rfr}")"

  size_bytes="$(stat -f '%z' -- "$file" 2>/dev/null)"
  if [[ "$size_bytes" == <-> ]]; then
    size_str="$(awk -v b="$size_bytes" 'BEGIN {
      b = b + 0
      if (b < 1024) { printf "%d B", b; exit }
      split("KB MB GB TB PB", u, " ")
      s = b; i = 0
      do { s /= 1024; i++ } while (s >= 1024 && i < 5)
      printf "%.1f %s", s, u[i]
    }')"
  else
    size_str="unknown size"
  fi

  print -r -- "${size_str}, ${res}, ${fps}, ${codec:-unknown}"
}

# Draw a single in-place progress bar frame from ffmpeg -progress values.
topaz_draw_progress_bar() {
  emulate -L zsh
  local total="$1" out_time="$2" speed="$3" state="${4:-}" cols="${5:-80}"

  awk -v total="$total" -v t="$out_time" -v speed="$speed" -v state="$state" -v cols="$cols" '
    function clk(s,   h, m, sec) {
      if (s < 0) s = 0
      h = int(s / 3600); s -= h * 3600
      m = int(s / 60);   sec = int(s - m * 60)
      return (h > 0) ? sprintf("%d:%02d:%02d", h, m, sec) : sprintf("%02d:%02d", m, sec)
    }
    BEGIN {
      esc = sprintf("%c", 27)
      cyan = esc "[1;36m"; dim = esc "[2m"; green = esc "[1;32m"
      yellow = esc "[1;33m"; reset = esc "[0m"; clr = esc "[K"

      n = split(t, p, ":")
      elapsed = (n == 3) ? p[1] * 3600 + p[2] * 60 + p[3] : t + 0
      sp = speed; gsub(/[^0-9.]/, "", sp); sp = sp + 0
      total = total + 0
      if (state == "end" && total > 0) elapsed = total

      if (total > 0) {
        pct = elapsed / total * 100
        if (pct < 0) pct = 0; if (pct > 100) pct = 100
        eta = (sp > 0 && total > elapsed) ? (total - elapsed) / sp : 0
        barw = cols - 44
        if (barw < 10) barw = 10; if (barw > 48) barw = 48
        filled = int(pct / 100 * barw + 0.5)
        if (filled > barw) filled = barw; if (filled < 0) filled = 0
        fill = ""; for (i = 0; i < filled; i++) fill = fill "█"
        emp = "";  for (i = 0; i < barw - filled; i++) emp = emp "░"
        printf "\r  %s%3d%%%s  %s%s%s%s%s  %s / %s  %sETA %s%s  %s%.2fx%s%s",
          cyan, pct, reset,
          green, fill, dim, emp, reset,
          clk(elapsed), clk(total),
          dim, clk(eta), reset,
          yellow, sp, reset, clr
      } else {
        sps = (sp > 0) ? sprintf("  %s%.2fx%s", yellow, sp, reset) : ""
        printf "\r  %s⏳ encoding…%s  %s%s elapsed%s%s%s",
          cyan, reset, dim, clk(elapsed), reset, sps, clr
      }
    }
  '
}

# Seconds from an ffmpeg out_time ("00:01:23.456789"); empty if unparseable.
topaz_clock_seconds() {
  emulate -L zsh
  local t="${1:-}" rest h m s

  [[ "$t" == *:*:* ]] || {
    [[ "$t" == <-> || "$t" == <->.<-> ]] && print -r -- "${t%%.*}"
    return
  }

  h="${t%%:*}"; rest="${t#*:}"
  m="${rest%%:*}"; s="${rest##*:}"; s="${s%%.*}"
  [[ "$h" == <-> && "$m" == <-> && "$s" == <-> ]] || return
  print -r -- $(( h * 3600 + m * 60 + s ))
}

# Consume ffmpeg -progress key=value stream on stdin, redrawing the bar.
# In log mode there is nothing to redraw, so emit one plain line per 5% of
# progress (plus a final line) — enough to see a long encode is alive when
# tailing NAME.job.log, few enough not to bury the rest of the transcript.
topaz_render_progress() {
  emulate -L zsh
  local total="${1:-}" cols="${2:-80}" plain="${3:-false}"
  local line key value out_time="" speed="" state="" drew=false
  local elapsed pct eta
  integer bucket last_bucket=-1

  while IFS= read -r line; do
    key="${line%%=*}"
    value="${line#*=}"
    case "$key" in
      out_time) out_time="$value" ;;
      speed) speed="${value//[[:space:]]/}" ;;   # ffmpeg pads it to " 5.6x"
      progress)
        state="$value"
        if [[ "$plain" != true ]]; then
          topaz_draw_progress_bar "$total" "$out_time" "$speed" "$state" "$cols"
          drew=true
          continue
        fi

        elapsed="$(topaz_clock_seconds "$out_time")"
        [[ -n "$elapsed" ]] || continue
        # No clamping to 100% on the final event: an interrupted encode should
        # leave its true last position in the log, not a fake completion.
        if [[ "$total" == <-> || "$total" == <->.<-> ]] && (( total > 0 )); then
          pct=$(( elapsed * 100 / ${total%%.*} ))
          (( pct > 100 )) && pct=100
          bucket=$(( pct / 5 ))
          [[ "$state" == end ]] || (( bucket != last_bucket )) || continue
          last_bucket=$bucket
          eta="$(awk -v t="$total" -v e="$elapsed" -v s="${speed//[^0-9.]/}" \
            'BEGIN { s = s + 0; print (s > 0 && t > e) ? (t - e) / s : 0 }')"
          info "  progress: ${pct}% ($(topaz_format_clock "$elapsed") / $(topaz_format_clock "$total")) at ${speed:-?}, eta $(topaz_format_clock "$eta")"
        else
          bucket=$(( elapsed / 60 ))
          [[ "$state" == end ]] || (( bucket != last_bucket )) || continue
          last_bucket=$bucket
          info "  progress: $(topaz_format_clock "$elapsed") encoded at ${speed:-?}"
        fi
        ;;
    esac
  done

  [[ "$drew" == true ]] && print -- ""
  return 0
}

# Run an encoder while retaining stdin for single-key controls. The encoder and
# progress renderer run separately so p can SIGSTOP/SIGCONT the live process
# without turning the pause into a partial-file resume.
topaz_run_with_controls() {
  emulate -L zsh
  setopt localoptions localtraps
  unsetopt bg_nice

  local total="${1:-}" cols="${2:-80}" log_file="$3" work_dir="$4" output_preview="$5"
  local control_dir progress_fifo encoder_pid progress_pid
  local key="" caught_signal="" encoder_status=0 progress_status=0
  local stop_wait_status=$((127 + ${signals[(i)STOP]}))
  local paused=false interactive=false stop_requested=false
  shift 5

  [[ -t 0 && -t 1 && "$log_mode" != true ]] && interactive=true

  control_dir="$(mktemp -d "${TMPDIR:-/tmp}/topaz-controls.XXXXXX")" || return 1
  progress_fifo="$control_dir/progress"
  if ! mkfifo "$progress_fifo"; then
    rmdir "$control_dir" 2>/dev/null || true
    return 1
  fi

  topaz_render_progress "$total" "$cols" "$log_mode" <"$progress_fifo" &
  progress_pid=$!

  # Reset inherited signal handlers before exec so q/Ctrl-C reaches ffmpeg even
  # though it is an asynchronous child. stdin belongs to this control loop.
  (
    cd "$work_dir" || exit 1
    trap - INT TERM HUP
    exec "$@" </dev/null
  ) >"$progress_fifo" 2>>"$log_file" &
  encoder_pid=$!

  trap 'caught_signal=INT' INT
  trap 'caught_signal=TERM' TERM
  trap 'caught_signal=HUP' HUP

  if [[ "$interactive" == true ]]; then
    print -P -- "  %F{white}controls:%f %F{cyan}[p] pause/continue%f · %F{magenta}[o] open in mpv%f · %F{yellow}[q] stop%f"
  fi

  while kill -0 "$encoder_pid" 2>/dev/null; do
    if [[ -n "$caught_signal" ]]; then
      if [[ "$paused" == true ]]; then
        kill -CONT "$progress_pid" 2>/dev/null || true
        kill -CONT "$encoder_pid" 2>/dev/null || true
        paused=false
      fi
      kill "-$caught_signal" "$encoder_pid" 2>/dev/null || true
      break
    fi

    if [[ "$interactive" != true ]]; then
      sleep 0.2
      continue
    fi

    key=""
    if read -r -s -k 1 -t 0.2 key; then
      case "${key:l}" in
        p)
          if [[ "$paused" == true ]]; then
            kill -CONT "$progress_pid" 2>/dev/null || true
            if kill -CONT "$encoder_pid" 2>/dev/null; then
              paused=false
              print -P -- "\r%F{green}%B▶ Encode resumed%b%f"
            fi
          elif kill -STOP "$encoder_pid" 2>/dev/null; then
            kill -STOP "$progress_pid" 2>/dev/null || true
            paused=true
            print
            print -P -- "%F{yellow}%B⏸ Encode paused%b%f — press %B[p]%b to continue or %B[q]%b to stop"
          fi
          ;;
        o)
          if [[ -n "$output_preview" && -s "$output_preview" ]] && command -v mpv >/dev/null 2>&1; then
            mpv --force-window=immediate --keep-open=yes -- "$output_preview" >/dev/null 2>&1 &!
            print -P -- "\r%F{magenta}▶ opened output in mpv%f"
          else
            print -P -- "\r%F{yellow}output not ready to preview yet%f"
          fi
          ;;
        q)
          if [[ "$paused" == true ]]; then
            kill -CONT "$progress_pid" 2>/dev/null || true
            kill -CONT "$encoder_pid" 2>/dev/null || true
            paused=false
          fi
          print
          print -P -- "%F{yellow}■ Stopping encode…%f"
          kill -INT "$encoder_pid" 2>/dev/null || true
          stop_requested=true
          break
          ;;
      esac
    fi
  done

  if [[ "$paused" == true ]]; then
    kill -CONT "$progress_pid" 2>/dev/null || true
    paused=false
  fi

  # zsh records each child STOP as a wait status. Consume those notifications
  # until wait reports the encoder's real final status after it was continued.
  while true; do
    encoder_status=0
    wait "$encoder_pid" || encoder_status=$?
    (( encoder_status == stop_wait_status )) || break
  done
  while true; do
    progress_status=0
    wait "$progress_pid" 2>/dev/null || progress_status=$?
    (( progress_status == stop_wait_status )) || break
  done

  rm -f -- "$progress_fifo"
  rmdir "$control_dir" 2>/dev/null || true
  trap - INT TERM HUP

  if [[ -n "$caught_signal" ]]; then
    case "$caught_signal" in
      INT) encoder_status=130 ;;
      TERM) encoder_status=143 ;;
      HUP) encoder_status=129 ;;
    esac
  elif [[ "$stop_requested" == true ]]; then
    encoder_status=130
  fi

  return "$encoder_status"
}

media_header_summary() {
  local first_summary

  first_summary="$(media_summary_for_file "$files[1]")"
  if (( ${#files[@]} > 1 )); then
    print -r -- "${first_summary}  [+$((${#files[@]} - 1)) more]"
  else
    print -r -- "$first_summary"
  fi
}

setfile_path_arg() {
  local file_path="$1"

  if [[ "$file_path" != /* && "${file_path:t}" == -* ]]; then
    print -r -- "./$file_path"
  else
    print -r -- "$file_path"
  fi
}

creation_date_for_setfile() {
  local input_file="$1"
  local epoch

  epoch="$(stat -f '%B' -- "$input_file" 2>/dev/null)" || return 1
  [[ "$epoch" == <-> ]] || return 1
  (( epoch > 0 )) || return 1

  date -r "$epoch" '+%m/%d/%Y %H:%M:%S'
}

copy_creation_date() {
  local input_file="$1"
  local output_file="$2"
  local created output_arg

  if ! have SetFile; then
    warn "SetFile not found; could not copy creation date"
    return 1
  fi

  if ! created="$(creation_date_for_setfile "$input_file")"; then
    warn "could not read creation date: $input_file"
    return 1
  fi

  output_arg="$(setfile_path_arg "$output_file")"
  if SetFile -d "$created" "$output_arg"; then
    info "Copied creation date: $created"
    return 0
  fi

  warn "failed to copy creation date to: $output_file"
  return 1
}

trash_original() {
  local input_file="$1"
  local target="$input_file"

  if have trash; then
    [[ "$target" != /* && "${target:t}" == -* ]] && target="./$target"
    trash "$target"
    return
  fi

  local trash_dir="$HOME/.Trash"
  local base dst stamp n

  mkdir -p -- "$trash_dir"
  base="${input_file:t}"
  dst="$trash_dir/$base"

  if [[ -e "$dst" ]]; then
    stamp="$(date +%Y%m%d-%H%M%S)"
    n=1
    while [[ -e "$trash_dir/${base} (${stamp}-${n})" ]]; do
      (( ++n ))
    done
    dst="$trash_dir/${base} (${stamp}-${n})"
  fi

  mv -n -- "$input_file" "$dst"
}

maybe_trash_original() {
  local input_file="$1"

  if trash_original "$input_file"; then
    info "Trashed original:  $input_file"
    return 0
  fi

  warn "failed to trash original: $input_file"
  return 1
}

confirm_open_preview() {
  local input_file="$1"
  local output_file="$2"
  local reply=""

  read -r "?Open preview beside original in mpv-preview? [y/N] " reply
  [[ "$reply" == [Yy] || "$reply" == [Yy][Ee][Ss] ]]
}

open_preview_pair() {
  local input_file="$1"
  local output_file="$2"

  if have mpv-preview; then
    mpv-preview "$input_file" "$output_file"
    return
  fi

  if have mpv; then
    mpv --force-window=immediate --keep-open=yes -- "$input_file" "$output_file"
    return
  fi

  warn "mpv-preview and mpv not found; could not open preview"
  return 1
}

# In log mode the encoder log is the only record of *why* an encode died, and
# nobody is going to go opening ~/Library/Logs after the fact — so quote its
# tail into the transcript.
report_encoder_log_tail() {
  local log_file="$1" line
  integer lines="${2:-15}"

  [[ "$log_mode" == true && -s "$log_file" ]] || return 0

  say_err "  %F{white}last ${lines} lines of the encoder log:%f"
  tail -n "$lines" -- "$log_file" | tr '\r' '\n' | while IFS= read -r line; do
    [[ -n "${line//[[:space:]]/}" ]] && print -r -- "    $line"
  done
  return 0
}

maybe_open_preview_pair() {
  local input_file="$1"
  local output_file="$2"

  # No prompting and no windows in a headless run.
  [[ "$log_mode" == true ]] && return 0

  confirm_open_preview "$input_file" "$output_file" || return 0
  open_preview_pair "$input_file" "$output_file"
}

preset_name=""
preset_flag=""
preset_value=""
preset_output_ext=""
preset_video_args=""
preset_metadata=""
media_header=""
trash_originals=false
preview_mode=false
preview_seconds="1"
resume_mode=false
copy_cmd_mode=false
nice_level=""
background_mode=false
output_override=""
files=()

while (( $# > 0 )); do
  case "$1" in
    --preview=*)
      preview_mode=true
      preview_seconds="${1#--preview=}"
      shift
      ;;
    --preview)
      preview_mode=true
      if (( $# >= 2 )) && [[ "${2:-}" != -* ]] && is_number "$2"; then
        preview_seconds="$2"
        shift 2
      else
        shift
      fi
      ;;
    --trash-originals|--trash-original)
      trash_originals=true
      shift
      ;;
    --resume)
      resume_mode=true
      shift
      ;;
    --copy-cmd)
      copy_cmd_mode=true
      shift
      ;;
    --nice=*)
      nice_level="${1#--nice=}"
      shift
      ;;
    --nice)
      nice_level=19
      if (( $# >= 2 )) && [[ "${2:-}" != -* ]] && is_number "$2"; then
        nice_level="$2"
        shift 2
      else
        shift
      fi
      ;;
    --background|--bg)
      background_mode=true
      shift
      ;;
    --log|--headless|--plain)
      log_mode=true
      log_mode_explicit=true
      shift
      ;;
    --no-log|--interactive)
      log_mode=false
      log_mode_explicit=true
      shift
      ;;
    --preset_name)
      (( $# >= 2 )) || {
        print -u2 -- "--preset_name requires a value"
        exit 1
      }
      preset_name="$2"
      shift 2
      ;;
    --filter_complex)
      (( $# >= 2 )) || {
        print -u2 -- "--filter_complex requires a value"
        exit 1
      }
      preset_flag="--filter_complex"
      preset_value="$2"
      shift 2
      ;;
    --output_ext)
      (( $# >= 2 )) || {
        print -u2 -- "--output_ext requires a value"
        exit 1
      }
      preset_output_ext="$2"
      shift 2
      ;;
    --video_args)
      (( $# >= 2 )) || {
        print -u2 -- "--video_args requires a value"
        exit 1
      }
      preset_video_args="$2"
      shift 2
      ;;
    --metadata)
      (( $# >= 2 )) || {
        print -u2 -- "--metadata requires a value"
        exit 1
      }
      preset_metadata="$2"
      shift 2
      ;;
    --)
      shift
      files+=("$@")
      break
      ;;
    -*)
      print -u2 "unknown option: $1"
      usage >&2
      exit 1
      ;;
    *)
      files+=("$1")
      shift
      ;;
  esac
done

# Auto-detect a headless caller unless --log/--no-log said otherwise.
if [[ "$log_mode_explicit" != true ]]; then
  if [[ ! -t 1 ]] ||
     [[ -n "${NO_COLOR:-}" ]] ||
     [[ "${CLICOLOR:-}" == 0 ]] ||
     [[ "${TERM:-}" == (dumb|) ]]; then
    log_mode=true
  fi
fi

is_number "$preview_seconds" || {
  print -u2 -- "--preview length must be numeric seconds"
  exit 1
}
number_gt_zero "$preview_seconds" || {
  print -u2 -- "--preview length must be greater than 0"
  exit 1
}

if [[ -n "$nice_level" ]]; then
  [[ "$nice_level" == (-|)<-> ]] || {
    print -u2 -- "--nice must be an integer niceness (e.g. --nice=19)"
    exit 1
  }
fi

# Launcher prefix for the encoder. Both nice(1) and taskpolicy(8) exec the
# target in place, so the encoder keeps the pid the pause/stop keys signal.
priority_cmd=()
if [[ "$background_mode" == true ]]; then
  if have taskpolicy; then
    priority_cmd+=(taskpolicy -b)
  else
    warn "taskpolicy not found; ignoring --background"
    background_mode=false
  fi
fi
if [[ -n "$nice_level" ]]; then
  if have nice; then
    priority_cmd+=(nice -n "$nice_level")
  else
    warn "nice not found; ignoring --nice"
    nice_level=""
  fi
fi

if [[ -n "$preset_name" || -n "$preset_value" ]]; then
  [[ -n "$preset_name" && -n "$preset_value" ]] || {
    print -u2 -- "--preset_name and --filter_complex must be supplied together"
    exit 1
  }
  (( ${#files[@]} > 0 )) || {
    print -u2 "no input files supplied"
    usage >&2
    exit 1
  }
else
  (( ${#files[@]} > 0 )) || {
    usage >&2
    exit 1
  }

  for input in "$files[@]"; do
    [[ -f "$input" ]] || {
      print -u2 "not a file: $input"
      exit 1
    }
  done

  # Self-describing partial: every Topaz output embeds its job in metadata
  # tags, so a lone file argument that carries them reconstructs the whole
  # encode — no preset flags needed, even after the preset is long forgotten.
  if (( ${#files[@]} == 1 )) && [[ -x "$TOPAZ_FFPROBE" ]]; then
    typeset -A embedded_job
    while IFS= read -r line; do
      line="${line#TAG:}"
      key="${line%%=*}"
      case "$key" in
        topaz_source|topaz_filter|topaz_preset_name|topaz_video_args|videoai)
          embedded_job[$key]="${line#*=}"
          ;;
      esac
    done < <(
      "$TOPAZ_FFPROBE" -v error \
        -show_entries format_tags=topaz_source,topaz_filter,topaz_preset_name,topaz_video_args,videoai \
        -of default=noprint_wrappers=1 -- "$files[1]" 2>/dev/null
    )

    if [[ -n "${embedded_job[topaz_filter]:-}" && -n "${embedded_job[topaz_source]:-}" ]]; then
      [[ -f "${embedded_job[topaz_source]}" ]] || {
        print -u2 -- "embedded Topaz job found, but its source is missing:"
        print -u2 -- "  ${embedded_job[topaz_source]}"
        exit 1
      }
      preset_name="${embedded_job[topaz_preset_name]:-resumed encode}"
      preset_flag="--filter_complex"
      preset_value="${embedded_job[topaz_filter]}"
      preset_video_args="${embedded_job[topaz_video_args]:-}"
      [[ -n "${embedded_job[videoai]:-}" ]] && preset_metadata="videoai=${embedded_job[videoai]}"
      preset_output_ext="${files[1]:e}"
      output_override="${files[1]:A}"
      files=("${embedded_job[topaz_source]}")
      say "%F{cyan}%B↻ embedded Topaz job found%b%f"
      say "  %F{white}preset:%f %F{magenta}$(topaz_escape_prompt "$preset_name")%f"
      say "  %F{white}source:%f %F{white}$(topaz_escape_prompt "${files[1]}")%f"
      say_blank
    fi
  fi
fi

if [[ -z "$preset_value" ]]; then
  # The picker needs a terminal. Fail loudly rather than hanging a queued job
  # on an fzf that has no tty.
  [[ "$log_mode" == true ]] && {
    say_err "no preset given and the interactive picker cannot run in log mode"
    say_err "  pass --preset_name NAME --filter_complex FILTER (topaz-encode --copy-cmd prints a ready-made command)"
    exit 1
  }

  command -v fzf >/dev/null 2>&1 || {
    print -u2 "fzf not found"
    exit 1
  }

  media_header="$(media_header_summary)"
  preview_frame_bind=""
  if [[ -x "$TOPAZ_PREVIEW_FRAME_KITTY" ]]; then
    preview_frame_bind="alt-p:execute-silent(${(q)TOPAZ_PREVIEW_FRAME_KITTY} --input ${(q)files[1]} --preset-name {2} --preset-flag {3} --filter {4})"
  fi

  selection="$(
    topaz_preset_picker_rows encode |
      fzf \
        --prompt='Topaz preset > ' \
        --delimiter=$'\t' \
        --with-nth=1 \
        --height=50% \
        --reverse \
        --border \
        --header="$media_header" \
        --header-first \
        --preview='printf "%s\n" {4}' \
        --preview-window='down:6:wrap' \
        ${preview_frame_bind:+--bind="$preview_frame_bind"}
  )"

  [[ -n "$selection" ]] || {
    print -u2 "no preset selected"
    exit 1
  }

  topaz_parse_preset_row "$selection"
  preset_name="$TOPAZ_PRESET_NAME"
  preset_flag="$TOPAZ_PRESET_FLAG"
  preset_value="$TOPAZ_PRESET_FILTER"
  preset_output_ext="$TOPAZ_PRESET_OUTPUT_EXT"
  preset_video_args="$TOPAZ_PRESET_VIDEO_ARGS"
  preset_metadata="$TOPAZ_PRESET_METADATA"
fi

# Absolutize inputs: the encode runs from the Topaz app dir, and resume/rerun
# commands must work from any cwd.
abs_files=()
for input in "$files[@]"; do
  [[ -f "$input" ]] || {
    print -u2 "not a file: $input"
    exit 1
  }
  abs_files+=("${input:A}")
done
files=("${abs_files[@]}")

if [[ "$copy_cmd_mode" == true ]]; then
  cmd_lines=""
  for input in "$files[@]"; do
    line="$(topaz_wrapper_cmd "$input")"
    print -r -- "$line"
    cmd_lines+="${cmd_lines:+$'\n'}$line"
  done
  if have pbcopy; then
    print -rn -- "$cmd_lines" | pbcopy
    say "%F{green}✓ command copied to clipboard%f"
  else
    say_err "%F{yellow}⚠ pbcopy not found — command printed only%f"
  fi
  exit 0
fi

[[ -x "$TOPAZ_FFMPEG" ]] || {
  print -u2 "Topaz ffmpeg not found or not executable: $TOPAZ_FFMPEG"
  topaz_app_help >&2
  exit 1
}

[[ -d "$TOPAZ_MODELS_DIR" ]] || {
  print -u2 "Topaz models dir not found: $TOPAZ_MODELS_DIR"
  topaz_app_help >&2
  exit 1
}

mkdir -p "$LOG_DIR"

term_cols="$(tput cols 2>/dev/null || true)"
[[ "$term_cols" == <1-> ]] || term_cols="${COLUMNS:-80}"
[[ "$term_cols" == <1-> ]] || term_cols=80

say "%F{blue}%BTopaz batch%b%f"
say "  %F{white}preset:%f %F{magenta}$(topaz_escape_prompt "$preset_name")%f"
[[ "$preview_mode" == true ]] && say "  %F{white}preview:%f %F{yellow}${preview_seconds}s sample encode%f"
if (( ${#priority_cmd[@]} > 0 )); then
  priority_desc=""
  [[ "$background_mode" == true ]] && priority_desc+="background (taskpolicy -b)"
  [[ -n "$nice_level" ]] && priority_desc+="${priority_desc:+, }nice $nice_level"
  say "  %F{white}priority:%f %F{yellow}${priority_desc}%f"
fi
if [[ "$trash_originals" == true && "$preview_mode" == true ]]; then
  say "  %F{white}cleanup:%f %F{yellow}ignored during preview%f"
elif [[ "$trash_originals" == true ]]; then
  say "  %F{white}cleanup:%f %F{yellow}trash originals after successful encodes%f"
fi
say_blank

integer ok_count=0
integer skip_count=0
integer fail_count=0
integer creation_date_fail_count=0
integer trash_fail_count=0

for input in "$files[@]"; do
  ext="${input:e}"
  base="${input:t:r}"
  output_ext="${preset_output_ext:-$ext}"
  output_ext="${output_ext#.}"
  video_args=(${(z)preset_video_args:-})

  (( ${#video_args[@]} > 0 )) || {
    video_args=(
      -c:v hevc_videotoolbox
      -profile:v main
      -tag:v hvc1
      -pix_fmt yuv420p
      -allow_sw 1
      -g 30
      -b:v 30M
    )
  }

  metadata_args=()
  [[ -n "$preset_metadata" ]] && metadata_args=(-metadata "$preset_metadata")

  # Embed the full job in the output so a crashed partial is self-describing:
  # `topaz-encode --resume <partial>` reconstructs everything from these tags.
  if [[ "$preview_mode" != true ]]; then
    metadata_args+=(
      -metadata "topaz_source=$input"
      -metadata "topaz_preset_name=$preset_name"
      -metadata "topaz_filter=$preset_value"
      -metadata "topaz_video_args=${(j: :)video_args}"
    )
  fi

  filename_preset="$(topaz_file_preset_label "$(topaz_short_preset_label "$preset_name")")"
  safe_preset="$(topaz_safe_log_label "$filename_preset")"

  # Any trailing "[...]" tags on the source name are replaced by the Topaz tag,
  # and overlong names are cropped rather than erroring at open time.
  clean_base="$(topaz_strip_trailing_brackets "$base")"

  if [[ "$preview_mode" == true ]]; then
    output="$(topaz_fit_filename "${input:h}" "$clean_base" " [Topaz Preview ${preview_seconds}s - ${filename_preset}].${output_ext}")"
    log_file="$(topaz_fit_filename "$LOG_DIR" "$clean_base" " [Topaz Preview ${preview_seconds}s - ${safe_preset}].log")"
  else
    output="$(topaz_fit_filename "${input:h}" "$clean_base" " [Topaz - ${filename_preset}].${output_ext}")"
    log_file="$(topaz_fit_filename "$LOG_DIR" "$clean_base" " [Topaz - ${safe_preset}].log")"
  fi
  # Embedded-job resume targets the exact file that was passed in, even if it
  # was renamed or moved since the original encode.
  [[ -n "$output_override" ]] && output="$output_override"
  ffmpeg_preset_flag="-${preset_flag#--}"
  input_duration_args=()
  [[ "$preview_mode" == true ]] && input_duration_args=(-t "$preview_seconds")

  # Existing-output handling: complete outputs are skipped; short outputs are
  # interrupted encodes and can be resumed (tail re-encode + lossless concat).
  resume_kf=""            # set to the resume keyframe time when resuming
  expected_duration=""
  if [[ "$preview_mode" != true && -e "$output" ]]; then
    src_duration="$(media_duration_seconds "$input")"
    out_duration="$(media_duration_seconds "$output")"
    slowmo_factor="$(topaz_slowmo_factor "$preset_value")"
    [[ -n "$src_duration" ]] && expected_duration="$(
      awk -v d="$src_duration" -v f="$slowmo_factor" 'BEGIN { print d * f }'
    )"

    if [[ -z "$expected_duration" || -z "$out_duration" ]] ||
        awk -v o="$out_duration" -v e="$expected_duration" 'BEGIN { exit !(o >= e - 5) }'; then
      say "%F{yellow}✓ skip:%f output already complete"
      say "  %F{white}file:%f %F{blue}$(topaz_escape_prompt "$output")%f"
      (( ++skip_count ))
      continue
    fi

    pct="$(awk -v o="$out_duration" -v e="$expected_duration" 'BEGIN { printf "%d", o / e * 100 }')"
    say "%F{yellow}%B⚠ partial encode detected%b%f"
    say "  %F{white}output:%f   %F{blue}$(topaz_escape_prompt "${output:t}")%f"
    say "  %F{white}progress:%f %F{yellow}$(topaz_format_clock "$out_duration") of $(topaz_format_clock "$expected_duration") (${pct}%%)%f"

    if [[ "$resume_mode" == true ]]; then
      resume_choice="r"
    elif [[ "$log_mode" == true ]]; then
      # Nobody to answer the prompt. Resume is the only choice that neither
      # discards work nor silently does nothing: the partial is left untouched
      # until a verified join exists, so it is safe to pick unattended.
      resume_choice="r"
      say "  %F{cyan}↻ resuming automatically (log mode)%f"
    else
      resume_choice=""
      read -k 1 "resume_choice?  ↻ [r]esume · [R]estart from scratch · [s]kip? " || resume_choice="s"
      say_blank
    fi

    case "$resume_choice" in
      r)
        resume_kf="$(topaz_last_keyframe_before "$output" \
          "$(awk -v o="$out_duration" 'BEGIN { print o - 2 }')")"
        if [[ -z "$resume_kf" ]]; then
          say_err "%F{red}✗ could not find a resume keyframe in the partial — not touching it%f"
          (( ++fail_count ))
          continue
        fi
        say "  %F{cyan}↻ resuming from $(topaz_format_clock "$resume_kf")%f"
        ;;
      R)
        say "  %F{yellow}restarting from scratch (partial moved to Trash)%f"
        trash_original "$output" || {
          say_err "%F{red}✗ could not trash partial output — aborting this file%f"
          (( ++fail_count ))
          continue
        }
        ;;
      *)
        say "  %F{yellow}skipped%f"
        (( ++skip_count ))
        continue
        ;;
    esac
  fi

  progress_total_seconds="$(media_duration_seconds "$input")"
  if [[ "$preview_mode" == true ]]; then
    if [[ -n "$progress_total_seconds" ]]; then
      progress_total_seconds="$(
        awk -v a="$progress_total_seconds" -v b="$preview_seconds" 'BEGIN { print (a < b) ? a : b }'
      )"
    else
      progress_total_seconds="$preview_seconds"
    fi
  fi

  # Resume: encode only the tail (source seek = output keyframe time mapped back
  # through any slow-motion factor), writing to a sidecar tail file that is later
  # concatenated onto the partial.
  encode_target="$output"
  if [[ -n "$resume_kf" ]]; then
    encode_target="${output:r} [resume tail].${output_ext}"
    input_seek="$(awk -v k="$resume_kf" -v f="$slowmo_factor" 'BEGIN { print k / f }')"
    input_duration_args=(-ss "$input_seek")
    progress_total_seconds="$(awk -v e="$expected_duration" -v k="$resume_kf" 'BEGIN { print e - k }')"
  fi

  # Progress already comes back on pipe:1, so in log mode ffmpeg's stderr stats
  # line is just carriage-return spam in the encoder log — and that log is what
  # gets tailed into the transcript when an encode fails.
  stats_args=()
  [[ "$log_mode" == true ]] && stats_args=(-nostats)

  ffmpeg_cmd=(
    "$TOPAZ_FFMPEG"
    -hide_banner
    -nostdin
    "${stats_args[@]}"
    -y
    -progress pipe:1
    "${input_duration_args[@]}"
    -i "$input"
    -sws_flags "spline+accurate_rnd+full_chroma_int"
    "$ffmpeg_preset_flag" "$preset_value"
    "${video_args[@]}"
    -map "0:a?"
    -c:a copy
    -map_metadata 0
    -map_metadata:s:v 0:s:v
    -map_chapters 0
    -fps_mode:v passthrough
    -movflags "frag_keyframe+empty_moov+delay_moov+use_metadata_tags+write_colr"
    -bf 0
    "${metadata_args[@]}"
    "$encode_target"
  )

  topaz_env=(
    "${priority_cmd[@]}"
    env
    LC_ALL=C
    LC_NUMERIC=C
    LANG=C
    TVAI_MODEL_DIR="$TOPAZ_MODELS_DIR"
    TVAI_MODEL_DATA_DIR="$TOPAZ_MODELS_DIR"
  )

  log_cmd=(
    cd "$TOPAZ_MACOS_DIR"
    "&&"
    "${topaz_env[@]}"
    "${ffmpeg_cmd[@]}"
  )

  : >| "$log_file"
  topaz_open_log_tail "$log_file"

  if [[ -n "$resume_kf" ]]; then
    say "%F{cyan}%B↻ Resuming encode%b%f"
  elif [[ "$preview_mode" == true ]]; then
    say "%F{cyan}%B▶ Encoding preview%b%f"
  else
    say "%F{cyan}%B▶ Encoding%b%f"
  fi
  say "  %F{white}app:%f    %F{magenta}$(topaz_escape_prompt "$TOPAZ_APP")%f"
  say "  %F{white}engine:%f %F{magenta}Topaz ffmpeg%f"
  say "  %F{white}video:%f  %F{magenta}$(topaz_escape_prompt "${(j: :)video_args}")%f"
  say "  %F{white}input:%f  %F{white}$(topaz_escape_prompt "$input")%f"
  say "  %F{white}output:%f %F{green}%B$(topaz_escape_prompt "$output")%b%f"
  say "  %F{white}log:%f    %F{blue}$(topaz_escape_prompt "$log_file")%f"
  if [[ -n "$resume_kf" ]]; then
    say "  %F{white}resume:%f %F{cyan}tail from $(topaz_format_clock "$resume_kf"), then lossless join%f"
  elif [[ "$preview_mode" == true ]]; then
    say "  %F{white}sample:%f %F{yellow}${preview_seconds}s from start%f"
  elif [[ "$log_mode" != true ]]; then
    say "  %F{white}preview:%f %F{magenta}press [o] during encode to open output in mpv%f"
  fi
  say "  %F{white}metadata:%f %F{green}copy source tags and creation date%f"
  [[ "$trash_originals" == true && "$preview_mode" != true ]] && say "  %F{white}cleanup:%f %F{yellow}trash original after success%f"
  say "  %F{white}rerun/resume with:%f"
  print -r -- "    $(topaz_wrapper_cmd "$input")"
  say_blank

  topaz_result=0
  {
    print "[$(date '+%F %T')] START $input"
    print "PRESET: $preset_name"
    print "TOPAZ_APP: $TOPAZ_APP"
    print "TOPAZ_FFMPEG: $TOPAZ_FFMPEG"
    print "TOPAZ_MODELS_DIR: $TOPAZ_MODELS_DIR"
    print "CMD: ${(q+)log_cmd}"
  } >"$log_file" 2>&1

  topaz_status=0
  topaz_run_with_controls \
    "$progress_total_seconds" "$term_cols" "$log_file" "$TOPAZ_MACOS_DIR" "$output" \
    "${topaz_env[@]}" "${ffmpeg_cmd[@]}" || topaz_status=$?

  {
    if (( topaz_status != 0 )); then
      print "[$(date '+%F %T')] FAILED status=$topaz_status"
      topaz_result="$topaz_status"
    elif [[ ! -s "$encode_target" ]]; then
      print "[$(date '+%F %T')] FAILED missing output: $encode_target"
      topaz_result=1
    else
      print "[$(date '+%F %T')] DONE $encode_target"
    fi
  } >>"$log_file" 2>&1

  if (( topaz_result != 0 )); then
    say_err "%F{red}✗ failed:%f $(topaz_escape_prompt "$input")"
    say_err "  %F{white}see log:%f %F{blue}$(topaz_escape_prompt "$log_file")%f"
    report_encoder_log_tail "$log_file"
    if [[ -n "$resume_kf" ]]; then
      say_err "  %F{white}partial output untouched:%f %F{blue}$(topaz_escape_prompt "$output")%f"
      [[ -s "$encode_target" ]] || rm -f -- "$encode_target"
    fi
    (( ++fail_count ))
    continue
  fi

  # Resume: losslessly join partial[0..keyframe] + freshly encoded tail, verify
  # the joined duration, then swap it into place. The partial is never modified
  # until the verified replacement exists.
  if [[ -n "$resume_kf" ]]; then
    say "  %F{cyan}↻ joining partial + tail…%f"
    concat_list="$(mktemp "${TMPDIR:-/tmp}/topaz-concat.XXXXXX")"
    joined="${${output:A}:r} [resume joined].${output_ext}"
    {
      print -r -- "file '$(topaz_concat_escape "${output:A}")'"
      print -r -- "outpoint $resume_kf"
      print -r -- "file '$(topaz_concat_escape "${encode_target:A}")'"
    } >| "$concat_list"

    concat_status=0
    (
      cd "$TOPAZ_MACOS_DIR"
      "${priority_cmd[@]}" "$TOPAZ_FFMPEG" -hide_banner -y -f concat -safe 0 -i "$concat_list" \
        -map 0 -c copy -movflags "use_metadata_tags+faststart" \
        "${metadata_args[@]}" -- "$joined"
    ) >>"$log_file" 2>&1 || concat_status=$?
    rm -f -- "$concat_list"

    joined_duration="$(media_duration_seconds "$joined")"
    duration_ok=false
    if (( concat_status == 0 )) && [[ -n "$joined_duration" ]] &&
        awk -v j="$joined_duration" -v e="$expected_duration" \
          'BEGIN { d = j - e; if (d < 0) d = -d; exit !(d <= 5) }'; then
      duration_ok=true
    fi

    if [[ "$duration_ok" != true ]]; then
      print "[$(date '+%F %T')] RESUME JOIN FAILED status=$concat_status joined_duration=${joined_duration:-?} expected=$expected_duration" >>"$log_file"
      say_err "%F{red}✗ resume join failed or duration mismatch — nothing was deleted%f"
      say_err "  %F{white}partial:%f %F{blue}$(topaz_escape_prompt "$output")%f"
      say_err "  %F{white}tail:%f    %F{blue}$(topaz_escape_prompt "$encode_target")%f"
      [[ -e "$joined" ]] && say_err "  %F{white}joined:%f  %F{blue}$(topaz_escape_prompt "$joined")%f"
      say_err "  %F{white}see log:%f %F{blue}$(topaz_escape_prompt "$log_file")%f"
      report_encoder_log_tail "$log_file"
      (( ++fail_count ))
      continue
    fi

    trash_original "$output" || warn "could not trash partial; overwriting in place"
    mv -f -- "$joined" "$output"
    rm -f -- "$encode_target"
    print "[$(date '+%F %T')] RESUME DONE $output" >>"$log_file"
    say "  %F{green}✓ resumed encode verified ($(topaz_format_clock "$joined_duration") ≈ $(topaz_format_clock "$expected_duration"))%f"
  fi

  copy_creation_date "$input" "$output" || (( ++creation_date_fail_count ))
  [[ "$preview_mode" == true ]] && maybe_open_preview_pair "$input" "$output" || true
  if [[ "$trash_originals" == true && "$preview_mode" != true ]]; then
    maybe_trash_original "$input" || (( ++trash_fail_count ))
  fi
  (( ++ok_count ))
  say "%F{green}%B✓ $(topaz_escape_prompt "${output:t}")%b%f"
  say "  %F{8}$(topaz_escape_prompt "$(topaz_output_summary_line "$output")")%f"
done

say_blank
say "%F{white}%BSummary%b%f  %F{green}✓ $ok_count ok%f · %F{yellow}$skip_count skipped%f · %F{red}$fail_count failed%f${creation_date_fail_count:+ · }%F{8}dates failed: $creation_date_fail_count, trash failed: $trash_fail_count%f"

# In log mode the exit status is the queue's success signal (job-runner files
# the job under _done/ or _err/ by it), so only a failed encode counts as
# failure — a missing SetFile or an undeletable original is a warning, not a
# reason to bury a good encode in _err/.
if [[ "$log_mode" == true ]]; then
  (( fail_count == 0 ))
else
  (( fail_count == 0 && creation_date_fail_count == 0 && trash_fail_count == 0 ))
fi
