#!/usr/bin/env zsh
# git-sync
#
# AI-assisted git sync using Claude or Codex + Gum.
#
# Flow: if the repo has an interrupted merge/rebase with conflicts, the AI
# resolves them and the merge/rebase is completed, then the repo is synced
# (pull --rebase, push). Otherwise changes are staged (asking when staged and
# unstaged changes are mixed), a commit message is generated, and the commit
# is synced to the remote.
#
# Usage:
#   git-sync
#   git-sync --multi
#   git-sync --staged-only
#   git-sync --claude
#   git-sync --codex
#   git-sync --multi --staged-only --claude

emulate -L zsh
set -euo pipefail

zmodload zsh/datetime   # $EPOCHREALTIME, for round-trip timing

# Cap on the patch body handed to the model. Normal commits land well under
# this and are sent whole; only pathological diffs get truncated.
GC_DIFF_MAX_CHARS=${GC_DIFF_MAX_CHARS:-65536}

# A persistent backend, signing, or Git failure should return control to the
# user instead of allowing an interactive retry cycle to run forever.
GC_RETRY_LIMIT=${GC_RETRY_LIMIT:-3}

usage() {
  cat <<'EOF'
Usage:
  git-sync [options]

AI-assisted git sync. Resolves any interrupted merge/rebase (conflicts are
fixed by the AI), stages changes (asking when staged and unstaged changes are
mixed), generates a commit message, then pulls --rebase and pushes.

Options:
  --multi    Generate a multiline conventional commit message
  --staged-only
             Commit only already-staged changes
  --claude   Use Claude to generate the message (default when available)
  --codex    Use Codex to generate the message (fallback)
  -h, --help Show this help

Environment variables:
  GC_BACKEND              claude|codex (default: claude if installed, else codex)
  GC_REASONING            Codex reasoning effort (default: low)
  GC_CLAUDE_MODEL         Claude model to use (default: claude-haiku-4-5-20251001)
  GC_DIFF_MAX_CHARS       Cap on the patch body sent to the model (default: 65536)
  GC_RETRY_LIMIT          Maximum attempts for a repeated operation (default: 3)

Examples:
  git-sync
  git-sync --multi
  git-sync --staged-only
  git-sync --claude
  git-sync --multi --staged-only
  GC_CLAUDE_MODEL=claude-opus-4-8 git-sync --claude
EOF
}

die() {
  gum style --foreground 196 --bold "✘ $*"
  exit 1
}

info() {
  gum style --foreground 81 --bold "◆ $*"
}

ok() {
  gum style --foreground 82 --bold "✓ $*"
}

warn() {
  gum style --foreground 214 --bold "▲ $*"
}

# Dim, indented aside — for numbers that are worth seeing but never the point.
note() {
  gum style --foreground 245 "  $*"
}

# After a failure during AI-driven conflict resolution, let the user fix the
# cause in place (e.g. start the 1Password signing agent) and retry, rather
# than always dropping straight to manual resolution.
confirm_retry() {
  local header=$1
  local choice
  choice=$(
    gum choose \
      --cursor "› " \
      --selected-prefix "● " \
      --unselected-prefix "○ " \
      --header "$header" \
      "retry" \
      "resolve manually"
  )
  [[ "$choice" == "retry" ]]
}

humanize_tokens() {
  local n=$1
  if (( n >= 1000 )); then
    printf '%.1fk' $(( n / 1000.0 ))
  else
    printf '%d' $n
  fi
}

# Surface what the round trip actually cost. Input counts cache reads and
# writes as well as fresh tokens — all three are context the model was sent,
# and lumping them together is what makes payload regressions visible here.
report_round_trip() {
  local json_file=$1 elapsed=$2

  local usage
  # `empty` rather than zeroes when .usage is absent: a silent line beats one
  # that reports a confident 0 in · 0 out.
  usage=$(jq -r '
    if .usage then
      .usage
      | [ ((.input_tokens // 0)
           + (.cache_creation_input_tokens // 0)
           + (.cache_read_input_tokens // 0)),
          (.output_tokens // 0) ]
      | @tsv
    else empty end' "$json_file" 2>/dev/null) || return 0

  [[ -n "$usage" ]] || return 0

  local in_tok=${usage%%$'\t'*} out_tok=${usage##*$'\t'}

  note "$(humanize_tokens $in_tok) in · $(humanize_tokens $out_tok) out · $(printf '%.1fs' $elapsed)"
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "Missing dependency: $1"
}

# `claude` may not be on PATH: the desktop app bundles the CLI under a
# per-version directory instead of installing it globally. Prefer a real PATH
# install, else fall back to the newest bundled binary.
resolve_claude() {
  if command -v claude >/dev/null 2>&1; then
    print -r -- claude
    return 0
  fi

  local -a bundled
  bundled=( "$HOME/Library/Application Support/Claude/claude-code"/*/claude.app/Contents/MacOS/claude(Nn-*) )
  (( ${#bundled} )) || return 1

  print -r -- "${bundled[-1]}"
}

# Write the diff the model gets to see. A full `git diff --cached` on a normal
# commit here runs to tens of KB, and every byte is both payload and thinking
# fodder, so trim it: a file-level summary (cheap, high signal) followed by a
# capped patch body with generated files dropped. Lockfiles and minified blobs
# still show up in the summary, where they say everything a commit message
# needs to know about them.
write_diff() {
  local out_file=$1

  local -a pathspec=(.)
  local g
  for g in '*.lock' '*-lock.json' '*.lockb' 'go.sum' '*.min.js' '*.min.css'; do
    pathspec+=( ":(exclude)$g" )
  done

  {
    print -r -- "Files changed:"
    git diff --cached --stat
    print
    print -r -- "Diff:"

    local body
    body=$(git diff --cached -U2 -- "${pathspec[@]}")

    if (( ${#body} > GC_DIFF_MAX_CHARS )); then
      print -r -- "${body[1,GC_DIFF_MAX_CHARS]}"
      print
      print -r -- "[diff truncated — the file summary above lists the full scope]"
    else
      print -r -- "$body"
    fi
  } > "$out_file"
}

build_prompt() {
  local diff_file=$1
  local previous_message=${2:-}

  if [[ -n "$previous_message" ]]; then
    cat <<EOF
Generate a better conventional commit message for this git diff.

The previous message was not satisfactory:

$previous_message

Improve it. Be more accurate, specific, and useful.

$(prompt_rules)

Git diff:

$(cat "$diff_file")
EOF
  else
    cat <<EOF
Generate a conventional commit message for this git diff.

$(prompt_rules)

Git diff:

$(cat "$diff_file")
EOF
  fi
}

prompt_rules() {
  if [[ "${GC_MULTI:-false}" == "true" ]]; then
    cat <<'EOF'
Format:

<type>[optional scope]: <short summary>

<body>

Rules:
- Return only the commit message.
- No markdown.
- No code fences.
- No explanation outside the commit message.
- First line must be conventional commit format.
- First line should be under 80 characters.
- Body should be 1-4 bullet points.
- Body should explain meaningful changes, not restate filenames.
- Use present tense.
- Use types like feat, fix, refactor, chore, docs, test, build, ci, perf.
- Add BREAKING CHANGE footer only if the diff clearly introduces one.
EOF
  else
    cat <<'EOF'
Rules:
- Return only the commit message.
- No markdown.
- No code fences.
- No explanation.
- One line only.
- Use format: <type>[optional scope]: <summary>
- Keep under 80 characters if possible.
- Use types like feat, fix, refactor, chore, docs, test, build, ci, perf.
EOF
  fi
}

generate_message() {
  local diff_file=$1
  local output_file=$2
  local previous_message=${3:-}

  local prompt_file="${output_file}.prompt"

  build_prompt "$diff_file" "$previous_message" > "$prompt_file"

  : > "$output_file"

  case "$GC_BACKEND" in
    claude)
      local err_file="${output_file}.err"
      # When git-sync is invoked from inside a Claude Code session, the parent
      # injects session env (nested-session guard, staging OAuth, proxy
      # base URL) that makes a plain `claude` refuse to run or hit a 401.
      # Strip that env so claude authenticates as a normal standalone CLI.
      local claude_env=(
        CLAUDECODE
        CLAUDE_CODE_ENTRYPOINT
        CLAUDE_CODE_SESSION_ID
        CLAUDE_CODE_CHILD_SESSION
        CLAUDE_CODE_EXECPATH
        CLAUDE_AGENT_SDK_VERSION
        CLAUDE_CODE_OAUTH_SCOPES
        CLAUDE_CODE_SDK_HAS_OAUTH_REFRESH
        CLAUDE_CODE_SDK_HAS_HOST_AUTH_REFRESH
        ANTHROPIC_BASE_URL
        USE_STAGING_OAUTH
        USE_LOCAL_OAUTH
      )
      # Writing a commit message needs none of the Claude Code harness. Left at
      # its defaults, a `claude --print` run loads the full system prompt, every
      # built-in tool definition, MCP servers, skills and project settings —
      # roughly 27k tokens of overhead on top of the diff — and then spends a
      # ~1.4k-token extended-thinking block walking the diff file by file before
      # emitting one line. The thinking block is what makes this slow; the rest
      # is what makes it expensive. Strip both.
      # JSON rather than bare text: the message comes back under .result, and
      # the same envelope carries the token usage report_round_trip prints.
      local -a claude_args=(
        --print
        --output-format json
        --model "${GC_CLAUDE_MODEL:-claude-haiku-4-5-20251001}"
        --system-prompt "You write conventional commit messages. Output only the commit message."
        --tools ""
        --strict-mcp-config
        --mcp-config '{"mcpServers":{}}'
        --setting-sources ""
        --disable-slash-commands
        --no-session-persistence
      )
      local json_file="${output_file}.json"
      local started=$EPOCHREALTIME

      if ! gum spin \
        --spinner dot \
        --title "Thinking..." \
        -- \
        zsh -c "env ${(j: :)${(@)claude_env/#/-u }} MAX_THINKING_TOKENS=0 ${(q)GC_CLAUDE_BIN} ${(j: :)${(@q)claude_args}} < ${(q)prompt_file} > ${(q)json_file} 2> ${(q)err_file}"
      then
        die "Claude failed: $(<"$err_file")$(<"$json_file")"
      fi

      local elapsed=$(( EPOCHREALTIME - started ))

      # A soft failure (API error, turn limit) still exits 0 and puts its
      # explanation in .result — catch it here, or it gets committed as the
      # commit message.
      if [[ "$(jq -r '.is_error // false' "$json_file" 2>/dev/null)" == "true" ]]; then
        die "Claude failed: $(jq -r '.result // .subtype // "unknown error"' "$json_file")"
      fi

      jq -r '.result // empty' "$json_file" > "$output_file" 2>/dev/null \
        || die "Claude returned unparseable output: $(<"$json_file")"
      [[ -s "$output_file" ]] || die "Claude returned an empty message"

      report_round_trip "$json_file" $elapsed
      ;;
    codex)
      # Writing a one-line commit message needs no deep reasoning. The user's
      # global ~/.codex/config.toml may set a high reasoning effort, which makes
      # every message slow to generate; override it low here just for git-sync.
      # ("minimal" is rejected when web_search/image_gen tools are enabled.)
      local started=$EPOCHREALTIME

      if ! gum spin \
        --spinner dot \
        --title "Thinking..." \
        -- \
        codex exec \
          -c model_reasoning_effort="${GC_REASONING:-low}" \
          --output-last-message "$output_file" \
          - < "$prompt_file"
      then
        die "Codex failed"
      fi
      [[ -s "$output_file" ]] || die "Codex returned an empty message"

      # `codex exec` reports no machine-readable usage alongside
      # --output-last-message, so timing is all there is to show here.
      note "$(printf '%.1fs' $(( EPOCHREALTIME - started )))"
      ;;
    *)
      die "Unknown backend: ${GC_BACKEND}"
      ;;
  esac
}

show_message() {
  local msg_file=$1

  gum style \
    --border rounded \
    --border-foreground 63 \
    --padding "0 1" \
    --width 100 \
    "$(<"$msg_file")"
}

edit_message() {
  local msg_file=$1
  local editor_cmd=${EDITOR:-vim}

  "$editor_cmd" "$msg_file"

  [[ -s "$msg_file" ]] || die "Commit cancelled: empty message"
}

commit_now() {
  local msg_file=$1

  print
  git diff --cached --stat
  print

  git commit -F "$msg_file"

  ok "Committed"
}

rebase_in_progress() {
  local git_dir
  git_dir=$(git rev-parse --git-dir)
  [[ -d "$git_dir/rebase-merge" || -d "$git_dir/rebase-apply" ]]
}

merge_in_progress() {
  local git_dir
  git_dir=$(git rev-parse --git-dir)
  [[ -f "$git_dir/MERGE_HEAD" ]]
}

has_conflicts() {
  [[ -n "$(git diff --name-only --diff-filter=U)" ]]
}

# An unmerged path stays in the index until it is staged, even after every
# marker has been removed from its working-tree file. Keep that Git state
# separate from the actual condition the AI is responsible for fixing.
has_conflict_markers() {
  local -a files
  files=( "${(@f)$(git diff --name-only --diff-filter=U)}" )

  local file
  for file in "${files[@]}"; do
    [[ -f "$file" ]] || continue
    LC_ALL=C grep -qE '^(<<<<<<<|\|\|\|\|\|\|\||=======|>>>>>>>)' "$file" \
      && return 0
  done

  return 1
}

# Stage only the paths that were unmerged. `git add -A` here would also sweep
# unrelated working-tree edits into the merge/rebase commit.
stage_conflicts() {
  local -a files
  files=( "${(@f)$(git diff --name-only --diff-filter=U)}" )
  (( ${#files} )) || return 0

  git add -A -- "${files[@]}"
}

push_now() {
  info "Pushing"
  git push
  ok "Pushed"
}

# Ask the configured backend to edit the currently-conflicted files in place.
# Its only job is to remove the conflict markers — staging and continuing the
# rebase is handled by resolve_rebase_with_ai, not the model.
ai_resolve_conflicts() {
  local files
  files=$(git diff --name-only --diff-filter=U)

  local prompt
  prompt=$(cat <<EOF
Resolve the git merge conflicts in this repository.

These files contain conflict markers (<<<<<<<, |||||||, =======, >>>>>>>):
$files

Edit each file in place to produce a correct merge that preserves the intent of
both sides, removing every conflict marker. Do not run git commands, do not
stage, do not commit — only edit the files.
EOF
)

  local rc=0
  case "$GC_BACKEND" in
    claude)
      # Same session-env strip as generate_message so claude authenticates as a
      # standalone CLI. acceptEdits lets it write files without prompting.
      local -a unset_args
      local v
      for v in \
        CLAUDECODE CLAUDE_CODE_ENTRYPOINT CLAUDE_CODE_SESSION_ID \
        CLAUDE_CODE_CHILD_SESSION CLAUDE_CODE_EXECPATH CLAUDE_AGENT_SDK_VERSION \
        CLAUDE_CODE_OAUTH_SCOPES CLAUDE_CODE_SDK_HAS_OAUTH_REFRESH \
        CLAUDE_CODE_SDK_HAS_HOST_AUTH_REFRESH ANTHROPIC_BASE_URL \
        USE_STAGING_OAUTH USE_LOCAL_OAUTH
      do
        unset_args+=(-u "$v")
      done
      gum spin --spinner dot --title "Resolving conflicts..." -- \
        env "${unset_args[@]}" \
          "$GC_CLAUDE_BIN" --print --permission-mode acceptEdits "$prompt" \
        || rc=$?
      ;;
    codex)
      gum spin --spinner dot --title "Resolving conflicts..." -- \
        codex exec -s workspace-write -c approval_policy="never" "$prompt" \
        || rc=$?
      ;;
  esac

  return $rc
}

# Run the AI on the currently-conflicted files, retrying at the user's
# choice if it fails or leaves markers behind. Returns 1 only once the user
# opts out to manual resolution.
resolve_conflicts_with_retry() {
  local attempt=0
  local files

  while true; do
    (( ++attempt ))

    files=$(git diff --name-only --diff-filter=U)
    info "Resolving conflicts: ${files//$'\n'/, }"

    if ai_resolve_conflicts && ! has_conflict_markers; then
      return 0
    fi

    if has_conflict_markers; then
      warn "AI left conflict markers in place"
    else
      warn "AI backend failed to resolve conflicts"
    fi

    if (( attempt >= GC_RETRY_LIMIT )); then
      warn "Conflict resolution failed after $attempt attempts"
      return 1
    fi

    confirm_retry "Retry conflict resolution with AI? (attempt $attempt/$GC_RETRY_LIMIT)" \
      || return 1
  done
}

# Run a git command that finalizes a staged resolution (rebase --continue,
# commit --no-edit), retrying at the user's choice if git itself fails — e.g.
# a signing agent that's down and just needs to be started. Without this,
# a failed --continue would leave the loop to misread the now-clean staged
# state as an empty replayed commit and `rebase --skip` it, silently
# dropping the work AI conflict resolution just did.
finalize_with_retry() {
  local description=$1
  shift

  local attempt=0
  local output_file output

  while true; do
    (( ++attempt ))

    output_file=$(mktemp)

    # Git and signing helpers are inconsistent about which stream carries the
    # useful diagnostic, so keep both. Previously stdout was discarded, which
    # reduced some failures to a blank warning and made retries guesswork.
    if GIT_EDITOR=true "$@" >"$output_file" 2>&1; then
      rm -f "$output_file"
      return 0
    fi

    output=$(<"$output_file")
    rm -f "$output_file"
    [[ -n "$output" ]] || output="no diagnostic output"

    warn "$description failed: $output"

    if (( attempt >= GC_RETRY_LIMIT )); then
      warn "$description failed after $attempt attempts"
      return 1
    fi

    confirm_retry "Retry '$description'? (attempt $attempt/$GC_RETRY_LIMIT)" \
      || return 1
  done
}

# `git rebase --continue` reports unrelated unstaged edits with the misleading
# "edit all merge conflicts" message. Detect that precondition ourselves so a
# retry cannot helpfully-but-pointlessly repeat the same command.
continue_rebase_with_retry() {
  if ! git diff --quiet; then
    warn "Unstaged changes block git rebase --continue:"
    git diff --name-only | sed 's/^/  • /'
    return 1
  fi

  finalize_with_retry "git rebase --continue" git rebase --continue
}

# Drive a conflicted rebase to completion with the AI: resolve markers, stage,
# continue, and repeat for each commit the rebase replays.
resolve_rebase_with_ai() {
  while rebase_in_progress; do
    if has_conflicts; then
      resolve_conflicts_with_retry || return 1

      stage_conflicts

      continue_rebase_with_retry || return 1
    elif ! git diff --cached --quiet; then
      # A previous git-sync run may have staged a successful resolution and
      # then stopped because --continue failed (for example, commit signing
      # was unavailable). Resume that staged replay; it is not an empty commit.
      continue_rebase_with_retry || return 1
    else
      # Mid-rebase with no conflicts and no staged change: the replayed commit
      # became empty because its change is already upstream.
      GIT_EDITOR=true git rebase --skip >/dev/null 2>&1 || return 1
    fi
  done

  return 0
}

# Complete an interrupted merge: resolve markers with the AI, stage, commit.
resolve_merge_with_ai() {
  if has_conflicts; then
    resolve_conflicts_with_retry || return 1
    stage_conflicts
  fi

  finalize_with_retry "git commit" git commit --no-edit || return 1
}

# Repo is mid-merge or mid-rebase (possibly with conflicts): drive it to a
# clean HEAD with the AI, then sync. Anything else in-progress (cherry-pick,
# bisect) is left to the user.
finish_conflicted_state() {
  warn "Repository has an interrupted merge/rebase"

  if has_conflicts; then
    git diff --name-only --diff-filter=U | sed 's/^/  • /'
  fi

  if rebase_in_progress; then
    resolve_rebase_with_ai \
      || die "AI could not finish the rebase — resolve manually (see 'git status')"
    ok "Conflicts resolved, rebase complete"
  elif merge_in_progress; then
    resolve_merge_with_ai \
      || die "AI could not finish the merge — resolve manually (see 'git status')"
    ok "Conflicts resolved, merge committed"
  else
    die "Conflicts outside a merge/rebase — resolve manually (see 'git status')"
  fi

  sync_repo
}

# Rebase onto the remote, then push. On conflict, hand it to the AI.
sync_repo() {
  info "Syncing with remote (pull --rebase)"

  if git pull --rebase --autostash; then
    push_now
    return
  fi

  # pull --rebase exited non-zero. Only a genuine rebase conflict is something
  # we can resolve; anything else (no upstream, network) is the user's.
  if ! rebase_in_progress || ! has_conflicts; then
    die "Sync failed — resolve manually, then push (see 'git status')"
  fi

  warn "Merge conflicts while rebasing onto the remote:"
  git diff --name-only --diff-filter=U | sed 's/^/  • /'

  resolve_rebase_with_ai \
    || die "AI could not finish the rebase — resolve manually (see 'git status')"

  ok "Conflicts resolved, rebase complete"
  push_now
}

commit_and_sync() {
  local msg_file=$1

  commit_now "$msg_file"
  sync_repo
}

main() {
  need git
  need gum

  [[ "$GC_RETRY_LIMIT" == <-> ]] && (( GC_RETRY_LIMIT > 0 )) \
    || die "GC_RETRY_LIMIT must be a positive integer"

  local staged_only=false
  export GC_MULTI=false

  if [[ -z "${GC_BACKEND:-}" ]]; then
    if resolve_claude >/dev/null; then
      GC_BACKEND=claude
    else
      GC_BACKEND=codex
    fi
  fi
  export GC_BACKEND

  while (( $# )); do
    case "$1" in
      --multi)
        export GC_MULTI=true
        ;;
      --staged-only)
        staged_only=true
        ;;
      --codex)
        export GC_BACKEND=codex
        ;;
      --claude)
        export GC_BACKEND=claude
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "Unknown option: $1"
        ;;
    esac
    shift
  done

  case "$GC_BACKEND" in
    codex)
      need codex
      ;;
    claude)
      need jq   # the --output-format json envelope is parsed with it
      GC_CLAUDE_BIN=$(resolve_claude) \
        || die "Missing dependency: claude (not on PATH, no desktop-app bundle)"
      export GC_CLAUDE_BIN
      ;;
    *)
      die "Unknown backend: $GC_BACKEND"
      ;;
  esac

  local repo_root
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null) \
    || die "Not inside a git repository"

  cd "$repo_root"

  local flags=("$GC_BACKEND")
  [[ "$GC_MULTI" == "true" ]] && flags+=(multi) || flags+=(single)
  $staged_only && flags+=(staged-only)

  gum style \
    --border rounded \
    --padding "0 1" \
    --border-foreground 63 \
    --bold \
    "󰊢 git sync · ${repo_root:t} · ${(j: :)flags}"

  # An interrupted merge/rebase takes priority over everything else: finish it
  # with the AI, sync, and stop.
  if rebase_in_progress || merge_in_progress || has_conflicts; then
    finish_conflicted_state
    return
  fi

  local has_staged=false has_unstaged=false
  git diff --cached --quiet || has_staged=true
  git diff --quiet || has_unstaged=true
  [[ -n "$(git ls-files --others --exclude-standard)" ]] && has_unstaged=true

  if ! $staged_only; then
    if $has_staged && $has_unstaged; then
      warn "Both staged and unstaged changes present"

      local stage_choice
      stage_choice=$(
        gum choose \
          --cursor "› " \
          --selected-prefix "● " \
          --unselected-prefix "○ " \
          --header "What should be committed?" \
          "stage everything" \
          "commit only what's staged"
      )
      [[ -n "$stage_choice" ]] || die "Cancelled"

      if [[ "$stage_choice" == "stage everything" ]]; then
        info "Staging all changes"
        git add -A
      fi
    elif $has_unstaged; then
      info "Staging all changes"
      git add -A
    fi
  fi

  # Nothing to commit: there may still be local commits to push, so sync.
  if git diff --cached --quiet; then
    info "Nothing to commit"
    sync_repo
    return
  fi

  local work_dir
  work_dir=$(mktemp -d)

  {
    local diff_file="$work_dir/diff.patch"
    local msg_file="$work_dir/message.txt"

    write_diff "$diff_file"

    info "Generating commit message"
    generate_message "$diff_file" "$msg_file"

    while true; do
      show_message "$msg_file"

      local action
      action=$(
        gum choose \
          --cursor "› " \
          --selected-prefix "● " \
          --unselected-prefix "○ " \
          "commit and sync" \
          "edit commit message" \
          "commit only" \
          "regenerate commit message"
      )

      case "$action" in
        "commit and sync")
          commit_and_sync "$msg_file"
          break
          ;;
        "edit commit message")
          edit_message "$msg_file"
          ;;
        "commit only")
          commit_now "$msg_file"
          break
          ;;
        "regenerate commit message")
          local previous_message
          previous_message=$(<"$msg_file")

          info "Regenerating commit message"
          generate_message "$diff_file" "$msg_file" "$previous_message"
          ;;
        *)
          die "Commit cancelled"
          ;;
      esac
    done

  } always {
    rm -rf "$work_dir"
  }
}

main "$@"
