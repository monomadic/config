[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true    # use n and N to move between diff sections
    light = false      # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default
[user]
	name = monomadic
	email = 129359+monomadic@users.noreply.github.com
	signingkey = ~/.ssh/id_ed25519.pub
[init]
	defaultBranch = development
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[pull]
	rebase = true
[gpg]
  format = ssh

[gpg "ssh"]
  # Wrapper around ssh-keygen that drops SSH_AUTH_SOCK first, so signing
  # always reads the key file and never waits on a 1Password approval.
  program = ~/.bin/ssh-sign-local

[commit]
  gpgsign = true

[add.interactive]
  useBuiltin = false # required for git 2.37.0
