# VirtualDJ settings worth keeping, applied with `vdj-settings apply`.
# Generated by `vdj-settings export` from settings.xml's modified=yes entries.
# settings.xml itself is not tracked: see the header of config/zsh/bin/vdj-settings.


# --- automation ---
automation/autoBPMMatch = always
automation/autoPitchLock = yes
automation/autoGain = no
automation/autoKey = yes
automation/autoCue = cue
automation/smartPlay = yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes, yes
automation/smartPlayLimitPitchRange = yes
automation/smartCue = yes, yes
automation/smartLoop = yes
automation/quantizeLoop = yes
automation/quantizeSetCue = yes
automation/globalQuantize = 1 beat
automation/smartScratch = no
automation/resetPitchOnLoad = yes
automation/resetEqOnLoad = no
automation/resetStemsOnLoad = No
automation/resetFXOnLoad = yes
automation/keyMatching = fuzzy full
automation/resetGainOnLoad = no
automation/quantizeScratch = yes

# --- controls ---
controls/playMode = play-pause
controls/cueMode = cue
controls/hotcueMode = play
controls/updateHotCueOnCueCombo = no
controls/hotcueSavesLoop = no
controls/loopBackMode = yes
controls/loopAutoMove = no
controls/loopDefault = 2.0, 32.0, 4.0, 16.0
controls/loopRollDefault = 1.0, 0.250
controls/eqMode = EZRemix
controls/defaultStemsEqMode = EZRemix
controls/stemsBleedMuteVocal = 0.545775
controls/stemsBleedMuteInstru = 0.538683
controls/stemsBleedOnlyVocal = 0.0
controls/vinylMode = yes
controls/masterTempo = no, yes
controls/pitchRange = 33.0
controls/autoPitchRange = no
controls/faderStart = no
controls/faderStartStop = yes
controls/crossfaderCurve = Scratch
controls/crossfaderDisable = yes
controls/crossfaderHamster = no
controls/mixFx = echo
controls/padsPagesOrder = 1 CUE, 2 SYNC, 3 FX, 3-FX, 4 PHRASE, 5 SAMPLER, 5-SAMPLER, 6 STEMS, 6-STEMS, 7 SLOTS, 7-SLOTS, 8 CUSTOM, 8-CUSTOM, AUTO CUES, Automix Cues, Automix Live, beatjump, BeatJump+HC, Codex - Mix FX Query Test, COLOR FX, ColorFX, CUE, CUE 16T, CUE CYCLE, CUE SCAN, CUE SEARCH, CUE-CHOP, CUE-CUTTER, CUE-EDIT, CUE-SEARCH II, CUE-STUTTER, cueloop, Cues and Stems, custom, DDJ-FLX10 PAD FX1, dmx, Dub Loop, ECHOPAD, EFFECTS, EFFECTS 16, ENERGY, FADES, FX, FX Fade, FX Manager, FX-ALL, FX-MULTISLOTS, FX-PADFX, FX-PRESETS, FX-SEL, FX-SLOTS, FX1, FXMulti, FXPRO, Groove, HOT CUE, hotcues, Hotcues 16, Hotcues 9-16, Hotcues XT, JUMP, keycue, loop, Loop Recorder, loop roll, loop+beatjump, Loop+HC, LOOPER, LOOPRIMING, manual loop, MIX FX QUERY TEST, MIXER, MULTIFX, PAD FX, PhantomFX, PHRASE, PUSH FX, REF: DECK ERROR TEST, REF: DUAL DECKMODE TEST, Reference - Deck Error Test, Reference - Dual Deck Mode Test, Reference - Mix FX Query Test, Reference - Sampler Loaded Test, Reference - Sparse Helper Tests, remix points, Roll+Slicer, sampler, SAMPLER READ ONLY, SAMPLER8, saved loops, scratch, scratchbank, slicer, SLOTFX, STEM FX, STEMFX, stems, Stems & FX, STEMS 16, Stems FX, Stems Split 3-Band, stems+fx, SYNC, SYNC-v2, Vocal FX, XP2 Transport, XP2-GRV6
controls/sixteenPadsMode = On
controls/loopPadPage = 0
controls/autoSortCues = no
controls/autoBpmTransitionLength = 16.0

