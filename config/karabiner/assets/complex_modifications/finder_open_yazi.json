    {
      "description": "Right Command + Y to open Kitty with Yazi (Finder and ForkLift)",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": ["^com\\.apple\\.finder$", "^com\\.binarynights\\.ForkLift$"]
            }
          ],
          "from": {
            "key_code": "y",
            "modifiers": {
              "mandatory": ["right_command"],
              "optional": ["any"]
            }
          },
          "to": [
            {
              "shell_command": "/Users/nom/.zsh/bin/finder-open-in-yazi"
            }
          ]
        }
      ]
    }
