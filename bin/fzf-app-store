#!/usr/bin/env zsh
# Browse the installers in scripts/install/ as an "app store": every entry shows
# whether it is installed, current, or has an update waiting. Enter runs the
# installer, then the list refreshes.
#
# "Needs an update":
#   src/ tools        a build input (*.rs, *.go, Cargo.toml, go.mod, ...), the
#   vendor/bin tools  vendored binary or the installer changed since the
#                     install — decided by bin/lib/install-staleness.zsh, the
#                     same check `deploy.sh --upgrade` uses
#   $SRC_PATH repos   upstream is ahead of the checkout, or the binary predates
#                     the checked-out commit
# Installers that download a release (rife, vsr, propainter, yt-dlp, ...) have
# nothing local to compare against, so they only report installed / not.
set -uo pipefail

typeset -r SELF="${0:A}"
typeset -r DOTFILES_DIR="${DOTFILES_DIR:-${SELF:h:h}}"
typeset -r INSTALL_DIR="$DOTFILES_DIR/scripts/install"
typeset -r SRC_PATH="${SRC_PATH:-$HOME/src}"
typeset -r BIN_DIR="$HOME/.local/bin"

source "${SELF:h}/lib/install-staleness.zsh"

usage() {
  cat <<'USAGE'
Usage: fzf-app-store [options] [initial query]

List every installer in scripts/install/ with its install status, and run the
selected one on enter.

Options:
      --list           Print the status list (TSV) and exit.
      --no-fetch       Don't git fetch the $SRC_PATH checkouts on startup.
  -h, --help           Show this help.

Keys:
  enter                Install / update the highlighted entry.
  ctrl-f               git fetch the $SRC_PATH checkouts, then refresh.
  ctrl-r               Refresh the list.
  ctrl-v               Toggle the preview.
USAGE
}

# Where each installer leaves its result, when that isn't ~/.local/bin/<name>.
typeset -A artifact_for=(
  bin                "$BIN_DIR/bin"
  cargo              "$HOME/.cargo/bin/cargo-recursive-clean"
  go-apps            "$HOME/go/bin/cgasm"
  wasmtime           "$HOME/.wasmtime/bin/wasmtime"
  job-monitor        "$HOME/Applications/Job Monitor.app"
  job-folder         "$HOME/Applications/Job Folder.app"
  wifi-widget        "$HOME/Applications/WiFi Widget.app"
  propainter         "$HOME/src/scrubber/.venv"
  rife-arm64         "$BIN_DIR/rife-ncnn-vulkan"
  vapoursynth-rife   "$HOME/.local/lib/vapoursynth/librife.dylib"
  vsr-arm64          "/Applications/VideoSubtitleRemover.app"
  yt-dlp             "$HOME/.local/share/uv/tools/yt-dlp"
)

# src/ subdirectory, when it isn't src/<name>. One workspace, three installers.
typeset -A src_for=(
  job-daemon   jobs
  job-monitor  jobs
  job-folder   jobs
)

installer_files() {
  local f
  for f in "$INSTALL_DIR"/*(.N); do
    [[ "${f:t}" == install-* || "${f:t}" == *.sh ]] && print -r -- "$f"
  done
}

# What each entry is, in a few words — the list's description column.
typeset -A about_for=(
  abner                      "A/B comparison player for videos"
  battery-widget             "Menu bar battery meter"
  bin                        "GitHub release binary manager"
  cargo                      "cargo-recursive-clean, for clearing Rust build dirs"
  chordpro-tui               "ChordPro chord chart browser"
  cpu-usage-widget           "Menu bar CPU and GPU load meter"
  dupchk                     "Finds duplicate files by size"
  free-disk-space-widget     "Menu bar free disk space meter"
  go-apps                    "Small Go command-line tools"
  job-daemon                 "Runs the jobs queue in the background"
  job-folder                 "Jobs queue and its menu bar, in one app"
  job-monitor                "Menu bar view of the jobs queue"
  menu-tidy                  "Hides menu bar clutter"
  motherfucker               "Spotlight replacement and app launcher"
  neuroserver-select-preset  "Previews and encodes Topaz Starlight presets"
  obsbot-rtsp-widget         "Menu bar control for the OBSBOT camera stream"
  pimped                     "Fast zsh prompt"
  propainter                 "AI video inpainting (removes objects and logos)"
  rclone-tower-ui            "Tower backup dashboard"
  rife-arm64                 "RIFE AI frame interpolation"
  safesync                   "Indexed drive sync with sentinels, offline lookup, TUI"
  spill                      "Fills a drive with files piped to it"
  switchblade                "Fullscreen media browser"
  system-uptime-widget       "Menu bar uptime display"
  tagform                    "Media tag editor"
  topaz-select-preset        "Previews and encodes Topaz Video AI presets"
  vapoursynth-rife           "RIFE frame interpolation plugin for VapourSynth"
  volume-control-widget      "Menu bar audio output and mute control"
  wifi-widget                "Menu bar Wi-Fi signal, band and internet check"
  vsr-arm64                  "Removes hardcoded subtitles from video"
  wasmtime                   "WebAssembly runtime"
  yt-dlp                     "Video downloader"
  ytform                     "Video downloader with a live tag form"
)

# Upstream-repo installers (lib/git-source-install.sh) name their repo on the
# git_source_install line, then the build kind and, for an app, its bundle.
git_source_repo() {
  awk '$1 == "git_source_install" { print $2; exit }' "$1"
}

git_source_app() {
  awk '$1 == "git_source_install" && $4 == "app" { gsub(/"/, "", $5); print $5; exit }' "$1"
}

artifact_of() {
  local name="$1" installer="$2" repo app
  if [[ -n "${artifact_for[$name]:-}" ]]; then
    print -r -- "${artifact_for[$name]}"
  elif app="$(git_source_app "$installer")" && [[ -n "$app" ]]; then
    print -r -- "/Applications/$app.app"
  elif repo="$(git_source_repo "$installer")" && [[ -n "$repo" ]]; then
    print -r -- "$BIN_DIR/$repo"
  else
    print -r -- "$BIN_DIR/$name"
  fi
}

# The about_for line; for an entry that has none yet, the first sentence of
# the installer's comment minus the "Build and install <name>, the" preamble.
description_of() {
  local installer="$1" name="$2" desc
  if [[ -n "${about_for[$name]:-}" ]]; then
    print -r -- "${about_for[$name]}"
    return
  fi
  desc="$(installer_comment "$installer")"
  desc="${desc%%. *}"
  desc="${desc%.}"
  desc="$(sed -E 's/^(Build and )?[Ii]nstall [^,:(]+([,:]| \([^)]*\)[,:]?)? *(the )?//' <<<"$desc")"
  print -r -- "${(U)desc[1]}${desc[2,-1]}"
}

installer_comment() {
  awk '
    NR == 1 && /^#!/ { next }
    /^#[[:space:]]*Generated by/ { next }
    /^#[[:space:]]*$/ { if (seen) exit; next }
    /^#/ { sub(/^#[[:space:]]*/, ""); printf "%s%s", (seen ? " " : ""), $0; seen = 1; next }
    { exit }
  ' "$1"
}

# Prints "<state>\t<reason>", state being one of: update, missing, ok, installed.
status_of() {
  local name="$1" installer="$2" artifact="$3"
  local repo src vendor hit ahead commit_epoch

  # A symlink into this repo is Dotter's, not an install.
  if [[ ! -e "$artifact" || ( -L "$artifact" && "${artifact:A}" == "$DOTFILES_DIR"/* ) ]]; then
    print -r -- $'missing\tnot installed'
    return
  fi

  if repo="$(git_source_repo "$installer")" && [[ -n "$repo" ]]; then
    src="$SRC_PATH/$repo"
    if [[ ! -d "$src/.git" ]]; then
      print -r -- $'installed\tno checkout at '"${src/#$HOME/~}"
      return
    fi
    ahead="$(git -C "$src" rev-list --count 'HEAD..@{upstream}' 2>/dev/null || echo 0)"
    if (( ahead > 0 )); then
      print -r -- $'update\tupstream is '"$ahead commit(s) ahead"
      return
    fi
    commit_epoch="$(git -C "$src" log -1 --format=%ct 2>/dev/null || echo 0)"
    if (( commit_epoch > $(stat -f %m "$artifact") )); then
      print -r -- $'update\tinstall predates the checked-out commit'
      return
    fi
    print -r -- $'ok\tup to date with '"$(git -C "$src" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null || echo HEAD)"
    return
  fi

  src="$DOTFILES_DIR/src/${src_for[$name]:-$name}"
  vendor="$DOTFILES_DIR/vendor/bin/$name"

  if [[ -d "$src" || -f "$vendor" ]]; then
    if hit="$(install_stale_reason "$installer" "$src" "$vendor" "$artifact")"; then
      print -r -- $'update\t'"$hit"
    else
      print -r -- $'ok\tbuilt from current source'
    fi
    return
  fi

  print -r -- $'installed\tinstalled (downloaded release; no local source to compare)'
}

# TSV: installer path, sort key, coloured badge, name, description.
list_entries() {
  local f name artifact state reason badge rank
  for f in $(installer_files); do
    name="$(install_entry_name "$f")"
    artifact="$(artifact_of "$name" "$f")"
    IFS=$'\t' read -r state reason <<<"$(status_of "$name" "$f" "$artifact")"
    case "$state" in
      update)    rank=1 badge=$'\e[33m↑ update       \e[0m' ;;
      missing)   rank=3 badge=$'\e[2m· not installed\e[0m' ;;
      ok)        rank=2 badge=$'\e[32m✓ up to date   \e[0m' ;;
      *)         rank=2 badge=$'\e[36m✓ installed    \e[0m' ;;
    esac
    printf '%s\t%s\t%s\t\e[1m%-26s\e[0m\t%s\n' \
      "$f" "$rank$name" "$badge" "$name" "$(description_of "$f" "$name")"
  done | LC_ALL=C sort -t $'\t' -k2,2 | cut -f1,3-
}

preview_entry() {
  local installer="$1" name artifact state reason
  name="$(install_entry_name "$installer")"
  artifact="$(artifact_of "$name" "$installer")"
  IFS=$'\t' read -r state reason <<<"$(status_of "$name" "$installer" "$artifact")"

  print -P -- "%B$name%b  $(description_of "$installer" "$name")"
  print
  print -r -- "status     $reason"
  print -r -- "updated    $(last_update_of "$name" "$installer")"
  [[ -e "$artifact" ]] && print -r -- "installed  $(stat -f '%Sm' -t '%Y-%m-%d %H:%M' "$artifact")"
  print -r -- "installer  ${installer#$DOTFILES_DIR/}"
  print -r -- "artifact   ${artifact/#$HOME/~}"
  print
  awk 'NR == 1 && /^#!/ { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$installer"
}

# When the source last changed: the newest commit of an upstream checkout
# (upstream's, once fetched, so a waiting update shows its date), or the last
# commit touching the src/ tree, vendored binary or installer here.
last_update_of() {
  local name="$1" installer="$2" repo src rev=HEAD
  local fmt='%cd (%cr)' date=--date=format:'%Y-%m-%d %H:%M'
  local -a paths

  if repo="$(git_source_repo "$installer")" && [[ -n "$repo" ]]; then
    src="$SRC_PATH/$repo"
    [[ -d "$src/.git" ]] || { print -r -- "unknown (no checkout)"; return; }
    git -C "$src" rev-parse -q --verify '@{upstream}' >/dev/null 2>&1 && rev='@{upstream}'
    git -C "$src" log -1 "$date" --format="$fmt" "$rev" 2>/dev/null
    return
  fi

  paths=("$installer")
  [[ -d "$DOTFILES_DIR/src/${src_for[$name]:-$name}" ]] && paths+=("$DOTFILES_DIR/src/${src_for[$name]:-$name}")
  [[ -f "$DOTFILES_DIR/vendor/bin/$name" ]] && paths+=("$DOTFILES_DIR/vendor/bin/$name")
  git -C "$DOTFILES_DIR" log -1 "$date" --format="$fmt" -- "${paths[@]}" 2>/dev/null
}

run_installer() {
  local installer="$1" name rc
  name="$(install_entry_name "$installer")"
  print -P -- "%B==> ${installer#$DOTFILES_DIR/}%b"
  if [[ -x "$installer" ]]; then
    "$installer"
  else
    sh "$installer"
  fi
  rc=$?
  print
  if (( rc == 0 )); then
    [[ -d "$DOTFILES_DIR/src/${src_for[$name]:-$name}" || -f "$DOTFILES_DIR/vendor/bin/$name" ]] &&
      install_record "$installer" "$DOTFILES_DIR/src/${src_for[$name]:-$name}" "$DOTFILES_DIR/vendor/bin/$name"
    print -P -- "%F{green}==> done%f"
  else
    print -P -- "%F{red}==> failed (exit $rc)%f"
  fi
  [[ -t 0 ]] && read -rs -k 1 '?Press any key to return to the list.'
}

fetch_checkouts() {
  local f repo
  for f in $(installer_files); do
    repo="$(git_source_repo "$f")"
    [[ -n "$repo" && -d "$SRC_PATH/$repo/.git" ]] || continue
    GIT_TERMINAL_PROMPT=0 git -C "$SRC_PATH/$repo" fetch --quiet --prune origin >/dev/null 2>&1 &
  done
  wait
}

main() {
  local fetch=1 query=""

  while (( $# )); do
    case "$1" in
      --list)          list_entries; return ;;
      --preview)       preview_entry "$2"; return ;;
      --install)       run_installer "$2"; return ;;
      --fetch)         fetch_checkouts; return ;;
      --no-fetch)      fetch=0 ;;
      -h|--help)       usage; return ;;
      -*)              print -u2 -r -- "Error: unknown option: $1"; usage >&2; return 2 ;;
      *)               query="$1" ;;
    esac
    shift
  done

  command -v fzf >/dev/null 2>&1 || { print -u2 -- "Error: missing dependency: fzf"; return 1; }

  (( fetch )) && fetch_checkouts

  list_entries | fzf \
    --ansi \
    --query="$query" \
    --delimiter=$'\t' \
    --with-nth=2.. \
    --nth=2,3 \
    --no-sort \
    --prompt='app store > ' \
    --header='enter install/update · ctrl-f fetch · ctrl-r refresh · ctrl-v preview' \
    --preview="${(q)SELF} --preview {1}" \
    --preview-window='right,50%,wrap' \
    --bind="enter:execute(${(q)SELF} --install {1})+reload(${(q)SELF} --list)" \
    --bind="ctrl-f:reload(${(q)SELF} --fetch; ${(q)SELF} --list)" \
    --bind="ctrl-r:reload(${(q)SELF} --list)" \
    --bind='ctrl-v:toggle-preview' \
    >/dev/null
  return 0
}

main "$@"
