#!/bin/zsh -f
# Only these two volumes may participate. Reformatting a disk requires updating
# its UUID here after checking `diskutil info -plist /Volumes/<name>`.
emulate -LR zsh
setopt ERR_EXIT NO_UNSET PIPE_FAIL
unsetopt BG_NICE
umask 077

readonly source_dir='/Volumes/Tower'
readonly destination_dir='/Volumes/Tower Backup'
readonly source_uuid='695E64CC-83EF-4155-AB6B-858E431468AC'
readonly destination_uuid='215CF628-9286-4D5A-9802-21DB64342287'
readonly history_dir="$destination_dir/.rclone"
readonly state_dir="$HOME/.rclone-tower-safe"
readonly retention_days=30

# Blast-radius guards. The largest run so far moved 285 files / 218G into
# history, so these leave room for a normal purge while still refusing to
# mirror a source tree that vanished or mounted empty. Override deliberately.
readonly max_delete=${RCLONE_TOWER_MAX_DELETE:-2000}
readonly max_delete_size=${RCLONE_TOWER_MAX_DELETE_SIZE:-1T}
# History holds full copies of everything replaced or deleted, so it grows
# without bound. A sync that starts with a nearly full destination fails
# partway and leaves a half-populated run directory behind.
readonly min_free_gib=${RCLONE_TOWER_MIN_FREE_GIB:-100}

die() { print -ru2 -- "rclone-tower-safe: $*"; exit 1; }
usage() { die 'Usage: rclone-tower-safe [--check-only | --dry-run | --prune]'; }

mode=${1:-sync}
(( $# <= 1 )) || usage
[[ $mode == sync || $mode == --check-only || $mode == --dry-run || $mode == --prune ]] || usage

# The dashboard re-enters this script; all disk and sync decisions stay here.
if [[ ${RCLONE_TOWER_DASHBOARD:-0} != 1 && -t 0 && -t 1 && ${TERM:-dumb} != dumb && $mode != --prune ]]; then
  if (( $+commands[rclone-tower-ui] )); then
    exec rclone-tower-ui "${0:A}" "$@"
  fi
  print -- 'Dashboard unavailable; install it with scripts/install/install-rclone-tower-ui.sh.'
fi

phase() {
  active_phase=$1
  print -r -- "Stage: $1"
}

# Reads $info, the plist held by the verify_volume call in scope, so that each
# volume costs one diskutil call rather than one per key.
plist_value() { print -r -- "$info" | /usr/bin/plutil -extract "$1" raw -o - -; }

verify_volume() {
  local volume=$1 expected_uuid=$2 writable=$3 info actual_uuid mount_point
  [[ -d $volume && ! -L $volume && -r $volume && -x $volume ]] ||
    die "Volume missing or unreadable: $volume"
  info=$(/usr/sbin/diskutil info -plist "$volume") || die "Cannot inspect $volume"
  actual_uuid=$(plist_value VolumeUUID) || die "Cannot identify $volume"
  mount_point=$(plist_value MountPoint) || die "Cannot find mount point for $volume"
  [[ $actual_uuid == $expected_uuid && $mount_point == $volume ]] ||
    die "Wrong disk or mount point: $volume (UUID $actual_uuid)"
  /bin/ls -f "$volume" >/dev/null || die "Cannot read directory entries on $volume"
  if [[ $writable == yes ]]; then
    [[ -w $volume && $(plist_value WritableVolume) == true ]] ||
      die "Destination is not writable: $volume"
  fi
}

verify_disks() {
  verify_volume "$source_dir" "$source_uuid" no
  verify_volume "$destination_dir" "$destination_uuid" yes
  [[ ! -L $history_dir ]] || die "Backup history must not be a symlink: $history_dir"
  [[ ! -e $history_dir || -d $history_dir ]] || die "Backup history is not a directory"
}

destination_free_gib() {
  local free_kib
  free_kib=$(/bin/df -Pk "$destination_dir" | /usr/bin/awk 'NR == 2 { print $4 }') ||
    die "Cannot read free space on $destination_dir"
  [[ $free_kib == <-> ]] || die "Cannot read free space on $destination_dir"
  print -- $(( free_kib / 1048576 ))
}

require_free_space() {
  local free_gib
  free_gib=$(destination_free_gib)
  (( free_gib >= min_free_gib )) ||
    die "Only ${free_gib} GiB free on $destination_dir (minimum ${min_free_gib} GiB).
  Reclaim history with: rclone-tower-safe --prune"
}

# Only direct, real directories with a recognized run name are candidates.
# Accept the original YYYY-MM-DD_HHMMSS names as well as the new unique suffix.
# Retention uses the run timestamp, never directory mtime (which copies change).
prune_history() {
  local forced=$1 candidate name stamp epoch cutoff reply
  typeset -a expired
  cutoff=$(( $(/bin/date +%s) - retention_days * 86400 ))
  for candidate in "$history_dir"/*(N/); do
    [[ ! -L $candidate && $candidate != $backup_dir ]] || continue
    name=${candidate:t}
    [[ $name =~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{6}(\.[[:alnum:]]{6})?$' ]] || continue
    stamp=${name[1,17]}
    epoch=$(/bin/date -j -f '%Y-%m-%d_%H%M%S' "$stamp" +%s 2>/dev/null) || continue
    if (( epoch < cutoff )); then
      expired+=("$candidate")
    fi
  done
  if (( ${#expired} == 0 )); then
    print -- "No backup runs older than $retention_days days."
    return 0
  fi
  print -- "Backup runs older than $retention_days days eligible for permanent removal:"
  printf '  %s\n' "${expired[@]}"
  if [[ $forced != forced ]]; then
    # No unattended pruning, including piped input or a closed terminal.
    if [[ ! -t 0 ]]; then
      print -- "Pruning skipped: no interactive terminal. Reclaim with: rclone-tower-safe --prune"
      return 0
    fi
    read -r 'reply?Permanently remove these backup runs? [y/N] ' || reply=n
    [[ $reply == [yY] ]] || { print -- 'Nothing pruned.'; return 0; }
  fi
  verify_disks
  for candidate in "${expired[@]}"; do
    [[ -d $candidate && ! -L $candidate ]] || die "Backup changed before pruning: $candidate"
    /bin/rm -r -- "$candidate" || die "Pruning failed: $candidate"
    print -- "Removed: $candidate"
  done
  print -- "$(destination_free_gib) GiB now free on $destination_dir."
}

phase 'Checking disk identities'
verify_disks
if [[ $mode == sync || $mode == --dry-run ]]; then
  (( $+commands[rclone] )) || die 'rclone is not installed'
fi

# Keep the lock inode in place. The OS releases the advisory lock on exit;
# deleting the file would let another process lock a different inode.
[[ ! -L $state_dir ]] || die "State directory must not be a symlink: $state_dir"
/bin/mkdir -p "$state_dir"
[[ -O $state_dir ]] || die "State directory is not owned by this user: $state_dir"
/bin/chmod 700 "$state_dir"
[[ ! -L $state_dir/lock ]] || die 'Lock file must not be a symlink'
: >> "$state_dir/lock"
zmodload zsh/system
zsystem flock -t 0 -f lock_fd "$state_dir/lock" 2>/dev/null ||
  die 'Another Tower sync or prune is already running'

readonly log_file="$state_dir/sync.log"
[[ ! -L $log_file ]] || die 'Log file must not be a symlink'
verify_disks

active_phase='preflight'
# Forward interrupts and wait for the active child before releasing the lock.
sync_pid=''
stop_sync() {
  trap '' INT TERM HUP
  if [[ -n $sync_pid ]]; then
    kill -TERM "$sync_pid" 2>/dev/null || true
    wait "$sync_pid" 2>/dev/null || true
  fi
  print -ru2 -- "Interrupted during $active_phase. The operation did not complete."
  exit "$1"
}
trap 'stop_sync 130' INT
trap 'stop_sync 143' TERM
trap 'stop_sync 129' HUP

# Check filesystem structures, not file contents. Never repair automatically.
# diskutil may temporarily unmount a volume; recheck both identities afterward.
verify_filesystems() {
  local volume result
  for volume in "$source_dir" "$destination_dir"; do
    active_phase="filesystem verification of ${volume:t}"
    phase "Checking filesystem: ${volume:t}"
    /usr/sbin/diskutil verifyVolume "$volume" &
    sync_pid=$!
    if wait "$sync_pid"; then
      sync_pid=''
    else
      result=$?
      sync_pid=''
      print -ru2 -- "Filesystem verification failed for $volume (exit $result).
Sync was not started. Review the disk in Disk Utility before retrying."
      exit "$result"
    fi
    print -- "Filesystem check passed: ${volume:t}"
  done
  verify_disks
}

if [[ $mode == sync || $mode == --check-only ]]; then
  verify_filesystems
fi
if [[ $mode == --check-only ]]; then
  print -- 'Both expected volumes passed filesystem verification.'
  print -- "$(destination_free_gib) GiB free on $destination_dir (minimum ${min_free_gib} GiB to sync)."
  exit 0
fi

# Pruning takes the same lock so it cannot race a sync writing into history.
backup_dir=''
if [[ $mode == --prune ]]; then
  active_phase=pruning
  prune_history forced
  exit 0
fi

typeset -a run_flags
if [[ $mode == --dry-run ]]; then
  run_flags=(--dry-run)
  backup_dir="$history_dir/dry-run"
else
  phase 'Checking free space'
  require_free_space
  /bin/mkdir -p "$history_dir"
  # Atomic allocation also verifies that we can actually write to this disk.
  backup_dir=$(/usr/bin/mktemp -d "$history_dir/$(/bin/date +%F_%H%M%S).XXXXXX")
  # mktemp honours the 077 umask; match the browsable history dirs around it.
  /bin/chmod 755 "$backup_dir"
fi

typeset -a display_flags
display_flags=(-P --stats 1s --stats-log-level NOTICE)
if [[ ${RCLONE_TOWER_DASHBOARD:-0} == 1 ]]; then
  display_flags=(--use-json-log --stats 1s --stats-log-level NOTICE)
  # Start a fresh per-run log: the UI never interprets old runs as new activity.
  # Retain the previous log for diagnosis; rclone rotates during this run.
  [[ ! -L $state_dir/previous.log ]] || die 'Previous log must not be a symlink'
  [[ ! -e $log_file ]] || /bin/mv -f "$log_file" "$state_dir/previous.log"
  : > "$log_file"
  print -r -- "Log: $log_file"
fi
phase 'Scanning and syncing'
print -- "Syncing Tower → Tower Backup ($mode). Log: $log_file"
# Size + modification time is intentional for large, frequently renamed videos.
# Renames deliberately skip content hashing; equal size and modtime are trusted.
# Keep conservative disk concurrency and rclone's normal transfer verification.
rclone sync "${display_flags[@]}" "${run_flags[@]}" \
  --track-renames --track-renames-strategy size,modtime \
  --metadata \
  --create-empty-src-dirs \
  --transfers 1 --checkers 3 \
  --max-delete "$max_delete" --max-delete-size "$max_delete_size" \
  --log-file "$log_file" --log-level INFO \
  --log-file-max-size 10M --log-file-max-backups 3 \
  --backup-dir "$backup_dir" \
  --exclude "/.rclone/**" \
  --exclude "/Installers/Cyberpunk MacOS/**" \
  --exclude "/.Trashes/**" \
  --exclude "/.TemporaryItems/**" \
  --exclude "/.Spotlight-V100/**" \
  --exclude "/.DocumentRevisions-V100/**" \
  --exclude "/.fseventsd/**" \
  --exclude "/.VolumeIcon.icns" \
  --exclude ".DS_Store" \
  --exclude "/.com.apple.timemachine.donotpresent" \
  --exclude "/lost+found/**" \
  "$source_dir/" "$destination_dir/" &
sync_pid=$!
if wait "$sync_pid"; then
  sync_pid=''
else
  result=$?
  sync_pid=''
  print -ru2 -- "Sync failed (exit $result); history was not pruned. See $log_file"
  exit "$result"
fi

verify_disks
[[ $mode != --dry-run ]] || { print -- 'Dry run complete; nothing pruned.'; exit 0; }
phase 'Finishing and retaining history'
prune_history ask
print -- "Free space after sync: $(destination_free_gib) GiB"
print -- 'Done.'
