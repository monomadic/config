#!/usr/bin/env zsh
# interpolate-resolve-job
# Queue DaVinci Resolve interpolation instead of running it here: sets up a
# job-folder workflow for the settings (fps, quality, codec) and queues each
# input on it.
#
#   interpolate-resolve-job [options] [fps] <input-file>...
#
# The workflow is named for the work — interpolate-resolve-60fps,
# interpolate-resolve-120fps-speed-warp-prores — so two renders of one clip
# land in different queues, and each folder can be reused by dropping more
# files into its input/. Its job.sh calls the deployed interpolate-resolve on
# $INPUT and writes into $OUTPUT_DIR.
#
# Installing it and queueing the files — which jobs folder, whether there is
# room, the atomic handoff — is send-job's work. Inputs go by --link unless
# --copy is given: input/ gets a symlink, and Resolve reads the source where it
# lies. That is the point with multi-gigabyte files on a local disk and the
# queue on this machine — and the one thing to keep in mind when send-job asks
# where to send it, since a link only makes sense to a runner that can see the
# path it points at.
#
# Resolve renders one timeline at a time through the scripting API. job-folder
# runs one input per workflow at a time, but different workflows side by side,
# so set its Workers to 1 if more than one Resolve workflow may be busy.

emulate -L zsh
setopt extended_glob
set -euo pipefail

script_name="${0:t}"

# The *deployed* path, not the repo one: the job runs from job-folder, which
# knows nothing about where this checkout lives.
interpolate="${INTERPOLATE_RESOLVE:-$HOME/.local/bin/interpolate-resolve}"
send_job="${SEND_JOB:-${0:A:h}/send-job}"
jobs_dir=""   # only when asked for; otherwise send-job chooses or asks

target_fps=60
quality=enhanced-better
use_prores=0
payload_mode=--link
dry_run=false
typeset -a positional=()

usage() {
  cat <<EOF
$script_name

Queue DaVinci Resolve interpolation on a job-folder workflow.

Usage:
  $script_name [options] [fps] <input-file>...

Arguments:
  [fps]              Target FPS as the first positional (60, 120, 23.976).
                     Defaults to 60.
  <input-file>       One or more input media files; one run each.

Options:
  --fps FPS          Target FPS. Overrides the positional FPS.
  --quality MODE     Optical Flow quality: enhanced-better, speed-warp
  --speed-warp       Shortcut for --quality speed-warp
  --prores           Render ProRes 422 Proxy MOV instead of HEVC MP4
  --copy             Copy the inputs into the workflow instead of linking them
  --dir DIR          Jobs folder, passed straight to send-job. Without it
                     send-job picks the folder, or asks. Also --dir=DIR.
  --dry-run          Print the workflow, write and send nothing
  -h, --help         Show help

Environment:
  JOBS_DIR             Jobs folder (send-job honours it)
  SEND_JOB             send-job to hand the workflow to
  INTERPOLATE_RESOLVE  Renderer the job calls (default: ~/.local/bin/interpolate-resolve)

Examples:
  $script_name clip.mp4
  $script_name 120 a.mp4 b.mov
  $script_name --prores --speed-warp clip.mp4
EOF
}

die() {
  print -u2 -- "$script_name: $1"
  exit "${2:-1}"
}

normalize_fps() {
  local fps="${1:l}"
  fps="${fps%fps}"
  [[ "$fps" =~ '^[0-9]+([.][0-9]+)?$' ]] || die "invalid fps: $1" 2
  [[ "$fps" == "0" || "$fps" == "0."* ]] && die "fps must be greater than zero: $1" 2
  print -r -- "$fps"
}

while (( $# )); do
  case "$1" in
    --fps)
      (( $# >= 2 )) || die "missing argument for --fps" 2
      target_fps="$(normalize_fps "$2")"
      shift 2
      ;;
    --fps=*)
      target_fps="$(normalize_fps "${1#--fps=}")"
      shift
      ;;
    --quality)
      (( $# >= 2 )) || die "missing argument for --quality" 2
      case "$2" in
        enhanced-better|speed-warp) quality="$2" ;;
        *) die "unknown quality: $2 (enhanced-better, speed-warp)" 2 ;;
      esac
      shift 2
      ;;
    --speed-warp)
      quality=speed-warp
      shift
      ;;
    --prores)
      use_prores=1
      shift
      ;;
    --copy)
      payload_mode=--copy
      shift
      ;;
    --dir)
      (( $# >= 2 )) || die "missing argument for --dir" 2
      jobs_dir="$2"
      shift 2
      ;;
    --dir=*)
      jobs_dir="${1#--dir=}"
      shift
      ;;
    --dry-run)
      dry_run=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      positional+=( "$@" )
      break
      ;;
    -*)
      die "unknown option: $1" 2
      ;;
    *)
      positional+=( "$1" )
      shift
      ;;
  esac
done

# A leading bare number is the fps, as in interpolate-resolve itself.
if (( ${#positional[@]} > 1 )) && [[ "${positional[1]:l}" =~ '^[0-9]+([.][0-9]+)?(fps)?$' ]]; then
  target_fps="$(normalize_fps "${positional[1]}")"
  positional=( "${positional[@]:1}" )
fi

(( ${#positional[@]} )) || { usage >&2; die "no input file given" 2 }
for input in "${positional[@]}"; do
  [[ -f "$input" ]] || die "input file not found: $input"
done

if ! $dry_run && [[ ! -x "$send_job" ]]; then
  send_job="$(command -v send-job)" || die "send-job not found (set \$SEND_JOB)"
fi

# Reference the renderer through $HOME so the job survives another account.
renderer_ref="${(qq)interpolate}"
if [[ "$interpolate" == "$HOME"/* ]]; then
  rest="${interpolate#$HOME/}"
  if [[ "$rest" == [A-Za-z0-9._/-]## ]]; then
    renderer_ref="\"\$HOME\"/$rest"
  else
    renderer_ref="\"\$HOME\"/${(qq)rest}"
  fi
fi

fps_label="${target_fps//./p}"
workflow="interpolate-resolve-${fps_label}fps"
[[ "$quality" != enhanced-better ]] && workflow+="-$quality"

typeset -a job_options=( --fps "$target_fps" --quality "$quality" )
description="${target_fps}fps, $quality"
# interpolate-resolve's own naming: clip.hevc60.mp4, clip.prores60.mov.
output_suffix=".hevc$fps_label.mp4"
if (( use_prores )); then
  job_options+=( --prores )
  description+=", ProRes 422 Proxy"
  workflow+="-prores"
  output_suffix=".prores$fps_label.mov"
fi

option_line=""
for option in "${job_options[@]}"; do
  if [[ "$option" == --* ]]; then
    option_line+=" $option"
  else
    option_line+=" ${(qq)option}"
  fi
done

# Resolve renders into a hidden .partial/ folder and the result is renamed into
# output/ only once it exits cleanly, so a stopped or crashed render never
# leaves something that looks finished — and a rerun of a finished input is a
# no-op rather than a second render.
job_text="#!/bin/zsh
# DaVinci Resolve interpolation workflow — generated by $script_name
# $description
# One file per run: the source is \$INPUT, the result goes in \$OUTPUT_DIR.
set -euo pipefail
: \"\${INPUT:?run me through job-folder, or set INPUT and OUTPUT_DIR}\"
: \"\${OUTPUT_DIR:?run me through job-folder, or set INPUT and OUTPUT_DIR}\"
name=\"\${INPUT_NAME:-\${\${INPUT:t}:r}}$output_suffix\"
if [[ -e \"\$OUTPUT_DIR/\$name\" ]]; then
  print -- \"already done: \$OUTPUT_DIR/\$name\"
  exit 0
fi
mkdir -p -- \"\$OUTPUT_DIR/.partial\"
rm -f -- \"\$OUTPUT_DIR/.partial/\$name\"
$renderer_ref$option_line -- \"\${INPUT:A}\" \"\$OUTPUT_DIR/.partial/\$name\"
mv -- \"\$OUTPUT_DIR/.partial/\$name\" \"\$OUTPUT_DIR/\$name\"
print -- \"done: \$OUTPUT_DIR/\$name\""

if $dry_run; then
  print -- "workflow: $workflow${jobs_dir:+ -> $jobs_dir}"
  print -r -- "$job_text"
  print
  print -- "inputs (${payload_mode#--}):"
  for input in "${positional[@]}"; do
    print -- "  ${input:A}"
  done
  exit 0
fi

staging="$(mktemp -d "${TMPDIR:-/tmp}/interpolate-resolve-job.XXXXXX")" \
  || die "could not make a staging directory"
trap 'rm -rf -- "$staging" 2>/dev/null || true' EXIT INT TERM

print -r -- "$job_text" > "$staging/job.sh" || die "could not write the job script"
chmod +x "$staging/job.sh" || die "could not make the job script executable"

# Everything from here — which jobs folder, free space, the atomic handoff —
# is send-job's job, and only has to be right in one place.
"$send_job" --job "$staging/job.sh" $payload_mode ${jobs_dir:+--dir="$jobs_dir"} \
  -- "$workflow" "${positional[@]}" \
  || die "send-job could not queue on $workflow"
