#!/usr/bin/osascript
-- finder-open-in-yazi
-- Open Yazi in a new Kitty OS window at the folder shown in the front
-- Finder or ForkLift window. Selected items are passed to yazi so it
-- opens with them highlighted.
--
-- Usage:  finder-open-in-yazi [finder|forklift]
-- Without an argument the frontmost application decides. Launching is
-- delegated to kitty-launch, which handles the Kitty IPC / cold-start cases.

use framework "Foundation"
use scripting additions

on run argv
	set which to ""
	if (count of argv) > 0 then set which to item 1 of argv
	if which is "" then
		tell application "System Events" to set frontId to bundle identifier of first application process whose frontmost is true
		if frontId is "com.binarynights.ForkLift" then
			set which to "forklift"
		else
			set which to "finder"
		end if
	end if

	if which is "forklift" then
		set {dir, selPaths} to my forkliftTarget()
	else
		set {dir, selPaths} to my finderTarget()
	end if
	if dir is "" then return

	set kittyLaunch to (POSIX path of (path to home folder)) & ".local/bin/kitty-launch"
	set cmd to kittyLaunch & " --os-window --cwd " & quoted form of dir & " --title ' yazi ' -- yazi"
	repeat with p in selPaths
		set cmd to cmd & " " & quoted form of p
	end repeat
	do shell script cmd
end run

-- Finder: the selection if there is one, otherwise the window's folder.
on finderTarget()
	tell application "Finder"
		set sel to selection
		set paths to {}
		repeat with anItem in sel
			set end of paths to POSIX path of (anItem as alias)
		end repeat
		try
			set dir to POSIX path of (target of front window as alias)
		on error
			set dir to POSIX path of (path to home folder)
		end try
	end tell
	if paths is not {} then set dir to my parentOf(item 1 of paths)
	return {dir, paths}
end finderTarget

-- ForkLift 4: the active tab's displayed URL. Remote tabs (sftp, s3, ...)
-- have no local path, so fall back to the home folder.
on forkliftTarget()
	tell application "ForkLift" to set theUrl to displayedUrl of activeTab 1 of front window
	if theUrl does not start with "file://" then return {POSIX path of (path to home folder), {}}
	set u1 to current application's NSURL's URLWithString:theUrl
	return {(u1's |path|()) as text, {}}
end forkliftTarget

on parentOf(p)
	set nsp to current application's NSString's stringWithString:p
	if nsp's hasSuffix:"/" then set nsp to nsp's stringByDeletingLastPathComponent()
	return (nsp's stringByDeletingLastPathComponent()) as text
end parentOf
