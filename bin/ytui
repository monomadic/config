#!/usr/bin/env zsh
# ============================================================================
# ytui — an interactive TUI wrapper around yt-dlp
# ============================================================================
#
# Download a URL with yt-dlp behind a live TUI: the thumbnail on the left, the
# progress bar and stats beside it, and below them two sections — the FILE the
# run will write (extractor, filename, directory, container, resolution, fps,
# bitrate) and the METADATA yt-dlp found on the page and embeds into it (title,
# channel, actors, date, duration, tags, category, description). Any arguments
# before the URL are passed straight through to yt-dlp, so the yt-dlp config
# aliases work as usual:
#
#   ytui --porn   https://…      # --porn is a yt-dlp --alias (see ~/.config/yt-dlp/config)
#   ytui --visuals https://…
#   ytui -f best  https://…
#
# The URL is always the LAST argument
#
# Gallery / index pages (a model page, a channel, a playlist) are detected in the
# preflight and switch the UI into gallery mode: an overall bar across the items
# plus the current item's own bar, filename, metadata and thumbnail.
#
# Keys while downloading:
#   p   pause / resume the download (SIGSTOP/SIGCONT on yt-dlp)
#   o   open in mpv — stream the growing .part file (keep downloading)
#   d   delete — stop yt-dlp, remove its partial/temp files AND the line in the
#       download archive, then exit (asks first)
#   q   cancel — stop yt-dlp, keep the partials (--continue picks them up), exit
#
# When the download finishes, a final prompt offers `r` (reveal in Finder via
# `open --reveal`), `o` (open with the default app) and `d` (delete the file and
# its archive line); any other key exits.
#
# Layout: with a window of at least 72×26 the full view is drawn; anything
# smaller gets the compact view — a small thumbnail, the title, the bar and the
# stats, nothing else. Both re-lay out on resize. Thumbnails need kitty.
#
# Subtitles: if yt-dlp wrote any .vtt sidecars next to an .mp4 (--write-subs /
# --write-auto-subs in the config or on the command line), each is embedded as a
# mov_text track with mp4-embed-vtt and the .vtt is deleted once that succeeds.
# A failed embed leaves both files as they were.
#
# How it works: yt-dlp runs in the background writing a machine-readable
# progress line (via --progress-template) into a fifo; the main loop waits on
# that fifo AND the terminal at once with zsh/zselect, so keystrokes stay
# responsive without busy-waiting. A short preflight (--simulate --print)
# resolves the output path and the metadata up front, so the thumbnail job and
# mpv streaming both know where the file will land.
#
# Debugging: YTUI_DEBUG_LOG=<file> appends every line read from yt-dlp.
#
# Dependencies: yt-dlp, mpv (for `o`), mp4-embed-vtt (subtitle embedding).
# See also: yt-dlp-stream, mp4-embed-vtt, ytq
# ============================================================================
emulate -L zsh
setopt pipefail extended_glob
zmodload zsh/zselect

SELF="${0:t}"

# ── colors ──────────────────────────────────────────────────────────────────
# C_BORDER/C_DESC use an explicit 256-color gray, NOT \e[90m ("bright black") —
# themes are free to map color8 to whatever they want, including literal black
# (e.g. the "1984" theme here maps both color0 AND color8 to #000000), which
# makes \e[90m text invisible on a black background. \e[38;5;244m is a fixed
# mid-gray independent of the terminal's ANSI palette.
typeset -gr \
  C_BORDER=$'\e[38;5;244m' \
  C_KEY=$'\e[97m'    C_DESC=$'\e[38;5;244m'   C_FILE=$'\e[1;36m' \
  C_OK=$'\e[32m'     C_ERR=$'\e[31m'    C_WARN=$'\e[33m'   \
  C_DIM=$'\e[2m'     C_BOLD=$'\e[1m'    C_ACCENT=$'\e[38;5;39m' \
  C_BAR=$'\e[38;5;46m'  C_SECT=$'\e[38;5;141m' \
  C_RESET=$'\e[0m'

die()  { print -ru2 -- "${SELF}: $*"; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

usage() {
  cat <<EOF
Usage: $SELF [yt-dlp args...] <url>

Download <url> with yt-dlp behind an interactive TUI. Everything before the URL
is forwarded to yt-dlp, so config aliases work: e.g. \`$SELF --porn <url>\`.

Keys:  p pause/resume · o open in mpv · d delete (partials + archive line) · q cancel
EOF
}

trim() { local s="$1"; s="${s#"${s%%[![:space:]]*}"}"; s="${s%"${s##*[![:space:]]}"}"; print -rn -- "$s"; }

# Strip a common form of ANSI SGR sequences (yt-dlp colors its log lines).
strip_ansi() { local s="$1"; s="${s//$'\e'\[[0-9;]#[a-zA-Z]/}"; print -rn -- "$s"; }

# Filesystem-safe: no slashes or control chars in a filename component.
sanitize() { local s="$1"; s="${s//\//-}"; s="${s//$'\n'/ }"; s="${s//$'\t'/ }"; print -rn -- "$(trim "$s")"; }

# A yt-dlp "absent" value: --output-na-placeholder "" makes it empty, otherwise
# it is the literal NA (or none from a %(…)l list).
na() { local s="$(trim "$1")"; [[ "$s" == (NA|none|null) ]] && s=""; print -rn -- "$s"; }

# Bytes → yt-dlp-style human units (MiB/GiB), so an estimate reads like the rest.
human_bytes() {
  local -i b=${1:-0}
  if   (( b >= 1073741824 )); then printf '%.2fGiB' "$(( b / 1073741824.0 ))"
  elif (( b >= 1048576 ));    then printf '%.1fMiB' "$(( b / 1048576.0 ))"
  elif (( b >= 1024 ));       then printf '%.1fKiB' "$(( b / 1024.0 ))"
  else                             printf '%dB' "$b"
  fi
}

# Width/height/fps as yt-dlp reports them → "1920×1080 · 60fps". Any of them can
# be absent ("NA", "none" or empty): audio-only gives nothing at all, and some
# extractors only know the height.
format_video_info() {
  local w="${1//[^0-9]/}" h="${2//[^0-9]/}" fps="${3//[^0-9.]/}" out=""
  if   [[ -n "$w" && -n "$h" ]]; then out="${w}×${h}"
  elif [[ -n "$h" ]];            then out="${h}p"
  fi
  if [[ "$fps" == [0-9]* ]] && (( fps > 0 )); then
    fps="$(printf '%.2f' "$fps")"               # 29.97002997 → 29.97, 60.0 → 60
    fps="${fps%%0#}"; fps="${fps%.}"
    out+="${out:+ · }${fps}fps"
  fi
  print -rn -- "$out"
}

# Nominal bitrate. yt-dlp's tbr (kbit/s, the format's own figure) when the
# extractor gives one, otherwise worked back from filesize ÷ duration; both are
# approximations and are marked as such. Nothing at all when neither is known.
format_bitrate() {
  local tbr="${1//[^0-9.]/}" size="${2//[^0-9]/}" dur="${3//[^0-9.]/}"
  local -F kbps=0; local mark="~"
  if [[ "$tbr" == [0-9]* ]] && (( tbr > 0 )); then
    (( kbps = tbr ))
  elif [[ -n "$size" && "$dur" == [0-9]* ]] && (( size > 0 && dur > 0 )); then
    (( kbps = size * 8.0 / dur / 1000 )); mark="≈"
  else
    return
  fi
  if (( kbps >= 1000 )); then printf '%s%.1f Mbps' "$mark" "$(( kbps / 1000 ))"
  else                        printf '%s%.0f kbps' "$mark" "$kbps"
  fi
}

# "avc1.640028" → "avc1", "" / "none" → "" — just the codec family for the UI.
codec_name() { local c="$(na "$1")"; print -rn -- "${c%%.*}"; }

# ── disk space ───────────────────────────────────────────────────────────────
# Two floors on the filesystem we're writing into: below LOW_SPACE_WARN the run
# asks before it starts at all, below LOW_SPACE_HALT it stops mid-download.
typeset -gr LOW_SPACE_WARN=$(( 8 * 1073741824 ))   # 8GiB — ask first
typeset -gr LOW_SPACE_HALT=$(( 2 * 1073741824 ))   # 2GiB — stop and wait

# Free bytes on the filesystem holding <path>, walking up to the nearest
# directory that exists (the output dir is created later than the first check).
# Prints nothing and returns 1 if df can't answer — no answer never blocks a run.
free_bytes() {
  local p="${1:-$PWD}"
  while [[ -n "$p" && "$p" != / && ! -d "$p" ]]; do p="${p:h}"; done
  [[ -d "$p" ]] || return 1
  local -a lines
  lines=( ${(f)"$(df -k -- "$p" 2>/dev/null)"} )
  (( ${#lines} >= 2 )) || return 1
  local avail="${${(z)lines[-1]}[4]}"        # macOS df -k: Avail is field 4
  [[ "$avail" == <-> ]] || return 1
  print -r -- $(( avail * 1024 ))
}

# Asked once, before the TUI is up, so the answer is a plain terminal prompt.
# Starting a multi-GB download on a nearly full disk is usually a mistake, but
# it's the user's call — a df that can't answer is not treated as "low".
confirm_low_space() {
  local -i free
  free=$(free_bytes "$proposed_dir") || return 0
  (( free > 0 && free < LOW_SPACE_WARN )) || return 0
  local ans
  print -r -- "${C_WARN}${SELF}: only $(human_bytes free) free on ${proposed_dir}${C_RESET}"
  if read -q "ans?  Low disk space, download anyway? [y/N] " </dev/tty; then
    print -r -- ""
  else
    print -r -- ""
    print -ru2 -- "${SELF}: cancelled — low disk space"
    exit 1
  fi
}

# The hard floor, checked while the download runs — at most once per run: stop
# yt-dlp where it stands (the .part is kept, --continue picks it back up) and
# leave the message on screen. `p` resumes once space has been freed.
check_space_live() {
  (( space_halted )) && return
  (( ++space_ticks % 10 )) && return          # ~2s apart, not every frame
  local dir="$proposed_dir"
  [[ -n "$dl_dest" ]] && dir="${dl_dest:h}"   # --paths temp: puts the .part elsewhere
  local -i free
  free=$(free_bytes "$dir") || return
  (( free > 0 && free < LOW_SPACE_HALT )) || return
  space_halted=1
  if [[ -n "$ytdlp_pid" ]] && kill -0 "$ytdlp_pid" 2>/dev/null && (( ! paused )); then
    kill -STOP "$ytdlp_pid" 2>/dev/null
    paused=1
  fi
  msg="Almost out of disk space. Free up some space to continue."
}

# ── argument parsing (URL is the last arg, rest passes through to yt-dlp) ─────
case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac
(( $# )) || { usage >&2; exit 2; }

typeset -a argv passthru
argv=( "$@" )
url="${argv[-1]}"
passthru=( "${(@)argv[1,-2]}" )   # (@) keeps them separate words, not one joined arg
[[ -n "$url" && "$url" != -* ]] || die "last argument must be a URL (got: ${url:-<none>})"

have yt-dlp || die "yt-dlp not found"

# ── metadata + download state (globals) ──────────────────────────────────────
# What the page gave us and yt-dlp will embed (see --parse-metadata in the config)
typeset -g title="" channel="" description="" upload_date="" duration_str=""
typeset -g tags_str="" category="" variant=""
typeset -ga actors=()
# What the run will write
typeset -g final_path="" final_real="" proposed_dir="" ext=""
typeset -g extractor="" video_id="" extractor_key="" archive_key=""
typeset -g video_info=""                  # "1920×1080 · 60fps", known from the preflight on
typeset -g bitrate_str="" codecs_str=""
typeset -ga final_files=()               # every after_move path, for the subtitle pass
typeset -gi in_archive=0
typeset -gA archive_set                   # loaded once: archive_set[<extractor> <id>]=1
# Live progress
typeset -g pct=0 dl_str="—" tot_str="—" spd_str="—" eta_str="—" dstatus="starting"
typeset -g phase_msg="" msg=""
typeset -g ytdlp_pid="" mpv_pid="" thumb_pid=""
typeset -g dl_dest=""                     # the latest "[download] Destination:" (the growing .part)
typeset -ga dl_dests=()                   # every one this run announced — what `d` removes
# thumbnail: shared with ytq via YT_DLP_THUMBCACHE_DIR, named <extractor>_<id>.<ext>
typeset -g thumb_stem="" thumb_file=""
typeset -g thumb_cache="${~YT_DLP_THUMBCACHE_DIR:-$HOME/.cache/ytq}"
typeset -gi thumb_drawn=0 thumb_active=0
typeset -g thumb_geom=""                  # "<cols>x<rows>" of the image on screen now
# Image band sizes (cells). A terminal cell is ~1:2, so 32×9 and 18×5 are both
# close to 16:9 — the letterboxed thumbnail fills them without bars.
typeset -gi FULL_TC=32 FULL_TR=9 MINI_TC=18 MINI_TR=5
typeset -gi FULL_MIN_COLS=72 FULL_MIN_ROWS=26
# metadata: shared with ytq via YT_DLP_JSON_DIR, same <extractor>_<id>.info.json naming as
# thumb_stem. Unset entirely (json_dir="") when YT_DLP_JSON_DIR isn't set — same opt-in as ytq.
typeset -g json_dir="" json_file=""
typeset -gi paused=0
typeset -gi space_halted=0 space_ticks=0   # low-space halt fires once per run
typeset -g fifo="" pfd="" tfd="" saved_stty="" alt_active=0
typeset -ga logring=()                    # recent yt-dlp lines, for error reporting

# gallery (playlist/index) mode: one URL, many items
typeset -gi gallery=0 gal_total=0 gal_index=0 gal_done=0
typeset -g gal_name="" gal_archive_key=""
typeset -gi gal_in_archive=0

# terminal geometry; need_full_redraw is set by SIGWINCH and on entering the TUI
typeset -gi TERM_ROWS=24 TERM_COLS=80 need_full_redraw=1

# ── preflight: resolve the output path and read the metadata ─────────────────
# One --simulate extraction. --print honors the yt-dlp config (aliases, paths,
# --output-na-placeholder ""), so the filename here matches what the real run
# will write, and empty fields come back as empty strings. The --parse-metadata
# rules in the config run at pre_process, so meta_category / meta_variant are
# already set when these print — exactly what will be embedded.
#
# --no-download-archive matters: the global config sets --download-archive, and
# an already-archived id is skipped BEFORE extraction — yt-dlp then exits 0 and
# prints nothing, which reads here as "could not resolve". ytui is an explicit,
# single-URL tool, so it overrides the archive on all its yt-dlp calls (preflight,
# thumbnail, real download) — you asked for this URL, you get it.
#
# -I 1:1 keeps this to ONE extraction even when the URL is a gallery/index page
# (a model page, a channel, a playlist). The extra %(playlist…)s prints are how we
# find out we're in one: --no-playlist already collapses a video-inside-a-playlist
# URL to the single video, so a non-empty playlist title / count > 1 here means the
# URL itself IS the playlist, and we switch to gallery mode.
#
# One field per line, except the description: it can span lines, so it is
# printed LAST and everything after the fixed fields is the description.
typeset -gi PF_FIXED=24
preflight() {
  local errf; errf="$(mktemp -t ytui-preflight)"
  local -a lines
  lines=( "${(@f)$(yt-dlp --no-warnings --no-playlist --simulate --no-download-archive \
    -I 1:1 \
    --print "filename" \
    --print "%(title)s" \
    --print "%(channel,uploader)s" \
    --print "%(cast)l" \
    --print "%(extractor)s_%(id)s" \
    --print "%(playlist_count)s" \
    --print "%(playlist,playlist_id)s" \
    --print "%(extractor_key)s" \
    --print "%(id)s" \
    --print "%(width)s" \
    --print "%(height)s" \
    --print "%(fps)s" \
    --print "%(extractor)s" \
    --print "%(tbr)s" \
    --print "%(filesize,filesize_approx)d" \
    --print "%(duration)s" \
    --print "%(duration_string)s" \
    --print "%(upload_date>%Y-%m-%d)s" \
    --print "%(tags)l" \
    --print "%(categories)l" \
    --print "%(vcodec)s" \
    --print "%(acodec)s" \
    --print "%(meta_category)s" \
    --print "%(meta_variant)s" \
    --print "%(description)s" \
    "${passthru[@]}" "$url" 2>"$errf")}" )
  local rc=$?
  if (( rc != 0 )) || [[ -z "${lines[1]:-}" ]]; then
    print -ru2 -- "${SELF}: could not resolve the video (yt-dlp exited $rc):"
    sed 's/^/  /' "$errf" >&2
    rm -f "$errf"; exit 1
  fi
  rm -f "$errf"

  final_path="${lines[1]}"
  proposed_dir="${final_path:h}"
  ext="${final_path:e}"
  title="$(trim "${lines[2]:-}")"
  channel="$(na "${lines[3]:-}")"
  actors=( ${(f)"$(split_list "${lines[4]:-}")"} )

  # <extractor>_<id> is exactly ytq's thumb-cache stem, so a thumbnail either of
  # us has already fetched is reused instead of re-downloaded.
  thumb_stem="$(sanitize "${lines[5]:-}")"

  # A missing field prints as the literal "NA" unless the config/alias in play
  # sets --output-na-placeholder "" — so both spellings of "absent" count here,
  # otherwise every plain video would look like a playlist.
  local count="${${lines[6]:-}//[^0-9]/}" plname="$(na "${lines[7]:-}")"
  if [[ -n "$plname" ]] || (( ${count:-0} > 1 )); then
    gallery=1
    gal_total=${count:-0}                 # 0 == count unknown (lazy playlist)
    gal_name="${final_path:t}"
  fi

  # The archive key yt-dlp actually writes/checks is "<extractor_key, lowercased> <id>"
  # — NOT the extractor_id form used for thumb_stem. Build and show it so it's obvious
  # which line in the archive this URL corresponds to, and whether it's already there.
  extractor_key="$(trim "${lines[8]:-}")"
  video_id="$(trim "${lines[9]:-}")"
  [[ -n "$extractor_key" && -n "$video_id" ]] && archive_key="${(L)extractor_key} ${video_id}"

  in_archive=0
  [[ -n "$archive_key" && -n "${archive_set[$archive_key]:-}" ]] && in_archive=1

  # The format is already selected at this point, so this is the resolution,
  # frame rate and bitrate of the file the real run will write.
  video_info="$(format_video_info "${lines[10]:-}" "${lines[11]:-}" "${lines[12]:-}")"
  extractor="$(na "${lines[13]:-}")"
  bitrate_str="$(format_bitrate "${lines[14]:-}" "${lines[15]:-}" "${lines[16]:-}")"
  duration_str="$(na "${lines[17]:-}")"
  upload_date="$(na "${lines[18]:-}")"
  local t="$(na "${lines[19]:-}")" c="$(na "${lines[20]:-}")"
  tags_str="$t"; [[ -n "$c" ]] && tags_str+="${t:+ · }$c"
  local vc="$(codec_name "${lines[21]:-}")" ac="$(codec_name "${lines[22]:-}")"
  codecs_str="$vc"; [[ -n "$ac" ]] && codecs_str+="${vc:+/}$ac"
  category="$(na "${lines[23]:-}")"
  variant="$(na "${lines[24]:-}")"
  description="$(trim "${(F)lines[PF_FIXED+1,-1]}")"
  [[ "$description" == (NA|none) ]] && description=""
}

# "a, b, c" (a %(…)l list) → one name per line, trimmed, blanks dropped.
split_list() {
  local s="$(na "$1")" a
  [[ -n "$s" ]] || return 0
  for a in "${(@s:,:)s}"; do a="$(trim "$a")"; [[ -n "$a" ]] && print -r -- "$a"; done
}

# Read the whole download-archive file into a hash once, so both the single-file
# check above and the per-item gallery check below are O(1) lookups instead of a
# grep per item (a gallery can be hundreds of entries).
load_archive_set() {
  local apath; apath="$(archive_file_path)"
  [[ -n "$apath" && -f "$apath" ]] || return
  local l
  while IFS= read -r l; do
    [[ -n "$l" ]] && archive_set[$l]=1
  done < "$apath"
}

# The counterpart to --no-download-archive above: ytui overrides the archive on
# every yt-dlp call it makes (including the real download), so nothing gets
# recorded automatically. Write the line ourselves once a file has actually
# landed (FINALPATH), the same bookkeeping a plain `yt-dlp <url>` would leave.
record_archive_key() {
  local key="$1"
  [[ -n "$key" ]] || return 0
  [[ -n "${archive_set[$key]:-}" ]] && return 0
  local apath; apath="$(archive_file_path)"
  [[ -n "$apath" ]] || return 0
  mkdir -p -- "${apath:h}" 2>/dev/null
  print -r -- "$key" >> "$apath" 2>/dev/null && archive_set[$key]=1
}

# The reverse, for `d`: drop every line that is exactly <key>. Rewritten through
# a temp file beside the archive and moved into place, so a crash halfway never
# leaves a truncated archive. Returns 0 whether or not the line was there.
unrecord_archive_key() {
  local key="$1"
  [[ -n "$key" ]] || return 0
  local apath; apath="$(archive_file_path)"
  [[ -n "$apath" && -f "$apath" ]] || return 0
  local tmp="${apath}.ytui.$$" l; local -i n=0
  while IFS= read -r l; do
    [[ "$l" == "$key" ]] && { (( n++ )); continue; }
    print -r -- "$l"
  done < "$apath" > "$tmp" || { rm -f -- "$tmp"; return 1; }
  if (( n )); then mv -f -- "$tmp" "$apath" && unset "archive_set[$key]"
  else rm -f -- "$tmp"
  fi
  return 0
}

# Same archive file ytq reads/writes: $YT_DLP_ARCHIVE_FILE, synced across machines,
# falling back to the path baked into the yt-dlp config's own --download-archive.
archive_file_path() {
  print -r -- "${YT_DLP_ARCHIVE_FILE:-$HOME/Library/Mobile Documents/com~apple~CloudDocs/Sync/archive.txt}"
}

# A thumbnail already in the shared cache, any common extension — or "" if none.
cached_thumb() {
  [[ -n "$thumb_stem" ]] || return
  local e
  for e in jpg jpeg png webp; do
    [[ -e "$thumb_cache/$thumb_stem.$e" ]] && { print -r -- "$thumb_cache/$thumb_stem.$e"; return; }
  done
}

# Letterbox a thumbnail onto a fixed 16:9 canvas so the image band always has
# the same shape, whatever the source aspect (portrait covers, square avatars…).
# Cached next to the original as <stem>.box.jpg; falls back to the raw file if
# ffmpeg is missing or fails. The ".box" suffix keeps it invisible to
# cached_thumb, so the raw cache stays shareable with ytq.
boxed_thumb() {
  local src="$1"
  [[ -n "$src" && -e "$src" ]] || return
  have ffmpeg || { print -r -- "$src"; return; }
  local dst="$thumb_cache/${src:t:r}.box.jpg"
  if [[ ! -e "$dst" || "$src" -nt "$dst" ]]; then
    ffmpeg -y -loglevel error -i "$src" \
      -vf "scale=640:360:force_original_aspect_ratio=decrease,pad=640:360:(ow-iw)/2:(oh-ih)/2:black" \
      "$dst" >/dev/null 2>&1 || { rm -f -- "$dst"; print -r -- "$src"; return; }
  fi
  print -r -- "$dst"
}

# ── terminal setup / teardown (single controlling-tty fd, alt screen) ────────
# Geometry is re-read from the tty rather than trusted from $LINES/$COLUMNS: this
# script never runs zle, so those are only accurate at startup.
measure_term() {
  local sz; sz="$(stty size <&$tfd 2>/dev/null)"
  TERM_ROWS=0; TERM_COLS=0
  [[ "$sz" == <->" "<-> ]] && { TERM_ROWS=${sz%% *}; TERM_COLS=${sz##* } }
  # a pty that reports 0x0 (some capture/CI harnesses) is not a usable answer
  (( TERM_ROWS < 8 ))  && TERM_ROWS=${LINES:-24}
  (( TERM_COLS < 24 )) && TERM_COLS=${COLUMNS:-80}
  (( TERM_ROWS < 8 ))  && TERM_ROWS=24
  (( TERM_COLS < 24 )) && TERM_COLS=80
}

# A resize invalidates everything on screen: the old frame's line wrapping is
# already scrambled and the kitty image is placed in cells that moved. Just flag
# it — render() does the full clear + image repaint on the next frame.
TRAPWINCH() { need_full_redraw=1 }

enter_tui() {
  exec {tfd}<>/dev/tty || die "no controlling terminal"
  saved_stty="$(stty -g <&$tfd 2>/dev/null)" || saved_stty=""
  stty -icanon -echo min 1 time 0 <&$tfd 2>/dev/null   # raw keys, but keep ISIG (Ctrl-C)
  printf '\e[?1049h\e[?25l' >&$tfd                      # alt screen, hide cursor
  alt_active=1
  measure_term
  need_full_redraw=1
}
leave_tui() {
  (( alt_active )) || return 0
  alt_active=0
  clear_thumb
  [[ -n "$saved_stty" ]] && stty "$saved_stty" <&$tfd 2>/dev/null
  printf '\e[?25h\e[?1049l' >&$tfd 2>/dev/null          # show cursor, leave alt screen
}

is_kitty() {
  [[ -n "${KITTY_WINDOW_ID:-}" || "${TERM_PROGRAM:-}" == "kitty" || "${TERM:-}" == xterm-kitty* ]]
}

# Paint the thumbnail into a <cols>×<rows> cell box at the top-left via kitty's
# icat. The image is on kitty's graphics layer, so the per-frame text redraw
# (which never writes into those cells) leaves it alone; it is only repainted
# when the box changes size (full ↔ compact) or after a full clear.
draw_thumb() {
  local -i tc=$1 tr=$2
  (( thumb_active )) || return
  (( thumb_drawn )) && [[ "$thumb_geom" == "${tc}x${tr}" ]] && return
  [[ -n "$thumb_file" && -e "$thumb_file" ]] || return
  local -a icat
  if   have kitty;  then icat=(kitty +kitten icat)
  elif have kitten; then icat=(kitten icat)
  else return; fi
  local img; img="$(boxed_thumb "$thumb_file")"; [[ -n "$img" ]] || img="$thumb_file"
  clear_thumb
  printf '\e[H' >&$tfd                                  # anchor at top-left
  "${icat[@]}" --clear --transfer-mode=file --stdin=no --align=left \
    --place="${tc}x${tr}@0x0" "$img" >&$tfd 2>/dev/null
  thumb_drawn=1; thumb_geom="${tc}x${tr}"
}

clear_thumb() {
  (( thumb_drawn )) || return
  printf '\e_Ga=d\e\\' >&$tfd 2>/dev/null               # delete every kitty image
  thumb_drawn=0; thumb_geom=""
}

cleanup() {
  local ec=$?
  # Resume first (a stopped process can't be signalled to die), then stop it.
  [[ -n "$ytdlp_pid" ]] && kill -CONT "$ytdlp_pid" 2>/dev/null
  [[ -n "$ytdlp_pid" ]] && kill "$ytdlp_pid" 2>/dev/null
  [[ -n "$thumb_pid" ]] && kill "$thumb_pid" 2>/dev/null
  leave_tui
  [[ -n "$fifo" && -e "$fifo" ]] && rm -f "$fifo"
  return $ec
}
trap cleanup EXIT
trap 'exit 130' INT TERM

# ── rendering ────────────────────────────────────────────────────────────────
hrule() { local -i n=$1 i; local out=""; for (( i = 0; i < n; i++ )); do out+="─"; done; print -rn -- "$out"; }

draw_bar() {
  local w=$1 p=$2 i filled g="" e=""
  (( p > 100 )) && p=100; (( p < 0 )) && p=0
  (( filled = (w * p) / 100 ))
  for (( i = 0; i < w; i++ )); do (( i < filled )) && g+="█" || e+="░"; done
  print -rn -- "${C_BAR}${g}${C_DIM}${e}${C_RESET}"
}

# Truncate to a visible width (input is plain text, no SGR) so a narrow window
# never wraps a line and pushes the whole frame down.
clip() {
  local -i n=$2; local s="$1"
  (( n < 1 )) && n=1
  (( ${#s} > n )) && s="${s[1,n-1]}…"
  print -rn -- "$s"
}

# Greedy word-wrap of plain text into at most <max> lines of <width> cells, one
# per output line; the last line is clipped with an ellipsis if text remains.
# Newlines in the input are flattened first (descriptions are paragraphs).
wrap_text() {
  local s="$1"; local -i w=$2 max=$3
  s="${s//$'\n'/ }"; s="${s//$'\t'/ }"
  s="${s//[[:space:]]##/ }"; s="$(trim "$s")"  # squeeze runs of whitespace
  (( w < 4 )) && w=4
  local -i n=0
  while [[ -n "$s" ]] && (( n < max )); do
    (( n++ ))
    if (( ${#s} <= w )); then print -r -- "$s"; s=""; break; fi
    local head="${s[1,w]}" cut
    if (( n == max )); then print -r -- "$(clip "$s" $w)"; s=""; break; fi
    cut="${head% *}"                            # back off to the last space
    [[ "$cut" == "$head" ]] && cut="$head"      # no space at all: hard break
    print -r -- "$cut"
    s="$(trim "${s[${#cut}+1,-1]}")"
  done
}

# Positioned line: row, column, text. Clears the rest of the row AFTER the text,
# so a line beside the thumbnail never wipes the image cells to its left.
typeset -g rbuf=""
put() { rbuf+=$'\e['"$1"';'"$2"'H'"$3"$'\e[K'; }

# A labelled row in the file / metadata sections: dim label, then the value,
# clipped to the width the window has. Skipped when the value is empty.
typeset -gi LBL_W=12
field() {   # row col width label value [color]
  local -i r=$1 c=$2 w=$3; local label="$4" val="$5" col="${6:-}"
  [[ -n "$val" ]] || return 1
  put $r $c "${C_DESC}$(printf '%-*s' $LBL_W "$label")${C_RESET}${col}$(clip "$val" $(( w - LBL_W )))${C_RESET}"
  return 0
}

render() {
  if (( need_full_redraw )); then
    measure_term
    thumb_drawn=0; thumb_geom=""       # cells moved — the image must be replaced
    printf '\e[H\e[2J' >&$tfd
    need_full_redraw=0
  fi
  [[ -z "$thumb_file" ]] && thumb_file="$(cached_thumb)"

  local -i compact=0
  (( TERM_COLS < FULL_MIN_COLS || TERM_ROWS < FULL_MIN_ROWS )) && compact=1

  # The image box: full size, compact size, or none (not kitty / no stem).
  local -i tc=0 tr=0 band=0
  if (( thumb_active )); then
    if (( compact )); then tc=$MINI_TC; tr=$MINI_TR; else tc=$FULL_TC; tr=$FULL_TR; fi
    (( TERM_COLS >= tc + 30 && TERM_ROWS >= tr + 1 )) && band=1
  fi
  if (( band )); then draw_thumb $tc $tr; else clear_thumb; tc=0; tr=0; fi

  # Text beside the image starts at column R; everything below it at column 3.
  local -i R=3 rw
  (( band )) && (( R = tc + 3 ))
  (( rw = TERM_COLS - R ))              # usable width beside the image (1-col right margin)
  (( rw < 16 )) && rw=16

  local statecol="$C_ACCENT" statetxt="$dstatus"
  (( paused )) && { statecol="$C_WARN"; statetxt="paused"; }
  [[ "$dstatus" == finished ]] && statecol="$C_OK"
  local pausekey="pause"; (( paused )) && pausekey="resume"

  local name
  if (( gallery )); then name="${gal_name:-…}"; else name="${final_path:t}"; fi
  local heading="${title:-$name}"

  rbuf=""
  local -i r=1

  # ── compact: small thumb · title · bar · stats · keys ──────────────────────
  if (( compact )); then
    local -i bw; (( bw = rw - 6 )); (( bw > 60 )) && bw=60; (( bw < 8 )) && bw=8
    if (( gallery )); then
      local total_txt="${gal_total:-0}"; (( gal_total > 0 )) || total_txt="?"
      put $((r++)) $R "${C_DIM}${gal_index}/${total_txt}${C_RESET} ${C_BOLD}$(clip "$heading" $(( rw - 8 )))${C_RESET}"
    else
      put $((r++)) $R "${C_BOLD}$(clip "$heading" $rw)${C_RESET}"
    fi
    put $((r++)) $R "$(draw_bar $bw $pct) ${C_BOLD}${pct}%${C_RESET}"
    put $((r++)) $R "$(clip "${dl_str} / ${tot_str}  ${spd_str}  ETA ${eta_str}" $(( rw - 12 )))  ${statecol}${statetxt}${C_RESET}"
    if [[ -n "$msg" ]]; then put $((r++)) $R "${C_ACCENT}$(clip "$msg" $rw)${C_RESET}"
    else                     put $((r++)) $R "${C_DIM}$(clip "${phase_msg:-$name}" $rw)${C_RESET}"
    fi
    put $((r++)) $R "${C_KEY}p${C_DESC} ${pausekey}  ${C_KEY}o${C_DESC} open  ${C_KEY}d${C_DESC} delete  ${C_KEY}q${C_DESC} cancel${C_RESET}"
    rbuf+=$'\e[J'
    printf '%s' "$rbuf" >&$tfd
    return
  fi

  # ── full: beside the image ─────────────────────────────────────────────────
  local -i W                          # bar cells; the border is W+2 wide
  (( W = rw - 6 )); (( W > 56 )) && W=56; (( W < 8 )) && W=8
  local rule; rule="$(hrule $(( W + 2 )))"

  put $((r++)) $R "${C_BOLD}${SELF}${C_RESET} ${C_DIM}$(clip "$url" $(( rw - ${#SELF} - 1 )))${C_RESET}"
  if (( gallery )); then
    local total_txt="${gal_total:-0}"; (( gal_total > 0 )) || total_txt="?"
    local -i overall=0
    if (( gal_total > 0 )); then
      (( overall = ((gal_index > 0 ? gal_index - 1 : 0) * 100 + pct) / gal_total ))
      (( overall > 100 )) && overall=100
    fi
    put $((r++)) $R "${C_DIM}gallery${C_RESET}  ${C_BOLD}item ${gal_index}/${total_txt}${C_RESET}  ${C_DIM}${gal_done} done${C_RESET}"
    (( gal_total > 0 )) && put $((r++)) $R "  $(draw_bar $W $overall) ${C_DIM}${overall}%${C_RESET}"
  fi
  put $((r++)) $R "${C_BORDER}╭${rule}╮${C_RESET}"
  put $((r++)) $R "${C_BORDER}│${C_RESET} $(draw_bar $W $pct) ${C_BORDER}│${C_RESET}"
  put $((r++)) $R "${C_BORDER}╰${rule}╯${C_RESET}"
  put $((r++)) $R " ${C_BOLD}${pct}%${C_RESET}  ${C_DIM}${dl_str} / ${tot_str}${C_RESET}  ${C_ACCENT}${spd_str}${C_RESET}  ${C_DIM}ETA ${eta_str}${C_RESET}  ${statecol}${statetxt}${C_RESET}"
  put $((r++)) $R " ${C_DIM}$(clip "$phase_msg" $(( rw - 1 )))${C_RESET}"
  if [[ -n "$msg" ]]; then put $((r++)) $R " ${C_ACCENT}$(clip "$msg" $(( rw - 1 )))${C_RESET}"; fi

  # ── full: below the image, full width ──────────────────────────────────────
  local -i L=3 lw
  (( r <= tr + 1 )) && (( r = tr + 2 ))
  (( lw = TERM_COLS - L ))
  local -i keys_row=$(( TERM_ROWS )) room

  local curr_akey curr_inarch
  if (( gallery )); then curr_akey="$gal_archive_key"; curr_inarch=$gal_in_archive
  else                   curr_akey="$archive_key";     curr_inarch=$in_archive
  fi
  local dir="$proposed_dir"; dir="${dir/#$HOME/~}"
  local container="${${final_real:-$final_path}:e}"
  [[ -n "$codecs_str" ]] && container+="${container:+ · }${codecs_str}"
  local idval="$curr_akey" idcol="$C_DIM"
  (( curr_inarch )) && { idval+="  ⚠ already in archive"; idcol="$C_WARN"; }

  put $((r++)) $L "${C_SECT}file${C_RESET}"
  field $r $L $lw "extractor" "$extractor"   "$C_DIM" && (( r++ ))
  field $r $L $lw "file"      "$name"        "$C_FILE" && (( r++ ))
  field $r $L $lw "directory" "$dir"         "$C_DIM" && (( r++ ))
  field $r $L $lw "container" "$container"   "$C_BOLD" && (( r++ ))
  field $r $L $lw "video"     "$video_info"  "$C_BOLD" && (( r++ ))
  field $r $L $lw "bitrate"   "$bitrate_str" "$C_BOLD" && (( r++ ))
  field $r $L $lw "id"        "$idval"       "$idcol" && (( r++ ))
  put $((r++)) $L ""

  put $((r++)) $L "${C_SECT}metadata${C_RESET} ${C_DIM}(embedded)${C_RESET}"
  field $r $L $lw "title"    "$title"            "$C_BOLD" && (( r++ ))
  field $r $L $lw "channel"  "$channel"          ""        && (( r++ ))
  field $r $L $lw "actors"   "${(j: · :)actors}" ""        && (( r++ ))
  field $r $L $lw "date"     "$upload_date"      ""        && (( r++ ))
  field $r $L $lw "duration" "$duration_str"     ""        && (( r++ ))
  field $r $L $lw "tags"     "$tags_str"         "$C_DIM"  && (( r++ ))
  field $r $L $lw "category" "${category}${variant:+ · $variant}" "" && (( r++ ))
  if [[ -n "$description" ]]; then
    (( room = keys_row - 2 - r )); (( room > 3 )) && room=3
    if (( room >= 1 )); then
      local -a dl; dl=( "${(@f)$(wrap_text "$description" $(( lw - LBL_W )) $room)}" )
      local -i i
      for (( i = 1; i <= ${#dl}; i++ )); do
        if (( i == 1 )); then field $r $L $lw "description" "${dl[i]}" "" && (( r++ ))
        else put $((r++)) $L "$(printf '%-*s' $LBL_W '')${dl[i]}"
        fi
      done
    fi
  fi
  put $((r++)) $L ""

  (( r > keys_row )) && r=$keys_row
  put $r $L "${C_KEY}p${C_DESC} ${pausekey}   ${C_KEY}o${C_DESC} open   ${C_KEY}d${C_DESC} delete   ${C_KEY}q${C_DESC} cancel${C_RESET}"
  rbuf+=$'\e[J'                        # clear anything below the block
  printf '%s' "$rbuf" >&$tfd
}

# Failure view: drawn INSIDE the alt screen so the yt-dlp error is readable in
# place, instead of flashing past on stderr after the TUI is torn down. Shows
# the tail of the captured log (logring) and waits for a keypress.
render_error() {
  clear_thumb                         # the failure panel owns the whole screen
  local nl=$'\e[K\n' l
  local buf=$'\e[H\e[J'
  buf+="  ${C_BOLD}${C_ERR}${SELF}: yt-dlp failed (exit ${1})${C_RESET}${nl}"
  buf+="${nl}"
  buf+="  ${C_DIM}${url}${C_RESET}${nl}"
  buf+="${nl}"
  if (( ${#logring} )); then
    for l in "${logring[@]:(-14)}"; do buf+="  ${l[1,112]}${nl}"; done
  else
    buf+="  ${C_DIM}(no output captured)${C_RESET}${nl}"
  fi
  buf+="${nl}"
  buf+="  ${C_KEY}q${C_DESC}/any key — close${C_RESET}${nl}"
  buf+=$'\e[J'
  printf '%s' "$buf" >&$tfd
  read -k 1 -u $tfd 2>/dev/null        # hold the panel until the user looks
}

# In gallery mode each item has its own thumbnail, and there is no per-item
# yt-dlp preflight to fetch it — the URL comes in on the ITEM line instead, so
# grab it straight with curl into the same shared cache ytq uses. Written to a
# temp name and moved into place, so a half-fetched file is never displayed.
fetch_thumb() {
  local turl="$1"
  [[ -n "$turl" && "$turl" == http* && -n "$thumb_stem" ]] || return
  [[ -n "$(cached_thumb)" ]] && return
  have curl || return
  local e="${${turl%%\?*}##*.}"
  [[ "$e" == (jpg|jpeg|png|webp) ]] || e=jpg
  local dest="$thumb_cache/$thumb_stem.$e"
  { local tmp="${dest}.part.$$"
    curl -sL --max-time 20 -o "$tmp" -- "$turl" 2>/dev/null && [[ -s "$tmp" ]] \
      && mv -f -- "$tmp" "$dest" || rm -f -- "$tmp"
  } >/dev/null 2>&1 &
  thumb_pid=$!
}

# ── progress / log line handling ─────────────────────────────────────────────
# Field separator for the ITEM line: titles and channel names can contain "|",
# so the gallery template uses the ASCII unit separator instead.
typeset -gr US=$'\x1f'
handle_line() {
  local line="$1"
  [[ -n "${YTUI_DEBUG_LOG:-}" ]] && print -r -- "$line" >> "$YTUI_DEBUG_LOG"
  if [[ "$line" == PROGRESS\|* ]]; then
    local rest="${line#PROGRESS|}" pc db tb sp et st dbr
    IFS='|' read -r pc db tb sp et st dbr <<<"$rest"
    local nf="${pc//[^0-9.]/}"; pct="${nf%%.*}"; [[ -z "$pct" ]] && pct=0
    dl_str="$(trim "$db")"; tot_str="$(trim "$tb")"
    spd_str="$(trim "$sp")"; eta_str="$(trim "$et")"
    dstatus="$(trim "$st")"
    [[ "$dstatus" == finished ]] && pct=100
    # HLS/live streams report no total up front (tot_str "N/A"), but we do get
    # bytes-so-far and a percentage — so back out an estimate and mark it "~".
    if [[ "$tot_str" == (N/A|NA|Unknown|unknown|-|) && "$nf" == [0-9]* ]]; then
      local dbc="${dbr//[^0-9]/}"
      local -F frac; (( frac = nf / 100.0 ))
      if [[ -n "$dbc" ]] && (( dbc > 0 && frac > 0 )); then
        local -i tot_est; (( tot_est = dbc / frac ))
        (( tot_est > 0 )) && tot_str="~$(human_bytes tot_est)"
      fi
    fi
    return
  fi
  if [[ "$line" == FINALPATH\|* ]]; then
    final_real="${line#FINALPATH|}"
    final_files+=("$final_real")
    if (( gallery )); then
      (( gal_done++ ))
      record_archive_key "$gal_archive_key"
    else
      record_archive_key "$archive_key"
    fi
    return
  fi
  # gallery: one ITEM line per entry, printed before that entry's download starts.
  if [[ "$line" == ITEM${US}* ]]; then
    local -a f; f=( "${(@ps:\x1f:)${line#ITEM${US}}}" )
    # 1 index · 2 stem · 3 w · 4 h · 5 fps · 6 thumb url · 7 filename · 8 extractor_key
    # 9 id · 10 title · 11 channel · 12 cast · 13 tbr · 14 duration_string · 15 date
    video_info="$(format_video_info "${f[3]:-}" "${f[4]:-}" "${f[5]:-}")"
    gal_index="${${f[1]:-}//[^0-9]/}"; (( gal_index > 0 )) || (( gal_index = gal_done + 1 ))
    [[ -n "${f[7]:-}" ]] && gal_name="${f[7]:t}"
    pct=0; dl_str="—"; tot_str="—"; spd_str="—"; eta_str="—"; dstatus="starting"
    local newstem; newstem="$(sanitize "${f[2]:-}")"
    if [[ -n "$newstem" && "$newstem" != "$thumb_stem" ]]; then
      thumb_stem="$newstem"; thumb_file=""; clear_thumb   # next frame paints the new one
      fetch_thumb "${f[6]:-}"
    fi
    local ek="$(trim "${f[8]:-}")" id="$(trim "${f[9]:-}")"
    gal_archive_key=""; [[ -n "$ek" && -n "$id" ]] && gal_archive_key="${(L)ek} ${id}"
    gal_in_archive=0
    [[ -n "$gal_archive_key" && -n "${archive_set[$gal_archive_key]:-}" ]] && gal_in_archive=1
    title="$(trim "${f[10]:-}")"
    channel="$(na "${f[11]:-}")"
    actors=( ${(f)"$(split_list "${f[12]:-}")"} )
    bitrate_str="$(format_bitrate "${f[13]:-}" "" "")"
    duration_str="$(na "${f[14]:-}")"
    upload_date="$(na "${f[15]:-}")"
    description=""; tags_str=""
    return
  fi
  # Any other yt-dlp chatter: keep a small ring for error reports, and show the
  # latest meaningful line as the phase message ([Merger], [Metadata], …).
  local clean; clean="$(strip_ansi "$line")"; clean="$(trim "$clean")"
  [[ -z "$clean" ]] && return
  # "[download] Destination: <path>" tells us where the growing .part actually
  # lives — which is the yt-dlp temp: path, not the final dir. `o` streams it,
  # `d` removes it (and every earlier one: a merge has one per stream).
  if [[ "$clean" == *"Destination: "* ]]; then
    dl_dest="${clean##*Destination: }"
    dl_dests+=("$dl_dest")
  fi
  logring+=("$clean"); (( ${#logring} > 40 )) && shift logring
  phase_msg="${clean[1,72]}"
}

# ── actions ──────────────────────────────────────────────────────────────────
toggle_pause() {
  [[ -n "$ytdlp_pid" ]] && kill -0 "$ytdlp_pid" 2>/dev/null || { msg="download already finished"; return; }
  if (( paused )); then kill -CONT "$ytdlp_pid" 2>/dev/null; paused=0; msg="resumed"
  else                  kill -STOP "$ytdlp_pid" 2>/dev/null; paused=1; msg="paused"; fi
}

# Where is the growing partial? With yt-dlp's --paths temp:… the .part lives in
# a temp tree, not the final dir, and for HLS it's "<file>.mp4.part" alongside
# per-fragment "*.part-FragNN.part" files. The one authoritative source is the
# running yt-dlp itself: whatever .part fd IT holds open is the real file, no
# matter how the paths are configured. lsof on our own child gives us exactly
# that; the Destination line and dir globs are only fallbacks if lsof is absent.
find_partfile() {
  local p
  # 1) the .part our yt-dlp child currently has open (exclude fragment parts)
  if [[ -n "$ytdlp_pid" ]] && kill -0 "$ytdlp_pid" 2>/dev/null && have lsof; then
    p=$(lsof -p "$ytdlp_pid" -Fn 2>/dev/null | sed -n 's/^n//p' \
          | grep -E '\.part$' | grep -v -- '.part-Frag' | head -1)
    [[ -n "$p" && -e "$p" ]] && { print -r -- "$p"; return; }
  fi
  # 2) names we can name directly (already-merged or non-temp downloads)
  local cand
  for cand in "${dl_dest}.part" "$dl_dest" "${final_path}.part" "$final_path" "$final_real"; do
    [[ -n "$cand" && -e "$cand" ]] && { print -r -- "$cand"; return; }
  done
  # 3) largest .part in the captured dest dir, else the final dir (largest, so
  #    the assembled file wins over the little *-FragNN.part siblings)
  local -a parts=()
  [[ -n "$dl_dest" ]]      && parts+=( ${dl_dest:h}/*.part~*.part-Frag*(N.OL) )
  [[ -n "$proposed_dir" ]] && parts+=( ${proposed_dir}/*.part~*.part-Frag*(N.OL) )
  (( ${#parts} )) && { print -r -- "${parts[1]}"; return; }
}

open_mpv() {
  have mpv || { msg="mpv not found"; return; }
  if [[ -n "$mpv_pid" ]] && kill -0 "$mpv_pid" 2>/dev/null; then msg="mpv already open"; return; fi
  local pf; pf="$(find_partfile)"
  [[ -z "$pf" ]] && { msg="nothing downloaded to play yet"; return; }
  mpv --force-window=immediate --force-seekable=yes --cache=yes \
      --demuxer-readahead-secs=20 --profile=low-latency -- "$pf" >/dev/null 2>&1 &
  mpv_pid=$!
  msg="streaming ${pf:t} in mpv"
}

# Everything this run has written so far, one path per line: the files yt-dlp
# has open right now, and for every Destination it announced the file itself,
# its .part, its .ytdl resume record and any HLS fragment parts. Only paths
# that exist are listed; nothing outside those names is ever touched.
partial_files() {
  local -a out=(); local d p
  if [[ -n "$ytdlp_pid" ]] && kill -0 "$ytdlp_pid" 2>/dev/null && have lsof; then
    for p in ${(f)"$(lsof -p "$ytdlp_pid" -Fn 2>/dev/null | sed -n 's/^n//p' | grep -E '\.(part|ytdl)$')"}; do
      [[ -f "$p" ]] && out+=("$p")
    done
  fi
  for d in "${dl_dests[@]}" "$final_path"; do
    [[ -n "$d" ]] || continue
    out+=( "$d"(N.) "$d".part(N.) "$d".ytdl(N.) "$d".part-Frag*(N.) )
  done
  (( ${#out} )) && print -rl -- "${(u)out[@]}"
}

# `d` — stop the download and remove what it left behind: the partial / temp
# files above and the archive line for this id (so a later run is not skipped
# as "already downloaded"). Asks first; yt-dlp is held stopped while the
# question is up so the answer is about the state you looked at.
delete_download() {
  local was_paused=$paused
  if [[ -n "$ytdlp_pid" ]] && kill -0 "$ytdlp_pid" 2>/dev/null && (( ! paused )); then
    kill -STOP "$ytdlp_pid" 2>/dev/null; paused=1
  fi
  local -a files; files=( ${(f)"$(partial_files)"} )
  local key="$archive_key"; (( gallery )) && key="$gal_archive_key"
  local inarch=0; [[ -n "$key" && -n "${archive_set[$key]:-}" ]] && inarch=1
  local what="${#files} file(s)"; (( inarch )) && what+=" + archive line"
  msg="delete ${what} and stop? y/N"
  render
  local ans=""; read -k 1 -u $tfd ans 2>/dev/null
  if [[ "$ans" != [yY] ]]; then
    if (( ! was_paused )) && [[ -n "$ytdlp_pid" ]]; then kill -CONT "$ytdlp_pid" 2>/dev/null; paused=0; fi
    msg="not deleted"
    return
  fi
  # Stop yt-dlp for good (CONT first: a stopped process ignores TERM), then
  # re-list — it may have opened another file between the prompt and now.
  if [[ -n "$ytdlp_pid" ]]; then
    kill -CONT "$ytdlp_pid" 2>/dev/null; kill -TERM "$ytdlp_pid" 2>/dev/null
    wait "$ytdlp_pid" 2>/dev/null
  fi
  files=( ${(f)"$(partial_files)"} )
  [[ -n "$mpv_pid" ]] && kill "$mpv_pid" 2>/dev/null
  leave_tui
  local f; local -i n=0
  for f in "${files[@]}"; do
    [[ -f "$f" ]] || continue
    if rm -f -- "$f"; then (( n++ )); print -r -- "  ${C_ERR}deleted${C_RESET} ${f/#$HOME/~}"
    else print -r -- "  ${C_WARN}could not delete${C_RESET} ${f/#$HOME/~}"
    fi
  done
  if (( inarch )); then
    if unrecord_archive_key "$key"; then print -r -- "  ${C_ERR}removed from archive${C_RESET} ${key}"
    else print -r -- "  ${C_WARN}could not update the archive${C_RESET} ${key}"
    fi
  fi
  print -r -- "${SELF}: deleted — ${n} file(s) removed"
  ytdlp_pid=""                       # already reaped; cleanup() must not kill it again
  exit 130
}

# ── subtitles: fold .vtt sidecars into the .mp4 ──────────────────────────────
# yt-dlp drops subtitles beside the video as <stem>.<lang>.vtt (or <stem>.vtt).
# mp4-embed-vtt reads the language from that suffix, verifies the remux, and only
# then replaces the video — so the .vtt is removed only when it returns 0. Only
# .mp4 is handled: mov_text is an MP4-family track, and that is all the embedder
# writes.
embed_subs() {
  local video="$1" base="${1:r}" vtt
  local -a vtts
  vtts=( "$base".vtt(N) "$base".*.vtt(N) )
  (( ${#vtts} )) || return 0
  if [[ "${(L)video:e}" != mp4 ]]; then
    print -r -- "  ${C_WARN}subtitles left as .vtt — embedding needs an .mp4, got .${video:e}${C_RESET}"
    return 0
  fi
  have mp4-embed-vtt || { print -r -- "  ${C_WARN}subtitles left as .vtt — mp4-embed-vtt not found${C_RESET}"; return 0; }
  for vtt in "${vtts[@]}"; do
    if mp4-embed-vtt "$vtt" "$video" 2>/dev/null; then
      rm -f -- "$vtt"
      print -r -- "  ${C_OK}embedded subs${C_RESET} ${vtt:t} ${C_DIM}(sidecar removed)${C_RESET}"
    else
      print -r -- "  ${C_ERR}subtitle embed failed${C_RESET} ${vtt:t} ${C_DIM}(both files left in place)${C_RESET}"
    fi
  done
}

# ── kick off the background jobs ─────────────────────────────────────────────
load_archive_set
preflight
confirm_low_space

# metadata: reuse ytq's shared info.json cache (same <extractor>_<id> naming as
# thumb_stem). If YT_DLP_JSON_DIR isn't set, json_dir stays empty and this is a no-op.
if [[ -n "${YT_DLP_JSON_DIR:-}" ]]; then
  json_dir="${~YT_DLP_JSON_DIR}"
  mkdir -p -- "$json_dir" 2>/dev/null
  [[ -n "$thumb_stem" ]] && json_file="$json_dir/${thumb_stem}.info.json"
fi
typeset -a json_write_args=()
[[ -n "$json_dir" ]] && json_write_args=( --write-info-json --paths "infojson:$json_dir" --output "infojson:%(extractor)s_%(id)s" )

# thumbnail: reuse ytq's shared cache. If it's already there, we display it at
# once; otherwise fetch it into that same cache (named <extractor>_<id>.jpg) so
# ytq and future ytui runs get it for free. Never re-download a cached thumb.
mkdir -p -- "$proposed_dir" "$thumb_cache" 2>/dev/null
thumb_file="$(cached_thumb)"
# In gallery mode the per-item thumbnails arrive with the ITEM lines instead —
# a second full extraction of the whole index here would cost minutes.
if (( ! gallery )) && [[ -z "$thumb_file" && -n "$thumb_stem" ]]; then
  if [[ -n "$json_file" && -s "$json_file" ]]; then
    # Metadata already cached (by ytq or a prior ytui run) — pull the thumbnail
    # straight out of it, no network round-trip needed.
    yt-dlp --quiet --no-warnings --skip-download --no-download-archive \
      --write-thumbnail --convert-thumbnails jpg \
      -o "thumbnail:${thumb_cache}/%(extractor)s_%(id)s.%(ext)s" \
      "${passthru[@]}" --load-info-json "$json_file" >/dev/null 2>&1 &
  else
    yt-dlp --quiet --no-warnings --no-playlist --skip-download --no-download-archive \
      --write-thumbnail --convert-thumbnails jpg \
      -o "thumbnail:${thumb_cache}/%(extractor)s_%(id)s.%(ext)s" \
      "${json_write_args[@]}" "${passthru[@]}" "$url" >/dev/null 2>&1 &
  fi
  thumb_pid=$!
fi
# reserve the image box only when we can actually draw one
is_kitty && [[ -n "$thumb_stem" ]] && thumb_active=1

# progress fifo: opened read/write so the parent never blocks and never sees
# EOF when yt-dlp exits — we detect completion with kill -0 instead.
fifo="$(mktemp -u -t ytui-fifo).fifo"
mkfifo "$fifo" || die "could not create fifo"
exec {pfd}<>"$fifo"

enter_tui

typeset -a item_print=()
# gallery: one line per entry as it starts, so the UI can follow the index, the
# current filename, its metadata and its thumbnail without a second extraction
# pass. Unit-separated (see US above): titles may contain "|".
(( gallery )) && item_print=(
  --print "before_dl:ITEM${US}%(playlist_index)s${US}%(extractor)s_%(id)s${US}%(width)s${US}%(height)s${US}%(fps)s${US}%(thumbnail)s${US}%(filename)s${US}%(extractor_key)s${US}%(id)s${US}%(title)s${US}%(channel,uploader)s${US}%(cast)l${US}%(tbr)s${US}%(duration_string)s${US}%(upload_date>%Y-%m-%d)s"
  --ignore-errors                     # one dead entry must not kill the whole gallery
)

# --no-quiet: --print implies --quiet, which would swallow the log lines the UI
# reads ("[download] Destination:" is how `o`/`d` learn where the .part is).
# PYTHONUNBUFFERED: yt-dlp block-buffers stdout when it is a pipe, so without it
# those lines would sit in its buffer until exit while progress streams.
PYTHONUNBUFFERED=1 yt-dlp --no-playlist --newline --no-quiet --no-download-archive --continue \
  --progress-template "download:PROGRESS|%(progress._percent_str)s|%(progress._downloaded_bytes_str)s|%(progress._total_bytes_str)s|%(progress._speed_str)s|%(progress._eta_str)s|%(progress.status)s|%(progress.downloaded_bytes)d" \
  --print "after_move:FINALPATH|%(filepath)s" \
  "${item_print[@]}" "${json_write_args[@]}" "${passthru[@]}" "$url" >&$pfd 2>&1 &
ytdlp_pid=$!

# ── main loop ────────────────────────────────────────────────────────────────
# NOTE: this runs at script top level, not in a function — so a bare `local x`
# here does NOT scope a variable, it runs `typeset x` which PRINTS x's current
# value into the alt screen (the stray "line=PROGRESS…" leak). Declare the
# loop's scratch vars once, up front, and only ever assign to them below.
typeset line="" key=""
render
while true; do
  zselect -t 20 -r $pfd -r $tfd 2>/dev/null    # wait ≤0.2s on progress OR keys

  while read -r -u $pfd -t 0 line 2>/dev/null; do handle_line "$line"; done

  while read -k 1 -u $tfd -t 0 key 2>/dev/null; do
    case "$key" in
      p|P) toggle_pause ;;
      o|O) open_mpv ;;
      d|D) delete_download ;;
      q|Q) leave_tui; print -r -- "${SELF}: cancelled — partial files kept, rerun to resume"; exit 130 ;;
    esac
  done

  check_space_live
  render
  kill -0 "$ytdlp_pid" 2>/dev/null || break
done

# ── drain any trailing output, then reap ─────────────────────────────────────
while read -r -u $pfd -t 0.1 line 2>/dev/null; do handle_line "$line"; done
wait "$ytdlp_pid"; typeset -gi rc=$?
[[ -n "$thumb_pid" ]] && wait "$thumb_pid" 2>/dev/null

# ── report ───────────────────────────────────────────────────────────────────
if (( rc != 0 )); then
  render_error "$rc"                 # show the failure IN the window, wait for a key
  leave_tui
  print -ru2 -- "${SELF}: yt-dlp failed (exit $rc)"   # one line for scrollback/logs
  exit $rc
fi

leave_tui

# gallery: many files, no single output path to report.
if (( gallery )); then
  if (( gal_done )); then
    print -r -- "${C_OK}✓${C_RESET} gallery finished — ${C_BOLD}${gal_done}${C_RESET} item(s) downloaded"
    [[ -n "$proposed_dir" ]] && print -r -- "  ${C_DESC}into:${C_RESET} ${proposed_dir}"
    for f in "${final_files[@]}"; do [[ -e "$f" ]] && embed_subs "$f"; done
  else
    print -r -- "${C_WARN}${SELF}: gallery finished, but no items were downloaded${C_RESET}"
  fi
  exit 0
fi

src="${final_real:-$final_path}"
if [[ ! -e "$src" ]]; then
  print -r -- "${C_WARN}${SELF}: finished, but couldn't locate the output file${C_RESET}"
  print -r -- "  expected: ${src}"
  exit 0
fi

print -r -- "${C_OK}✓${C_RESET} downloaded  ${C_FILE}${src:t}${C_RESET}"
[[ -n "$video_info" ]] && print -r -- "  ${C_DESC}video:${C_RESET} ${video_info}${bitrate_str:+ · $bitrate_str}"
[[ -z "$thumb_file" ]] && thumb_file="$(cached_thumb)"
[[ -n "$thumb_file" ]] && print -r -- "  ${C_DESC}thumbnail:${C_RESET} ${thumb_file:t} ${C_DIM}(cached)${C_RESET}"
[[ -n "$json_file" && -s "$json_file" ]] && print -r -- "  ${C_DESC}metadata:${C_RESET} ${json_file:t} ${C_DIM}(cached)${C_RESET}"

embed_subs "$src"

# ── final prompt: reveal / open / delete the finished file ───────────────────
# One keypress, read straight from the tty (stdin may be a pipe). `r` reveals in
# Finder, `o` opens with the default app, `d` deletes the file and its archive
# line; anything else just exits.
if [[ -e "$src" && -r /dev/tty ]]; then
  print -rn -- "  ${C_KEY}r${C_DESC} reveal   ${C_KEY}o${C_DESC} open   ${C_KEY}d${C_DESC} delete   ${C_DIM}any other key: done${C_RESET} "
  if read -k 1 -s key </dev/tty 2>/dev/null; then
    print -r -- ""
    case "$key" in
      r|R) open --reveal -- "$src" ;;
      o|O) open -- "$src" ;;
      d|D)
        if read -q "key?  delete ${src:t} and its archive line? [y/N] " </dev/tty; then
          print -r -- ""
          rm -f -- "$src" && print -r -- "  ${C_ERR}deleted${C_RESET} ${src:t}"
          unrecord_archive_key "$archive_key" && [[ -n "$archive_key" ]] \
            && print -r -- "  ${C_ERR}removed from archive${C_RESET} ${archive_key}"
        else
          print -r -- ""
        fi ;;
    esac
  else
    print -r -- ""
  fi
fi
