#!/usr/bin/env zsh
# Encode video to AV1 (SVT-AV1) in an MKV.
#
# The stream targets the Apple hardware AV1 decoder (M3 / A17 Pro and later):
# Main profile, 4:2:0, 10-bit, no film-grain synthesis. mpv, VLC and anything
# else built on VideoToolbox decode it in hardware; QuickTime and Finder do
# not open MKV at all. Every audio and subtitle track is copied untouched,
# except MP4 mov_text subtitles, which become SRT.
#
# Usage:
#   encode-av1 [--fast|--balanced|--quality|--archive] [-d|--delete] <input>...
#   encode-av1 -p <profile> <input>...
#
# Output: <input stem>.av1.mkv next to the source. Existing outputs are skipped.
#
# Profiles (SVT-AV1 preset / CRF):
#   fast      7 / 28   bulk conversion, previews
#   balanced  5 / 24   default
#   quality   4 / 21   keeps fine detail; ~2x slower than balanced
#   archive   3 / 18   near-transparent; slow

set -u

profile=balanced
delete_source=0
inputs=()

while (( $# )); do
	case "$1" in
		--fast|--balanced|--quality|--archive) profile="${1#--}" ;;
		-p|--profile) shift; profile="${1:-}" ;;
		-d|--delete) delete_source=1 ;;
		-h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
		--) shift; inputs+=("$@"); break ;;
		-*) print -u2 "encode-av1: unknown option: $1"; exit 2 ;;
		*) inputs+=("$1") ;;
	esac
	shift
done

(( ${#inputs} )) || { print -u2 "usage: encode-av1 [--fast|--balanced|--quality|--archive] [-d] <input>..."; exit 2 }

case "$profile" in
	fast)     preset=7; crf=28 ;;
	balanced) preset=5; crf=24 ;;
	quality)  preset=4; crf=21 ;;
	archive)  preset=3; crf=18 ;;
	*) print -u2 "encode-av1: unknown profile: $profile"; exit 2 ;;
esac

rc=0
for src in "${inputs[@]}"; do
	if [[ ! -f "$src" ]]; then
		print -u2 "encode-av1: not a file: $src"; rc=1; continue
	fi
	dst="${src:r}.av1.mkv"
	if [[ -e "$dst" ]]; then
		print -u2 "encode-av1: exists, skipping: $dst"; continue
	fi

	# Matroska cannot hold MP4's mov_text; turn it into SRT, copy anything else.
	sub_codec=copy
	if ffprobe -v error -select_streams s -show_entries stream=codec_name \
		-of default=nw=1:nk=1 -- "$src" 2>/dev/null | grep -qx mov_text; then
		sub_codec=srt
	fi

	print -- "→ ${src:t}  [$profile: preset $preset, crf $crf]"
	if ffmpeg -hide_banner -nostdin -i "$src" \
		-map 0:v:0 -map '0:a?' -map '0:s?' -map '0:t?' -map_metadata 0 \
		-c:v libsvtav1 -preset "$preset" -crf "$crf" \
		-pix_fmt yuv420p10le \
		-svtav1-params "tune=0:keyint=10s:film-grain=0" \
		-c:a copy -c:s "$sub_codec" -c:t copy \
		-- "$dst"
	then
		touch -r "$src" "$dst" 2>/dev/null
		if (( delete_source )); then
			mv -- "$src" "$HOME/.Trash/" || { print -u2 "encode-av1: could not trash: $src"; rc=1 }
		fi
	else
		print -u2 "encode-av1: failed: $src"
		rm -f -- "$dst"
		rc=1
	fi
done

exit $rc
