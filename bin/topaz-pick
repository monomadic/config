#!/usr/bin/env zsh
# Purpose: quick interactive picker matching the mpv `z` menu.
# Use this when you want the guided three-step choice of enhancement, frame
# interpolation, and output format. It hands the resulting job to topaz-encode;
# use topaz-workflow instead when transform A/B previews are the priority.
set -euo pipefail

# Offline Topaz encode picker: the same three-step flow as the mpv `z` menu
# (enhancement -> interpolation -> output format), driven by fzf, handing off to
# topaz-encode for the actual encode (which handles resume, logging, progress).

script_name="${0:t}"

usage() {
  cat <<EOF
usage:
  $script_name [--preview [seconds]] [--resume] [--copy-cmd] [--trash-originals] file1 [file2 ...]

Interactive Topaz encode for the terminal:
  1. enhancement preset (grouped by what is wrong with the source)
     then the output resolution, when the model and source allow an upscale
  2. frame interpolation (or none)
  3. output format

Composes the filter exactly like the mpv Topaz menu (orientation-aware 4K
targets, interpolation inserted before the lanczos tail) and runs topaz-encode,
Neuroserver-only presets (Starlight Precise) are not offered: they cannot be
encoded by ffmpeg.
so interrupted encodes can be resumed by rerunning the same command.

--copy-cmd prints/copies the final topaz-encode command instead of encoding.
Other flags are passed through to topaz-encode.
EOF
}

(( $# == 0 )) && {
  usage >&2
  exit 1
}

case "${1:-}" in
  -h|--help|help)
    usage
    exit 0
    ;;
esac

PRESET_CATALOG="${0:A:h}/lib/topaz-preset-catalog.zsh"
TOPAZ_RUN="${0:A:h}/topaz-encode"

[[ -r "$PRESET_CATALOG" ]] || {
  print -u2 "Topaz preset catalog not found: $PRESET_CATALOG"
  exit 1
}
[[ -x "$TOPAZ_RUN" ]] || {
  print -u2 "topaz-encode not found: $TOPAZ_RUN"
  exit 1
}
command -v fzf >/dev/null 2>&1 || {
  print -u2 "fzf not found"
  exit 1
}

source "$PRESET_CATALOG"

passthrough_args=()
files=()

while (( $# > 0 )); do
  case "$1" in
    --preview=*|--resume|--copy-cmd|--trash-originals|--trash-original)
      passthrough_args+=("$1")
      shift
      ;;
    --preview)
      passthrough_args+=("$1")
      if (( $# >= 2 )) && [[ "${2:-}" != -* ]]; then
        passthrough_args+=("$2")
        shift
      fi
      shift
      ;;
    --)
      shift
      files+=("$@")
      break
      ;;
    -*)
      print -u2 "unknown option: $1"
      usage >&2
      exit 1
      ;;
    *)
      files+=("$1")
      shift
      ;;
  esac
done

(( ${#files[@]} > 0 )) || {
  usage >&2
  exit 1
}

for input in "$files[@]"; do
  [[ -f "$input" ]] || {
    print -u2 "not a file: $input"
    exit 1
  }
done

# ---- source profile (first file drives category gating and 4K targets) ----

probe_bin="ffprobe"
command -v ffprobe >/dev/null 2>&1 || probe_bin=""

src_w="" src_h="" src_fps=""
if [[ -n "$probe_bin" ]]; then
  while IFS='=' read -r key value; do
    case "$key" in
      width) src_w="$value" ;;
      height) src_h="$value" ;;
      avg_frame_rate)
        src_fps="$(awk -v r="$value" 'BEGIN {
          split(r, p, "/")
          if (p[2] == "" || p[2] == 0) { if (p[1] != "") printf "%.0f", p[1] }
          else printf "%.0f", p[1] / p[2]
        }')"
        ;;
    esac
  done < <(
    "$probe_bin" -v error -select_streams v:0 \
      -show_entries stream=width,height,avg_frame_rate \
      -of default=noprint_wrappers=1 -- "$files[1]" 2>/dev/null
  )
fi

# Orientation-aware 4K target: long edge -> 3840, aspect preserved, even dims.
target_w=3840 target_h=2160
if [[ "$src_w" == <-> && "$src_h" == <-> ]]; then
  read -r target_w target_h < <(awk -v w="$src_w" -v h="$src_h" 'BEGIN {
    if (w >= h) { tw = 3840; th = h * 3840 / w } else { th = 3840; tw = w * 3840 / h }
    tw = int(tw / 2 + 0.5) * 2; th = int(th / 2 + 0.5) * 2
    print tw, th
  }')
fi

is_4k=false
if [[ "$src_w" == <-> && "$src_h" == <-> ]]; then
  long_edge=$(( src_w > src_h ? src_w : src_h ))
  (( long_edge > 2560 )) && is_4k=true
fi

# 2x of an exactly-1080p source IS the 4K target: a scale=2-only model can then
# still be offered the 4K row (mirrors two_x_is_4k in the mpv menu).
two_x_is_4k=false
if [[ "$src_w" == <-> && "$src_h" == <-> ]] &&
    (( src_w * 2 == target_w && src_h * 2 == target_h )); then
  two_x_is_4k=true
fi

if [[ -n "$src_w" ]]; then
  media_header="${files[1]:t}  ${src_w}x${src_h} @ ${src_fps:-?}fps"
  (( ${#files[@]} > 1 )) && media_header+="  [+$(( ${#files[@]} - 1 )) more]"
else
  media_header="${files[1]:t}  (unprobed — original resolution only)"
fi

# Menu groups, keyed by what is wrong with the source (same keys and order as
# CATEGORY_ORDER in the mpv menu; a preset in an unknown category still shows,
# under its raw key).
category_label() {
  case "$1" in
    polish) print -r -- "Decent Source · Polish" ;;
    focus-fix) print -r -- "Soft · Out of Focus" ;;
    lowlight) print -r -- "Dark · Noisy" ;;
    compressed) print -r -- "Compressed · Old Codecs" ;;
    interlaced) print -r -- "Interlaced · Broadcast / DV" ;;
    stylized) print -r -- "Stylized · Texture" ;;
    hdr) print -r -- "SDR → HDR" ;;
    *) print -r -- "$1" ;;
  esac
}
category_rank() {
  case "$1" in
    polish) print 1 ;; focus-fix) print 2 ;; lowlight) print 3 ;; compressed) print 4 ;;
    interlaced) print 5 ;; stylized) print 6 ;; hdr) print 7 ;; *) print 9 ;;
  esac
}

# ---- step 1: enhancement ----
# Catalog rows: category display slug scales filter_body blurb metadata
#               ns_model ns_store ns_params free_size
# fzf rows: label<TAB>slug<TAB>filter_body<TAB>scales<TAB>free_size<TAB>blurb<TAB>metadata
# Empty fields carry a "-" placeholder: tab-IFS `read` collapses consecutive
# tabs, which would silently shift fields. Neuroserver presets (Starlight
# Precise) are left out: topaz-encode drives ffmpeg, which cannot reach them.

enhancement_rows() {
  emulate -L zsh
  local category display slug scales filter_body blurb metadata
  local ns_model ns_store ns_params free_size label

  print -r -- $'[Original] Original (no enhancement)\t__original__\t-\t1,2,4k\t-\tSkip enhance — interpolate / re-encode only\tvideoai=Original (no enhancement)'

  # Tab is whitespace to `read`, so a run of empty columns would collapse and
  # shift the trailing fields: pad every empty column with "-" first.
  topaz_enhancement_preset_rows |
  sed $'s/\t\t/\t-\t/g; s/\t\t/\t-\t/g; s/\t$/\t-/' |
  while IFS=$'\t' read -r category display slug scales filter_body blurb metadata \
      ns_model ns_store ns_params free_size; do
    [[ "${ns_model:--}" != "-" ]] && continue
    [[ "$free_size" == "1" ]] || free_size=""
    label="[$(category_label "$category")] ${display}"
    print -r -- "$(category_rank "$category")"$'\t'"${label}"$'\t'"${slug}"$'\t'"${filter_body:--}"$'\t'"${scales:--}"$'\t'"${free_size:--}"$'\t'"${blurb:--}"$'\t'"${metadata:--}"
  done | sort -s -t $'\t' -k1,1n | cut -f2-
}

enh_selection="$(
  enhancement_rows | fzf \
    --prompt='enhancement > ' \
    --delimiter=$'\t' \
    --with-nth=1 \
    --height=60% \
    --reverse \
    --border \
    --header="$media_header" \
    --header-first \
    --preview='printf "%s\n\n%s\n" {6} {3}' \
    --preview-window='down:5:wrap'
)" || true
[[ -n "$enh_selection" ]] || {
  print -u2 "no enhancement selected"
  exit 1
}

IFS=$'\t' read -r enh_label enh_slug enh_body enh_scales enh_free_size enh_blurb enh_metadata <<< "$enh_selection"
[[ "$enh_body" == "-" ]] && enh_body=""
[[ "$enh_free_size" == "-" ]] && enh_free_size=""
[[ "$enh_metadata" == "-" ]] && enh_metadata=""
enh_display="${enh_label#\[*\] }"

# ---- step 1b: resolution (the mpv menu's Output tab) ----
# "1" and "2" are the model's fixed scales; "4k" means it takes a free target
# size (scale=0:w:h), which both the 4K and the 4x row need. A source at or
# above 4K, or one that could not be probed, is only ever rendered as-is.

has_scale() { [[ ",${enh_scales}," == *",$1,"* ]]; }

res_rows() {
  emulate -L zsh
  print -r -- "orig"$'\t'"Original${src_w:+ — ${src_w}×${src_h}}"$'\t'"${src_w:-0}"$'\t'"${src_h:-0}"
  [[ "$is_4k" == false && "$src_w" == <-> ]] || return 0
  local -a rows
  if has_scale 4k || { [[ "$two_x_is_4k" == true ]] && has_scale 2; }; then
    rows+=("4k"$'\t'"Upscale to 4K — ${target_w}×${target_h}"$'\t'"${target_w}"$'\t'"${target_h}")
  fi
  if has_scale 2 && (( src_w * 2 != target_w || src_h * 2 != target_h )); then
    rows+=("2x"$'\t'"Upscale 2x — $(( src_w * 2 ))×$(( src_h * 2 ))"$'\t'"$(( src_w * 2 ))"$'\t'"$(( src_h * 2 ))")
  fi
  if has_scale 4k && (( src_w * 4 <= 7680 && src_h * 4 <= 7680 )); then
    rows+=("4x"$'\t'"Upscale 4x — $(( src_w * 4 ))×$(( src_h * 4 ))"$'\t'"$(( src_w * 4 ))"$'\t'"$(( src_h * 4 ))")
  fi
  # Smallest target first, as the mpv menu orders them.
  local row
  for row in "${rows[@]}"; do
    print -r -- "$(( ${${(s:	:)row}[3]} * ${${(s:	:)row}[4]} ))"$'\t'"$row"
  done | sort -t $'\t' -k1,1n | cut -f2-
}

res_key="orig" res_w="$src_w" res_h="$src_h"
if [[ "$is_4k" == false && "$src_w" == <-> ]] && { has_scale 2 || has_scale 4k; }; then
  res_selection="$(
    res_rows | fzf \
      --prompt='resolution > ' \
      --delimiter=$'\t' \
      --with-nth=2 \
      --height=30% \
      --reverse \
      --border \
      --header="$media_header  ·  $enh_display" \
      --header-first
  )" || true
  [[ -n "$res_selection" ]] || {
    print -u2 "no resolution selected"
    exit 1
  }
  IFS=$'\t' read -r res_key res_label res_w res_h <<< "$res_selection"
fi

# Fill @SCALE@ the way the mpv menu's enh_filter_for does: scale=1 / scale=2 /
# scale=0:w:h, the free-target form gaining a lanczos tail so the encode lands
# on the exact size whatever the model produced. free_size models (Starlight
# Mini) take the explicit size at every resolution, as the app drives them.
enh_filter="" enh_tail=""
if [[ -n "$enh_body" ]]; then
  clause="scale=1"
  if [[ -n "$enh_free_size" && "$res_w" == <-> && "$res_h" == <-> ]]; then
    clause="scale=0:w=${res_w}:h=${res_h}"
      [[ "$res_key" != orig ]] && enh_tail="scale=w=${res_w}:h=${res_h}:flags=lanczos:threads=0"
  elif [[ "$res_key" == 2x ]]; then
    clause="scale=2"
  elif [[ "$res_key" != orig ]]; then
    if has_scale 4k; then
      clause="scale=0:w=${res_w}:h=${res_h}"
      enh_tail="scale=w=${res_w}:h=${res_h}:flags=lanczos:threads=0"
    else
      clause="scale=2"
    fi
  fi
  enh_filter="${enh_body//@SCALE@/$clause}"
elif [[ "$res_key" != orig ]]; then
  # Original (no enhancement) upscaled: a plain lanczos scale, no AI pass.
  enh_tail="scale=w=${res_w}:h=${res_h}:flags=lanczos:threads=0"
fi
[[ "$res_key" != orig ]] && enh_display+=" → ${res_key:u}"

# ---- step 2: interpolation ----
# fzf rows: display<TAB>slug<TAB>fi_filter<TAB>metadata

interp_selection="$(
  {
    print -r -- $'None (keep source frame rate)\t__none__\t-\tEncode the enhancement as-is.'
    topaz_interpolation_preset_rows
  } | fzf \
    --prompt='interpolation > ' \
    --delimiter=$'\t' \
    --with-nth=1 \
    --height=50% \
    --reverse \
    --border \
    --header="$media_header" \
    --header-first \
    --preview='printf "%s\n" {4}' \
    --preview-window='down:4:wrap'
)" || true
[[ -n "$interp_selection" ]] || {
  print -u2 "no interpolation selected"
  exit 1
}

IFS=$'\t' read -r interp_display interp_slug interp_filter interp_metadata <<< "$interp_selection"
[[ "$interp_slug" == "__none__" || "$interp_filter" == "-" ]] && interp_filter=""

# ---- step 3: output format ----
# rows: display<TAB>slug<TAB>output_ext<TAB>video_args

output_selection="$(
  topaz_output_profile_rows | fzf \
    --prompt='output > ' \
    --delimiter=$'\t' \
    --with-nth=1 \
    --height=40% \
    --reverse \
    --border \
    --header="$media_header" \
    --header-first \
    --preview='printf "%s\n" {4}' \
    --preview-window='down:3:wrap'
)" || true
[[ -n "$output_selection" ]] || {
  print -u2 "no output format selected"
  exit 1
}

IFS=$'\t' read -r output_display output_slug output_ext output_video_args <<< "$output_selection"

# ---- compose and hand off (interpolation goes before the lanczos tail) ----

filter_parts=()
[[ -n "$enh_filter" ]] && filter_parts+=("$enh_filter")
[[ -n "$interp_filter" ]] && filter_parts+=("$interp_filter")
[[ -n "$enh_tail" ]] && filter_parts+=("$enh_tail")
final_filter="${(j:,:)filter_parts}"
[[ -n "$final_filter" ]] || final_filter="null"

preset_name="$enh_display"
[[ -n "$interp_filter" ]] && preset_name+=" + ${interp_display}"
preset_name+=" - ${output_display}"

metadata="$enh_metadata"
[[ -n "$metadata" ]] || metadata="videoai=${enh_display}"

exec "$TOPAZ_RUN" \
  "${passthrough_args[@]}" \
  --preset_name "$preset_name" \
  --filter_complex "$final_filter" \
  --output_ext "$output_ext" \
  --video_args "$output_video_args" \
  --metadata "$metadata" \
  -- "$files[@]"
