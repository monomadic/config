#!/usr/bin/env python3
"""Find HTTP(S) servers on the default macOS interface's IPv4 subnet."""
import argparse
import asyncio
import ipaddress
import math
import re
import resource
import ssl
import subprocess
import sys
import time

DEFAULT_PORTS = '80,443,8000,8008,8080,8081,8443,8888,9000,9090'
TLS_PORTS = {443,8443,9443}


def ports_arg(value):
    ports = set()
    try:
        for part in value.split(','):
            bounds = part.split('-')
            if len(bounds) == 1:
                start = end = int(part)
            else:
                start, end = map(int, bounds)
            if not 1 <= start <= end <= 65535:
                raise ValueError
            ports.update(range(start, end + 1))
    except ValueError:
        raise argparse.ArgumentTypeError('use ports or ranges between 1 and 65535')
    return sorted(ports)


def positive_float(value):
    number = float(value)
    if not math.isfinite(number) or number <= 0:
        raise argparse.ArgumentTypeError('must be a positive finite number')
    return number


def local_network(interface):
    if not interface:
        route = subprocess.check_output(['/sbin/route', '-n', 'get', 'default'], text=True)
        match = re.search(r'interface:\s+(\S+)', route)
        if not match:
            raise ValueError('no default interface; specify a CIDR or --interface')
        interface = match[1]
    config = subprocess.check_output(['/sbin/ifconfig', interface], text=True)
    match = re.search(r'inet (\S+) netmask (\S+)', config)
    if not match:
        raise ValueError(f'{interface} has no IPv4 address')
    address, mask = match.groups()
    if mask.startswith('0x'):
        mask = str(ipaddress.IPv4Address(int(mask, 16)))
    return ipaddress.IPv4Network(f'{address}/{mask}', strict=False)


async def close(writer):
    writer.close()
    try:
        await asyncio.wait_for(writer.wait_closed(), 0.1)
    except (OSError, asyncio.TimeoutError):
        pass


async def request(host, port, scheme, timeout, context):
    writer = None
    try:
        reader, writer = await asyncio.wait_for(asyncio.open_connection(
            host, port, ssl=context if scheme == 'https' else None,
            server_hostname=host if scheme == 'https' else None,
            limit=8192), timeout)
        writer.write(f'HEAD / HTTP/1.1\r\nHost: {host}:{port}\r\nConnection: close\r\n\r\n'.encode())
        await asyncio.wait_for(writer.drain(), timeout)
        line = await asyncio.wait_for(reader.readline(), timeout)
        match = re.fullmatch(rb'HTTP/1\.[01] ([1-5][0-9]{2})(?: [^\r\n]*)?\r?\n', line)
        if match:
            default = 443 if scheme == 'https' else 80
            authority = host if port == default else f'{host}:{port}'
            return f'{scheme}://{authority}/', match[1].decode()
    except (OSError, asyncio.TimeoutError, ValueError):
        pass
    finally:
        if writer:
            await close(writer)


async def probe(host, port, timeout, context):
    # Screen closed ports once, without paying for two protocol timeouts.
    try:
        _, writer = await asyncio.wait_for(asyncio.open_connection(host, port), timeout)
    except (OSError, asyncio.TimeoutError):
        return
    await close(writer)
    schemes = ('https', 'http') if port in TLS_PORTS else ('http', 'https')
    for scheme in schemes:
        result = await request(host, port, scheme, timeout, context)
        if result:
            return result


async def scan(network, ports, concurrency, timeout):
    context = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
    context.check_hostname = False
    context.verify_mode = ssl.CERT_NONE  # Discovery includes self-signed LAN appliances.
    jobs = ((str(host), port) for host in network.hosts() for port in ports)
    found = 0

    async def worker():
        nonlocal found
        for host, port in jobs:
            result = await probe(host, port, timeout, context)
            if result:
                found += 1
                print(f'{result[0]}\t{result[1]}', flush=True)

    await asyncio.gather(*(worker() for _ in range(concurrency)))
    return found


def main():
    parser = argparse.ArgumentParser(description=__doc__, epilog=(
        'Prints URL and HTTP status as servers respond. No ping or DNS lookup. '
        'IPv4 only; hostname-only virtual hosts are not discovered. Short timeouts '
        'can miss slow devices; retry with --timeout 2. TLS certificates are not verified.'))
    parser.add_argument('cidr', nargs='?', help='subnet or IP (default: default-route interface subnet)')
    parser.add_argument('-i', '--interface', help='interface to scan, e.g. en0')
    parser.add_argument('-p', '--ports', type=ports_arg, default=DEFAULT_PORTS,
                        help=f'comma-separated ports/ranges (default: {DEFAULT_PORTS}); all: 1-65535')
    parser.add_argument('-c', '--concurrency', type=int, default=256, help='parallel probes (default: 256)')
    parser.add_argument('-t', '--timeout', type=positive_float, default=0.6, help='seconds per network operation (default: 0.6)')
    args = parser.parse_args()
    if args.concurrency < 1 or args.concurrency > 4096:
        parser.error('concurrency must be between 1 and 4096')
    if args.cidr and args.interface:
        parser.error('choose either CIDR or --interface')
    try:
        network = ipaddress.IPv4Network(args.cidr, strict=False) if args.cidr else local_network(args.interface)
        # Reserve descriptors for the interpreter and event loop, and respect OS limits.
        soft, hard = resource.getrlimit(resource.RLIMIT_NOFILE)
        desired = args.concurrency + 64
        if soft < desired:
            try:
                resource.setrlimit(resource.RLIMIT_NOFILE, (min(desired, hard) if hard != resource.RLIM_INFINITY else desired, hard))
            except (OSError, ValueError):
                pass
        soft, _ = resource.getrlimit(resource.RLIMIT_NOFILE)
        concurrency = min(args.concurrency, max(1, soft - 64)) if soft != resource.RLIM_INFINITY else args.concurrency
        print(f'Scanning {network}, {len(args.ports)} ports, {concurrency} concurrent probes…', file=sys.stderr)
        started = time.monotonic()
        found = asyncio.run(scan(network, args.ports, concurrency, args.timeout))
        print(f'Found {found} servers in {time.monotonic() - started:.2f}s.', file=sys.stderr)
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        parser.exit(1, f'lan-http: {error}\n')
    except KeyboardInterrupt:
        parser.exit(130, '\nScan interrupted.\n')


if __name__ == '__main__':
    main()
