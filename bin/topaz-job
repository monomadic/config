#!/usr/bin/env zsh
# topaz-job
# Turn a Topaz preset file into a job-folder workflow — a folder whose job.sh
# encodes any video dropped in its input/ with that preset — and queue a video
# on it.
#
#   topaz-job [mode] [destination] --preset PRESET_FILE [--] INPUT
#
# The workflow is named for the preset (topaz-<preset name>, or --workflow
# NAME), so every video sent with the same preset lands in the same queue, and
# the folder can be reused by dropping more files into its input/ directly.
#
# Its job.sh is machine-agnostic: the source is $INPUT, the result goes to
# $OUTPUT_DIR, and the encoder is named through $HOME, so it runs wherever the
# workflow folder sits — here, or on a render machine that mounts the share.
# It passes --resume, so a run that was stopped or interrupted picks up from its
# partial output rather than starting over, and one already finished is
# skipped.
#
# It deliberately sets no scheduling priority. Whoever runs the queue decides
# that: job-folder runs one input per workflow at a time, and a render box
# wants the machine's full attention.
#
# Modes (what to do with the workflow):
#   --send   default. Install the workflow in the first reachable jobs folder
#            and copy the video into its input/ (via send-job).
#   --save   Install the workflow in the first reachable jobs folder and stop.
#            Nothing is queued; drop files into its input/ later.
#   --run    Run the workflow's script on the video here, now, writing the
#            result beside the video. Nothing is installed.
#
# Destinations are tried in order until one is a writable directory, so a job
# lands on the render share when it is mounted, syncs through iCloud when it is
# not, and falls back to a folder on this machine:
#
#   $JOBS_DIR             when set (also --dir DIR) — tried first, alone if forced
#   remote  /Volumes/job  /Volumes/Jobs
#   cloud   $ICLOUD_HOME/Jobs
#   local   $HOME/jobs  $HOME/Jobs
#
# --remote / --cloud / --local restrict the search to one group; $TOPAZ_JOB_ORDER
# (default "remote,cloud,local") reorders the automatic search.
#
# The preset file is `key=value` lines, one per line, `#` comments allowed. Keys
# are the topaz-encode flags that describe an encode:
#
#   preset_name=Proteus — Detail Max + Upscale to 4K + H.265 MP4
#   filter_complex=tvai_up=model=prob-4:scale=2,scale=w=3840:h=2160:flags=lanczos
#   output_ext=mp4
#   video_args=-c:v hevc_videotoolbox -b:v 40M -tag:v hvc1
#   metadata=videoai=Proteus Detail Max
#
# preset_name and filter_complex are required; the rest are optional. Values are
# taken literally to end of line — no quoting, no escaping.

emulate -L zsh
setopt extended_glob
set -euo pipefail

script_name="${0:t}"

# The *deployed* encoder path, not the repo one: the workflow has to make sense
# on whatever machine ends up running it.
topaz_encode="${TOPAZ_ENCODE:-$HOME/.local/bin/topaz-encode}"
# send-job does the workflow install and the copy-then-rename into input/ — no
# reason to have a second copy of that here.
send_job="${SEND_JOB:-${0:A:h}/send-job}"

mode=send
forced_dir=""
group=""
preset_file=""
workflow=""
input=""
dry_run=false

usage() {
  cat <<EOF
$script_name

Build a job-folder workflow from a Topaz preset file, and queue a video on it.

Usage:
  $script_name [--send|--save|--run] [--dir DIR|--remote|--cloud|--local] \\
      [--workflow NAME] --preset PRESET_FILE [--] INPUT

Modes:
  --send             Install the workflow and queue the video on it (default)
  --save             Install the workflow and stop
  --run              Run the workflow's script on the video here

Destination (--send and --save):
  --dir DIR          Use exactly this folder (also --dir=DIR, or \$JOBS_DIR)
  --remote           Only /Volumes/job, /Volumes/Jobs
  --cloud            Only \$ICLOUD_HOME/Jobs
  --local            Only \$HOME/jobs, \$HOME/Jobs

Other:
  --preset FILE      Preset file (required; also --preset=FILE)
  --workflow NAME    Workflow folder name (default: topaz-<preset name>)
  --dry-run          Print the workflow and the chosen destination, change nothing
  -h, --help         Show help

Environment:
  JOBS_DIR           Forced destination, as --dir
  TOPAZ_JOB_ORDER    Automatic search order (default: remote,cloud,local)
  ICLOUD_HOME        iCloud Drive root (default: the standard macOS path)
  TOPAZ_ENCODE       Encoder the job calls (default: \$HOME/.local/bin/topaz-encode)

Examples:
  $script_name --preset clip.topaz-preset clip.mp4
  $script_name --run --preset clip.topaz-preset clip.mp4
  $script_name --local --preset clip.topaz-preset clip.mp4
EOF
}

die() {
  print -u2 -- "$script_name: $1"
  exit "${2:-1}"
}

warn() {
  print -u2 -- "$script_name: $1"
}

while (( $# )); do
  case "$1" in
    --send)   mode=send; shift ;;
    --save)   mode=save; shift ;;
    --run)    mode=run;  shift ;;
    --remote|--cloud|--local)
      group="${1#--}"
      shift
      ;;
    --dir)
      (( $# >= 2 )) || die "missing argument for --dir" 2
      forced_dir="$2"
      shift 2
      ;;
    --dir=*)
      forced_dir="${1#--dir=}"
      shift
      ;;
    --preset)
      (( $# >= 2 )) || die "missing argument for --preset" 2
      preset_file="$2"
      shift 2
      ;;
    --preset=*)
      preset_file="${1#--preset=}"
      shift
      ;;
    --workflow)
      (( $# >= 2 )) || die "missing argument for --workflow" 2
      workflow="$2"
      shift 2
      ;;
    --workflow=*)
      workflow="${1#--workflow=}"
      shift
      ;;
    --dry-run)
      dry_run=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      (( $# )) || die "no input file given" 2
      [[ -z "$input" ]] || die "only one input file, got extra: $1" 2
      input="$1"
      shift
      ;;
    -*)
      die "unknown option: $1" 2
      ;;
    *)
      [[ -z "$input" ]] || die "only one input file, got extra: $1" 2
      input="$1"
      shift
      ;;
  esac
done

[[ -n "$preset_file" ]] || { usage >&2; die "no preset file given (--preset)" 2 }
[[ -f "$preset_file" ]] || die "preset file not found: $preset_file"
# --save installs a workflow and nothing else, so it needs no video.
if [[ "$mode" != save ]]; then
  [[ -n "$input" ]] || { usage >&2; die "no input file given" 2 }
fi
if [[ -n "$input" ]]; then
  [[ -f "$input" ]] || die "input file not found: $input"
  input="${input:A}"
fi

if [[ -n "$forced_dir" && -n "$group" ]]; then
  die "--dir and --$group are mutually exclusive" 2
fi

# --- preset file ------------------------------------------------------------

typeset -A preset=()
typeset -a known=( preset_name filter_complex output_ext video_args metadata )

lineno=0
while IFS= read -r line || [[ -n "$line" ]]; do
  (( ++lineno ))
  if [[ "$line" == [[:space:]]#(\#*|) ]]; then
    continue
  fi
  [[ "$line" == *=* ]] || die "$preset_file:$lineno: not key=value: $line"

  key="${${line%%=*}//[[:space:]]/}"
  value="${line#*=}"

  if (( ! ${known[(I)$key]} )); then
    die "$preset_file:$lineno: unknown preset key: $key (known: ${known[*]})"
  fi
  preset[$key]="$value"
done < "$preset_file"

[[ -n "${preset[preset_name]:-}" ]] || die "preset file has no preset_name: $preset_file"
[[ -n "${preset[filter_complex]:-}" ]] || die "preset file has no filter_complex: $preset_file"

# topaz-<preset name>, lowercased, with every run of anything else a single
# dash: a folder name that survives SMB, the shell and a Finder glance alike.
if [[ -z "$workflow" ]]; then
  slug="${(L)preset[preset_name]}"
  slug="${slug//[^a-z0-9]##/-}"
  slug="${${slug##-##}%%-##}"
  workflow="topaz-${slug[1,60]%%-##}"
fi
[[ "$workflow" != */* && "$workflow" != .* ]] || die "not a workflow name: $workflow" 2

# --- job script -------------------------------------------------------------

# Reference the encoder through $HOME when it lives there, so the workflow
# survives a different user account on the render machine.
encoder_ref="${(qq)topaz_encode}"
if [[ "$topaz_encode" == "$HOME"/* ]]; then
  rest="${topaz_encode#$HOME/}"
  if [[ "$rest" == [A-Za-z0-9._/-]## ]]; then
    encoder_ref="\"\$HOME\"/$rest"
  else
    encoder_ref="\"\$HOME\"/${(qq)rest}"
  fi
fi

typeset -a job_args=( --preset_name "${preset[preset_name]}" \
                      --filter_complex "${preset[filter_complex]}" )
for key in output_ext video_args metadata; do
  if [[ -n "${preset[$key]:-}" ]]; then
    job_args+=( "--$key" "${preset[$key]}" )
  fi
done

# job_args is flag/value pairs; flags come from the whitelist above and need no
# quoting, values always get it.
command_line="$encoder_ref --resume"
for (( i = 1; i <= ${#job_args[@]}; i += 2 )); do
  command_line+=" ${job_args[i]} ${(qq)job_args[i + 1]}"
done
# The source and the destination are the two things the job must not hardcode.
command_line+=' --output-dir "$OUTPUT_DIR" -- "$INPUT"'

job_text="#!/bin/zsh
# Topaz encode workflow — generated by $script_name
# ${preset[preset_name]}
# One video per run: the source is \$INPUT, the result goes in \$OUTPUT_DIR.
: \"\${INPUT:?run me through job-folder, or set INPUT and OUTPUT_DIR}\"
: \"\${OUTPUT_DIR:?run me through job-folder, or set INPUT and OUTPUT_DIR}\"
exec $command_line"

if $dry_run; then
  print -- "workflow: $workflow"
  print -r -- "$job_text"
fi

staging=""
cleanup() {
  [[ -n "$staging" ]] && rm -rf -- "$staging" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

write_job() {
  staging="$(mktemp -d "${TMPDIR:-/tmp}/topaz-job.XXXXXX")" || die "could not make a staging directory"
  print -r -- "$job_text" > "$staging/job.sh" || die "could not write the job script"
  chmod +x "$staging/job.sh" || die "could not make the job script executable"
}

# --- run --------------------------------------------------------------------

if [[ "$mode" == run ]]; then
  $dry_run && exit 0
  write_job
  print -- "running $workflow on ${input:t}"
  # The environment job-folder gives it, with the video's own folder standing
  # in for both input/ and output/: the result lands beside the source.
  cd -- "${input:h}"
  INPUT="$input" INPUT_DIR="${input:h}" INPUT_FILE="${input:t}" \
    INPUT_NAME="${${input:t}:r}" OUTPUT_DIR="${input:h}" JOB_DIR="$staging" \
    "$staging/job.sh"
  exit $?
fi

# --- send / save: find a jobs folder ----------------------------------------

if [[ ! -x "$send_job" ]]; then
  send_job="$(command -v send-job)" || die "send-job not found (set \$SEND_JOB)"
fi

icloud_home="${ICLOUD_HOME:-$HOME/Library/Mobile Documents/com~apple~CloudDocs}"

group_dirs() {
  case "$1" in
    remote) print -r -- /Volumes/job; print -r -- /Volumes/Jobs ;;
    cloud)  print -r -- "$icloud_home/Jobs" ;;
    local)  print -r -- "$HOME/jobs"; print -r -- "$HOME/Jobs" ;;
    *)      die "unknown destination group: $1" 2 ;;
  esac
}

typeset -a candidates=()
if [[ -n "$forced_dir" ]]; then
  candidates=( "${forced_dir%/}" )
elif [[ -n "$group" ]]; then
  candidates=( ${(f)"$(group_dirs "$group")"} )
else
  if [[ -n "${JOBS_DIR:-}" ]]; then
    candidates+=( "${JOBS_DIR%/}" )
  fi
  for g in ${(s:,:)${TOPAZ_JOB_ORDER:-remote,cloud,local}}; do
    candidates+=( ${(f)"$(group_dirs "${g//[[:space:]]/}")"} )
  done
fi

(( ${#candidates[@]} )) || die "no destination to try"

$dry_run || write_job

typeset -a payload=()
[[ "$mode" == send ]] && payload=( "$input" )

sent=""
for dir in "${candidates[@]}"; do
  if [[ ! -d "$dir" ]]; then
    print -- "skip  $dir (not there)"
    continue
  fi
  if [[ ! -w "$dir" ]]; then
    print -- "skip  $dir (not writable)"
    continue
  fi

  if $dry_run; then
    print -- "would $mode to $dir/$workflow"
    sent="$dir"
    break
  fi

  print -- "try   $dir"
  # --copy and an explicit --dir: the destination is already decided here, and
  # a job bound for a render machine has to take its video with it — neither
  # question send-job would otherwise ask is open.
  if "$send_job" --job "$staging/job.sh" --copy --dir="$dir" -- "$workflow" "${payload[@]}"; then
    sent="$dir"
    break
  fi
  warn "send failed for $dir, trying the next destination"
done

if [[ -z "$sent" ]]; then
  print -u2 -- "$script_name: nowhere to put the workflow. Tried:"
  for dir in "${candidates[@]}"; do
    print -u2 -- "  $dir"
  done
  exit 1
fi

$dry_run && exit 0

if [[ "$mode" == send ]]; then
  print -- "sent ${input:t} to $sent/$workflow"
else
  print -- "saved $sent/$workflow"
fi
exit 0
