#!/bin/zsh
emulate -L zsh

# rename-footage
# Rename camera footage to the canonical media-library filename syntax:
#
#   YYYY-MM-DD--HH-MM-SS PEOPLE - TITLE (LOCATION) #TAGS ★★★★★ [RES FPS ...].ext
#
# Viewed at a higher level this is:
#
#   DATE PEOPLE - TITLE (LOCATION) #TAGS RATING [METADATA].ext
#
# Every segment except DATE and [METADATA] drops out when its field is empty, and
# the dash appears only when there is a title to separate the people from, so the
# grammar degrades cleanly:
#
#   DATE PEOPLE - TITLE (LOCATION) #TAGS ★★★★★ [METADATA].ext
#   DATE PEOPLE (LOCATION) #TAGS ★★★★★ [METADATA].ext
#   DATE (LOCATION) [METADATA].ext
#   DATE [METADATA].ext
#
#   DATE      determined by, in priority order:
#               1. exif data           (exiftool, if installed)
#               2. existing filename   (a leading canonical timestamp)
#               3. mp4 metadata        (ffprobe creation_time)
#               4. file creation ctime (birth time)
#   PEOPLE    embedded XMP-iptcExt:PersonInImage
#   CHANNEL   embedded XMP-xmpDM:Album. Stored and read, never rendered: the
#             parentheses it once occupied now hold the location.
#   TITLE     embedded XMP-dc:Title, used verbatim, and set with --title. With
#             none stored, it is mined from the filename and embedded (see the
#             rules below). A
#             camera's own name -- IMG_4855, GX010042, C0001 -- is recognised
#             and not promoted to a title; PreservedFileName already holds it.
#   LOCATION  embedded XMP-iptcExt:LocationCreatedCity, or, with --geocode,
#             reverse-geocoded from the coordinates the camera stored
#   TAGS      embedded XMP-dc:Subject, one #tag per entry
#   RATING    embedded XMP-xmp:Rating, one star per point; 0 renders as nothing
#   METADATA  probed fresh with ffprobe (+ exiftool for DEVICE).
#
# Every embedded field found is printed as the file is read, along with the GPS
# coordinates if the camera stored any. GPS is reported only: the file holds
# numbers, while LOCATION wants a place name -- the city QuickTime shows is
# macOS reverse-geocoding those coordinates live, and is not stored anywhere.
#
# On the first run over a file its existing name is recorded, write-once, as
# XMP-xmpMM:PreservedFileName, so the name a camera or a person originally gave
# it stays recoverable however often the file is re-rendered afterwards.
#
# The PEOPLE/CHANNEL/LOCATION/TAGS fields are authored, not probed: nothing in
# the file's contents implies them, so the file itself is their only store. The
# options below embed them as XMP with exiftool; every run then re-renders the
# filename from whatever is embedded, which makes the name disposable and the
# metadata authoritative.
#
# How a field gets its value, in order:
#
#   1. an argument was supplied  -> it wins and is written to the file. For a
#      list the supplied values ARE the list, replacing what was stored.
#   2. no argument, metadata present -> keep it; the filename is ignored.
#   3. no argument, no metadata      -> take it from the filename and embed it.
#
# Rule 3 is why nothing is lost. The filename is the source of last resort, and
# anything mined from it becomes a real tag before the rename, so the name stays
# disposable without ever being the only copy of something.
#
# Options:
#   --title NAME     Set the title
#   --people NAME    Set a person (repeatable; replaces the stored list)
#   --tag NAME       Set a keyword (repeatable; replaces the stored list)
#   --channel NAME   Set the originating channel / studio
#   --location NAME  Set the place the footage was shot
#   --geocode        Derive LOCATION from the file's GPS coordinates
#   --rating N       Set a 0-5 star rating
#   --clear-title    Store an empty title
#   --clear-people   Store an empty person list
#   --clear-tags     Store an empty keyword list
#   --print-target   Print the canonical target path only
#   --dry-run        Show what would be renamed without changing files
#   --verbose        Print debug information about probe/date decisions
#   --color          Enable ANSI colors
#   --icons          Use Nerd Font icons
#   -h, --help       Show this message
#
# --geocode turns the coordinates a phone or camera writes into a place name and
# embeds both together: the city as XMP-iptcExt:LocationCreatedCity (which is
# what the filename renders), alongside ProvinceState, CountryName and the
# coordinates themselves in the same IPTC location block. The name is looked up
# through bin/reverse-geocode, which asks MapKit -- the service behind Finder's
# "Created in Makati, Philippines" line, so the two agree. Answers are cached by
# rounded coordinate, so a whole shoot costs one lookup.
#
# Nothing else consults the network, and a failed lookup is a warning, not an
# error: the file still gets renamed, just without a place name.
#
# Dependencies: ffprobe and exiftool, both required. exiftool is NOT optional:
# every authored field lives in XMP that only exiftool can read or write, so a
# run without it would rebuild the filename from nothing and silently strip
# whatever the name was the only copy of.

DRY_RUN=false
VERBOSE=false
USE_COLOR=false
USE_ICONS=false
PRINT_TARGET=false
SCRIPT_NAME="${0:t}"

RATING=""
TITLE=""
CHANNEL=""
LOCATION=""
GEOCODE=false
# What the user typed. Never modified per file, so that processing several
# files in one run cannot leak file 1's values into file 2.
typeset -ga CLI_PEOPLE=()
typeset -ga CLI_KEYWORDS=()
typeset -ga METADATA_ARGS=()
PEOPLE_GIVEN=false
KEYWORDS_GIVEN=false
CLEAR_TITLE=false
CLEAR_PEOPLE=false
CLEAR_TAGS=false

# Coordinates read off the file, and the place name they resolve to.
GEO_LAT=""
GEO_LON=""
GEO_CITY=""
GEO_STATE=""
GEO_COUNTRY=""

# Candidates parsed out of the current filename (parse_filename_fields).
FN_TITLE=""
FN_CHANNEL=""
FN_LOCATION=""
FN_RATING=""
typeset -ga FN_PEOPLE=()
typeset -ga FN_TAGS=()

# The decided value of each field (resolve_fields): what gets embedded and what
# the new filename is rendered from. WRITE_FIELD holds the subset to write back.
FINAL_TITLE=""
FINAL_CHANNEL=""
FINAL_LOCATION=""
FINAL_STATE=""
FINAL_COUNTRY=""
FINAL_RATING=""
typeset -ga FINAL_PEOPLE=()
typeset -ga FINAL_TAGS=()
typeset -gA WRITE_FIELD=()

META_PEOPLE=""
META_CHANNEL=""
META_TITLE=""
META_LOCATION=""
META_STATE=""
META_COUNTRY=""
META_PRESERVED=""""
META_RATING=""
META_GPS=""
typeset -ga META_TAGS=()

ICON_VIDEO="▶ "
ICON_OK="✓ "
ICON_WARN="⚠ "
ICON_SKIP="• "

RESET=""
GREEN=""
YELLOW=""
CYAN=""

enable_color() {
  RESET=$'\e[0m'
  GREEN=$'\e[32m'
  YELLOW=$'\e[33m'
  CYAN=$'\e[36m'
  USE_COLOR=true
}

enable_icons() {
  ICON_VIDEO="󰎈 "
  ICON_OK=" "
  ICON_WARN=" "
  ICON_SKIP="󰄱 "
  USE_ICONS=true
}

usage() {
  print -r -- "Usage: ${SCRIPT_NAME} [OPTIONS] video_file..."
  print -r -- ""
  print -r -- "Rename camera footage to:"
  print -r -- "  DATE PEOPLE - TITLE (LOCATION) #TAGS ★★★★★ [RES FPS LENGTH BITRATE CODEC DEVICE ORIENTATION].ext"
  print -r -- ""
  print -r -- "Authored metadata (embedded as XMP, then re-rendered into the filename):"
  print -r -- "  --title NAME     Set the title"
  print -r -- "  --people NAME    Set a person (repeatable; replaces the stored list)"
  print -r -- "  --tag NAME       Set a keyword (repeatable; replaces the stored list)"
  print -r -- "  --channel NAME   Set the originating channel / studio"
  print -r -- "  --location NAME  Set the place the footage was shot"
  print -r -- "  --geocode        Derive the location from the file's GPS coordinates"
  print -r -- "  --rating N       Set a 0-5 star rating (one star per point in the name)"
  print -r -- "  --clear-title    Store an empty title"
  print -r -- "  --clear-people   Store an empty person list"
  print -r -- "  --clear-tags     Store an empty keyword list"
  print -r -- ""
  print -r -- "Options:"
  print -r -- "  --print-target   Print only the canonical target path"
  print -r -- "  --dry-run        Show what would be renamed without changing files"
  print -r -- "  --verbose        Print debug information about probe/date decisions"
  print -r -- "  --color          Enable ANSI colors in output"
  print -r -- "  --icons          Use Nerd Font icons instead of plain Unicode symbols"
  print -r -- "  -h, --help       Show this message"
}

log_verbose() {
  $VERBOSE || return 0
  print -u2 -r -- "${CYAN}${ICON_SKIP}$*${RESET}"
}

trim_whitespace() {
  local s="$1"

  s="${s//$'\t'/ }"
  s="${s//$'\n'/ }"
  s="${s//$'\r'/ }"

  while [[ "$s" == *"  "* ]]; do
    s="${s//  / }"
  done

  while [[ "$s" == [[:space:]]* ]]; do
    s="${s[2,-1]}"
  done

  while [[ "$s" == *[[:space:]] ]]; do
    s="${s[1,-2]}"
  done

  print -r -- "$s"
}

touch_modified_now() {
  local file="$1"
  touch "$file" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# TITLE
# ---------------------------------------------------------------------------

# Capitalize the first letter of each word. Other characters keep their case,
# and words whose first character is not a letter (#tags, -flags) are untouched.
capitalize_title() {
  local s="$1"
  local -a words
  local w out=""

  words=("${(@s: :)s}")
  for w in "${words[@]}"; do
    [[ -z "$w" ]] && continue
    if [[ "${w[1]}" == [A-Za-z] ]]; then
      w="${(U)w[1]}${w[2,-1]}"
    fi
    out+="${out:+ }$w"
  done

  print -r -- "$out"
}

# A rating renders as one star per point, so it stays readable at a glance and
# sorts with the rest of the name. Zero renders as nothing at all: an unrated
# clip and a deliberately zero-rated one look the same in a filename, and the
# stored tag is where that distinction lives.
render_stars() {
  local n=${1:-0} out=""
  while (( n > 0 )); do
    out+="★"
    (( n-- ))
  done
  print -r -- "$out"
}

# ---------------------------------------------------------------------------
# DATE
# ---------------------------------------------------------------------------

# Given raw Y M D H M S digits, print canonical "YYYY-MM-DD--HH-MM-SS" or nothing.
format_stamp() {
  local y="$1" mo="$2" d="$3" h="$4" mi="$5" s="$6"
  [[ -z "$y" || -z "$mo" || -z "$d" ]] && return 0
  [[ "$y" == 0000 ]] && return 0
  printf '%04d-%02d-%02d--%02d-%02d-%02d' \
    "$y" "$mo" "$d" "${h:-0}" "${mi:-0}" "${s:-0}"
}

# EXIF timestamps come as "YYYY:MM:DD HH:MM:SS" (optionally with subsec/offset).
parse_exif_stamp() {
  local raw="$1"
  if [[ "$raw" =~ '([0-9]{4}):([0-9]{2}):([0-9]{2})[ T]([0-9]{2}):([0-9]{2}):([0-9]{2})' ]]; then
    format_stamp "$match[1]" "$match[2]" "$match[3]" "$match[4]" "$match[5]" "$match[6]"
  fi
}

date_from_exif() {
  local file="$1" raw tag
  command -v exiftool >/dev/null 2>&1 || return 0
  for tag in DateTimeOriginal CreateDate MediaCreateDate CreationDate; do
    raw="$(exiftool -s3 -"$tag" -- "$file" 2>/dev/null | head -1)"
    [[ -z "$raw" || "$raw" == 0000* ]] && continue
    local stamp
    stamp="$(parse_exif_stamp "$raw")"
    [[ -n "$stamp" ]] && { print -r -- "$stamp"; return 0; }
  done
}

date_from_filename() {
  local name="$1"
  if [[ "$name" =~ '^([0-9]{4})-([0-9]{2})-([0-9]{2})--([0-9]{2})-([0-9]{2})-([0-9]{2})' ]]; then
    format_stamp "$match[1]" "$match[2]" "$match[3]" "$match[4]" "$match[5]" "$match[6]"
  fi
}

date_from_mp4() {
  local file="$1" raw
  raw="$(
    ffprobe -v error -show_entries format_tags=creation_time \
      -of default=noprint_wrappers=1:nokey=1 -- "$file" 2>/dev/null | head -1
  )"
  # creation_time looks like "2025-02-02T12:23:44.000000Z"
  if [[ "$raw" =~ '([0-9]{4})-([0-9]{2})-([0-9]{2})[ T]([0-9]{2}):([0-9]{2}):([0-9]{2})' ]]; then
    format_stamp "$match[1]" "$match[2]" "$match[3]" "$match[4]" "$match[5]" "$match[6]"
  fi
}

date_from_ctime() {
  local file="$1"
  # macOS stat: %SB is the birth (creation) time, formatted with -t.
  stat -f '%SB' -t '%Y-%m-%d--%H-%M-%S' -- "$file" 2>/dev/null | head -1
}

resolve_date() {
  local file="$1" name="$2" stamp

  stamp="$(date_from_exif "$file")"
  [[ -n "$stamp" ]] && { log_verbose "date source: exif -> $stamp"; print -r -- "$stamp"; return 0; }

  stamp="$(date_from_filename "$name")"
  [[ -n "$stamp" ]] && { log_verbose "date source: filename -> $stamp"; print -r -- "$stamp"; return 0; }

  stamp="$(date_from_mp4 "$file")"
  [[ -n "$stamp" ]] && { log_verbose "date source: mp4 metadata -> $stamp"; print -r -- "$stamp"; return 0; }

  stamp="$(date_from_ctime "$file")"
  [[ -n "$stamp" ]] && { log_verbose "date source: ctime -> $stamp"; print -r -- "$stamp"; return 0; }
}

# ---------------------------------------------------------------------------
# METADATA (fresh probe)
# ---------------------------------------------------------------------------

get_resolution_label() {
  local d=${1:-0}
  if (( d <= 480 )); then
    print -r -- "480p"
  elif (( d <= 720 )); then
    print -r -- "720p"
  elif (( d <= 1080 )); then
    print -r -- "1080p"
  elif (( d <= 1440 )); then
    print -r -- "1440p"
  elif (( d <= 2160 )); then
    print -r -- "2160p"
  else
    print -r -- "${d}p"
  fi
}

format_duration() {
  local secs=${1:-0}
  local hours=$(( secs / 3600 ))
  local mins=$(( secs / 60 ))

  if (( hours > 0 )); then
    print -r -- "${hours}hr"
  elif (( mins > 0 )); then
    print -r -- "${mins}min"
  else
    print -r -- "${secs}sec"
  fi
}

get_rotation() {
  local file="$1"
  local rotation=""

  rotation="$(
    ffprobe -v error -select_streams v:0 \
      -show_entries stream_side_data=rotation \
      -of default=noprint_wrappers=1:nokey=1 -- "$file" 2>/dev/null | head -1 || true
  )"
  if [[ -z "$rotation" ]]; then
    rotation="$(
      ffprobe -v error -select_streams v:0 \
        -show_entries stream_tags=rotate \
        -of default=noprint_wrappers=1:nokey=1 -- "$file" 2>/dev/null | head -1 || true
    )"
  fi
  if [[ -z "$rotation" ]]; then
    rotation="$(
      ffprobe -v error \
        -show_entries format_tags=rotate \
        -of default=noprint_wrappers=1:nokey=1 -- "$file" 2>/dev/null | head -1 || true
    )"
  fi

  [[ -z "$rotation" ]] && rotation="0"
  print -r -- "$rotation"
}

# One short word naming the capture device, e.g. "iPhone 15 Pro" -> "iPhone15Pro".
get_device() {
  local file="$1" model="" tag

  if command -v exiftool >/dev/null 2>&1; then
    for tag in Model CameraModelName com.apple.quicktime.model Make; do
      model="$(exiftool -s3 -"$tag" -- "$file" 2>/dev/null | head -1)"
      [[ -n "$model" ]] && break
    done
  fi

  if [[ -z "$model" ]]; then
    model="$(
      ffprobe -v error \
        -show_entries format_tags=com.apple.quicktime.model \
        -of default=noprint_wrappers=1:nokey=1 -- "$file" 2>/dev/null | head -1
    )"
  fi

  model="$(trim_whitespace "$model")"
  model="${model// /}"   # device must be a single word
  print -r -- "$model"
}

# ---------------------------------------------------------------------------
# AUTHORED METADATA (embedded, never probed)
# ---------------------------------------------------------------------------

# Field resolution, in three steps: parse the filename into candidates, then
# decide each field's final value, then write back only what changed.
#
# The precedence is fixed and the same for every field:
#
#   1. an argument was supplied  -> it wins outright and is written to the file.
#      For a list, the supplied values ARE the list; the stored one is replaced.
#      The filename is not consulted.
#   2. no argument, field already has metadata -> keep it, ignore the filename.
#   3. no argument, no metadata   -> take it from the filename and embed it.
#
# Step 3 is the one that stops data disappearing. The filename used to be parsed
# only to be discarded: a clip named "Sarah's Birthday Party" with no embedded
# title was renamed from metadata alone and those words were gone. Now the name
# is the source of last resort, and whatever it yields becomes a real tag before
# the rename happens -- so the filename stays disposable, which is the whole
# point of the scheme, without it being the only copy of anything.

# A camera's own filename is not a title. These are already kept verbatim in
# PreservedFileName, so declining to promote them loses nothing, and promoting
# them would put "IMG_4855" in the title of every clip a camera ever produced.
is_camera_name() {
  local n="${(U)1}"
  [[ "$n" =~ '^(IMG|MVI|DSC|DSCF|VID|PXL|MAH|MAQ|DJI|GOPR)[_-]?[0-9]+$' ]] && return 0
  [[ "$n" =~ '^G[HXP][0-9]{4,}$' ]] && return 0
  [[ "$n" =~ '^C[0-9]{4}$' ]] && return 0
  return 1
}

# Read the rendered grammar back out of a name:
#   DATE PEOPLE - TITLE (LOCATION) #TAGS RATING [METADATA]
# Under the older grammar the location was unmarked -- "TITLE LOCATION" with
# nothing between them -- so for those names it still stays part of the title
# candidate, and is trimmed off below only when the file says what it is.
parse_filename_fields() {
  local n="$1"
  local lead trail tagpart tok
  local dated=false

  FN_TITLE="" FN_CHANNEL="" FN_LOCATION="" FN_RATING=""
  FN_PEOPLE=() FN_TAGS=()

  if [[ "$n" =~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}--[0-9]{2}-[0-9]{2}-[0-9]{2}[[:space:]]*' ]]; then
    n="${n[$(( MEND + 1 )),-1]}"
    dated=true
  fi

  # every [...] block is probed metadata, rebuilt fresh on each run
  while [[ "$n" == *\[*\]* ]]; do
    n="${n%%\[*}${n#*\]}"
  done
  n="$(trim_whitespace "$n")"

  # Stars are rendered after the tags, so they come off first. A run of them at
  # the end of the name is a rating and nothing else -- no other field can
  # produce one.
  if [[ "$n" == *★ ]]; then
    local stars="${n##* }"
    if [[ "$stars" =~ '^★+$' ]]; then
      FN_RATING=${#stars}
      n="$(trim_whitespace "${n%${stars}}")"
    fi
  fi

  # Tags are pulled out of the name before it is split, because they are
  # rendered after both halves and so belong to neither. Cut at the first " #" rather
  # than dropping #-prefixed words, so a multi-word tag like "#Teen (18+)" does
  # not leave debris behind.
  tagpart=""
  if [[ "$n" == \#* ]]; then
    tagpart=" $n"
    n=""
  elif [[ "$n" == *" #"* ]]; then
    tagpart="${n#"${n%% \#*}"}"
    n="$(trim_whitespace "${n%% \#*}")"
  fi
  for tok in "${(@s: #:)tagpart}"; do
    tok="$(trim_whitespace "${tok#\#}")"
    [[ -n "$tok" ]] && FN_TAGS+=("$tok")
  done

  # " - " divides the two halves of the grammar. With no divider the whole
  # remainder is one half or the other, and which one is decided by the date:
  #
  #   the script emits " - " only when the right-hand half has something in it,
  #   so "DATE Alice, Rob [META]" is a name it wrote for a titleless clip, and
  #   that text is the PEOPLE segment. Reading it as a title is what renamed
  #   such a clip to "DATE Alice, Rob - Alice, Rob [META]", embedding the people
  #   as the title on the way past.
  #
  #   without a canonical date the name is not this script's work -- a camera's
  #   "IMG_4855", or something typed by hand -- and its one segment is a title.
  lead="" trail=""
  if [[ "$n" == *" - "* ]]; then
    lead="${n%% - *}"
    trail="${n#* - }"
  elif $dated; then
    lead="$n"
  else
    trail="$n"
  fi

  # Parentheses hold the location. They used to hold the channel, on the other
  # side of the dash, and names written under that grammar are still out there:
  # a parenthesised value in front of the dash is read as a channel, and one
  # that matches the channel the file already stores is read as a channel
  # wherever it sits. Everything else is a location.
  if [[ "$trail" == *\(*\)* ]]; then
    FN_LOCATION="$(trim_whitespace "${${trail##*\(}%%\)*}")"
    trail="$(trim_whitespace "${trail%% \(*}")"
    if [[ -n "$META_CHANNEL" && "$FN_LOCATION" == "$META_CHANNEL" ]]; then
      FN_CHANNEL="$FN_LOCATION"
      FN_LOCATION=""
    fi
  fi

  if [[ "$lead" == *\(*\)* ]]; then
    local parenthesised
    parenthesised="$(trim_whitespace "${${lead##*\(}%%\)*}")"
    lead="$(trim_whitespace "${lead%% \(*}")"
    if [[ -n "$trail" || "$parenthesised" == "$META_CHANNEL" ]]; then
      FN_CHANNEL="$parenthesised"
    else
      FN_LOCATION="$parenthesised"
    fi
  fi

  if [[ -n "$lead" ]]; then
    for tok in "${(@s:, :)lead}"; do
      tok="$(trim_whitespace "$tok")"
      [[ -n "$tok" ]] && FN_PEOPLE+=("$tok")
    done
  fi

  FN_TITLE="$(trim_whitespace "$trail")"
  log_verbose "filename yields: title='${FN_TITLE}' channel='${FN_CHANNEL}' location='${FN_LOCATION}' rating='${FN_RATING}' people=(${(j:, :)FN_PEOPLE}) tags=(${(j:, :)FN_TAGS})"
}

# The location is rendered immediately after the title, so a title mined from a
# name that already carried one would otherwise absorb it and render it twice.
# Only a trailing match is removed: substring-replacing the value anywhere would
# turn a clip titled "Berlin Marathon", shot in Berlin, into " Marathon".
strip_trailing_location() {
  local s="$1"
  [[ -n "$META_LOCATION" && "$s" == *" ${META_LOCATION}" ]] && s="${s% ${META_LOCATION}}"
  print -r -- "$s"
}

resolve_fields() {
  local value

  FINAL_TITLE="" FINAL_CHANNEL="" FINAL_LOCATION="" FINAL_RATING=""
  FINAL_PEOPLE=() FINAL_TAGS=()
  WRITE_FIELD=()

  # people
  if $PEOPLE_GIVEN; then
    FINAL_PEOPLE=("${CLI_PEOPLE[@]}"); WRITE_FIELD[people]=1
  elif $CLEAR_PEOPLE; then
    WRITE_FIELD[people]=1
  elif [[ -n "$META_PEOPLE" ]]; then
    FINAL_PEOPLE=(${(@s:, :)META_PEOPLE})
  elif (( ${#FN_PEOPLE} )); then
    FINAL_PEOPLE=("${FN_PEOPLE[@]}"); WRITE_FIELD[people]=1
  fi

  # tags
  if $KEYWORDS_GIVEN; then
    FINAL_TAGS=("${CLI_KEYWORDS[@]}"); WRITE_FIELD[tags]=1
  elif $CLEAR_TAGS; then
    WRITE_FIELD[tags]=1
  elif (( ${#META_TAGS} )); then
    for value in "${META_TAGS[@]}"; do FINAL_TAGS+=("${value#\#}"); done
  elif (( ${#FN_TAGS} )); then
    FINAL_TAGS=("${FN_TAGS[@]}"); WRITE_FIELD[tags]=1
  fi

  # channel
  if [[ -n "$CHANNEL" ]]; then
    FINAL_CHANNEL="$CHANNEL"; WRITE_FIELD[channel]=1
  elif [[ -n "$META_CHANNEL" ]]; then
    FINAL_CHANNEL="$META_CHANNEL"
  elif [[ -n "$FN_CHANNEL" ]]; then
    FINAL_CHANNEL="$FN_CHANNEL"; WRITE_FIELD[channel]=1
  fi

  # location -- no filename source, so argument, stored value, or coordinates.
  # A stored city beats a geocoded one: it was authored, and the lookup is only
  # ever a guess about which name a place goes by.
  FINAL_STATE="$META_STATE"
  FINAL_COUNTRY="$META_COUNTRY"
  if [[ -n "$LOCATION" ]]; then
    FINAL_LOCATION="$LOCATION"; WRITE_FIELD[location]=1
  elif [[ -n "$META_LOCATION" ]]; then
    FINAL_LOCATION="$META_LOCATION"
  elif [[ -n "$GEO_CITY" ]]; then
    FINAL_LOCATION="$GEO_CITY"
    FINAL_STATE="$GEO_STATE"
    FINAL_COUNTRY="$GEO_COUNTRY"
    WRITE_FIELD[location]=1
  elif [[ -n "$FN_LOCATION" ]]; then
    FINAL_LOCATION="$FN_LOCATION"; WRITE_FIELD[location]=1
  fi

  # rating -- now rendered into the name, so it is backfilled from one like any
  # other field rather than being write-only.
  if [[ -n "$RATING" ]]; then
    FINAL_RATING="$RATING"; WRITE_FIELD[rating]=1
  elif [[ -n "$META_RATING" ]]; then
    FINAL_RATING="$META_RATING"
  elif [[ -n "$FN_RATING" ]]; then
    FINAL_RATING="$FN_RATING"; WRITE_FIELD[rating]=1
  fi

  # title -- capitalized only when mined from a filename; an argument and a
  # stored value are both authored, so they are used exactly as written.
  if [[ -n "$TITLE" ]]; then
    FINAL_TITLE="$TITLE"; WRITE_FIELD[title]=1
  elif $CLEAR_TITLE; then
    WRITE_FIELD[title]=1
  elif [[ -n "$META_TITLE" ]]; then
    FINAL_TITLE="$META_TITLE"
  elif [[ -n "$FN_TITLE" && "$FN_TITLE" != "$META_PEOPLE" ]] && ! is_camera_name "$FN_TITLE"; then
    FINAL_TITLE="$(capitalize_title "$(strip_trailing_location "$FN_TITLE")")"
    [[ -n "$FINAL_TITLE" ]] && WRITE_FIELD[title]=1
  fi

  log_verbose "resolved: title='${FINAL_TITLE}' channel='${FINAL_CHANNEL}' location='${FINAL_LOCATION}' rating='${FINAL_RATING}' people=(${(j:, :)FINAL_PEOPLE}) tags=(${(j:, :)FINAL_TAGS}) writing=(${(k)WRITE_FIELD})"
}

# Standard XMP fields are used in preference to the QuickTime atoms because the
# atoms have no equivalent for a rating, and ItemList:Keywords is not writable
# at all. XMP-dc:Subject and XMP-iptcExt:PersonInImage are also true lists,
# where the atoms would force a comma-joined string.
build_metadata_args() {
  local file="$1"
  local value

  METADATA_ARGS=()

  # Write-once. This records the name the file carried when this script first
  # saw it, which is the only surviving copy of anything the new naming scheme
  # drops -- a hand-typed title, a camera's own IMG_4855. Stamping it on every
  # run would overwrite that original with whatever the previous run generated,
  # so it is only added when the tag is absent.
  if [[ -z "$META_PRESERVED" ]]; then
    METADATA_ARGS+=("-XMP-xmpMM:PreservedFileName=${file:t}")
    META_PRESERVED="${file:t}"
  fi

  # These are XMP list tags, so a plain assignment appends rather than replaces.
  # An empty assignment first clears the stored list; the values that follow must
  # then use "=" and not "+=", because an append is applied against the original
  # list and so survives the clear, quietly accumulating on every run.
  #
  # WRITE_FIELD says which fields resolve_fields decided to write: the ones an
  # argument set, and the ones backfilled from the filename. A field that simply
  # kept its stored value is not re-emitted, so a plain rename never rewrites
  # metadata it did not change.
  if [[ -n "${WRITE_FIELD[people]:-}" ]]; then
    METADATA_ARGS+=("-XMP-iptcExt:PersonInImage=")
    for value in "${FINAL_PEOPLE[@]}"; do
      METADATA_ARGS+=("-XMP-iptcExt:PersonInImage=${value}")
    done
  fi

  if [[ -n "${WRITE_FIELD[tags]:-}" ]]; then
    METADATA_ARGS+=("-XMP-dc:Subject=")
    for value in "${FINAL_TAGS[@]}"; do
      METADATA_ARGS+=("-XMP-dc:Subject=${value}")
    done
  fi

  [[ -n "${WRITE_FIELD[channel]:-}" ]] && METADATA_ARGS+=("-XMP-xmpDM:Album=${FINAL_CHANNEL}")
  # The city is what the filename renders, but it is stored as one field of the
  # IPTC location block, so the province, the country and the coordinates that
  # produced it are written alongside -- the plain-text place and the numbers it
  # came from end up in the same structure, and neither can be read without the
  # other.
  if [[ -n "${WRITE_FIELD[location]:-}" ]]; then
    METADATA_ARGS+=("-XMP-iptcExt:LocationCreatedCity=${FINAL_LOCATION}")
    [[ -n "$FINAL_STATE" ]]   && METADATA_ARGS+=("-XMP-iptcExt:LocationCreatedProvinceState=${FINAL_STATE}")
    [[ -n "$FINAL_COUNTRY" ]] && METADATA_ARGS+=("-XMP-iptcExt:LocationCreatedCountryName=${FINAL_COUNTRY}")
    if [[ -n "$GEO_LAT" && -n "$GEO_LON" ]]; then
      METADATA_ARGS+=("-XMP-iptcExt:LocationCreatedGPSLatitude=${GEO_LAT}")
      METADATA_ARGS+=("-XMP-iptcExt:LocationCreatedGPSLongitude=${GEO_LON}")
    fi
  fi
  [[ -n "${WRITE_FIELD[title]:-}" ]] && METADATA_ARGS+=("-XMP-dc:Title=${FINAL_TITLE}")
  [[ -n "${WRITE_FIELD[rating]:-}" ]] && METADATA_ARGS+=("-XMP-xmp:Rating=${FINAL_RATING}")
}

# Print the first argument that holds a real value. exiftool's -f prints "-" for
# a tag the file does not carry, so that stands in for empty here too.
first_present() {
  local value
  for value in "$@"; do
    value="$(trim_whitespace "$value")"
    [[ -n "$value" && "$value" != "-" ]] && { print -r -- "$value"; return 0; }
  done
}

# Read the authored fields back out for the filename. One exiftool call; -f -T
# gives a tab-separated row with "-" standing in for anything absent, so the
# columns stay aligned however many fields the file actually carries.
#
# Each field is read from the XMP written by --actor/--tag/... first, then falls
# back to the QuickTime Keys atoms that yt-dlp's --embed-metadata writes. Without
# that fallback an existing download would be read as having no people, channel
# or tags, and this script would strip them out of a filename that was the only
# other place they existed.
read_authored_metadata() {
  local file="$1" row subject
  local -a cols

  META_PEOPLE="" META_CHANNEL="" META_TITLE="" META_LOCATION="" META_PRESERVED=""
  META_RATING="" META_GPS="" META_STATE="" META_COUNTRY=""
  META_TAGS=()

  command -v exiftool >/dev/null 2>&1 || return 0

  row="$(
    exiftool -f -T -PersonInImage -XMP-xmpDM:Album -Title -Subject \
      -LocationCreatedCity -Keys:Actors -Keys:Artist -Keys:AlbumArtist \
      -Keys:Album -Keys:Keywords -XMP-xmpMM:PreservedFileName \
      -XMP-xmp:Rating -GPSCoordinates \
      -LocationCreatedProvinceState -LocationCreatedCountryName \
      -- "$file" 2>/dev/null | head -1
  )"
  [[ -z "$row" ]] && return 0

  cols=("${(@s:	:)row}")
  META_PEOPLE="$(first_present "${cols[1]}" "${cols[6]}" "${cols[7]}")"
  META_CHANNEL="$(first_present "${cols[2]}" "${cols[8]}" "${cols[9]}")"
  META_TITLE="$(first_present "${cols[3]}")"
  META_LOCATION="$(first_present "${cols[5]}")"
  META_PRESERVED="$(first_present "${cols[11]}")"
  META_RATING="$(first_present "${cols[12]}")"
  META_GPS="$(first_present "${cols[13]}")"
  META_STATE="$(first_present "${cols[14]}")"
  META_COUNTRY="$(first_present "${cols[15]}")"

  # Keywords come back as a ", "-joined list; each entry becomes one #tag.
  subject="$(first_present "${cols[4]}" "${cols[10]}")"
  if [[ -n "$subject" ]]; then
    local tag
    for tag in "${(@s:,:)subject}"; do
      tag="$(trim_whitespace "$tag")"
      [[ -n "$tag" ]] && META_TAGS+=("#${tag}")
    done
  fi

  report_authored_metadata "$file"
}

# Print what the file already carries, before anything is written or renamed, so
# a run shows the values it is about to keep or replace rather than only the name
# it ends up with. Absent fields are omitted rather than printed empty, which
# keeps a bare camera clip to a single line.
#
# GPS is reported but never used: the coordinates are all the file stores, and
# LOCATION wants a place name. QuickTime's "Created in Makati" is macOS
# reverse-geocoding those numbers live, not something read back off the file.
#
# Suppressed under --print-target, whose stdout is a path meant to be consumed
# by another command.
report_authored_metadata() {
  local file="$1"
  local -a lines
  local place

  $PRINT_TARGET && return 0

  # City, province and country are three tags but one fact, so they are reported
  # as one line. Only the city is ever rendered into the filename.
  place="$META_LOCATION"
  [[ -n "$META_STATE" ]]   && place="${place:+${place}, }${META_STATE}"
  [[ -n "$META_COUNTRY" ]] && place="${place:+${place}, }${META_COUNTRY}"

  [[ -n "$META_TITLE" ]]     && lines+=("title:     ${META_TITLE}")
  [[ -n "$META_PEOPLE" ]]    && lines+=("people:    ${META_PEOPLE}")
  [[ -n "$META_CHANNEL" ]]   && lines+=("channel:   ${META_CHANNEL}")
  [[ -n "$place" ]]          && lines+=("location:  ${place}")
  [[ -n "$META_GPS" ]]       && lines+=("gps:       ${META_GPS}")
  (( ${#META_TAGS} ))        && lines+=("tags:      ${(j: :)META_TAGS}")
  [[ -n "$META_RATING" ]]    && lines+=("rating:    ${META_RATING}")
  [[ -n "$META_PRESERVED" ]] && lines+=("was:       ${META_PRESERVED}")

  if (( ${#lines} )); then
    print -r -- "${CYAN}${ICON_SKIP}${file:t}${RESET}"
    local line
    for line in "${lines[@]}"; do
      print -r -- "${CYAN}    ${line}${RESET}"
    done
  else
    print -r -- "${CYAN}${ICON_SKIP}${file:t}: no embedded metadata${RESET}"
  fi
}

# ---------------------------------------------------------------------------
# GEOCODING
# ---------------------------------------------------------------------------

# The coordinates a camera writes, as signed decimal degrees. Read separately
# from the main metadata row because that row reports them the way QuickTime's
# Get Info panel does -- 14 deg 33' 50.36" N -- and a geocoder wants numbers.
read_gps_position() {
  local file="$1" pos

  GEO_LAT="" GEO_LON=""

  pos="$(exiftool -c '%+.6f' -s3 -f -GPSPosition -- "$file" 2>/dev/null | head -1)"
  if [[ "$pos" =~ '([-+]?[0-9]+\.[0-9]+),[[:space:]]*([-+]?[0-9]+\.[0-9]+)' ]]; then
    GEO_LAT="$match[1]"
    GEO_LON="$match[2]"
    log_verbose "gps position: ${GEO_LAT}, ${GEO_LON}"
  fi
}

# Coordinates -> place name, via bin/reverse-geocode (MapKit).
#
# Cached by coordinate rounded to four decimals, about 11 metres, so a shoot that
# never left one street costs a single lookup however many clips came off it. A
# failed lookup is cached as nothing at all: the next run should retry it, since
# the usual cause is that this machine was offline.
geocode_position() {
  local cache_dir cache_file row

  GEO_CITY="" GEO_STATE="" GEO_COUNTRY=""
  [[ -z "$GEO_LAT" || -z "$GEO_LON" ]] && return 0

  if ! command -v reverse-geocode >/dev/null 2>&1; then
    print -u2 -r -- "${YELLOW}${ICON_WARN}--geocode needs reverse-geocode on PATH (deploy the bin package)${RESET}"
    return 0
  fi

  cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/rename-footage/geocode"
  cache_file="${cache_dir}/$(printf '%.4f_%.4f' "$GEO_LAT" "$GEO_LON").tsv"

  if [[ -s "$cache_file" ]]; then
    row="$(head -1 -- "$cache_file")"
    log_verbose "geocode cache hit: ${cache_file:t}"
  else
    row="$(reverse-geocode "$GEO_LAT" "$GEO_LON" 2>/dev/null | head -1)"
    if [[ -z "$row" ]]; then
      print -u2 -r -- "${YELLOW}${ICON_WARN}Could not geocode ${GEO_LAT}, ${GEO_LON}${RESET}"
      return 0
    fi
    mkdir -p -- "$cache_dir" 2>/dev/null && print -r -- "$row" > "$cache_file"
  fi

  local -a parts
  parts=("${(@s:	:)row}")
  GEO_CITY="${parts[1]:-}"
  GEO_STATE="${parts[2]:-}"
  GEO_COUNTRY="${parts[3]:-}"
  log_verbose "geocoded ${GEO_LAT}, ${GEO_LON} -> ${GEO_CITY}, ${GEO_STATE}, ${GEO_COUNTRY}"
}

embed_metadata() {
  local file="$1"

  # Always attempted: a run with no authored options still needs to stamp
  # PreservedFileName, and may still be backfilling fields from the filename.
  # build_metadata_args yields nothing once there is nothing left to write,
  # which is what makes a repeat run a no-op.
  command -v exiftool >/dev/null 2>&1 || return 0

  build_metadata_args "$file"
  (( ${#METADATA_ARGS} )) || return 0

  if $DRY_RUN; then
    log_verbose "would embed into ${file:t}: ${(j: :)METADATA_ARGS}"
    return 0
  fi

  # -overwrite_original_in_place keeps the inode, so Finder tags and the rest of
  # the file's xattrs survive; plain -overwrite_original renames a temp file over
  # the original and silently drops them. Neither reorders atoms, so a faststart
  # layout is preserved either way.
  if exiftool -q -overwrite_original_in_place "${METADATA_ARGS[@]}" -- "$file"; then
    log_verbose "embedded authored metadata into ${file:t}"
  else
    print -u2 -r -- "${YELLOW}${ICON_WARN}Could not embed metadata: ${file:t}${RESET}"
    return 1
  fi
}

# ---------------------------------------------------------------------------
# main per-file worker
# ---------------------------------------------------------------------------

process_video() {
  local file="$1"

  log_verbose "processing file: $file"

  # Read first: embedding has to know whether PreservedFileName is already set,
  # and reading before the rename is also what makes the stamp record the right
  # name. --print-target is a query, so it stays side-effect free.
  read_authored_metadata "$file"

  local filename="${file:t}"
  local dirname="${file:h}"
  local extension="${filename:e}"
  local name_without_ext="${filename:r}"

  # Parse the name before anything is written, then decide each field. Both the
  # embedded metadata and the rendered filename come from the same resolved
  # values, so what lands on disk and what the file is called cannot disagree.
  parse_filename_fields "$name_without_ext"

  # Coordinates are only read when something is going to use them: --geocode
  # needs them to find a place name, and --location writes them into the same
  # block as the name it was given, so the two stay together.
  GEO_LAT="" GEO_LON="" GEO_CITY="" GEO_STATE="" GEO_COUNTRY=""
  if $GEOCODE || [[ -n "$LOCATION" ]]; then
    read_gps_position "$file"
    $GEOCODE && [[ -z "$LOCATION" && -z "$META_LOCATION" ]] && geocode_position
  fi

  resolve_fields
  $PRINT_TARGET || embed_metadata "$file"

  local date_stamp
  date_stamp="$(resolve_date "$file" "$name_without_ext")"

  log_verbose "title='${FINAL_TITLE}' date='${date_stamp}'"

  local tag
  local video_info
  if ! video_info="$(
    ffprobe -v error -select_streams v:0 \
      -show_entries stream=codec_name,width,height,r_frame_rate,bit_rate \
      -of default=noprint_wrappers=1:nokey=0 -- "$file" 2>/dev/null
  )"; then
    print -r -- "${YELLOW}${ICON_WARN}Could not read video info: $file${RESET}"
    return 0
  fi

  local duration_secs
  if ! duration_secs="$(
    ffprobe -v error -show_entries format=duration -of csv=p=0 -- "$file" 2>/dev/null
  )"; then
    duration_secs="0"
  fi
  duration_secs="$(awk -v d="$duration_secs" 'BEGIN{printf("%d", d+0.5)}')"

  local width="" height="" frame_rate="" bit_rate="" codec_name=""
  local line key value
  while IFS= read -r line; do
    key="${line%%=*}"
    value="${line#*=}"
    case "$key" in
      codec_name) codec_name="$value" ;;
      width)      width="$value" ;;
      height)     height="$value" ;;
      r_frame_rate) frame_rate="$value" ;;
      bit_rate)   bit_rate="$value" ;;
    esac
  done <<< "$video_info"

  if [[ "$frame_rate" == */* ]]; then
    local num=${frame_rate%%/*}
    local denom=${frame_rate##*/}
    if (( denom > 0 )); then
      frame_rate=$(( (num + denom / 2) / denom ))
    else
      frame_rate=0
    fi
  fi

  local rotation abs_rotation display_width display_height
  rotation="$(get_rotation "$file")"
  abs_rotation=${rotation#-}
  display_width=$width
  display_height=$height
  if [[ "$abs_rotation" == "90" || "$abs_rotation" == "270" ]]; then
    display_width=$height
    display_height=$width
  fi

  local smaller_dim=$(( display_width < display_height ? display_width : display_height ))
  local resolution
  resolution="$(get_resolution_label "$smaller_dim")"

  local orientation_flag
  if (( display_width > display_height )); then
    orientation_flag="H"
  elif (( display_height > display_width )); then
    orientation_flag="V"
  else
    orientation_flag="S"
  fi

  local mbps="unknown"
  if [[ -n "$bit_rate" && "$bit_rate" != "N/A" ]]; then
    mbps="$(awk -v b="$bit_rate" 'BEGIN{printf("%dmbps", (b+500000)/1000000)}')"
  fi

  local duration
  duration="$(format_duration "$duration_secs")"

  local codec_flag=""
  case "${codec_name:l}" in
    hevc|h265) codec_flag="h265" ;;
    h264|avc1) codec_flag="h264" ;;
    prores)    codec_flag="PRO" ;;
    vp9)       codec_flag="VP9" ;;
    av1)       codec_flag="AV1" ;;
  esac

  local device
  device="$(get_device "$file")"

  log_verbose "metadata for ${filename}: res=${resolution} fps=${frame_rate} len=${duration} bitrate=${mbps} codec=${codec_flag:-<none>} device=${device:-<none>} orientation=${orientation_flag}"

  # order: RES FPS LENGTH BITRATE CODEC DEVICE ORIENTATION
  local -a tags
  tags+=("$resolution")
  tags+=("${frame_rate}fps")
  tags+=("$duration")
  [[ "$mbps" != "unknown" ]] && tags+=("$mbps")
  [[ -n "$codec_flag" ]] && tags+=("$codec_flag")
  [[ -n "$device" ]] && tags+=("$device")
  tags+=("$orientation_flag")

  local tags_block="[${(j: :)tags}]"

  # assemble: DATE PEOPLE - TITLE (LOCATION) #TAGS RATING [METADATA].ext
  #
  # The dash separates the people from the title and appears only when there is
  # a title to separate them from; everything after it -- location, tags, stars
  # -- simply follows whichever side the name ended on. Every segment drops out
  # when its field is empty, so an untitled clip reads
  # "DATE PEOPLE (LOCATION) #TAGS [METADATA]" and a bare one "DATE [METADATA]".
  #
  # The channel is not rendered at all. It stays embedded as XMP-xmpDM:Album,
  # where the parentheses it used to occupy now hold the location.
  local -a parts rendered_tags
  [[ -n "$date_stamp" ]] && parts+=("$date_stamp")
  (( ${#FINAL_PEOPLE} )) && parts+=("${(j:, :)FINAL_PEOPLE}")
  [[ -n "$FINAL_TITLE" ]] && parts+=("-" "$FINAL_TITLE")
  [[ -n "$FINAL_LOCATION" ]] && parts+=("(${FINAL_LOCATION})")
  for tag in "${FINAL_TAGS[@]}"; do rendered_tags+=("#${tag}"); done
  (( ${#rendered_tags} )) && parts+=("${(j: :)rendered_tags}")
  [[ -n "$FINAL_RATING" ]] && (( FINAL_RATING > 0 )) && parts+=("$(render_stars "$FINAL_RATING")")
  parts+=("$tags_block")

  local stem="${(j: :)parts}"
  stem="$(trim_whitespace "$stem")"
  stem="${stem//\//-}"   # a metadata field may legitimately contain a slash

  local new_filename="${stem}.${extension}"
  local new_path="${dirname}/${new_filename}"

  log_verbose "rename target for ${filename}: ${new_filename}"

  if $PRINT_TARGET; then
    print -r -- "$new_path"
    return 0
  fi

  if [[ "$filename" == "$new_filename" ]]; then
    print -r -- "${YELLOW}${ICON_SKIP}Unchanged: ${filename}${RESET}"
  elif [[ -e "$new_path" ]]; then
    print -r -- "${YELLOW}${ICON_WARN}Exists: $new_filename${RESET}"
  else
    if $DRY_RUN; then
      print -r -- "${CYAN}${ICON_VIDEO}${new_filename}${RESET}"
    else
      if mv -- "$file" "$new_path"; then
        touch_modified_now "$new_path"
        print -r -- "${GREEN}${ICON_OK}${new_filename}${RESET}"
      else
        print -r -- "${YELLOW}${ICON_WARN}Could not rename: ${filename} -> ${new_filename}${RESET}"
        return 1
      fi
    fi
  fi
}

normalize_input_path() {
  local s="$1"
  local unescaped candidate cwd_name

  if [[ -e "$s" ]]; then
    print -r -- "${s:a}"
    return 0
  fi

  unescaped="${(Q)s}"
  if [[ -e "$unescaped" ]]; then
    print -r -- "${unescaped:a}"
    return 0
  fi

  cwd_name="${PWD:t}"

  if [[ "$unescaped" != /* && "$unescaped" == */* && "${unescaped:h:t}" == "$cwd_name" ]]; then
    candidate="${unescaped:t}"
    if [[ -e "$candidate" ]]; then
      print -r -- "${candidate:a}"
      return 0
    fi
  fi

  if [[ "$s" != /* && "$s" == */* && "${s:h:t}" == "$cwd_name" ]]; then
    candidate="${s:t}"
    if [[ -e "$candidate" ]]; then
      print -r -- "${candidate:a}"
      return 0
    fi
  fi

  if [[ "$unescaped" != "$s" ]]; then
    print -r -- "$unescaped"
    return 0
  fi

  print -r -- "$s"
}

main() {
  while (( $# > 0 )); do
    case "$1" in
      --title|--people|--actor|--tag|--channel|--location|--rating)
        if (( $# < 2 )); then
          print -u2 -r -- "${YELLOW}${ICON_WARN}$1 requires a value${RESET}"
          exit 1
        fi
        case "$1" in
          --title)    TITLE="$2" ;;
          --people|--actor) CLI_PEOPLE+=("$2"); PEOPLE_GIVEN=true ;;
          --tag)      CLI_KEYWORDS+=("$2"); KEYWORDS_GIVEN=true ;;
          --channel)  CHANNEL="$2" ;;
          --location) LOCATION="$2" ;;
          --rating)
            if [[ "$2" != [0-5] ]]; then
              print -u2 -r -- "${YELLOW}${ICON_WARN}--rating must be 0-5, got: $2${RESET}"
              exit 1
            fi
            RATING="$2"
            ;;
        esac
        shift 2
        ;;
      --clear-title)  CLEAR_TITLE=true; shift ;;
      --clear-people|--clear-actors) CLEAR_PEOPLE=true; shift ;;
      --geocode) GEOCODE=true; shift ;;
      --clear-tags)   CLEAR_TAGS=true; shift ;;
      --dry-run) DRY_RUN=true; shift ;;
      --verbose) VERBOSE=true; shift ;;
      --color)   enable_color; shift ;;
      --icons)   enable_icons; shift ;;
      --print-target|--target-path) PRINT_TARGET=true; shift ;;
      --) shift; break ;;
      -h|--help) usage; exit 0 ;;
      -*)
        print -u2 -r -- "${YELLOW}${ICON_WARN}Unknown option: $1${RESET}"
        exit 1
        ;;
      *) break ;;
    esac
  done

  if ! command -v ffprobe >/dev/null 2>&1; then
    print -u2 -r -- "${YELLOW}${ICON_WARN}ffprobe is required but not installed.${RESET}"
    exit 1
  fi

  # Not optional, despite what the old header said. Every authored field lives
  # in XMP that only exiftool can read. Without it read_authored_metadata comes
  # back empty, the filename is rebuilt from nothing, and a name like
  # "Alice (MyChannel) - Wedding Toast Berlin #beach.mov" becomes
  # "2026-08-28--16-45-08 [480p 30fps 1sec h264 H].mov" -- with the title gone
  # for good, since PreservedFileName cannot be written either.
  if ! command -v exiftool >/dev/null 2>&1; then
    print -u2 -r -- "${YELLOW}${ICON_WARN}exiftool is required but not installed.${RESET}"
    print -u2 -r -- "${YELLOW}  Renaming without it would strip people, channel, title, location and${RESET}"
    print -u2 -r -- "${YELLOW}  tags from filenames that are their only copy. Install with: brew install exiftool${RESET}"
    exit 1
  fi

  local raw_file file

  for raw_file in "$@"; do
    file="$(normalize_input_path "$raw_file")"

    if [[ -f "$file" ]]; then
      case "${file:l}" in
        *.mp4|*.mov|*.avi|*.mkv|*.wmv|*.flv|*.webm|*.m4v)
          process_video "$file"
          ;;
        *)
          print -r -- "${YELLOW}${ICON_SKIP}Not a video: ${file:t}${RESET}"
          ;;
      esac
    else
      # Named rather than shrugged at, and with the whole path: the usual cause
      # is a path from before a previous run renamed the file out from under it,
      # where a bare basename looks exactly like a file that was read and left
      # alone.
      print -r -- "${YELLOW}${ICON_WARN}Not found: ${file}${RESET}"
    fi
  done
}

main "$@"
