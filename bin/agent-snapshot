#!/bin/zsh -f
# agent-snapshot: safety net for work no agent committed (Crush and other
# tools without a Stop hook, a crashed turn, your own edits).
#
# Every dirty git worktree under $SRC_PATH (and this dotfiles repo) has its
# uncommitted work saved to the hidden ref refs/wip/<branch>: a commit whose
# parent is HEAD. Your branch, index and working tree are never touched.
# Its message names the agent sessions active in that worktree:
#   Claude-Session / Codex-Session  transcripts with that cwd written recently
#   Agent-Process                   other agent processes running there
#
#   agent-snapshot                            snapshot now (launchd: every 5 min)
#   agent-snapshot list                       snapshots of work still uncommitted
#   git diff HEAD refs/wip/<branch>           what was uncommitted
#   git checkout refs/wip/<branch> -- <path>  restore a file from it
#   git reflog refs/wip/<branch>              every earlier snapshot
#
# Untracked files can't bloat .git: dependency/build dirs (venv, node_modules,
# target, ...) and media/archives are never taken, nor files over
# $AGENT_SNAPSHOT_MAX_KB (5120), nor more than $AGENT_SNAPSHOT_MAX_TOTAL_MB (20)
# of them per snapshot; what was left out is noted in the message.
# Old snapshots expire with the reflog. Installed as a LaunchAgent by
# scripts/install/install-agent-snapshot.sh.

emulate -L zsh
setopt extended_glob null_glob
zmodload -F zsh/stat b:zstat

# launchd hands us a bare PATH; Homebrew git and jq live here.
export PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH
# Never take index.lock on a real index: an agent may be mid-`git add`.
export GIT_OPTIONAL_LOCKS=0

ROOT=${0:A:h:h}
SRC=${SRC_PATH:-$HOME/src}
MAX_KB=${AGENT_SNAPSHOT_MAX_KB:-5120}
MAX_TOTAL_MB=${AGENT_SNAPSHOT_MAX_TOTAL_MB:-20}
# Never snapshotted, ignored or not: rebuildable, and huge.
JUNK_DIRS='(venv|.venv|env|node_modules|target|__pycache__|.mypy_cache|.pytest_cache|.tox|dist|build|.build|DerivedData|Pods|.gradle|.next|.cache)'
# Media and archives: downloads and renders, never an agent's source.
JUNK_EXTS='(m4a|mp3|wav|aif|aiff|flac|aac|ogg|opus|mp4|m4v|mov|mkv|webm|avi|zip|tar|gz|tgz|xz|7z|rar|dmg|iso|pkg)'
WINDOW_MIN=${AGENT_SNAPSHOT_WINDOW_MIN:-15}
OTHER_AGENTS=(${=AGENT_SNAPSHOT_PROCS:-crush aider gemini opencode cursor-agent goose amp})

# --- worktrees ---------------------------------------------------------------

typeset -U worktrees
for repo in $SRC/*/.git(:h) $ROOT; do
  worktrees+=(${(f)"$(git -C $repo worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p')"})
done
worktrees=(${^worktrees}(N/))

# The worktree a path belongs to: the longest one containing it, so a nested
# worktree (.claude/worktrees/x) isn't credited to the checkout around it.
owner() {
  local best= wt
  for wt in $worktrees; do
    [[ $1 == $wt || $1 == $wt/* ]] && (( ${#wt} > ${#best} )) && best=$wt
  done
  REPLY=$best
}

branch_ref() {
  local branch
  branch=$(git symbolic-ref -q --short HEAD) || branch=detached-${1:t}
  REPLY=refs/wip/$branch
}

# --- who was working where ---------------------------------------------------

typeset -A trailers  # worktree -> newline-separated trailer lines
credit() {
  owner $2
  [[ -n $REPLY && ${trailers[$REPLY]} != *"$1"* ]] && trailers[$REPLY]+="$1"$'\n'
}

collect_agents() {
  local f cwd id line
  for f in $HOME/.claude/projects/*/*.jsonl(.mm-$WINDOW_MIN); do
    cwd=$(grep -m1 -o '"cwd":"[^"]*"' $f) || continue
    cwd=${${cwd#\"cwd\":\"}%\"}
    credit "Claude-Session: ${f:t:r}" $cwd
  done
  for f in $HOME/.codex/sessions/**/*.jsonl(.mm-$WINDOW_MIN); do
    line=$(head -1 $f | jq -r '[.payload.id, .payload.cwd] | @tsv' 2>/dev/null) || continue
    id=${line%%$'\t'*} cwd=${line#*$'\t'}
    [[ -n $id && $id != null ]] && credit "Codex-Session: $id" $cwd
  done
  local cmd
  lsof -a -d cwd ${OTHER_AGENTS/#/-c} -Fcn 2>/dev/null | while read -r line; do
    case $line in
      c*) cmd=${line#c} ;;
      n*) credit "Agent-Process: $cmd" ${line#n} ;;
    esac
  done
}

# --- snapshot ----------------------------------------------------------------

snapshot() {
  local wt=$1 head ref idx tree summary commit f
  local -a untracked small big notes
  local -a sz
  cd -q $wt 2>/dev/null || return 0
  [[ -n $(git status --porcelain 2>/dev/null) ]] || return 0
  head=$(git rev-parse -q --verify HEAD) || return 0  # unborn branch
  branch_ref $wt; ref=$REPLY

  # Build the tree in a copy of the index: stat-cached, so it's fast.
  idx=$(mktemp -t agent-snapshot) || return 1
  cp -- "$(git rev-parse --git-path index)" $idx 2>/dev/null \
    || GIT_INDEX_FILE=$idx git read-tree $head
  GIT_INDEX_FILE=$idx git add -u 2>/dev/null
  # Untracked files are where the bloat hides (an unignored venv, downloads),
  # so they get a per-file limit, a per-snapshot budget and a junk-dir filter.
  local -i budget=$(( MAX_TOTAL_MB * 1024 * 1024 )) junk=0 over=0
  untracked=(${(0)"$(git ls-files -oz --exclude-standard)"})
  for f in $untracked; do
    if [[ /$f == */${~JUNK_DIRS}/* || ${(L)f:e} == ${~JUNK_EXTS} || ${f:t} == .DS_Store ]]; then
      (( ++junk )); continue
    fi
    zstat -A sz +size -- $f 2>/dev/null || continue
    if (( sz[1] > MAX_KB * 1024 )); then
      big+=($f)
    elif (( sz[1] > budget )); then
      (( ++over ))
    else
      small+=($f)
      (( budget -= sz[1] ))
    fi
  done
  (( $#small )) && print -rN -- $small \
    | GIT_INDEX_FILE=$idx git add --pathspec-from-file=- --pathspec-file-nul 2>/dev/null
  tree=$(GIT_INDEX_FILE=$idx git write-tree)
  rm -f -- $idx
  [[ -n $tree ]] || return 1

  # Nothing new since the last snapshot, or nothing worth saving.
  [[ $tree == $(git rev-parse "$head^{tree}") ]] && return 0
  if git rev-parse -q --verify $ref >/dev/null \
    && [[ $(git rev-parse "$ref^{tree}") == $tree && $(git rev-parse "$ref^") == $head ]]; then
    return 0
  fi

  summary=$(git diff --shortstat $head $tree)
  for f in $big[1,10]; do notes+=("Skipped-Large: $f"); done
  (( $#big > 10 )) && notes+=("Skipped-Large: $(( $#big - 10 )) more")
  (( over )) && notes+=("Skipped-Untracked: $over files over the ${MAX_TOTAL_MB} MB budget")
  (( junk )) && notes+=("Skipped-Untracked: $junk files in dependency/build dirs or media/archives")
  commit=$(
    print -r -- "wip snapshot:${summary}"$'\n\n'"${trailers[$wt]}${(F)notes}" \
      | GIT_AUTHOR_NAME=agent-snapshot GIT_AUTHOR_EMAIL=agent-snapshot@localhost \
      GIT_COMMITTER_NAME=agent-snapshot GIT_COMMITTER_EMAIL=agent-snapshot@localhost \
        git commit-tree $tree -p $head
  ) || return 1
  git update-ref --create-reflog -m agent-snapshot $ref $commit
  print -r -- "$wt $ref:$summary"
}

# --- list --------------------------------------------------------------------

list() {
  local wt head
  for wt in $worktrees; do
    cd -q $wt 2>/dev/null || continue
    head=$(git rev-parse -q --verify HEAD) || continue
    branch_ref $wt
    git rev-parse -q --verify $REPLY >/dev/null || continue
    # Once HEAD moves the work was committed (or abandoned); see the reflog.
    [[ $(git rev-parse "$REPLY^") == $head ]] || continue
    git log -1 --color=always \
      --format="%C(yellow)$wt%C(reset) $REPLY %C(dim)(%cr)%C(reset)%n  %s%n%(trailers:unfold,separator=%x0a  ,key=Claude-Session,key=Codex-Session,key=Agent-Process,key=Skipped-Large)" \
      $REPLY | sed -e '3s/^/  /' -e '/^ *$/d'
    print
  done
}

case ${1:-} in
  '')
    collect_agents
    for wt in $worktrees; do snapshot $wt; done
    ;;
  list) list ;;
  -h|--help) sed -n '2,21p' ${0:A} | sed 's/^# \{0,1\}//' ;;
  *) print -ru2 -- "usage: agent-snapshot [list]"; exit 2 ;;
esac
