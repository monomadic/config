#!/usr/bin/env zsh
# kitty-launch
# Launch a command in Kitty from an external environment.
#
# Behavior:
#   - If Kitty IPC is reachable, open a new Kitty window/tab via `kitten @ launch`.
#   - If not reachable, start a new Kitty instance listening on the chosen socket.
#   - If no command is provided, open an interactive login shell.
#   - --shell runs the command through the login $SHELL, for its env/PATH;
#     --interactive does the same with -i, so .zshrc is read too.
#   - Focuses/shows the launched Kitty window by default after launching.
#   - Closes the window when the command exits. --hold keeps it open;
#     --hold-on-fail keeps it only after a failure, by running the command
#     under kitty-hold-on-error (red tab, dismiss / copy buffer / shell menu).
#   - --float opens a panel along the bottom of the screen instead of a
#     tab/window.
#
# Socket priority:
#   1. KITTY_LAUNCH_SOCKET
#   2. KITTY_LISTEN_ON, when launched from inside Kitty
#   3. unix:/tmp/kitty-$USER
#   4. reachable /tmp/kitty-* socket discovery

emulate -L zsh
set -euo pipefail

script_name="${0:t}"
script_dir="${0:a:h}"

user_name="${USER:-${LOGNAME:-$(id -un)}}"
default_shell="${SHELL:-/bin/zsh}"

configured_socket_addr="${KITTY_LAUNCH_SOCKET:-${KITTY_LISTEN_ON:-unix:/tmp/kitty-${user_name}}}"
socket_addr="$configured_socket_addr"

launch_type="tab"
cwd=""
title=""
keep_focus=false
activate=true
detach=true
debug=false
hold=false
hold_on_fail=false
float_lines=16
auto_hide=false
via_shell=false
shell_flags="-lc"

usage() {
  cat <<EOF
$script_name

Launch a command in Kitty, using IPC if Kitty is already running.

If no command is provided, opens an interactive login shell.

Usage:
  $script_name [options] [-- command [args...]]

Options:
  --tab              Open in a new Kitty tab (default)
  --window           Open in a new Kitty window inside current OS window
  --os-window        Open in a new top-level OS window
  --float            Open in a floating panel along the bottom of the screen
  --lines N          Height of the --float panel in lines (default: 16)
  --cwd DIR          Working directory for launched command
  --title TITLE      Window/tab title
  --shell            Run the command through \$SHELL -lc, so it gets your login
                     env (PATH etc.). One argument is evaluated as a shell
                     string; several are run as argv, exactly as supplied
  --interactive      Like --shell, but through \$SHELL -lic, so .zshrc is read
                     too (aliases, functions, PATH set up only there)
  --keep-focus       Do not focus the newly launched Kitty window/tab internally
  --hold             Keep the window open after the command exits, until a
                     key is pressed (default: close it)
  --hold-on-fail     Close on success; on failure turn the tab red and offer
                     dismiss / copy buffer / interactive shell
                     (runs the command under kitty-hold-on-error)
  --dismiss          No-op; closing is the default (accepted for old callers)
  --auto-hide        Hide Kitty.app after the launched command exits
  --activate         Focus/show the launched Kitty window after launch (default)
  --no-activate      Do not focus/show the launched Kitty window after launch
  --socket ADDR      Kitty IPC address
  --no-detach        Do not detach when starting Kitty fallback
  --debug            Print chosen socket and command
  -h, --help         Show help

Environment:
  KITTY_LAUNCH_SOCKET  Override socket address.
  KITTY_LISTEN_ON      Used automatically when running inside Kitty.
  SHELL                Shell used when no command is provided.

Current defaults:
  socket: $configured_socket_addr
  shell:  $default_shell

Examples:
  $script_name
  $script_name --cwd ~/Downloads
  $script_name --tab -- zsh -lc 'cd ~/src && hx .'
  $script_name --tab --shell -- 'cd ~/src && hx .'
  $script_name --window -- yazi ~/Downloads
  $script_name --auto-hide --shell -- make test
  $script_name --float --hold-on-fail --shell -- cargo build --release
  $script_name --os-window -- zsh -l
EOF
}

normalize_cwd() {
  local input="${1:-}"
  local resolved=""

  # ForkLift may pass newline-separated selected paths.
  # zsh: split scalar into lines.
  local -a selected_paths
  selected_paths=( "${(@f)input}" )

  resolved="${selected_paths[1]:-}"

  # Empty input: use HOME.
  if [[ -z "$resolved" ]]; then
    print -r -- "$HOME"
    return 0
  fi

  # Trim trailing slash except root.
  if [[ "$resolved" != "/" ]]; then
    resolved="${resolved%/}"
  fi

  # If selected item is a file, use its containing directory.
  if [[ -f "$resolved" ]]; then
    resolved="${resolved:h}"
  fi

  print -r -- "$resolved"
}

while (( $# )); do
  case "$1" in
    --tab)
      launch_type="tab"
      shift
      ;;
    --window)
      launch_type="window"
      shift
      ;;
    --os-window|--os_window)
      launch_type="os-window"
      shift
      ;;
    --cwd)
      (( $# >= 2 )) || {
        print -u2 -- "missing argument for --cwd"
        exit 2
      }
      cwd="$(normalize_cwd "$2")"
      shift 2
      ;;
    --title)
      (( $# >= 2 )) || {
        print -u2 -- "missing argument for --title"
        exit 2
      }
      title="$2"
      shift 2
      ;;
    --shell)
      via_shell=true
      shift
      ;;
    --interactive)
      via_shell=true
      shell_flags="-lic"
      shift
      ;;
    --keep-focus)
      keep_focus=true
      shift
      ;;
    --float)
      launch_type="os-panel"
      shift
      ;;
    --lines)
      (( $# >= 2 )) || {
        print -u2 -- "missing argument for --lines"
        exit 2
      }
      float_lines="$2"
      shift 2
      ;;
    --hold)
      hold=true
      hold_on_fail=false
      shift
      ;;
    --hold-on-fail)
      hold_on_fail=true
      hold=false
      shift
      ;;
    --dismiss)
      # Closing is the default; accepted so old callers keep working.
      hold=false
      hold_on_fail=false
      shift
      ;;
    --auto-hide)
      auto_hide=true
      shift
      ;;
    --activate)
      activate=true
      shift
      ;;
    --no-activate)
      activate=false
      shift
      ;;
    --socket)
      (( $# >= 2 )) || {
        print -u2 -- "missing argument for --socket"
        exit 2
      }
      configured_socket_addr="$2"
      socket_addr="$2"
      shift 2
      ;;
    --no-detach)
      detach=false
      shift
      ;;
    --debug)
      debug=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      print -u2 -- "unknown option: $1"
      exit 2
      ;;
    *)
      break
      ;;
  esac
done

if (( $# )) && $via_shell; then
  # One argument is a shell string; several are argv routed through the shell.
  if (( $# == 1 )); then
    command_argv=( "$default_shell" "$shell_flags" "$1" )
  else
    command_argv=( "$default_shell" "$shell_flags" 'exec "$@"' "$script_name" "$@" )
  fi
elif (( $# )); then
  command_argv=( "$@" )
else
  command_argv=( "$default_shell" -l )
fi

$hold_on_fail && command_argv=( "$script_dir/kitty-hold-on-error" "${command_argv[@]}" )

panel_opts=( edge=bottom "lines=$float_lines" layer=top focus-policy=on-demand )

have() {
  command -v "$1" >/dev/null 2>&1
}

gui_session() {
  # Aqua = inside the logged-in GUI session; ssh/cron/launchd land in Background.
  [[ "$(launchctl managername 2>/dev/null)" == "Aqua" ]]
}

run_inline_fallback() {
  [[ -t 0 && -t 1 ]] || return 1

  $debug && {
    print -u2 -- "mode:            inline"
    print -u2 -- "command:         ${(q)command_argv[@]}"
  }

  exec "${command_argv[@]}"
}

activate_kitty() {
  osascript -e 'tell application id "net.kovidgoyal.kitty" to activate' >/dev/null 2>&1 || \
  osascript -e 'tell application "kitty" to activate' >/dev/null 2>&1 || \
  true
}

have kitty || {
  run_inline_fallback
  print -u2 -- "kitty not found in PATH and no tty to run inline"
  exit 127
}

if have kitten; then
  kitten_cmd=( kitten )
else
  kitten_cmd=( kitty +kitten )
fi

hide_kitty_app() {
  osascript -e 'tell application "System Events" to set visible of first application process whose bundle identifier is "net.kovidgoyal.kitty" to false' >/dev/null 2>&1 || \
  osascript -e 'tell application "System Events" to set visible of application process "kitty" to false' >/dev/null 2>&1 || \
  true
}

focus_launched_window() {
  local window_id="${1:-}"
  [[ "$window_id" == <-> ]] || return 1

  "${kitten_cmd[@]}" @ --to "$socket_addr" resize-os-window --match "id:$window_id" --action=show >/dev/null 2>&1 || true
  "${kitten_cmd[@]}" @ --to "$socket_addr" focus-window --match "id:$window_id" >/dev/null 2>&1
}

auto_hide_when_window_closes() {
  local window_id="${1:-}"
  [[ "$window_id" == <-> ]] || return 1

  (
    while "${kitten_cmd[@]}" @ --to "$socket_addr" ls --match "id:$window_id" >/dev/null 2>&1; do
      sleep 0.2
    done

    sleep 0.1
    hide_kitty_app
  ) >/dev/null 2>&1 &!
}

reachable_socket() {
  local candidate="$1"
  "${kitten_cmd[@]}" @ --to "$candidate" ls >/dev/null 2>&1
}

discover_socket() {
  local candidate

  # 1. Explicit/configured socket first.
  if reachable_socket "$configured_socket_addr"; then
    print -r -- "$configured_socket_addr"
    return 0
  fi

  # 2. Common fixed socket.
  candidate="unix:/tmp/kitty-${user_name}"
  if [[ "$candidate" != "$configured_socket_addr" ]] && reachable_socket "$candidate"; then
    print -r -- "$candidate"
    return 0
  fi

  # 3. Scan Kitty socket-looking files in /tmp.
  local socket_file
  for socket_file in /tmp/kitty-* /tmp/kitty.*(N); do
    [[ -S "$socket_file" ]] || continue

    candidate="unix:$socket_file"
    if reachable_socket "$candidate"; then
      print -r -- "$candidate"
      return 0
    fi
  done

  return 1
}

if discovered_socket="$(discover_socket)"; then
  socket_addr="$discovered_socket"

  $debug && {
    print -u2 -- "mode:            ipc"
    print -u2 -- "socket:          $socket_addr"
    print -u2 -- "launch_type:     $launch_type"
    print -u2 -- "cwd:             ${cwd:-}"
    print -u2 -- "title:           ${title:-}"
    print -u2 -- "keep_focus:      $keep_focus"
    print -u2 -- "hold:            $hold"
    print -u2 -- "hold_on_fail:    $hold_on_fail"
    print -u2 -- "auto_hide:       $auto_hide"
    print -u2 -- "activate:        $activate"
    print -u2 -- "command:         ${(q)command_argv[@]}"
  }

  launch_args=(
    @
    --to "$socket_addr"
    launch
    --type "$launch_type"
  )

  [[ -n "$cwd" ]] && launch_args+=( --cwd "$cwd" )
  [[ -n "$title" ]] && launch_args+=( --title "$title" )
  $keep_focus && launch_args+=( --keep-focus )
  $hold && launch_args+=( --hold )
  [[ "$launch_type" == os-panel ]] && launch_args+=( --os-panel=${^panel_opts} )

  launched_window_id="$("${kitten_cmd[@]}" "${launch_args[@]}" -- "${command_argv[@]}")"
  [[ -n "$launched_window_id" ]] && print -r -- "$launched_window_id"

  if $activate && ! $keep_focus; then
    focus_launched_window "$launched_window_id"
  fi

  $auto_hide && auto_hide_when_window_closes "$launched_window_id"

  exit 0
fi

# No reachable socket. Spawning a fresh Kitty only makes sense inside the
# logged-in GUI session; over ssh (or from cron/launchd) run inline instead.
gui_session || {
  run_inline_fallback
  print -u2 -- "no reachable Kitty socket, no GUI session, and no tty to run inline"
  exit 1
}

$debug && {
  print -u2 -- "mode:            fallback-new-kitty"
  print -u2 -- "socket:          $socket_addr"
  print -u2 -- "launch_type:     $launch_type"
  print -u2 -- "cwd:             ${cwd:-}"
  print -u2 -- "title:           ${title:-}"
  print -u2 -- "hold:            $hold"
  print -u2 -- "hold_on_fail:    $hold_on_fail"
  print -u2 -- "auto_hide:       $auto_hide"
  print -u2 -- "activate:        $activate"
  print -u2 -- "detach:          $detach"
  print -u2 -- "command:         ${(q)command_argv[@]}"
}

kitty_args=(
  --listen-on "$socket_addr"
  -o allow_remote_control=socket-only
)

[[ -n "$cwd" ]] && kitty_args+=( --directory "$cwd" )
[[ -n "$title" ]] && kitty_args+=( --title "$title" )
$hold && kitty_args+=( --hold )

case "$launch_type" in
  os-panel)
    # A standalone panel instead of a normal first window. The panel kitten
    # takes neither --listen-on nor --hold; tty remote control is enough for
    # kitty-hold-on-error to read the buffer.
    [[ -n "$cwd" ]] && cd -- "$cwd"
    kitty_args=( +kitten panel --${^panel_opts} -o allow_remote_control=yes )
    ;;
  os-window)
    # Starting a fresh Kitty app already creates an OS window.
    ;;
  tab|window)
    # Fallback cannot create a tab/window inside a non-existent Kitty instance;
    # this starts a fresh OS window instead.
    ;;
esac

if $detach; then
  nohup kitty "${kitty_args[@]}" -- "${command_argv[@]}" >/dev/null 2>&1 &
  disown

  $activate && activate_kitty

  exit 0
else
  $activate && activate_kitty
  exec kitty "${kitty_args[@]}" -- "${command_argv[@]}"
fi
