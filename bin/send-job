#!/usr/bin/env zsh
# send-job
# Queue files on a job-folder workflow: put them in <jobs>/<workflow>/input/,
# where job-folder (src/jobs/job-folder) runs each one through the workflow's
# job.sh.
#
#   send-job [--job job.sh] [--copy|--link] [--dir DIR] <workflow> <files...>
#
# The target is just a directory — the jobs root, normally ~/jobs or an
# already-mounted share. Nothing here knows about hostnames, shares or
# credentials: mount it however you like and point --dir / $JOBS_DIR at it.
#
# Two questions decide what "sending" means, and neither has one right answer:
#
#   the payload  — copy it across, or symlink it and let the job read the
#                  source where it already lives
#   the folder   — which jobs root, when more than one is reachable
#
# Both are asked with a picker when there is a terminal to ask on, and both can
# be answered up front by flag for scripts and keybindings. Nothing is prompted
# for that was given on the command line.
#
# --copy copies each file to a hidden temporary in the jobs root, checks its
# size, and only then renames it into input/ — one volume, so the rename is
# atomic and the queue never sees half a file. Free space is part of the
# question rather than a surprise in the middle of a copy.
#
# --link copies nothing: input/ gets a symlink to the source. What you want for
# multi-gigabyte media on a local disk with the queue on the same machine, and
# exactly what you do not want when the job is bound for another box.
#
# --job installs a script as the workflow's job.sh first, creating the folder
# if it isn't there — how a generator like topaz-job ships a workflow and its
# first input in one go. Without it, the workflow must already exist.

emulate -L zsh
set -euo pipefail

script_name="${0:t}"

payload_mode=""      # copy | link | "" (ask)
jobs_dir=""          # set by --dir, else chosen from the candidates
job_script=""        # --job: installed as the workflow's job.sh
force=false
positional=()

usage() {
  cat <<EOF
$script_name

Queue files on a job-folder workflow.

Usage:
  $script_name [options] <workflow> <files...>

Options:
  --job FILE         Install FILE as the workflow's job.sh (creating the
                     workflow if needed) before queueing anything
  --dir DIR          Jobs root. Skips the folder picker. Also --dir=DIR;
                     \$JOBS_DIR does the same.
  --copy             Copy the files into input/ (the default when there is no
                     terminal to ask on)
  --link             Symlink the files into input/; the job reads the sources
                     where they are
  --force            Queue a file even if input/ already holds one of the same
                     name and size
  -h, --help         Show help

A copy needs the files plus 256 MB of headroom on the destination. Roots are
offered with their free space, and one that cannot take the files can only be
sent to by link.

Examples:
  $script_name interpolate-60fps clip.mp4
  $script_name --link upscale a.mov b.mov
  $script_name --job ./job.sh --dir=/Volumes/jobs my-workflow clip.mov
EOF
}

die() {
  print -u2 -- "$script_name: $1"
  exit "${2:-1}"
}

# --- the picker -------------------------------------------------------------

# One of many, chosen with the keys that hand is already on: ↑/↓ or k/j, g/G,
# Enter to accept, q or Esc to cancel. Draws on /dev/tty and prints the chosen
# index on stdout, so it composes inside $(...) like anything else. Returns 1
# when cancelled, 2 when there is no terminal to ask on.
choose_one() {
  local prompt="$1"
  shift
  local -a items=( "$@" )
  local count=${#items[@]}
  (( count )) || return 2

  local out in
  { exec {out}>/dev/tty } 2>/dev/null || return 2
  if ! { exec {in}</dev/tty } 2>/dev/null; then
    exec {out}>&-
    return 2
  fi

  local saved
  saved="$(stty -g <&$in 2>/dev/null)" || { exec {out}>&-; exec {in}<&-; return 2 }
  stty -icanon -echo <&$in

  local index=1 chosen=0 drawn=0 key rest i

  restore() {
    stty "$saved" <&$in 2>/dev/null || true
    print -nr -u$out -- $'\e[?25h'
  }

  print -nr -u$out -- $'\e[?25l'
  while true; do
    (( drawn )) && print -nr -u$out -- $'\e['"$(( count + 1 ))"'A'
    drawn=1
    print -r -u$out -- $'\e[2K\e[1m'"$prompt"$'\e[0m'
    for i in {1..$count}; do
      if (( i == index )); then
        print -r -u$out -- $'\e[2K\e[7m ❯ '"${items[i]}"$' \e[0m'
      else
        print -r -u$out -- $'\e[2K   '"${items[i]}"
      fi
    done

    if ! read -k 1 -u $in key; then
      break
    fi

    case "$key" in
      $'\e')
        # An escape on its own is a cancel; followed by [A/[B it is an arrow.
        if read -t 0.05 -k 1 -u $in rest 2>/dev/null && [[ "$rest" == "[" ]]; then
          read -t 0.05 -k 1 -u $in rest 2>/dev/null || rest=""
          case "$rest" in
            A) (( index = index > 1 ? index - 1 : count )) ;;
            B) (( index = index < count ? index + 1 : 1 )) ;;
          esac
        else
          break
        fi
        ;;
      k|$'\C-p') (( index = index > 1 ? index - 1 : count )) ;;
      j|$'\C-n') (( index = index < count ? index + 1 : 1 )) ;;
      g) index=1 ;;
      G) index=$count ;;
      $'\n'|$'\r') chosen=$index; break ;;
      q|$'\C-c'|$'\C-d') break ;;
    esac
  done

  # Collapse the menu back to the one line that says what happened.
  print -nr -u$out -- $'\e['"$(( count + 1 ))"'A'
  for i in {1..$(( count + 1 ))}; do
    print -r -u$out -- $'\e[2K'
  done
  print -nr -u$out -- $'\e['"$(( count + 1 ))"'A'
  if (( chosen )); then
    print -r -u$out -- "$prompt ${items[chosen]}"
  else
    print -r -u$out -- "$prompt cancelled"
  fi

  restore
  exec {out}>&-
  exec {in}<&-

  (( chosen )) || return 1
  print -r -- "$chosen"
}

# --- arguments --------------------------------------------------------------

while (( $# )); do
  case "$1" in
    --dir)
      (( $# >= 2 )) || die "missing argument for --dir" 2
      jobs_dir="$2"
      shift 2
      ;;
    --dir=*)
      jobs_dir="${1#--dir=}"
      shift
      ;;
    --job)
      (( $# >= 2 )) || die "missing argument for --job" 2
      job_script="$2"
      shift 2
      ;;
    --job=*)
      job_script="${1#--job=}"
      shift
      ;;
    --copy)
      payload_mode=copy
      shift
      ;;
    --link)
      payload_mode=link
      shift
      ;;
    --force)
      force=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      positional+=( "$@" )
      break
      ;;
    -*)
      die "unknown option: $1" 2
      ;;
    *)
      positional+=( "$1" )
      shift
      ;;
  esac
done

(( ${#positional[@]} >= 1 )) || { usage >&2; die "no workflow given" 2 }

workflow="${positional[1]}"
payload=( "${(@)positional[2,-1]}" )

[[ -n "$workflow" && "$workflow" != */* && "$workflow" != .* ]] \
  || die "not a workflow name: $workflow (one folder name, not a path)" 2
[[ -z "$job_script" || -f "$job_script" ]] || die "job script not found: $job_script"
(( ${#payload[@]} )) || [[ -n "$job_script" ]] || die "no files given" 2
for f in "${payload[@]}"; do
  [[ -f "$f" ]] || die "file not found: $f"
done

# --- sizes ------------------------------------------------------------------

# Through symlinks, so a linked input compares by the file it points at.
size_of() {
  stat -L -f %z "$1" 2>/dev/null
}

# Free bytes on the filesystem holding a directory.
free_bytes() {
  local blocks
  blocks="$(df -Pk -- "$1" 2>/dev/null | awk 'NR == 2 { print $4 }')" || return 1
  [[ "$blocks" == <-> ]] || return 1
  print -r -- $(( blocks * 1024 ))
}

human_size() {
  local -F bytes=$1
  local -a units=( B KB MB GB TB PB )
  local unit=1
  while (( bytes >= 1024 && unit < ${#units[@]} )); do
    (( bytes = bytes / 1024 ))
    (( unit++ ))
  done
  if (( unit == 1 )); then
    printf '%d %s' $(( bytes )) "${units[unit]}"
  else
    printf '%.1f %s' $bytes "${units[unit]}"
  fi
}

payload_bytes=0
for f in "${payload[@]}"; do
  size="$(size_of "$f")" || die "could not stat $f"
  (( payload_bytes += size ))
done

# A copy that fills the disk to the last byte is a copy that fails somewhere
# more expensive than here, so ask for the payload plus a little room.
headroom=$(( 256 * 1024 * 1024 ))
needed=$(( payload_bytes + headroom ))

# True when the folder can take the whole payload. A folder whose free space
# cannot be read is given the benefit of the doubt — better an honest copy
# error than refusing to send over a df that did not answer.
fits() {
  local free
  free="$(free_bytes "$1")" || return 0
  (( free >= needed ))
}

# --- where to send it -------------------------------------------------------

icloud_home="${ICLOUD_HOME:-$HOME/Library/Mobile Documents/com~apple~CloudDocs}"

# Every folder worth offering, in the order they are worth offering. Only the
# ones that exist and are writable ever reach the picker.
typeset -a searched=(
  /Volumes/jobs
  /Volumes/job
  /Volumes/Jobs
  "$icloud_home/Jobs"
  "$HOME/jobs"
  "$HOME/job"
  "$HOME/Jobs"
)
[[ -n "${JOBS_DIR:-}" ]] && searched=( "${JOBS_DIR%/}" "${searched[@]}" )

if [[ -z "$jobs_dir" ]]; then
  typeset -a candidates=()
  typeset -A seen=()
  for dir in "${searched[@]}"; do
    dir="${dir%/}"
    [[ -d "$dir" && -w "$dir" ]] || continue
    key="${dir:A}"
    [[ -n "${seen[$key]:-}" ]] && continue
    seen[$key]=1
    candidates+=( "$dir" )
  done

  case ${#candidates[@]} in
    0)
      print -u2 -- "$script_name: no jobs folder found. Tried:"
      for dir in "${searched[@]}"; do
        print -u2 -- "  $dir"
      done
      die "nowhere to send the job (is the share mounted? try --dir)"
      ;;
    1)
      jobs_dir="${candidates[1]}"
      ;;
    *)
      # Free space belongs in the question: it is the thing that decides
      # whether copying is even on the table for a given folder.
      typeset -a labels=()
      for dir in "${candidates[@]}"; do
        free="$(free_bytes "$dir")" || free=""
        if [[ -z "$free" ]]; then
          labels+=( "$dir" )
        elif (( ${#payload[@]} )) && ! fits "$dir"; then
          labels+=( "$dir — $(human_size $free) free, too small for $(human_size $payload_bytes) (link only)" )
        else
          labels+=( "$dir — $(human_size $free) free" )
        fi
      done

      if pick="$(choose_one "jobs folder:" "${labels[@]}")"; then
        jobs_dir="${candidates[$pick]}"
      else
        status_code=$?
        (( status_code == 1 )) && die "cancelled" 130
        # No terminal to ask on: the first reachable folder.
        jobs_dir="${candidates[1]}"
      fi
      ;;
  esac
fi

jobs_dir="${jobs_dir%/}"
[[ -d "$jobs_dir" ]] || die "jobs folder not there: $jobs_dir (is the share mounted?)"
[[ -w "$jobs_dir" ]] || die "jobs folder is not writable: $jobs_dir"

# --- the workflow -----------------------------------------------------------

workflow_dir="$jobs_dir/$workflow"
input_dir="$workflow_dir/input"

if [[ -n "$job_script" ]]; then
  mkdir -p -- "$input_dir" || die "could not create $input_dir"
  # Before any input: a file queued ahead of its script would run through
  # whatever job.sh was there before.
  if cmp -s -- "$job_script" "$workflow_dir/job.sh"; then
    print -- "job   $workflow/job.sh (unchanged)"
  else
    tmp="$workflow_dir/.job.sh.sending"
    cp -- "$job_script" "$tmp" || die "could not copy the job script"
    chmod +x "$tmp" 2>/dev/null || true
    mv -f -- "$tmp" "$workflow_dir/job.sh" || die "could not install $workflow/job.sh"
    print -- "job   $workflow/job.sh installed"
  fi
elif [[ ! -f "$workflow_dir/job.sh" ]]; then
  print -u2 -- "$script_name: no workflow '$workflow' in $jobs_dir. Workflows there:"
  for script in "$jobs_dir"/*/job.sh(N); do
    print -u2 -- "  ${script:h:t}"
  done
  die "nothing queued (pass --job to create it)"
else
  mkdir -p -- "$input_dir" || die "could not create $input_dir"
fi

(( ${#payload[@]} )) || exit 0

# --- copy the payload, or link it -------------------------------------------

jobs_free="$(free_bytes "$jobs_dir")" || jobs_free=""
if ! fits "$jobs_dir"; then
  # Not a preference any more. Say what is wrong in the numbers that matter,
  # and go on by link rather than starting a copy that cannot finish.
  print -u2 -- "$script_name: $jobs_dir has ${jobs_free:+$(human_size $jobs_free) free, }not enough for $(human_size $payload_bytes) plus $(human_size $headroom) headroom"
  if [[ "$payload_mode" == copy ]]; then
    die "not enough space to copy the files (send them by --link, or free some space)"
  fi
  payload_mode=link
  print -u2 -- "$script_name: linking — the job reads the sources where they are"
fi

if [[ -z "$payload_mode" ]]; then
  typeset -a choices=(
    "copy — send $(human_size $payload_bytes) to $jobs_dir${jobs_free:+ ($(human_size $jobs_free) free)}"
    "link — leave them here; input/ gets symlinks to them"
  )
  if pick="$(choose_one "payload:" "${choices[@]}")"; then
    (( pick == 1 )) && payload_mode=copy || payload_mode=link
  else
    status_code=$?
    (( status_code == 1 )) && die "cancelled" 130
    payload_mode=copy
  fi
fi

print -- "jobs: $jobs_dir"

# A free name in input/: clip.mov, then clip-2.mov, clip-3.mov, …
free_name() {
  local name="$1" stem ext n
  if [[ ! -e "$input_dir/$name" && ! -L "$input_dir/$name" ]]; then
    print -r -- "$name"
    return
  fi
  if [[ "$name" == ?*.* ]]; then
    stem="${name%.*}" ext=".${name##*.}"
  else
    stem="$name" ext=""
  fi
  for n in {2..999}; do
    if [[ ! -e "$input_dir/$stem-$n$ext" && ! -L "$input_dir/$stem-$n$ext" ]]; then
      print -r -- "$stem-$n$ext"
      return
    fi
  done
  return 1
}

for f in "${payload[@]}"; do
  name="${f:t}"
  src_size="$(size_of "$f")" || die "could not stat $f"

  # Sent twice by accident is the likely story; queueing it twice is not.
  if [[ -e "$input_dir/$name" ]] && ! $force && [[ "$(size_of "$input_dir/$name")" == "$src_size" ]]; then
    print -- "skip  $name (already queued)"
    continue
  fi

  dest_name="$(free_name "$name")" || die "too many files named $name in $input_dir"

  if [[ "$payload_mode" == link ]]; then
    ln -s -- "${f:A}" "$input_dir/$dest_name" || die "could not link $name"
    print -- "link  $dest_name -> ${f:A}"
    continue
  fi

  # In the jobs root, hidden, so neither a workflow nor anything browsing the
  # root mistakes it for work; and on the same volume as input/, so the rename
  # that finishes it is atomic.
  tmp="$jobs_dir/.$name.sending"
  print -- "send  $name ($(human_size $src_size))"
  rm -f -- "$tmp" 2>/dev/null || true
  if ! cp -- "$f" "$tmp"; then
    rm -f -- "$tmp" 2>/dev/null || true
    die "copy failed: $name"
  fi

  dest_size="$(size_of "$tmp")" || dest_size=""
  if [[ "$dest_size" != "$src_size" ]]; then
    rm -f -- "$tmp" 2>/dev/null || true
    die "size mismatch for $name (local $src_size, remote ${dest_size:-?}) — not queued"
  fi

  mv -- "$tmp" "$input_dir/$dest_name" || die "could not queue $name"
  print -- "ok    $dest_name queued"
done

print -- "queued on $workflow in $jobs_dir"
exit 0
