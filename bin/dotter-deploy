#!/usr/bin/env zsh

set -euo pipefail

# This file lives at <repo>/bin/dotter-deploy and is symlinked onto
# PATH, so resolve through the symlink (:A) to find the checkout it belongs to.
# The repo can therefore live anywhere, not just ~/config.
CONFIG_DIR="${${0:A}:h:h}"
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
CACHE_DIR="$XDG_CONFIG_HOME/dotter/cache"
CACHE_FILE="$XDG_CONFIG_HOME/dotter/cache.toml"
GLOBAL_CONFIG="$CONFIG_DIR/dotter/global.toml"
LOCAL_CONFIG="$CONFIG_DIR/dotter/local.toml"
MACOS_ICON_SCRIPT="$CONFIG_DIR/scripts/setup/apply-file-icons.sh"
HEALTHCHECK_SCRIPT="$CONFIG_DIR/scripts/setup/check.sh"
YTDLP_INSTALL_SCRIPT="$CONFIG_DIR/scripts/install/install-yt-dlp.sh"
YAZI_PACKAGE_MANIFEST="$XDG_CONFIG_HOME/yazi/package.toml"
YAZI_PACKAGE_PLUGIN_DIR="$XDG_CONFIG_HOME/yazi/plugins"
INSTALL_DIR="$CONFIG_DIR/scripts/install"
UPGRADE=0
APPLY_ICONS=0
SCRIPT_NAME="${0:t}"

usage() {
  cat <<EOF
Usage: $SCRIPT_NAME [--upgrade] [--icons] [--full]

Runs Dotter deploy — symlinking config is all a bare run does.

  --icons    reapply the macOS app icon overrides
  --upgrade  sync Yazi packages, repair the yt-dlp install, run brew upgrade,
             and rebuild any src/ tool whose source is newer than the copy
             installed on this machine
  --full     --icons plus --upgrade

Skip individual upgrade steps with DOTTER_SKIP_YAZI_PACKAGES=1,
DOTTER_SKIP_YTDLP=1, DOTTER_SKIP_BREW=1 or DOTTER_SKIP_SRC=1.
EOF
}

while (( $# > 0 )); do
  case "$1" in
    --full)
      UPGRADE=1
      APPLY_ICONS=1
      ;;
    --upgrade)
      UPGRADE=1
      ;;
    --icons)
      APPLY_ICONS=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Error: unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

if [[ ! -d "$CONFIG_DIR" ]]; then
  echo "Error: dotfiles directory not found: $CONFIG_DIR"
  exit 1
fi

if [[ ! -f "$GLOBAL_CONFIG" ]]; then
  echo "Error: Dotter global config not found: $GLOBAL_CONFIG"
  exit 1
fi

if [[ ! -f "$LOCAL_CONFIG" ]]; then
  echo "Error: Dotter local config not found: $LOCAL_CONFIG"
  echo "Create it from one of the examples in $CONFIG_DIR/dotter/."
  exit 1
fi

mkdir -p "$CACHE_DIR"

if [[ -x "$HEALTHCHECK_SCRIPT" ]] && [[ "${DOTTER_SKIP_HEALTHCHECK:-0}" != "1" ]]; then
  "$HEALTHCHECK_SCRIPT"
fi

prepare_yazi_package_manifest() {
  local source_manifest="$CONFIG_DIR/config/yazi/package.toml"

  if [[ ! -f "$source_manifest" ]] || [[ ! -f "$YAZI_PACKAGE_MANIFEST" ]] || [[ -L "$YAZI_PACKAGE_MANIFEST" ]]; then
    return
  fi

  if cmp -s "$source_manifest" "$YAZI_PACKAGE_MANIFEST"; then
    rm -f "$YAZI_PACKAGE_MANIFEST"
  fi
}

prepare_yazi_package_dirs() {
  local dir

  mkdir -p "$YAZI_PACKAGE_PLUGIN_DIR"

  while IFS= read -r dir; do
    [[ -n "$dir" ]] || continue

    dir="$YAZI_PACKAGE_PLUGIN_DIR/$dir"
    if [[ -L "$dir" ]]; then
      rm -f "$dir"
    elif [[ -d "$dir" ]]; then
      find "$dir" -type l -delete
    fi
  done < <(
    awk -F '"' '
      /^[[:space:]]*use[[:space:]]*=/ {
        name = $2
        sub(/^.*:/, "", name)
        sub(/^.*\//, "", name)
        if (name !~ /\.yazi$/) name = name ".yazi"
        print name
      }
    ' "$YAZI_PACKAGE_MANIFEST"
  )
}

prepare_yazi_local_plugin_dirs() {
  local source_plugins="$CONFIG_DIR/config/yazi/plugins"
  local source_dir
  local source_file
  local target_dir
  local target_file

  [[ -d "$source_plugins" ]] || return

  mkdir -p "$YAZI_PACKAGE_PLUGIN_DIR"

  for source_dir in "$source_plugins"/*.yazi(N/); do
    target_dir="$YAZI_PACKAGE_PLUGIN_DIR/${source_dir:t}"

    if [[ -L "$target_dir" && "${target_dir:A}" == "${source_dir:A}" ]]; then
      rm -f "$target_dir"
      mkdir -p "$target_dir"
    elif [[ -d "$target_dir" && ! -L "$target_dir" ]]; then
      for source_file in "$source_dir"/*(N); do
        [[ -f "$source_file" || -L "$source_file" ]] || continue

        target_file="$target_dir/${source_file:t}"
        [[ -e "$target_file" || -L "$target_file" ]] || continue

        if [[ ! -L "$target_file" ]] || [[ "${target_file:A}" != "${source_file:A}" ]]; then
          rm -f "$target_file"
        fi
      done
    fi
  done
}

install_yazi_packages() {
  local install_help
  local -a install_args=()

  if [[ "${DOTTER_SKIP_YAZI_PACKAGES:-0}" == "1" ]]; then
    return
  fi

  if [[ ! -f "$YAZI_PACKAGE_MANIFEST" ]]; then
    return
  fi

  if ! command -v ya >/dev/null 2>&1; then
    echo "Skipping Yazi packages: ya is not installed."
    return
  fi

  prepare_yazi_package_dirs

  echo "Installing Yazi packages from $YAZI_PACKAGE_MANIFEST..."
  install_help="$(ya pkg install --help 2>&1 || true)"
  if [[ "$install_help" == *"--discard"* ]]; then
    install_args=(--discard)
  fi
  ya pkg install "${install_args[@]}"
}

install_yt_dlp() {
  if [[ "${DOTTER_SKIP_YTDLP:-0}" == "1" ]]; then
    return
  fi

  if [[ ! -x "$YTDLP_INSTALL_SCRIPT" ]]; then
    return
  fi

  if ! command -v uv >/dev/null 2>&1; then
    echo "Skipping yt-dlp: uv is not installed."
    return
  fi

  # Non-fatal: a network blip or an unreachable index must not abort a deploy
  # whose real job is symlinking config.
  if ! "$YTDLP_INSTALL_SCRIPT"; then
    echo "Warning: yt-dlp install failed; run $YTDLP_INSTALL_SCRIPT manually." >&2
  fi
}

upgrade_homebrew() {
  if [[ "${DOTTER_SKIP_BREW:-0}" == "1" ]]; then
    return
  fi

  if ! command -v brew >/dev/null 2>&1; then
    echo "Skipping brew upgrade: brew is not installed."
    return
  fi

  # Non-fatal, like every other upgrade step: one unreachable tap must not
  # take down the rest of the run.
  echo "Upgrading Homebrew packages..."
  if ! brew update; then
    echo "Warning: brew update failed; continuing." >&2
  fi
  if ! brew upgrade; then
    echo "Warning: brew upgrade failed; run it manually." >&2
  fi
}

# src/ tools are built, not symlinked, so a `git pull` leaves the installed
# copy stale until someone remembers to re-run its installer. Rebuild the ones
# that are already installed and whose source has moved on.
#
# Deliberately never installs a tool that is absent: not every machine wants
# every widget, and a deploy is the wrong place to acquire new software.
# Staleness is decided by mtime, not by a version string — these crates rarely
# bump Cargo.toml, and `git pull` touches exactly the files that changed.
upgrade_src_tools() {
  local spec name installer artifact script
  local -a specs

  if [[ "${DOTTER_SKIP_SRC:-0}" == "1" ]]; then
    return
  fi

  # <src subdir>|<installer>|<installed artifact>
  specs=(
    "battery-widget|install-battery-widget.sh|$HOME/.local/bin/battery-widget"
    "cpu-usage-widget|install-cpu-usage-widget.sh|$HOME/.local/bin/cpu-usage-widget"
    "dupchk|install-dupchk.sh|$HOME/.local/bin/dupchk"
    "free-disk-space-widget|install-free-disk-space-widget.sh|$HOME/.local/bin/free-disk-space-widget"
    "menu-tidy|install-menu-tidy.sh|$HOME/.local/bin/menu-tidy"
    "motherfucker|install-motherfucker.sh|$HOME/.local/bin/motherfucker"
    "neuroserver-select-preset|install-neuroserver-select-preset.sh|$HOME/.local/bin/neuroserver-select-preset"
    "obsbot-rtsp-widget|obsbot-rtsp-widget.sh|$HOME/.local/bin/obsbot-rtsp-widget"
    "pimped|install-pimped.sh|$HOME/.local/bin/pimped"
    "rclone-tower-ui|install-rclone-tower-ui.sh|$HOME/.local/bin/rclone-tower-ui"
    "safesync|install-safesync.sh|$HOME/.local/bin/safesync"
    "spill|install-spill.sh|$HOME/.local/bin/spill"
    "system-uptime-widget|install-system-uptime-widget.sh|$HOME/.local/bin/system-uptime-widget"
    "topaz-select-preset|install-topaz-select-preset.sh|$HOME/.local/bin/topaz-select-preset"
    "volume-control-widget|install-volume-control-widget.sh|$HOME/.local/bin/volume-control-widget"
    "ytform|ytform.sh|$HOME/.local/bin/ytform"
    # One cargo workspace, three separately installed artifacts. Each is
    # checked against the whole tree, since they share job-core.
    "jobs|install-job-daemon.sh|$HOME/.local/bin/job-daemon"
    "jobs|install-job-monitor.sh|$HOME/Applications/Job Monitor.app"
    "jobs|install-job-folder.sh|$HOME/Applications/Job Folder.app"
  )

  for spec in "${specs[@]}"; do
    name="${spec%%|*}"
    installer="${${spec#*|}%%|*}"
    artifact="${spec##*|}"
    script="$INSTALL_DIR/$installer"

    [[ -e "$artifact" ]] || continue          # not installed here — leave it alone
    [[ -x "$script" ]] || continue
    [[ -d "$CONFIG_DIR/src/$name" ]] || continue

    # ~/.local/bin also holds Dotter's symlinks to bin/. Those are config, not
    # builds, and must never be handed to an installer.
    if [[ -L "$artifact" && "${artifact:A}" == "$CONFIG_DIR"/* ]]; then
      continue
    fi

    # Editing the installer counts as staleness too.
    if [[ "$script" -nt "$artifact" ]]; then
      echo "Rebuilding $name ($installer is newer than $artifact)..."
      "$script" || echo "Warning: $installer failed; run it manually." >&2
      continue
    fi

    # Only real build inputs decide staleness. A README or a design mockup is
    # not one, and treating it as one means every doc edit triggers a rebuild
    # of everything. Pruned dirs: build output, and the nested checkouts that
    # agent worktrees leave under .claude/.
    # -quit stops at the first hit instead of walking the whole tree.
    if [[ -z "$(find "$CONFIG_DIR/src/$name" \
                     \( -name target -o -name .git -o -name .claude \
                        -o -name designs -o -name design \) -prune -o \
                     -type f \( -name '*.rs' -o -name '*.go' -o -name '*.c' \
                        -o -name '*.h' -o -name '*.m' -o -name '*.swift' \
                        -o -name 'Cargo.toml' -o -name 'Cargo.lock' \
                        -o -name 'go.mod' -o -name 'go.sum' \) \
                     -newer "$artifact" -print -quit 2>/dev/null)" ]]; then
      continue
    fi

    echo "Rebuilding $name (source is newer than $artifact)..."
    if ! "$script"; then
      echo "Warning: $installer failed; run it manually." >&2
    fi
  done
}

if (( UPGRADE )); then
  prepare_yazi_package_manifest
  prepare_yazi_local_plugin_dirs
fi

(
  cd "$CONFIG_DIR"
  dotter \
    --cache-directory "$CACHE_DIR" \
    --cache-file "$CACHE_FILE" \
    deploy \
    --global-config "$GLOBAL_CONFIG" \
    --local-config "$LOCAL_CONFIG"
)

if (( UPGRADE )); then
  upgrade_homebrew
  install_yazi_packages
  install_yt_dlp
  upgrade_src_tools
fi

if (( APPLY_ICONS )) && [[ "$OSTYPE" == darwin* ]] && [[ -x "$MACOS_ICON_SCRIPT" ]]; then
  "$MACOS_ICON_SCRIPT"
fi

echo
echo "Dotter deploy completed successfully."
