#!/usr/bin/env zsh
set -euo pipefail
#
#   fzf-select — pick paths from stdin with fzf and print the selection back.
#
#   The on-screen display ("name  dir") is mapped back to the real path via an
#   index table, so selecting a prettified line still yields the exact path.
#
#   Performance: the per-record loop does no forks (display formatted with zsh
#   builtins, index table written via a dedicated fd), and UTF-8 sanitisation
#   runs once over the whole stream rather than once per file.

show_absolute=false
print_color=false
read0=false
print0=false
stream=false
passthrough_args=()
records_loaded=0

for arg in "$@"; do
  case "$arg" in
    --absolute-paths) show_absolute=true ;;
    --color)          print_color=true ;;
    -0|--read0)       read0=true ;;
    --print0)         print0=true ;;
    --stream)         stream=true ;;
    *)                passthrough_args+=("$arg") ;;
  esac
done

if [[ -t 0 ]]; then
  print -u2 "Error: expected piped input"
  exit 1
fi

for bin in fzf mktemp awk; do
  command -v "$bin" >/dev/null 2>&1 || {
    print -u2 "Error: missing dependency: $bin"
    exit 1
  }
done

tmp_map=$(mktemp -t fzf-select.map.XXXXXX)
tmp_lines=$(mktemp -t fzf-select.lines.XXXXXX)
tmp_lines_raw=$(mktemp -t fzf-select.lines-raw.XXXXXX)
tmp_selected=$(mktemp -t fzf-select.selected.XXXXXX)
tmp_selected_lines=$(mktemp -t fzf-select.selected-lines.XXXXXX)
tmp_fzf_status=$(mktemp -t fzf-select.status.XXXXXX)

cleanup() {
  rm -f -- "$tmp_map" "$tmp_lines" "$tmp_lines_raw" "$tmp_selected" \
           "$tmp_selected_lines" "$tmp_fzf_status"
  (stty sane < /dev/tty >/dev/null 2>&1) 2>/dev/null || true
}
trap cleanup EXIT INT TERM

esc=$'\033'
grey="${esc}[90m"
reset="${esc}[0m"

status_message() {
  [[ -t 2 ]] || return 0
  print -u2 -- "fzf-select: $*"
}

sanitize_utf8() {
  if command -v iconv >/dev/null 2>&1; then
    iconv -f UTF-8 -t UTF-8 -c 2>/dev/null
  else
    cat
  fi
}

# Emit one record to stdout and record its raw path on $map_fd. Fork-free:
# everything here is a zsh builtin. Records are NUL-delimited when --read0 is
# set, newline-delimited otherwise.
emit_one() {
  local raw="$1" idx="$2" disp base dir

  if $show_absolute; then
    disp=$raw
  else
    base=${raw:t}
    dir=${raw:h}
    if $print_color; then
      disp="${base} ${grey}${dir}${reset}"
    else
      disp="$base $dir"
    fi
  fi

  print -r -u $map_fd -- "$raw"

  if $read0; then
    printf '%s\t%s\0' "$idx" "$disp"
  else
    printf '%s\t%s\n' "$idx" "$disp"
  fi
}

# Read stdin and emit records to stdout. The index advances only for records
# actually emitted, keeping it aligned with $map_fd line N.
build_records() {
  local raw idx=1

  if $read0; then
    while IFS= read -r -d $'\0' raw || [[ -n "$raw" ]]; do
      [[ -z "$raw" ]] && { raw=""; continue; }
      emit_one "$raw" "$idx"
      (( ++idx )); raw=""
    done
  else
    while IFS= read -r raw || [[ -n "$raw" ]]; do
      [[ -z "$raw" ]] && { raw=""; continue; }
      emit_one "$raw" "$idx"
      (( ++idx )); raw=""
    done
  fi

  records_loaded=$(( idx - 1 ))
  return 0
}

map_selection() {
  if $print0; then
    tr '\0' '\n' < "$tmp_selected" > "$tmp_selected_lines"
    LC_ALL=C awk '
      NR == FNR { paths[NR] = $0; next }
      $1 in paths { printf "%s%c", paths[$1], 0 }
    ' "$tmp_map" "$tmp_selected_lines"
  else
    LC_ALL=C awk '
      NR == FNR { paths[NR] = $0; next }
      $1 in paths { print paths[$1] }
    ' "$tmp_map" "$tmp_selected"
  fi
}

reveal_bind="execute-silent(zsh -c 'path=\$(sed -n \"\${1}p\" \"\$2\"); [[ -n \"\$path\" ]] && open --reveal \"\$path\"' _ {1} ${(q)tmp_map})"

fzf_args=(
  --multi
  --preview-window=next
  --exact
  --cycle
  --delimiter=$'\t'
  --with-nth=2
  --accept-nth=1
  --bind 'enter:select-all+accept'
  --bind "alt-r:$reveal_bind"
  --bind "ctrl-r:$reveal_bind"
)

$print_color && fzf_args+=(--ansi)
$read0 && fzf_args+=(--read0)
$print0 && fzf_args+=(--print0)
fzf_args+=("${passthrough_args[@]}")

exec {map_fd}>"$tmp_map"

set +e
if $stream; then
  build_records | sanitize_utf8 | {
    fzf "${fzf_args[@]}" > "$tmp_selected"
    print -r -- "$?" > "$tmp_fzf_status"
  }
  fzf_status="$(< "$tmp_fzf_status")"
  [[ -n "$fzf_status" ]] || fzf_status=1
else
  status_message "reading stdin before launching fzf (safe mode; use --stream for experimental live input)"
  build_records > "$tmp_lines_raw"
  sanitize_utf8 < "$tmp_lines_raw" > "$tmp_lines"
  status_message "loaded $records_loaded item(s); launching fzf"
  fzf "${fzf_args[@]}" < "$tmp_lines" > "$tmp_selected"
  fzf_status=$?
fi
set -e

exec {map_fd}>&-

case "$fzf_status" in
  0) ;;
  1) exit 0 ;;
  130) exit 130 ;;
  *) exit "$fzf_status" ;;
esac

if [[ -s "$tmp_selected" ]]; then
  map_selection
fi
