#!/usr/bin/env zsh
set -euo pipefail

script_name="${0:t}"

usage() {
  cat <<EOF
usage:
  $script_name --input file --preset-name name --preset-flag flag --filter filter [--time seconds] [--times seconds[,seconds...]] [--no-open] [--prompt-open] [--print-paths] [--log-file path]
  $script_name ... --filter filter --keep-window [--window frames] [--keep-interpolation] ...
  $script_name --input file --preset-name name --preset-flag flag --ns-model name [--ns-store dir] [--ns-params json] [--ns-size WxH] [--keep-window] ...

Render Topaz still-frame preview JPEGs for one or more timestamps.

For each timestamp, writes:
  original JPEG
  Topaz JPEG
  side-by-side A/B JPEG

The original and Topaz JPEGs open automatically in mpv as a playlist, so you can
flip between matching frames. With --prompt-open, the render finishes first and
asks before opening. With --print-paths, machine-readable preview paths are
printed for mpv scripts.

Models the ffmpeg filter cannot reach (Starlight Precise) render through the
app's neuroserver instead: --ns-model names the model, --ns-store the directory
under the app's models/models/ that must hold its weights (checked before any
work starts — neuroserver never downloads), --ns-params a JSON object of extra
filter keys ({"softness": 1}), --ns-size the exact output size. Neuroserver
renders a short window of frames to produce one still; --keep-window also
writes every frame of that window (Topaz and matching original) as JPEGs and,
with --print-paths, lists them as
  TOPAZ_PREVIEW_WINDOW_START=<first source frame index>
  TOPAZ_PREVIEW_WINDOW_TARGET=<offset of the requested frame in the window>
  TOPAZ_PREVIEW_WINDOW_TOPAZ=<offset>\t<path>      (one per frame)
  TOPAZ_PREVIEW_WINDOW_ORIGINAL=<offset>\t<path>   (one per frame)
  TOPAZ_PREVIEW_WINDOW_RATIO=<Topaz frames per source frame>

--keep-window works on the ffmpeg backend too: it renders --window frames
(default 8) starting two before the requested one, through the filter, with the
matching source frames. The decode always feeds the engine at least four source
frames whatever the window — fed fewer, the Topaz models return nothing and
ffmpeg crashes — and the output is capped at the window. The still drops any tvai_fi stage; --keep-interpolation
keeps it in the window render, so the run shows the frames interpolation
invents. The Topaz side then holds RATIO frames per source frame (fps × slowmo
÷ source fps), and TARGET stays an offset into the source window.

With --log-file, ffmpeg runs verbose (-loglevel info -stats) and its output is
written to that path — model loading and downloading, device selection, and live
frame stats. Without it a render is silent, so a slow model and a hang look the
same. Each step is preceded by a "### <stage>" marker.

Set TOPAZ_PREVIEW_FRAME_TIMES to a comma-separated list, for example:
  TOPAZ_PREVIEW_FRAME_TIMES=5,30,90 topaz-simple-presets file.mp4
EOF
}

die() {
  print -u2 -- "$*"
  exit 1
}

have() {
  command -v "$1" >/dev/null 2>&1
}

is_number() {
  [[ "${1:-}" == <-> || "${1:-}" == <->.<-> ]]
}

slugify() {
  local value="${1:l}"
  value="${value// /-}"
  value="${value//[^a-z0-9._-]/}"
  value="${value//---/-}"
  value="${value//--/-}"
  value="${value#-}"
  value="${value%-}"
  [[ -n "$value" ]] || value="preview"
  print -r -- "$value"
}

format_time_label() {
  local value="$1"
  value="${value//:/-}"
  value="${value//./p}"
  print -r -- "$value"
}

media_rotation() {
  local file="$1"
  local probe="$2"
  local rotation=""

  if [[ -x "$probe" ]]; then
    rotation="$("$probe" -v error -select_streams v:0 -show_entries stream_side_data=rotation -of default=noprint_wrappers=1:nokey=1 -- "$file" 2>/dev/null | head -1 || true)"
    if [[ -z "$rotation" ]]; then
      rotation="$("$probe" -v error -select_streams v:0 -show_entries stream_tags=rotate -of default=noprint_wrappers=1:nokey=1 -- "$file" 2>/dev/null | head -1 || true)"
    fi
    if [[ -z "$rotation" ]]; then
      rotation="$("$probe" -v error -show_entries format_tags=rotate -of default=noprint_wrappers=1:nokey=1 -- "$file" 2>/dev/null | head -1 || true)"
    fi
  fi

  [[ -n "$rotation" ]] || rotation="0"
  print -r -- "$rotation"
}

media_display_orientation() {
  local file="$1"
  local probe="$2"
  local width="" height="" rotation="" abs_rotation=""
  local line key value display_width display_height

  if [[ -x "$probe" ]]; then
    while IFS= read -r line; do
      key="${line%%=*}"
      value="${line#*=}"
      case "$key" in
        width) width="$value" ;;
        height) height="$value" ;;
      esac
    done < <(
      "$probe" -v error -select_streams v:0 -show_entries stream=width,height -of default=noprint_wrappers=1 -- "$file" 2>/dev/null
    )
  fi

  [[ "$width" == <-> && "$height" == <-> ]] || {
    print -r -- "unknown"
    return
  }

  rotation="$(media_rotation "$file" "$probe")"
  abs_rotation="${rotation#-}"
  display_width="$width"
  display_height="$height"
  if [[ "$abs_rotation" == "90" || "$abs_rotation" == "270" ]]; then
    display_width="$height"
    display_height="$width"
  fi

  if (( display_height > display_width )); then
    print -r -- "portrait"
  elif (( display_width > display_height )); then
    print -r -- "landscape"
  else
    print -r -- "square"
  fi
}

adapt_filter_for_orientation() {
  local filter="$1"
  local orientation="$2"

  if [[ "$orientation" == "portrait" ]]; then
    filter="${filter//w=3840:h=2160/w=2160:h=3840}"
    filter="${filter//h=2160:w=3840/h=3840:w=2160}"
    filter="${filter//scale=w=3840:h=2160/scale=w=2160:h=3840}"
    filter="${filter//scale=h=2160:w=3840/scale=h=3840:w=2160}"
  fi

  print -r -- "$filter"
}

still_preview_filter() {
  local filter="$1"
  local orientation="$2"
  local part
  local -a parts kept

  filter="$(adapt_filter_for_orientation "$filter" "$orientation")"
  parts=("${(@s:,:)filter}")
  kept=()
  for part in "${parts[@]}"; do
    [[ "$part" == tvai_fi=* ]] && continue
    [[ -n "$part" ]] && kept+=("$part")
  done

  if (( ${#kept[@]} == 0 )); then
    print -r -- "format=yuvj420p"
  else
    print -r -- "${(j:,:)kept},format=yuvj420p"
  fi
}

media_duration() {
  local file="$1"
  local probe="$2"
  local duration=""

  if [[ -x "$probe" ]]; then
    duration="$("$probe" -v error -show_entries format=duration -of default=nokey=1:noprint_wrappers=1 -- "$file" 2>/dev/null || true)"
  elif have ffprobe; then
    duration="$(ffprobe -v error -show_entries format=duration -of default=nokey=1:noprint_wrappers=1 -- "$file" 2>/dev/null || true)"
  fi

  print -r -- "$duration"
}

clamp_time_to_duration() {
  local value="$1"
  local duration="$2"

  awk -v t="$value" -v d="$duration" 'BEGIN {
    if (!(d > 0)) {
      print t
      exit
    }

    if (t < 0) {
      print 0
      exit
    }

    if (t >= d) {
      t = d / 2
      if (t < 0.1) {
        t = 0
      }
    }

    printf "%.3f\n", t
  }'
}

open_images() {
  local -a images=("$@")
  (( ${#images[@]} > 0 )) || return 0

  if have mpv; then
    mpv \
    --fs \
    --force-window=immediate \
    --keep-open=yes \
    --image-display-duration=inf \
    --osd-level=1 \
    -- "${images[@]}" >/dev/null 2>&1 &!
    return 0
  fi

  qlmanage -p -- "${images[@]}" >/dev/null 2>&1 &!
}

input=""
preset_name=""
preset_flag=""
filter_complex=""
open_after=true
prompt_open=false
print_paths=false
log_file=""
ns_model=""
ns_store=""
ns_params=""
ns_size=""
keep_window=false
window_frames=8
keep_interpolation=false
times=()

if [[ -n "${TOPAZ_PREVIEW_FRAME_TIMES:-}" ]]; then
  times=("${(@s:,:)TOPAZ_PREVIEW_FRAME_TIMES}")
fi

while (( $# > 0 )); do
  case "$1" in
    -h|--help|help)
      usage
      exit 0
      ;;
    --input)
      (( $# >= 2 )) || die "--input needs a file"
      input="$2"
      shift 2
      ;;
    --preset-name)
      (( $# >= 2 )) || die "--preset-name needs a value"
      preset_name="$2"
      shift 2
      ;;
    --preset-flag)
      (( $# >= 2 )) || die "--preset-flag needs a value"
      preset_flag="$2"
      shift 2
      ;;
    --filter)
      (( $# >= 2 )) || die "--filter needs a value"
      filter_complex="$2"
      shift 2
      ;;
    --time)
      (( $# >= 2 )) || die "--time needs seconds"
      times+=("$2")
      shift 2
      ;;
    --times)
      (( $# >= 2 )) || die "--times needs seconds"
      times+=("${(@s:,:)2}")
      shift 2
      ;;
    --no-open)
      open_after=false
      shift
      ;;
    --prompt-open)
      prompt_open=true
      shift
      ;;
    --print-paths)
      print_paths=true
      shift
      ;;
    --log-file)
      (( $# >= 2 )) || die "--log-file needs a path"
      log_file="$2"
      shift 2
      ;;
    --ns-model)
      (( $# >= 2 )) || die "--ns-model needs a model name"
      ns_model="$2"
      shift 2
      ;;
    --ns-store)
      (( $# >= 2 )) || die "--ns-store needs a directory name"
      ns_store="$2"
      shift 2
      ;;
    --ns-params)
      (( $# >= 2 )) || die "--ns-params needs a JSON object"
      ns_params="$2"
      shift 2
      ;;
    --ns-size)
      (( $# >= 2 )) || die "--ns-size needs WxH"
      ns_size="$2"
      shift 2
      ;;
    --keep-window)
      keep_window=true
      shift
      ;;
    --window)
      (( $# >= 2 )) || die "--window needs a frame count"
      [[ "$2" == <1-> ]] || die "--window must be a positive frame count: $2"
      window_frames="$2"
      shift 2
      ;;
    --keep-interpolation)
      keep_interpolation=true
      shift
      ;;
    --)
      shift
      break
      ;;
    *)
      die "unknown option: $1"
      ;;
  esac
done

[[ -n "$input" ]] || die "--input is required"
[[ -f "$input" ]] || die "not a file: $input"
# Absolute: the render stages run from the Topaz app's MacOS dir, so a relative
# input would resolve there and fail to open.
input="${input:A}"
[[ -n "$preset_name" ]] || die "--preset-name is required"
[[ -n "$preset_flag" ]] || die "--preset-flag is required"
if [[ -z "$ns_model" ]]; then
  [[ -n "$filter_complex" ]] || die "--filter is required (or --ns-model for the neuroserver backend)"
fi

(( ${#times[@]} > 0 )) || times=("10")
for time_value in "${times[@]}"; do
  is_number "$time_value" || die "time must be numeric seconds: $time_value"
done

TOPAZ_APP_LIB="${0:A:h}/lib/topaz-app.zsh"
[[ -r "$TOPAZ_APP_LIB" ]] || die "Topaz app resolver not found: $TOPAZ_APP_LIB"
source "$TOPAZ_APP_LIB"

TOPAZ_APP="$(topaz_resolve_app)"
TOPAZ_MACOS_DIR="$(topaz_resolve_macos_dir "$TOPAZ_APP")"
TOPAZ_FFMPEG="$(topaz_resolve_ffmpeg "$TOPAZ_APP")"
TOPAZ_FFPROBE="$TOPAZ_MACOS_DIR/ffprobe"
TOPAZ_MODELS_DIR="$(topaz_resolve_models_dir "$TOPAZ_APP")"
[[ -x "$TOPAZ_FFMPEG" ]] || die "Topaz ffmpeg not executable: $TOPAZ_FFMPEG"

# Preflight: a model whose weights are not on disk does not fail — it hangs. The
# filter graph initialises, prints "Press [q] to stop", and then nothing happens:
# no error, no download, no progress, forever. Every descriptor ships with the
# app, so only a weights-and-dependencies check can tell an unrunnable model from
# a merely slow one. Catch it here, in milliseconds, rather than after minutes.
filter_model_codes() {
  local rest="$1"
  local model
  local -a codes

  while [[ "$rest" == *model=* ]]; do
    rest="${rest#*model=}"
    model="${rest%%[^A-Za-z0-9-]*}"
    [[ -n "$model" ]] && codes+=("$model")
  done

  # One code per line: the caller splits on newlines, and a space-joined list
  # would reach the checker as a single unknown name ("prob-4 chf-3").
  (( ${#codes[@]} )) && print -rl -- "${(u)codes[@]}"
  return 0
}

model_status_py="${0:A:h}/lib/topaz-model-status.py"
model_codes=("${(@f)$(filter_model_codes "$filter_complex")}")
if [[ -z "$ns_model" && -r "$model_status_py" && -n "${model_codes[1]:-}" ]]; then
  if ! model_report="$(python3 "$model_status_py" "$TOPAZ_MODELS_DIR" --check "${model_codes[@]}")"; then
    die "Topaz model cannot render here — it would hang, not fail:
$model_report

A model whose weights are missing downloads when you run it once in the Topaz
app. A model with no coreml backend never will: it is served by neuroserver
inside the app and is unreachable from ffmpeg, whatever you download.
Models dir: $TOPAZ_MODELS_DIR"
  fi
fi

safe_preset="$(slugify "$preset_name")"
safe_input="$(slugify "${input:t:r}")"
stamp="$(date +%Y%m%d-%H%M%S)"
out_dir="${HOME}/Library/Caches/topaz-preview-frames/${safe_input}/${safe_preset}/${stamp}"
mkdir -p "$out_dir"

ffmpeg_preset_flag="-${preset_flag#--}"
display_orientation="$(media_display_orientation "$input" "$TOPAZ_FFPROBE")"
preview_filter_complex="$(still_preview_filter "$filter_complex" "$display_orientation")"
duration="$(media_duration "$input" "$TOPAZ_FFPROBE")"
topaz_env=(
  env
  LC_NUMERIC=C
  LANG="${LANG:-en_US.UTF-8}"
  LC_CTYPE="${LC_CTYPE:-${LANG:-en_US.UTF-8}}"
  TVAI_MODEL_DIR="$TOPAZ_MODELS_DIR"
  TVAI_MODEL_DATA_DIR="$TOPAZ_MODELS_DIR"
)

# ffmpeg verbosity. By default the renders stay quiet. With --log-file the Topaz
# filter's own output is captured instead — model loading, model *downloading*,
# device selection and per-frame stats — so a caller (the mpv menu) can show live
# status rather than a silent wait that looks identical to a hang.
ffmpeg_verbosity=(-loglevel error)
if [[ -n "$log_file" ]]; then
  ffmpeg_verbosity=(-loglevel info -stats -stats_period 0.5)
  mkdir -p "${log_file:h}"
  # Absolute: each render stage runs from the Topaz app's MacOS dir, so a
  # relative path would resolve there (and fail, unwritably).
  log_file="${log_file:A}"
  : >| "$log_file"
fi

# Killing this wrapper does NOT kill the ffmpeg it spawned — the child is simply
# reparented to init and carries on burning GPU with nothing left to report it.
# A Topaz render is expensive enough that an orphan is a real problem, so:
#
#   * ffmpeg runs in the background and its PID is written beside the log, for a
#     caller that had to resort to SIGKILL (mpv aborts subprocesses that way, and
#     SIGKILL cannot be trapped) to clean up afterwards;
#   * a trap covers every catchable case — Ctrl-C in a terminal, SIGTERM — by
#     passing the signal on to ffmpeg rather than dying and abandoning it.
#
# ffmpeg exits cleanly on SIGINT/SIGTERM, so there is no need to SIGKILL it here.
ffmpeg_pid=""
pid_file=""
[[ -n "$log_file" ]] && pid_file="${log_file}.pid"

forward_signal() {
  local sig="$1"
  local code="$2"
  [[ -n "$ffmpeg_pid" ]] && kill -"$sig" "$ffmpeg_pid" 2>/dev/null
  [[ -n "$pid_file" ]] && rm -f "$pid_file"
  exit "$code"
}
trap 'forward_signal INT 130' INT
trap 'forward_signal TERM 143' TERM

# Run one child process for a stage, in the background so its PID is known (see
# the signal handling above), appending its output to the log when one is
# requested. `stage` is written as a `### ` marker so a reader can name the step.
run_child() {
  local stage="$1"
  shift
  local rc=0   # not `status`: zsh reserves that as a read-only alias for $?

  if [[ -n "$log_file" ]]; then
    print -r -- "### $stage" >> "$log_file"
    "$@" >> "$log_file" 2>&1 &
  else
    "$@" >/dev/null 2>&1 &
  fi

  ffmpeg_pid=$!
  [[ -n "$pid_file" ]] && print -r -- "$ffmpeg_pid" >| "$pid_file"
  wait "$ffmpeg_pid" || rc=$?
  ffmpeg_pid=""
  [[ -n "$pid_file" ]] && rm -f "$pid_file"
  return $rc
}

# Run the Topaz ffmpeg for one stage. stdout is discarded; only stderr carries
# ffmpeg's progress, so it is the stream that reaches the log.
run_ffmpeg() {
  local stage="$1"
  shift
  local rc=0

  if [[ -n "$log_file" ]]; then
    print -r -- "### $stage" >> "$log_file"
    "${topaz_env[@]}" "$TOPAZ_FFMPEG" -hide_banner "${ffmpeg_verbosity[@]}" "$@" 2>> "$log_file" &
  else
    "${topaz_env[@]}" "$TOPAZ_FFMPEG" -hide_banner "${ffmpeg_verbosity[@]}" "$@" &
  fi

  ffmpeg_pid=$!
  [[ -n "$pid_file" ]] && print -r -- "$ffmpeg_pid" >| "$pid_file"
  wait "$ffmpeg_pid" || rc=$?
  ffmpeg_pid=""
  [[ -n "$pid_file" ]] && rm -f "$pid_file"
  return $rc
}

# ===== neuroserver backend =====
# Models with no coreml backend (Starlight Precise, Astra, Hyperion 2) are served
# by the app's neuroserver process and are unreachable from the tvai_up filter.
# (Starlight Mini is not one of them: it is a three-part coreml model that tvai_up
# loads itself, and the app drives it through ffmpeg.) They are
# rendered here instead, which differs from the ffmpeg path in three ways worth
# knowing: the model is named rather than expressed as a filter chain, the weight
# store must be pointed at explicitly (neuroserver defaults to ./data, relative to
# a temp working directory it creates, and never downloads anything itself), and
# it refuses windows shorter than five frames — so a single-frame preview renders
# a short run and pulls one frame back out.

NS_DIR="$TOPAZ_MACOS_DIR/neuroserver"
NS_BIN="$NS_DIR/neuroserver"
NS_STORE="$TOPAZ_MODELS_DIR/models"
NS_WINDOW=8   # frames to render; must stay >= 5

# Preflight, the neuroserver counterpart of the weights check above. The model
# name and its weights directory are not derivable from one another (slp-25
# lives in slp25m, slp-26 in slp26), so the preset names both. A missing store
# fails inside neuroserver only after the Python runtime and the model registry
# have loaded — a slow, unhelpful failure — so refuse it here instead.
if [[ -n "$ns_model" && -n "$ns_store" ]]; then
  if [[ ! -d "$NS_STORE/$ns_store" ]] || ! ls -A "$NS_STORE/$ns_store"/blob.* >/dev/null 2>&1; then
    die "neuroserver model $ns_model has no weights here: $NS_STORE/$ns_store

A neuroserver model downloads only when the Topaz app runs it once — run any
short export with this model in the app, then retry."
  fi
fi

# --filters takes a JSON array of one object: the model plus any extra keys the
# app would pass alongside it (Starlight Precise 2.6 carries "softness": 1).
ns_filters_json() {
  local extra="${ns_params:-}"
  extra="${extra## }"
  extra="${extra%% }"
  if [[ -n "$extra" ]]; then
    [[ "$extra" == \{*\} ]] || die "--ns-params must be a JSON object: $extra"
    extra="${extra#\{}"
    extra="${extra%\}}"
  fi
  if [[ -n "${extra// /}" ]]; then
    print -r -- "[{\"model\": \"${ns_model}\", ${extra}}]"
  else
    print -r -- "[{\"model\": \"${ns_model}\"}]"
  fi
}

# Frames per second of the source, for turning a timestamp into a frame index.
media_fps() {
  local file="$1" probe="$2" rate=""
  if [[ -x "$probe" ]]; then
    rate="$("$probe" -v error -select_streams v:0 -show_entries stream=r_frame_rate \
      -of default=nokey=1:noprint_wrappers=1 -- "$file" 2>/dev/null | head -1 || true)"
  fi
  awk -v r="${rate:-}" 'BEGIN {
    n = split(r, a, "/")
    if (n == 2 && a[2] > 0) { printf "%.6f\n", a[1] / a[2] }
    else if (r + 0 > 0)     { printf "%.6f\n", r + 0 }
    else                    { print "25" }
  }'
}

# Render `time_value` through neuroserver and write a single JPEG to `out_jpg`.
neuroserver_still() {
  local time_value="$1"
  local out_jpg="$2"
  local fps start target offset tmp_mov

  fps="$(media_fps "$input" "$TOPAZ_FFPROBE")"
  target=$(awk -v t="$time_value" -v f="$fps" 'BEGIN { printf "%d", int(t * f + 0.5) }')
  # Centre the window on the wanted frame where possible; never start below zero.
  start=$(( target - 2 ))
  (( start < 0 )) && start=0
  offset=$(( target - start ))

  tmp_mov="$out_dir/.ns-window.mov"
  rm -f "$tmp_mov"

  local -a ns_args=(
    "$NS_BIN" --once
    --input-path "$input"
    --output-path "$tmp_mov"
    --filters "$(ns_filters_json)"
    --start-frame-idx "$start"
    --end-frame-idx "$(( start + NS_WINDOW ))"
    --output-codec prores
    --device 0
  )
  if [[ -n "$ns_size" ]]; then
    ns_args+=(--output-width "${ns_size%%x*}" --output-height "${ns_size##*x}")
  fi

  # neuroserver resolves its own modules relative to cwd, so it must run from its
  # directory; TOPAZ_MODEL_STORE is what makes it find the weight blobs at all.
  local ns_env=(
    env
    TOPAZ_MODEL_STORE="$NS_STORE"
    TVAI_MODEL_DIR="$TOPAZ_MODELS_DIR"
    TVAI_MODEL_DATA_DIR="$TOPAZ_MODELS_DIR"
    LC_NUMERIC=C
  )

  ( cd "$NS_DIR" && run_child "enhancing (neuroserver: $ns_model)" "${ns_env[@]}" "${ns_args[@]}" ) \
    || die "neuroserver render failed${log_file:+ — see $log_file}"

  [[ -f "$tmp_mov" ]] || die "neuroserver produced no output${log_file:+ — see $log_file}"

  # Pull the wanted frame out of the rendered window.
  run_ffmpeg "extracting preview frame" -y \
    -i "$tmp_mov" \
    -vf "select=eq(n\\,${offset}),format=yuvj420p" \
    -frames:v 1 -color_range pc -q:v 2 "$out_jpg"

  if [[ "$keep_window" == true ]]; then
    # Every frame of the window, Topaz and source alike, so a caller can step
    # through the run neuroserver actually produced rather than one still.
    local stem="${out_jpg:r}" i src_frame
    run_ffmpeg "extracting window frames" -y \
      -i "$tmp_mov" \
      -vf "format=yuvj420p" \
      -color_range pc -q:v 2 -start_number 0 "${stem} [window %02d].jpg"
    run_ffmpeg "extracting source window" -y \
      -autorotate \
      -i "$input" \
      -vf "select=between(n\\,${start}\\,$(( start + NS_WINDOW - 1 ))),format=yuvj420p" \
      -fps_mode passthrough \
      -color_range pc -q:v 2 -start_number 0 "${stem} [window original %02d].jpg"
    if [[ "$print_paths" == true ]]; then
      print -r -- "TOPAZ_PREVIEW_WINDOW_START=$start"
      print -r -- "TOPAZ_PREVIEW_WINDOW_TARGET=$offset"
      print -r -- "TOPAZ_PREVIEW_WINDOW_RATIO=1"
      for (( i = 0; i < NS_WINDOW; i++ )); do
        src_frame="$(printf '%02d' "$i")"
        [[ -f "${stem} [window ${src_frame}].jpg" ]] && \
          print -r -- "TOPAZ_PREVIEW_WINDOW_TOPAZ=${i}"$'\t'"${stem} [window ${src_frame}].jpg"
        [[ -f "${stem} [window original ${src_frame}].jpg" ]] && \
          print -r -- "TOPAZ_PREVIEW_WINDOW_ORIGINAL=${i}"$'\t'"${stem} [window original ${src_frame}].jpg"
      done
    fi
  fi

  rm -f "$tmp_mov"
}

# Topaz frames per source frame in a window render: 1, unless a kept tvai_fi
# stage invents more — fps=60 on a 30fps source makes 2, and slowmo=2 doubles
# that again.
window_ratio() {
  local filter="$1" fps="$2" fi="" fi_fps="" slowmo="1"
  if [[ "$keep_interpolation" == true && "$filter" == *tvai_fi=* ]]; then
    fi="${filter#*tvai_fi=}"
    fi=":${fi%%,*}:"
    [[ "$fi" =~ ':fps=([0-9.]+):' ]] && fi_fps="${match[1]}"
    [[ "$fi" =~ ':slowmo=([0-9.]+):' ]] && slowmo="${match[1]}"
  fi
  awk -v f="$fps" -v o="$fi_fps" -v s="$slowmo" \
    'BEGIN { r = (o > 0 && f > 0) ? o / f : 1; printf "%.6f\n", r * s }'
}

# Name an ffmpeg exit status: a signal death is what the Topaz engine's own
# crashes look like, and "exit 139" alone sends the reader to the wrong place.
ffmpeg_exit_reason() {
  local rc="$1"
  case "$rc" in
    139) print -r -- "the Topaz engine crashed, SIGSEGV" ;;
    134) print -r -- "the Topaz engine aborted, SIGABRT" ;;
    130|143) print -r -- "cancelled" ;;
    *) print -r -- "ffmpeg exit $rc" ;;
  esac
}

# The ffmpeg counterpart of the neuroserver window: `window_frames` source
# frames, starting two before the requested one, rendered through the filter and
# written one JPEG per frame beside the matching source frames. The requested
# frame is also copied to `out_jpg`, so the still and A/B paths carry on as usual.
ffmpeg_window() {
  local time_value="$1" out_jpg="$2"
  local stem="${out_jpg:r}" fps target start offset seek span ratio cap
  local window_filter topaz_target f idx
  local -a made
  integer lead=2

  fps="$(media_fps "$input" "$TOPAZ_FFPROBE")"
  target=$(awk -v t="$time_value" -v f="$fps" 'BEGIN { printf "%d", int(t * f + 0.5) }')
  (( window_frames < 5 )) && lead=$(( (window_frames - 1) / 2 ))
  start=$(( target - lead ))
  (( start < 0 )) && start=0

  # The Topaz engine must be fed at least four source frames, whatever the
  # window: given fewer, every temporal model (measured: prob-4, rxl-1, nyx-3,
  # iris-3, thd-3, amq-13) returns nothing and ffmpeg then dies in the engine's
  # postflight (SIGSEGV, "No filtered frames for output stream"). So the decode
  # always spans at least `min_feed` frames — exactly that minimum, since every
  # fed frame is inferred at full cost even when the output is capped — and
  # -frames:v caps the *output* at the window instead. Near the end of the
  # file the span is pulled back so it still fits, and the window grows to keep
  # the requested frame inside it.
  integer min_feed=4 feed keep total
  feed=$window_frames
  (( feed < min_feed )) && feed=$min_feed
  total=$(awk -v d="${duration:-0}" -v f="$fps" 'BEGIN { printf "%d", int(d * f + 0.5) }')
  if (( total > 0 && start + feed > total )); then
    start=$(( total - feed ))
    (( start < 0 )) && start=0
  fi
  offset=$(( target - start ))
  keep=$window_frames
  (( keep < offset + 1 )) && keep=$(( offset + 1 ))

  # Accurate input seeking keeps the frames at or after the seek point, so
  # seeking half a frame early lands on frame `start` whatever the rounding of
  # its timestamp, and a span of N frame durations stops after frame start+N-1.
  seek=$(awk -v s="$start" -v f="$fps" 'BEGIN { t = (s - 0.5) / f; if (t < 0) t = 0; printf "%.6f", t }')
  span=$(awk -v n="$feed" -v f="$fps" 'BEGIN { printf "%.6f", n / f }')

  if [[ "$keep_interpolation" == true ]]; then
    window_filter="$(adapt_filter_for_orientation "$filter_complex" "$display_orientation"),format=yuvj420p"
  else
    window_filter="$preview_filter_complex"
  fi
  ratio="$(window_ratio "$filter_complex" "$fps")"
  cap=$(awk -v n="$keep" -v r="$ratio" 'BEGIN { printf "%d", int(n * r + 0.5) }')

  run_ffmpeg "enhancing (${keep}-frame window)" -y \
    -ss "$seek" -t "$span" \
    -autorotate \
    -i "$input" \
    -sws_flags "spline+accurate_rnd+full_chroma_int" \
      "$ffmpeg_preset_flag" "$window_filter" \
    -frames:v "$cap" \
    -fps_mode passthrough \
    -color_range pc -q:v 2 -start_number 0 "${stem} [window %03d].jpg" \
    || die "Topaz window render failed ($(ffmpeg_exit_reason $?))${log_file:+ — see $log_file}"
  run_ffmpeg "extracting source window" -y \
    -ss "$seek" -t "$span" \
    -autorotate \
    -i "$input" \
    -vf "format=yuvj420p" \
    -frames:v "$keep" \
    -fps_mode passthrough \
    -color_range pc -q:v 2 -start_number 0 "${stem} [window original %03d].jpg"

  made=("${stem} [window "<->"].jpg"(Nn))
  (( ${#made} )) || die "the window render wrote no frames${log_file:+ — see $log_file}"
  topaz_target=$(awk -v o="$offset" -v r="$ratio" 'BEGIN { printf "%d", int(o * r + 0.5) }')
  f="${stem} [window $(printf '%03d' "$topaz_target")].jpg"
  [[ -f "$f" ]] || f="${made[-1]}"
  cp -f -- "$f" "$out_jpg"

  if [[ "$print_paths" == true ]]; then
    print -r -- "TOPAZ_PREVIEW_WINDOW_START=$start"
    print -r -- "TOPAZ_PREVIEW_WINDOW_TARGET=$offset"
    print -r -- "TOPAZ_PREVIEW_WINDOW_RATIO=$ratio"
    for f in "${made[@]}"; do
      idx="${${f:t:r}##*\[window }"
      print -r -- "TOPAZ_PREVIEW_WINDOW_TOPAZ=$(( 10#${idx%\]} ))"$'\t'"$f"
    done
    for f in "${stem} [window original "<->"].jpg"(Nn); do
      idx="${${f:t:r}##*\[window original }"
      print -r -- "TOPAZ_PREVIEW_WINDOW_ORIGINAL=$(( 10#${idx%\]} ))"$'\t'"$f"
    done
  fi
}

mpv_images=()

# The Topaz ffmpeg must run from inside the app bundle to find its libraries.
# This used to be a per-stage subshell, but a subshell would put ffmpeg out of
# reach of the signal trap above — every path here is absolute, so cd once.
cd "$TOPAZ_MACOS_DIR"

print -P -- "%F{cyan}Topaz frame preview%f"
print -P -- "  %F{white}input:%f  $input"
print -P -- "  %F{white}preset:%f $preset_name"
print -P -- "  %F{white}dir:%f    $out_dir"
[[ "$display_orientation" != "unknown" ]] && print -P -- "  %F{white}shape:%f  $display_orientation"
if [[ "$preview_filter_complex" != "${filter_complex},format=yuvj420p" ]]; then
  print -P -- "  %F{white}still:%f  adapted filter for JPEG preview"
fi

for time_value in "${times[@]}"; do
  time_value="$(clamp_time_to_duration "$time_value" "$duration")"
  time_label="$(format_time_label "$time_value")"
  original_jpg="$out_dir/${safe_input} [original ${time_label}s].jpg"
  topaz_jpg="$out_dir/${safe_input} [topaz ${time_label}s - ${safe_preset}].jpg"
  compare_jpg="$out_dir/${safe_input} [A-B ${time_label}s - ${safe_preset}].jpg"

  print -P -- "  %F{white}time:%f   ${time_value}s"

  run_ffmpeg "extracting source frame" -y \
    -ss "$time_value" \
    -autorotate \
    -i "$input" \
    -vf "format=yuvj420p" \
    -frames:v 1 \
    -color_range pc \
    -q:v 2 \
    "$original_jpg"

  if [[ -n "$ns_model" ]]; then
    neuroserver_still "$time_value" "$topaz_jpg"
  elif [[ "$keep_window" == true ]]; then
    ffmpeg_window "$time_value" "$topaz_jpg"
  else
    run_ffmpeg "enhancing" -y \
      -ss "$time_value" \
      -autorotate \
      -i "$input" \
      -sws_flags "spline+accurate_rnd+full_chroma_int" \
        "$ffmpeg_preset_flag" "$preview_filter_complex" \
      -frames:v 1 \
      -color_range pc \
      -q:v 2 \
      "$topaz_jpg"
  fi

  run_ffmpeg "building A/B" -y \
    -i "$original_jpg" \
    -i "$topaz_jpg" \
    -filter_complex "[0:v]scale=-2:1440,format=yuvj420p[left];[1:v]scale=-2:1440,format=yuvj420p[right];[left][right]hstack=inputs=2,format=yuvj420p" \
    -frames:v 1 \
    -color_range pc \
    -q:v 2 \
    "$compare_jpg"

  if [[ "$print_paths" == true ]]; then
    print -r -- "TOPAZ_PREVIEW_ORIGINAL=$original_jpg"
    print -r -- "TOPAZ_PREVIEW_TOPAZ=$topaz_jpg"
    print -r -- "TOPAZ_PREVIEW_COMPARE=$compare_jpg"
  fi

  mpv_images+=("$topaz_jpg" "$original_jpg")
done

print -P -- "  %F{white}open:%f   ${(j: :)mpv_images}"
if [[ "$open_after" == true ]]; then
  if [[ "$prompt_open" == true ]]; then
    reply=""
    read -r "?Open original/Topaz frames in preview viewer? [Y/n] " reply
    [[ "$reply" == [Nn] || "$reply" == [Nn][Oo] ]] && exit 0
  fi

  open_images "${mpv_images[@]}"
fi
