#!/usr/bin/env zsh

input_file=$1
output_file=${2:-${input_file:r}_trimmed.m4a}

# Detect silence duration at start
silence_end=$(ffmpeg -nostdin -i "$input_file" -af silencedetect=noise=-50dB:d=0.1 -f null - 2>&1 \
  | rg 'silence_end: ([0-9.]+)' -or '$1' | head -1)

if [[ -z $silence_end ]]; then
  echo "No initial silence detected; copying audio as-is."
  if [[ ${input_file:e:l} == m4a ]]; then
    cp "$input_file" "$output_file"
  else
    # A video container (mp4, mkv): remux the audio track, don't copy the file.
    ffmpeg -nostdin -i "$input_file" -map 0:a:0 -c copy "$output_file"
  fi
  exit
fi

# Use stream copy to avoid re-encoding (lossless)
# -map 0:a:0 keeps video/subtitle streams of an mp4 or mkv out of the .m4a.
ffmpeg -nostdin -ss "$silence_end" -i "$input_file" -map 0:a:0 -c copy "$output_file" || exit

echo "Trimmed silence of ${silence_end}s from start. Saved as '$output_file'."
