#!/usr/bin/env zsh
# Review detected scenes, then split a video into per-scene clips.

emulate -L zsh
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  ffmpeg-split-scenes [options] <input-video>

Options:
  -n, --dry-run            Print the split plan and ffmpeg commands without writing files
  -o, --output-dir <dir>   Output directory (default: same directory as input)
  -t, --threshold <value>  Scene sensitivity threshold passed to ffmpeg-detect-scenes
                           Lower values detect more cuts; higher values detect fewer.
                           Start with 0.30 unless the detector is too noisy or too strict.
  -e, --exact              Cut at the detected scene times instead of snapping backward
                           to keyframes. This re-encodes video with libx264 so the visual
                           cut can land exactly on the detected frame.
                           Non-video streams are copied where possible.
  -f, --force              Overwrite existing output files
  -w, --width <px>         Thumbnail preview width in fzf (default: 480)
  -k, --keep-previews      Keep generated preview thumbnails instead of deleting them
  -h, --help               Show this help

Behavior:
  - Shows an fzf review of detected scene changes before writing anything
  - By default, uses keyframe-safe stream-copy cuts for lossless output where possible
  - Writes clips beside the source as <name>.scene-001.<ext>, <name>.scene-002.<ext>, ...

Examples:
  ffmpeg-split-scenes movie.mp4
  ffmpeg-split-scenes --dry-run movie.mp4
  ffmpeg-split-scenes --exact --threshold 0.4 movie.mp4
  ffmpeg-split-scenes --output-dir /tmp/scenes movie.mkv
EOF
}

die() {
  print -u2 -- "error: $*"
  exit 1
}

warn() {
  print -u2 -- "warning: $*"
}

have() {
  command -v "$1" >/dev/null 2>&1
}

format_ts() {
  python3 - "$1" <<'PY'
import sys
s = float(sys.argv[1])
h = int(s // 3600)
m = int((s % 3600) // 60)
sec = s % 60
print(f"{h:02d}:{m:02d}:{sec:09.6f}")
PY
}

quote_cmd() {
  printf '%q ' "$@"
  printf '\n'
}

review_scenes() {
  local input_file="$1"
  local detections_file="$2"
  local width="$3"
  local keep_previews="$4"

  local tmp_dir
  tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/ffmpeg-split-scenes-review.XXXXXXXX")"

  review_cleanup() {
    if [[ "$keep_previews" == true ]]; then
      print -u2 -- "kept previews in: $tmp_dir"
    else
      rm -rf -- "$tmp_dir"
    fi
  }

  local list_file="$tmp_dir/list.tsv"
  : > "$list_file"

  local idx raw_frame raw_time cut_frame cut_time score pretty_ts img_file
  local -a ffmpeg_pids=()
  while IFS=$'\t' read -r idx raw_frame raw_time cut_frame cut_time score; do
    [[ -n "$idx" ]] || continue
    pretty_ts="$(format_ts "$raw_time")"
    img_file="$tmp_dir/scene-${idx}.jpg"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$idx" "$raw_time" "$pretty_ts" "$score" "$cut_time" "$raw_frame" "$img_file" >> "$list_file"
    (
      ffmpeg -v error -y \
        -ss "$raw_time" -i "$input_file" \
        -frames:v 1 \
        -vf "scale=${width}:-2:flags=lanczos" \
        -q:v 3 \
        -- "$img_file"
    ) &
    ffmpeg_pids+=("$!")
  done < <(grep -v '^#' "$detections_file")

  if [[ ! -s "$list_file" ]]; then
    review_cleanup
    return 0
  fi

  local pid
  for pid in "${ffmpeg_pids[@]}"; do
    wait "$pid" || {
      review_cleanup
      return 1
    }
  done

  local preview_script="$tmp_dir/preview.zsh"
  cat > "$preview_script" <<'EOF'
#!/usr/bin/env zsh
emulate -L zsh
set -euo pipefail

idx="$1"
raw_ts="$2"
pretty_ts="$3"
score="$4"
cut_ts="$5"
raw_frame="$6"
img="$7"

preview_cols="${FZF_PREVIEW_COLUMNS:-80}"
preview_lines="${FZF_PREVIEW_LINES:-24}"
image_lines=$(( preview_lines > 5 ? preview_lines - 5 : preview_lines ))

print -- "Scene break #$idx"
print -- "Detected frame: $raw_frame"
print -- "Detected time:  $pretty_ts ($raw_ts)"
print -- "Scene score:    $score"
print -- "Cut-safe time:  $cut_ts"
print -- ""

if [[ -n "${KITTY_WINDOW_ID:-}" ]] && command -v kitty >/dev/null 2>&1; then
  kitty +kitten icat \
    --clear \
    --transfer-mode=stream \
    --stdin=no \
    --place="${preview_cols}x${image_lines}@0x5" \
    -- "$img"
elif [[ -n "${WEZTERM_PANE:-}" ]] && command -v wezterm >/dev/null 2>&1; then
  wezterm imgcat --width "${preview_cols}" -- "$img"
elif command -v imgcat >/dev/null 2>&1; then
  imgcat "$img"
elif command -v chafa >/dev/null 2>&1; then
  chafa --animate=off --size="${preview_cols}x${image_lines}" -- "$img"
else
  print -- "$img"
fi
EOF
  chmod +x "$preview_script"

  fzf \
    --delimiter=$'\t' \
    --with-nth=1,3,4 \
    --no-sort \
    --layout=reverse \
    --height=100% \
    --border \
    --prompt='scene> ' \
    --header="Review detected scenes for ${input_file:t} - Enter to continue, Esc to cancel" \
    --preview-window='right,70%,border-left' \
    --preview "zsh '$preview_script' {1} {2} {3} {4} {5} {6} {7}" \
    < "$list_file" >/dev/null || {
      rc=$?
      review_cleanup
      return "$rc"
    }

  review_cleanup
}

dry_run=false
output_dir=""
threshold="0.30"
exact=false
force=false
width=480
keep_previews=false
typeset -a positionals=()

while (( $# > 0 )); do
  case "$1" in
    -n|--dry-run)
      dry_run=true
      shift
      ;;
    -o|--output-dir)
      (( $# >= 2 )) || die "missing value for $1"
      output_dir="$2"
      shift 2
      ;;
    -t|--threshold)
      (( $# >= 2 )) || die "missing value for $1"
      threshold="$2"
      shift 2
      ;;
    -e|--exact)
      exact=true
      shift
      ;;
    -f|--force)
      force=true
      shift
      ;;
    -w|--width)
      (( $# >= 2 )) || die "missing value for $1"
      width="$2"
      shift 2
      ;;
    -k|--keep-previews)
      keep_previews=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      while (( $# > 0 )); do
        positionals+=("$1")
        shift
      done
      ;;
    -*)
      die "unknown option: $1"
      ;;
    *)
      positionals+=("$1")
      shift
      ;;
  esac
done

(( ${#positionals[@]} == 1 )) || {
  usage >&2
  exit 2
}

input_file="${positionals[1]}"
[[ -f "$input_file" ]] || die "input not found: $input_file"
[[ "$threshold" == <-> || "$threshold" == <->.<-> || "$threshold" == .<-> ]] || die "threshold must be numeric"
[[ "$width" == <-> ]] || die "width must be an integer"

have ffmpeg || die "ffmpeg not found"
have ffprobe || die "ffprobe not found"
have python3 || die "python3 not found"
have fzf || die "fzf not found"
have ffmpeg-detect-scenes || die "ffmpeg-detect-scenes not found"

base_name="${input_file:t}"
dir_name="${input_file:h}"
if [[ "$base_name" == *.* ]]; then
  stem="${base_name:r}"
  ext="${base_name:e}"
else
  stem="$base_name"
  ext="mkv"
fi

if [[ -z "$output_dir" ]]; then
  output_dir="$dir_name"
fi

tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/ffmpeg-split-scenes.XXXXXXXX")"
cleanup() {
  rm -rf -- "$tmp_dir"
}
trap cleanup EXIT INT TERM

detections_file="$tmp_dir/detections.tsv"
duration_file="$tmp_dir/duration.txt"
plan_file="$tmp_dir/plan.tsv"

ffmpeg-detect-scenes --snap-to-keyframe --threshold "$threshold" -- "$input_file" > "$detections_file"
ffprobe -v error \
  -show_entries format=duration \
  -of default=nw=1:nk=1 \
  -- "$input_file" > "$duration_file"

if grep -qv '^#' "$detections_file"; then
  print -- "Reviewing detected scenes..."
  review_scenes "$input_file" "$detections_file" "$width" "$keep_previews" || exit $?
else
  warn "no scene changes detected; output will be a single clip covering the whole file"
fi

python3 - "$detections_file" "$duration_file" "$plan_file" "$exact" <<'PY'
import csv
import math
import sys

detections_path = sys.argv[1]
duration_path = sys.argv[2]
plan_path = sys.argv[3]
exact = sys.argv[4].lower() == "true"

duration = float(open(duration_path, "r", encoding="utf-8").read().strip())
if not math.isfinite(duration) or duration <= 0:
    raise SystemExit("invalid duration")

rows = []
with open(detections_path, "r", encoding="utf-8") as fh:
    for line in fh:
        if not line.strip() or line.startswith("#"):
            continue
        idx, raw_frame, raw_time, cut_frame, cut_time, score = line.rstrip("\n").split("\t")
        rows.append(
            {
                "idx": int(idx),
                "raw_time": float(raw_time),
                "cut_time": float(cut_time),
            }
        )

boundaries = [0.0]
for row in rows:
    boundaries.append(row["raw_time"] if exact else row["cut_time"])
boundaries.append(duration)

raw_boundaries = [0.0]
for row in rows:
    raw_boundaries.append(row["raw_time"])
raw_boundaries.append(duration)

segments = []
pending_raw_start = raw_boundaries[0]
segment_idx = 1
for idx in range(len(boundaries) - 1):
    start = boundaries[idx]
    end = boundaries[idx + 1]
    raw_end = raw_boundaries[idx + 1]
    if end - start <= 1e-6:
        continue
    raw_start = pending_raw_start
    exact_cut = abs(start - raw_start) <= 1e-6
    segments.append(
        (
            segment_idx,
            start,
            end,
            end - start,
            raw_start,
            raw_end,
            1 if exact_cut else 0,
        )
    )
    pending_raw_start = raw_end
    segment_idx += 1

with open(plan_path, "w", encoding="utf-8", newline="") as fh:
    writer = csv.writer(fh, delimiter="\t", lineterminator="\n")
    for row in segments:
        writer.writerow(
            [
                row[0],
                f"{row[1]:.6f}",
                f"{row[2]:.6f}",
                f"{row[3]:.6f}",
                f"{row[4]:.6f}",
                f"{row[5]:.6f}",
                row[6],
            ]
        )
PY

[[ -s "$plan_file" ]] || die "scene planning produced no output"
if [[ "$dry_run" == false ]]; then
  mkdir -p -- "$output_dir"
fi

scene_count=0
exact_count=0
while IFS=$'\t' read -r idx start end duration raw_start raw_end exact_cut; do
  (( scene_count += 1 ))
  (( exact_count += exact_cut ))

  output_file="${output_dir}/${stem}.scene-$(printf '%03d' "$idx").${ext}"
  if [[ -e "$output_file" && "$force" == false && "$dry_run" == false ]]; then
    die "output exists: $output_file (use --force to overwrite)"
  fi

  start_fmt="$(format_ts "$start")"
  end_fmt="$(format_ts "$end")"
  raw_start_fmt="$(format_ts "$raw_start")"
  raw_end_fmt="$(format_ts "$raw_end")"

  if (( exact_cut == 1 )); then
    split_status="exact"
  else
    split_status="keyframe-adjusted"
  fi

  print -- "scene $(printf '%03d' "$idx"): ${start_fmt} -> ${end_fmt} (${split_status})"
  if (( exact_cut == 0 )); then
    print -- "  detected scene range: ${raw_start_fmt} -> ${raw_end_fmt}"
  fi

  if [[ "$exact" == true ]]; then
    cmd=(
      ffmpeg
      -hide_banner
      -loglevel error
    )
    if [[ "$force" == true ]]; then
      cmd+=(-y)
    else
      cmd+=(-n)
    fi
    cmd+=(
      -i "$input_file"
      -ss "$start"
      -t "$duration"
      -map 0
      -c:v libx264
      -preset medium
      -crf 18
      -c:a copy
      -c:s copy
      -c:d copy
      "$output_file"
    )
  else
    cmd=(
      ffmpeg
      -hide_banner
      -loglevel error
    )
    if [[ "$force" == true ]]; then
      cmd+=(-y)
    else
      cmd+=(-n)
    fi
    cmd+=(
      -ss "$start"
      -i "$input_file"
      -t "$duration"
      -map 0
      -c copy
      -reset_timestamps 1
      "$output_file"
    )
  fi

  if [[ "$dry_run" == true ]]; then
    print -- "  command:"
    print -n -- "    "
    quote_cmd "${cmd[@]}"
  else
    "${cmd[@]}"
  fi
done < "$plan_file"

print -- ""
print -- "Planned segments: $scene_count"
if [[ "$exact" == true ]]; then
  print -- "Mode: exact re-encode"
else
  print -- "Exact scene cuts: $exact_count"
  print -- "Adjusted to keyframes: $(( scene_count - exact_count ))"
fi

if [[ "$dry_run" == true ]]; then
  print -- "Dry run only. No files were written."
else
  print -- "Wrote scene files to: $output_dir"
fi
