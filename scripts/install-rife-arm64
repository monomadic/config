#!/usr/bin/env bash
set -euo pipefail

# Model sources. nihui's own releases stop at rife-v4.6 (2022); the TNTwise
# fork ships the same CLI with every model up to rife-v4.26, so it is the
# default. Pass --repo nihui to go back to upstream.
repo="tntwise"
asset_regex='macos.*\.zip$'
prefix="${RIFE_PREFIX:-$HOME/.local}"
models="rife-v4.6,rife-v4.25-lite"
dry_run=0
list_only=0
tmp_dir=""

usage() {
  cat <<'EOF'
Usage: install-rife-arm64 [options]

Download the latest macOS rife-ncnn-vulkan release, thin it to arm64 if it
is a universal binary, and install it with the selected model(s) to
$PREFIX/share/rife-ncnn-vulkan with a symlink at $PREFIX/bin/rife-ncnn-vulkan.

The model dirs are installed next to the binary, which is where rife-60fps
(and rife itself, given an absolute -m path) expects to find them.

Sources (--repo):
  tntwise   TNTwise/rife-ncnn-vulkan (default) - nihui's CLI plus every model
            up to rife-v4.26. ~830MB download; only the requested models are
            kept. Newer is NOT better here: benchmarked on an M4 Pro at 1080p
            against true-60fps ground truth, v4.6 was both the most accurate
            and the fastest of nine models. Relative to v4.6, v4.25-lite is
            -0.65dB at 35% slower and v4.26 is -0.48dB at 40% slower; the
            whole v4.15-v4.26 range lands within 0.7dB of v4.6 while costing
            1.2-2.2x the time. Stay on v4.6 unless you have measured
            otherwise on your own footage. "-lite" is lite for its own
            generation, not against v4.6.
  nihui     nihui/rife-ncnn-vulkan - upstream, but its releases carry nothing
            newer than rife-v4.6.
  OWNER/REPO  Any other GitHub repo publishing a macOS zip in the same shape.

Options:
  --prefix DIR        Install prefix. Default: ~/.local
  --models a,b,c      Comma-separated model dirs to install.
                      Default: rife-v4.6,rife-v4.25-lite
  --repo NAME|O/R     Source, see above. Default: tntwise
  -l, --list-models   List the model dirs the release contains and exit.
                      Reads only the zip index, not the whole archive.
  -n, --dry-run       Print planned work without writing.
  -h, --help          Show this help.

Environment:
  RIFE_PREFIX         Overrides the install prefix.
  GITHUB_TOKEN        Optional GitHub API token for higher rate limits.

Examples:
  install-rife-arm64 --list-models
  install-rife-arm64 --models rife-v4.6,rife-v4.25-lite,rife-v4.26
  install-rife-arm64 --repo nihui --models rife-v4.6
EOF
}

log() {
  printf '==> %s\n' "$*"
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

run() {
  if [[ "$dry_run" -eq 1 ]]; then
    printf '+'
    printf ' %q' "$@"
    printf '\n'
  else
    "$@"
  fi
}

cleanup() {
  if [[ -n "$tmp_dir" && -d "$tmp_dir" ]]; then
    rm -rf "$tmp_dir"
  fi
}

trap cleanup EXIT

while [[ $# -gt 0 ]]; do
  case "$1" in
    --prefix)
      shift
      [[ $# -gt 0 ]] || die "--prefix requires a path"
      prefix="${1%/}"
      ;;
    --models)
      shift
      [[ $# -gt 0 ]] || die "--models requires a comma-separated list"
      models="$1"
      ;;
    --repo)
      shift
      [[ $# -gt 0 ]] || die "--repo requires OWNER/REPO"
      repo="$1"
      ;;
    -l|--list-models)
      list_only=1
      ;;
    -n|--dry-run)
      dry_run=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown option: $1"
      ;;
  esac
  shift
done

case "$repo" in
  tntwise) repo="TNTwise/rife-ncnn-vulkan" ;;
  nihui)   repo="nihui/rife-ncnn-vulkan" ;;
esac

share_dir="$prefix/share/rife-ncnn-vulkan"
bin_link="$prefix/bin/rife-ncnn-vulkan"

curl_json() {
  if [[ -n "${GITHUB_TOKEN:-}" ]]; then
    curl -fsSL -H "Authorization: Bearer $GITHUB_TOKEN" "$1"
  else
    curl -fsSL "$1"
  fi
}

# List the top-level model dirs inside the release zip without downloading it.
# The zip central directory lives at the end of the archive, so a range request
# for the last chunk is enough. Prints one name per line; silent + nonzero if
# the probe does not work (ranges unsupported, odd archive), so callers can
# fall back to validating after extraction.
list_zip_models() {
  local url="$1" size tail_file start
  command -v python3 >/dev/null 2>&1 || return 1
  size="$(curl -fsSLI "$url" | awk 'BEGIN{IGNORECASE=1} /^content-length:/{n=$2} END{gsub(/\r/,"",n); print n+0}')"
  [[ "$size" -gt 100000 ]] || return 1
  tail_file="$(mktemp "${TMPDIR:-/tmp}/rife-zipidx.XXXXXX")"
  start=$(( size - 300000 )); [[ "$start" -lt 0 ]] && start=0
  curl -fsSL -r "${start}-$((size - 1))" "$url" -o "$tail_file" || { rm -f "$tail_file"; return 1; }
  python3 - "$tail_file" <<'PY' || { rm -f "$tail_file"; return 1; }
import re, struct, sys
data = open(sys.argv[1], "rb").read()
names = []
for m in re.finditer(b"PK\x01\x02", data):
    o = m.start()
    try:
        nlen = struct.unpack("<H", data[o + 28:o + 30])[0]
    except struct.error:
        continue
    if not 0 < nlen < 300:
        continue
    name = data[o + 46:o + 46 + nlen].decode("utf-8", "replace")
    parts = [p for p in name.split("/") if p]
    # archives are either <top>/<model>/file or <model>/file
    if len(parts) >= 3:
        names.append(parts[1])
    elif len(parts) == 2:
        names.append(parts[0])
models = sorted({n for n in names if n.lower().startswith("rife")})
if not models:
    sys.exit(1)
print("\n".join(models))
PY
  rm -f "$tail_file"
}

download_file() {
  local url="$1"
  local out="$2"

  if [[ -n "${GITHUB_TOKEN:-}" ]]; then
    curl -fL --progress-bar -H "Authorization: Bearer $GITHUB_TOKEN" -o "$out" "$url"
  else
    curl -fL --progress-bar -o "$out" "$url"
  fi
}

main() {
  [[ "$(uname -s)" == "Darwin" ]] || die "this installer is only for macOS"
  [[ "$(uname -m)" == "arm64" ]] || die "this installer is only for Apple Silicon Macs"
  for cmd in curl jq unzip lipo codesign xattr; do
    need_cmd "$cmd"
  done

  local api_url="https://api.github.com/repos/$repo/releases/latest"
  local release_json tag_name asset_name asset_url

  log "Looking up latest release from $repo"
  release_json="$(curl_json "$api_url")"
  tag_name="$(printf '%s' "$release_json" | jq -r '.tag_name // empty')"
  asset_name="$(printf '%s' "$release_json" | jq -r --arg re "$asset_regex" '[.assets[] | select(.name | test($re; "i"))][0].name // empty')"
  asset_url="$(printf '%s' "$release_json" | jq -r --arg re "$asset_regex" '[.assets[] | select(.name | test($re; "i"))][0].browser_download_url // empty')"

  [[ -n "$tag_name" ]] || die "could not read latest release tag"
  [[ -n "$asset_name" && -n "$asset_url" ]] || die "no release asset matched regex: $asset_regex"

  log "Latest release: $tag_name"
  log "Matched asset: $asset_name"

  # The archive is large (hundreds of MB on the tntwise fork), so check the
  # requested models against the zip index before paying for the download.
  local available=""
  if [[ "$list_only" -eq 1 || "$dry_run" -eq 0 ]]; then
    available="$(list_zip_models "$asset_url" 2>/dev/null || true)"
  fi

  if [[ "$list_only" -eq 1 ]]; then
    [[ -n "$available" ]] || die "could not read the model list from $asset_name"
    printf '%s\n' "$available"
    exit 0
  fi

  if [[ -n "$available" ]]; then
    local model missing=""
    for model in ${models//,/ }; do
      printf '%s\n' "$available" | grep -qx "$model" || missing="$missing $model"
    done
    if [[ -n "$missing" ]]; then
      printf 'error: model(s) not in %s:%s\n\navailable:\n' "$asset_name" "$missing" >&2
      printf '%s\n' "$available" | sed 's/^/  /' >&2
      exit 1
    fi
  fi

  tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/rife-install.XXXXXX")"
  local zip_path="$tmp_dir/$asset_name"

  log "Downloading"
  if [[ "$dry_run" -eq 1 ]]; then
    run download "$asset_url" "$zip_path"
  else
    download_file "$asset_url" "$zip_path"
  fi

  log "Extracting"
  run unzip -q "$zip_path" -d "$tmp_dir/extract"

  local src_bin src_dir
  if [[ "$dry_run" -eq 1 ]]; then
    src_dir="$tmp_dir/extract/<release>"
    src_bin="$src_dir/rife-ncnn-vulkan"
  else
    src_bin="$(find "$tmp_dir/extract" -name rife-ncnn-vulkan -type f | head -1)"
    [[ -n "$src_bin" ]] || die "no rife-ncnn-vulkan binary found in the archive"
    src_dir="$(dirname "$src_bin")"
  fi

  # Upstream ships a universal binary; the tntwise fork is already arm64-only.
  if [[ "$dry_run" -eq 1 ]] || lipo -archs "$src_bin" 2>/dev/null | grep -qw x86_64; then
    log "Thinning universal binary to arm64"
    run lipo -thin arm64 "$src_bin" -output "$src_bin.arm64"
  else
    log "Binary is already arm64-only"
    run cp "$src_bin" "$src_bin.arm64"
  fi
  run codesign --force --sign - "$src_bin.arm64"

  log "Installing to $share_dir"
  run rm -rf "$share_dir"
  run mkdir -p "$share_dir" "$prefix/bin"
  run cp "$src_bin.arm64" "$share_dir/rife-ncnn-vulkan"
  run chmod 755 "$share_dir/rife-ncnn-vulkan"

  local model
  for model in ${models//,/ }; do
    if [[ "$dry_run" -eq 0 && ! -d "$src_dir/$model" ]]; then
      printf 'error: model not found in release: %s\n\navailable:\n' "$model" >&2
      (cd "$src_dir" && ls -d rife* 2>/dev/null | sed 's/^/  /') >&2 || true
      exit 1
    fi
    log "Installing model $model"
    run cp -R "$src_dir/$model" "$share_dir/$model"
  done

  run ln -sfn "$share_dir/rife-ncnn-vulkan" "$bin_link"

  if [[ "$dry_run" -eq 0 ]]; then
    xattr -dr com.apple.quarantine "$share_dir" >/dev/null 2>&1 || true

    log "Verifying"
    lipo -archs "$share_dir/rife-ncnn-vulkan" | grep -qw arm64 || die "installed binary is not arm64"
    # rife exits nonzero when run without args, so don't pipe it under pipefail
    local usage_out
    usage_out="$("$bin_link" 2>&1 || true)"
    printf '%s' "$usage_out" | grep -q "Usage:" || die "installed binary did not print usage"

    case ":$PATH:" in
      *":$prefix/bin:"*) ;;
      *) printf 'note: %s is not on your PATH\n' "$prefix/bin" >&2 ;;
    esac
  fi

  log "Done: $bin_link ($tag_name, models: $models)"
}

main "$@"
