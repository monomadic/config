# Plain zsh, sourced by scripts/setup/link.zsh.
# Add a call to extend deployment; comment it out to skip it.
# link_file links a file or whole directory. link_tree links each file below it.
# Targets are quoted so spaces and $HOME work normally.
# Removing a call does not remove previously installed links.

# Tracked under config/ but deliberately not linked (source-only):
#   beatportdl, compressor, git, homebrew, iterm, ollama, python, tag-media

# --- Shell and prompt ---------------------------------------------------------

link_file config/zsh/zshrc.zsh "$HOME/.zshrc"
link_file config/zsh/zshenv.zsh "$HOME/.zshenv"
link_file config/zsh/zprofile.zsh "$HOME/.zprofile"
link_file config/zsh/zlogin.zsh "$HOME/.zlogin"
link_file config/zsh/zlogout.zsh "$HOME/.zlogout"
link_file config/zsh/emoji.json "$HOME/.zsh/emoji.json"
link_tree config/zsh/completions "$HOME/.zsh/completions"
link_tree config/zsh/autoload "$HOME/.zsh/autoload"

link_file config/bash/rc.bash "$HOME/.bashrc"
link_file config/bash/fzm.bash "$HOME/.bash/fzm.bash"

# One symlink per command, so the installed binaries already in ~/.local/bin
# (pimped, the widgets, pipx shims) are left alone.
link_tree bin "$HOME/.local/bin"

link_file config/starship/starship.toml "$HOME/.config/starship.toml"

# --- Terminals ----------------------------------------------------------------

link_file config/alacritty/alacritty.toml "$HOME/.config/alacritty/alacritty.toml"

link_file config/kitty/bin/kitty-repl "$HOME/.config/kitty/bin/kitty-repl"
link_file config/kitty/kittens/toggle_repl.py "$HOME/.config/kitty/kittens/toggle_repl.py"
link_file config/kitty/kitty.conf "$HOME/.config/kitty/kitty.conf"
link_file config/kitty/quick-access-terminal.conf "$HOME/.config/kitty/quick-access-terminal.conf"
link_file config/kitty/tab_bar.py "$HOME/.config/kitty/tab_bar.py"
link_file config/kitty/themes/1984-dark "$HOME/.config/kitty/themes/1984-dark"

link_file config/tmux/tmux.conf "$HOME/.tmux.conf"

link_tree config/zellij "$HOME/.config/zellij"

# --- Editors and viewers ------------------------------------------------------

link_file config/chordpro-tui/chordpro-tui.toml "$HOME/.config/chordpro-tui/chordpro-tui.toml"
link_tree config/helix "$HOME/.config/helix"
link_file config/leaf/config.toml "$HOME/.config/leaf/config.toml"
link_tree config/micro "$HOME/.config/micro"

# --- File managers ------------------------------------------------------------

link_tree config/broot "$HOME/.config/broot"
link_tree config/lsd "$HOME/.config/lsd"

link_file config/marta/conf.marco "$HOME/Library/Application Support/org.yanex.marta/conf.marco"
link_file config/marta/favorites.marco "$HOME/Library/Application Support/org.yanex.marta/favorites.marco"
link_file config/marta/Themes/Black.theme "$HOME/Library/Application Support/org.yanex.marta/Themes/Black.theme"

link_file 'src/open-in-forklift/Open In Forklift.app' "$HOME/Applications/Open In Forklift.app"

link_tree config/yazi "$HOME/.config/yazi"

# --- Git ----------------------------------------------------------------------

link_file config/delta/allowed_signers "$HOME/.config/git/allowed_signers"
link_file config/delta/gitconfig "$HOME/.gitconfig"
link_file config/gitui/vim.ron "$HOME/.config/gitui/key_bindings.ron"

# --- macOS window management and input ----------------------------------------

link_tree config/hammerspoon "$HOME/.hammerspoon"
link_tree config/karabiner/assets/complex_modifications "$HOME/.config/karabiner/assets/complex_modifications"
link_file config/macos-shortcuts/shortcuts.toml "$HOME/.config/macos-shortcuts/shortcuts.toml"
link_file config/skhd/skhd.conf "$HOME/.config/skhd/skhdrc"
link_tree config/switch "$HOME/.switch"
link_tree config/switchblade "$HOME/.config/switchblade"

# --- Media --------------------------------------------------------------------

link_file config/cointop/config.toml "$HOME/.config/cointop/config.toml"

# Resolve scans subfolders of its LUT dir and shows each as a category, so the
# repo's LUTs land in a "Custom" category alongside the bundled vendor sets
# rather than replacing them. The LUT dir is world-writable, so no sudo needed.
link_file assets/LUTs "/Library/Application Support/Blackmagic Design/DaVinci Resolve/LUT/Custom"

# Final Cut's Custom LUT effect scans <Application Support>/ProApps/Custom LUTs.
# Only .cube and .mga are recognised; the effect lists them flat, so no
# subfolders here.
link_file assets/LUTs "$HOME/Library/Application Support/ProApps/Custom LUTs"

link_file config/gomu/gomu.conf "$HOME/.config/gomu/gomu.conf"
link_tree config/mpv "$HOME/.config/mpv"
link_tree config/virtualdj/Mappers "$HOME/Library/Application Support/VirtualDJ/Mappers"
link_tree config/virtualdj/Pads "$HOME/Library/Application Support/VirtualDJ/Pads"
link_tree config/yt-dlp "$HOME/.config/yt-dlp"

# --- Misc tooling -------------------------------------------------------------

link_tree config/crush "$HOME/.config/crush"
link_tree config/dprint "$HOME/.config/dprint"
link_tree config/elio "$HOME/Library/Application Support/elio"
link_file config/motherfucker/config.toml "$HOME/.config/motherfucker/config.toml"
link_tree config/motherfucker/themes "$HOME/.config/motherfucker/themes"
link_tree config/rclone "$HOME/.config/rclone"
