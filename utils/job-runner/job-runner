#!/usr/bin/env bash
# job-runner — execute *.job shell scripts dropped into a watch folder.
#
# Triggered by a launchd WatchPaths LaunchAgent on $JOBS_DIR (see
# setup/install/install-job-runner.sh, which installs this script to
# ~/.local/bin). Only top-level *.job files are run; subdirectories and
# non-.job files are ignored.
#
# Lifecycle of a job NAME.job (first *.job alphabetically runs first):
#   1. Renamed in place to NAME.job.running while it runs. The scanner only
#      matches *.job, so a claimed job can never be picked up twice. One job
#      runs at a time.
#   2. Runs cd'd into $JOBS_DIR with JOB_NAME=NAME, JOB_FILE, JOB_DIR
#      exported, and TERM=dumb / NO_COLOR=1 / CLICOLOR=0 set for clean logs.
#      stdout is captured to NAME.job.log, stderr to NAME.job.errors — each
#      created only once that stream produces output, so a silent job leaves
#      no empty artifacts behind.
#   3. On exit 0 : renamed NAME.job.done and moved to $JOBS_DIR/_done/,
#                  along with its .log (if any).
#      On failure: renamed NAME.job.err and moved to $JOBS_DIR/_err/,
#                  along with its .log (if any).
#      An .errors file exists only if the job wrote to stderr, and always
#      lands in $JOBS_DIR/_err/.
# A one-line status trail for every job is appended to $LOG_FILE.

set -uo pipefail

JOBS_DIR="${JOBS_DIR:-$HOME/jobs}"
DONE_DIR="$JOBS_DIR/_done"
ERR_DIR="$JOBS_DIR/_err"
LOCK_DIR="$JOBS_DIR/.lock"
LOG_FILE="${JOB_RUNNER_LOG:-$HOME/Library/Logs/job-runner.log}"
SETTLE_SECS="${JOB_RUNNER_SETTLE:-2}"

mkdir -p "$JOBS_DIR" "$DONE_DIR" "$ERR_DIR" "$(dirname "$LOG_FILE")"

log() { printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*" >>"$LOG_FILE"; }

# Single-instance lock => only one job runs at a time. A running instance
# rescans before exiting, so a concurrent trigger can safely bail. Steal a lock
# left behind by a killed run (>60m old).
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
  if [[ -n "$(find "$LOCK_DIR" -maxdepth 0 -mmin +60 2>/dev/null)" ]]; then
    rmdir "$LOCK_DIR" 2>/dev/null || true
    mkdir "$LOCK_DIR" 2>/dev/null || exit 0
  else
    exit 0
  fi
fi
trap 'rmdir "$LOCK_DIR" 2>/dev/null' EXIT

# 0 if the file's size held steady across SETTLE_SECS (i.e. upload finished).
is_stable() {
  local f="$1" s1 s2
  s1=$(stat -f %z "$f" 2>/dev/null) || return 1
  sleep "$SETTLE_SECS"
  s2=$(stat -f %z "$f" 2>/dev/null) || return 1
  [[ "$s1" == "$s2" ]]
}

# Echo a non-colliding path: if $1 exists, insert a timestamp before the
# ".job.<suffix>" tail so an earlier run's artifact is never clobbered.
uniq_dest() {
  local path="$1"
  [[ -e "$path" ]] || { printf '%s' "$path"; return; }
  local dir base stem tail ts
  dir="$(dirname "$path")"; base="$(basename "$path")"
  stem="${base%%.job.*}"; tail="${base#"$stem".}"
  ts="$(date '+%Y%m%d-%H%M%S')"
  printf '%s/%s.%s.%s' "$dir" "$stem" "$ts" "$tail"
}

# Copy stdin to $1, creating the file only when the first line of output
# arrives — a stream that stays silent never gets a file at all. Flushed per
# line so a running job's log can be tailed.
lazy_write() {
  LAZY_OUT="$1" awk '{ print > ENVIRON["LAZY_OUT"]; fflush() }'
}

run_one() {
  local job="$1" name running logfile errfile rcfile rc dest_dir dest_job stem
  name="$(basename "$job")"; name="${name%.job}"
  running="$JOBS_DIR/$name.job.running"
  logfile="$JOBS_DIR/$name.job.log"
  errfile="$JOBS_DIR/$name.job.errors"

  # Claim the job by renaming it out of the scan set before running.
  if ! mv "$job" "$running" 2>/dev/null; then
    log "SKIP $name (could not mark running)"
    return
  fi
  log "RUN  $name"
  chmod +x "$running" 2>/dev/null || true

  # Run cd'd into the jobs dir; honour a shebang if present, else use bash.
  # JOB_NAME lets a job reference its target without knowing the rename
  # scheme (foo.mp4.job => JOB_NAME=foo.mp4). TERM=dumb / NO_COLOR make
  # well-behaved tools drop progress-bar redraws and ANSI color in the logs.
  #
  # Both streams go through lazy_write, so the exit status can't come from $?
  # (it would be the pipeline's) — the job's own status is stashed in $rcfile.
  rcfile="$(mktemp -t job-runner)"
  {
    {
      (
        cd "$JOBS_DIR" || exit 127
        export JOB_NAME="$name" JOB_FILE="$running" JOB_DIR="$JOBS_DIR"
        export TERM=dumb NO_COLOR=1 CLICOLOR=0
        if [[ -x "$running" ]]; then
          "$running"
        else
          /bin/bash "$running"
        fi
      )
      echo $? >"$rcfile"
    } 2>&1 1>&3 | lazy_write "$errfile"
  } 3>&1 | lazy_write "$logfile"
  rc="$(cat "$rcfile" 2>/dev/null)"
  rm -f "$rcfile"
  rc="${rc:-1}"

  if [[ $rc -eq 0 ]]; then
    dest_dir="$DONE_DIR"; dest_job="$DONE_DIR/$name.job.done"
    log "DONE $name (exit 0)"
  else
    dest_dir="$ERR_DIR"; dest_job="$ERR_DIR/$name.job.err"
    log "FAIL $name (exit $rc)"
  fi

  dest_job="$(uniq_dest "$dest_job")"
  stem="$(basename "$dest_job")"; stem="${stem%.*}"   # NAME[.ts].job
  mv "$running" "$dest_job" 2>/dev/null || log "WARN could not move $name job artifact"
  if [[ -s "$logfile" ]]; then
    mv "$logfile" "$(uniq_dest "$dest_dir/$stem.log")" 2>/dev/null || true
  else
    rm -f "$logfile"
  fi
  if [[ -s "$errfile" ]]; then
    mv "$errfile" "$(uniq_dest "$ERR_DIR/$stem.errors")" 2>/dev/null || true
  else
    rm -f "$errfile"
  fi
}

# Loop until no runnable job remains, so files that arrive during a run are
# still picked up (sequentially) before we release the lock. The glob is
# alphabetical, and in-flight/finished names (*.job.running, *.job.done,
# *.job.err) no longer end in .job, so they can't match.
while :; do
  found=0
  shopt -s nullglob
  for job in "$JOBS_DIR"/*.job; do
    [[ -f "$job" ]] || continue   # skip dirs named *.job
    if ! is_stable "$job"; then
      log "WAIT $(basename "$job") (still uploading)"
      continue
    fi
    found=1
    run_one "$job"
  done
  shopt -u nullglob
  [[ $found -eq 0 ]] && break
done
