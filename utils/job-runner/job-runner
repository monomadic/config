#!/usr/bin/env bash
# job-runner — execute *.job shell scripts dropped into a watch folder.
#
# Triggered by a launchd WatchPaths LaunchAgent on $JOBS_DIR (see
# setup/install/install-job-runner.sh, which installs this script to
# ~/.local/bin). Only top-level *.job files are run; subdirectories and
# non-.job files are ignored.
#
# Lifecycle of a job TARGET.job (first *.job alphabetically runs first):
#   1. A run folder $JOBS_DIR/_running/<date>-<JOB_NAME> is created and the
#      job file — plus its target file, if one sits beside it — is moved into
#      it. The move out of the top level *is* the claim: the scanner only
#      matches $JOBS_DIR/*.job, so a claimed job can never be picked up twice.
#      One job runs at a time.
#   2. The run folder becomes the CWD. TARGET_FILE (the job filename minus
#      .job), JOB_NAME (TARGET_FILE minus its extension), JOB_FILE, JOB_DIR
#      and JOB_RUN_DIR are exported, and TERM=dumb / NO_COLOR=1 / CLICOLOR=0
#      are set for clean logs. stdout is captured to $JOB_NAME.log, stderr to
#      $JOB_NAME.error.log — each created only once that stream produces
#      output, so a silent job leaves no empty artifacts behind.
#   3. On exit 0 the whole run folder is moved to $JOBS_DIR/_done/,
#      otherwise to $JOBS_DIR/_err/ — logs, target file and all.
# A one-line status trail for every job is appended to $LOG_FILE.

set -uo pipefail

JOBS_DIR="${JOBS_DIR:-$HOME/jobs}"
RUNNING_DIR="$JOBS_DIR/_running"
DONE_DIR="$JOBS_DIR/_done"
ERR_DIR="$JOBS_DIR/_err"
LOCK_DIR="$JOBS_DIR/.lock"
LOG_FILE="${JOB_RUNNER_LOG:-$HOME/Library/Logs/job-runner.log}"
SETTLE_SECS="${JOB_RUNNER_SETTLE:-2}"

mkdir -p "$JOBS_DIR" "$RUNNING_DIR" "$DONE_DIR" "$ERR_DIR" "$(dirname "$LOG_FILE")"

log() { printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*" >>"$LOG_FILE"; }

# Single-instance lock => only one job runs at a time. A running instance
# rescans before exiting, so a concurrent trigger can safely bail. Steal a lock
# left behind by a killed run (>60m old).
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
  if [[ -n "$(find "$LOCK_DIR" -maxdepth 0 -mmin +60 2>/dev/null)" ]]; then
    rmdir "$LOCK_DIR" 2>/dev/null || true
    mkdir "$LOCK_DIR" 2>/dev/null || exit 0
  else
    exit 0
  fi
fi
trap 'rmdir "$LOCK_DIR" 2>/dev/null' EXIT

# 0 if the file's size held steady across SETTLE_SECS (i.e. upload finished).
is_stable() {
  local f="$1" s1 s2
  s1=$(stat -f %z "$f" 2>/dev/null) || return 1
  sleep "$SETTLE_SECS"
  s2=$(stat -f %z "$f" 2>/dev/null) || return 1
  [[ "$s1" == "$s2" ]]
}

# Echo a non-colliding directory path: append -2, -3, ... if $1 is taken.
uniq_dir() {
  local path="$1" n=2
  while [[ -e "$path" ]]; do
    path="$1-$n"
    n=$((n + 1))
  done
  printf '%s' "$path"
}

# Copy stdin to $1, creating the file only when the first line of output
# arrives — a stream that stays silent never gets a file at all. Flushed per
# line so a running job's log can be tailed.
lazy_write() {
  LAZY_OUT="$1" awk '{ print > ENVIRON["LAZY_OUT"]; fflush() }'
}

run_one() {
  local job="$1" base target name rundir jobfile logfile errfile rcfile rc dest
  base="$(basename "$job")"     # foo.mp4.job
  target="${base%.job}"         # foo.mp4
  name="${target%.*}"           # foo

  # Claim the job by moving it — and its target file, if present — out of the
  # scan set and into a dated run folder. mkdir (no -p) is the atomic step.
  rundir="$(uniq_dir "$RUNNING_DIR/$(date '+%Y%m%d-%H%M%S')-$name")"
  if ! mkdir "$rundir" 2>/dev/null; then
    log "SKIP $name (could not create run folder)"
    return
  fi
  jobfile="$rundir/$base"
  if ! mv "$job" "$jobfile" 2>/dev/null; then
    rmdir "$rundir" 2>/dev/null || true
    log "SKIP $name (could not claim job file)"
    return
  fi
  if [[ -e "$JOBS_DIR/$target" ]]; then
    mv "$JOBS_DIR/$target" "$rundir/$target" 2>/dev/null \
      || log "WARN could not move target file $target"
  fi

  log "RUN  $name"
  chmod +x "$jobfile" 2>/dev/null || true

  logfile="$rundir/$name.log"
  errfile="$rundir/$name.error.log"

  # Run cd'd into the run folder; honour a shebang if present, else use bash.
  # TARGET_FILE lets a job reference the file it was named after
  # (foo.mp4.job => TARGET_FILE=foo.mp4, JOB_NAME=foo) without knowing the
  # folder scheme. TERM=dumb / NO_COLOR make well-behaved tools drop
  # progress-bar redraws and ANSI color in the logs.
  #
  # Both streams go through lazy_write, so the exit status can't come from $?
  # (it would be the pipeline's) — the job's own status is stashed in $rcfile.
  rcfile="$(mktemp -t job-runner)"
  {
    {
      (
        cd "$rundir" || exit 127
        export JOB_NAME="$name" TARGET_FILE="$target"
        export JOB_FILE="$jobfile" JOB_DIR="$JOBS_DIR" JOB_RUN_DIR="$rundir"
        export TERM=dumb NO_COLOR=1 CLICOLOR=0
        if [[ -x "$jobfile" ]]; then
          "$jobfile"
        else
          /bin/bash "$jobfile"
        fi
      )
      echo $? >"$rcfile"
    } 2>&1 1>&3 | lazy_write "$errfile"
  } 3>&1 | lazy_write "$logfile"
  rc="$(cat "$rcfile" 2>/dev/null)"
  rm -f "$rcfile"
  rc="${rc:-1}"

  [[ -s "$logfile" ]] || rm -f "$logfile"
  [[ -s "$errfile" ]] || rm -f "$errfile"

  # The whole run folder is the artifact: job file, target file and logs move
  # together to _done or _err.
  if [[ $rc -eq 0 ]]; then
    dest="$DONE_DIR/$(basename "$rundir")"
    log "DONE $name (exit 0)"
  else
    dest="$ERR_DIR/$(basename "$rundir")"
    log "FAIL $name (exit $rc)"
  fi
  mv "$rundir" "$(uniq_dir "$dest")" 2>/dev/null \
    || log "WARN could not move run folder for $name"
}

# Loop until no runnable job remains, so files that arrive during a run are
# still picked up (sequentially) before we release the lock. The glob is
# alphabetical, and claimed jobs live under _running/ (and then _done/_err),
# so they can't match again.
while :; do
  found=0
  shopt -s nullglob
  for job in "$JOBS_DIR"/*.job; do
    [[ -f "$job" ]] || continue   # skip dirs named *.job
    if ! is_stable "$job"; then
      log "WAIT $(basename "$job") (still uploading)"
      continue
    fi
    # The target file may still be copying in even once the job file settled.
    target_path="$JOBS_DIR/$(basename "$job" .job)"
    if [[ -f "$target_path" ]] && ! is_stable "$target_path"; then
      log "WAIT $(basename "$job") (target still uploading)"
      continue
    fi
    found=1
    run_one "$job"
  done
  shopt -u nullglob
  [[ $found -eq 0 ]] && break
done
